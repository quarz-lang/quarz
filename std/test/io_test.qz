# Files: reads and writes on one opened "r+".
class FileReadWriteTest < Test::Case
  # A file of the test's own (tests may run at once).
  def path(name: String) -> String = "#{Dir.tmpdir}/quarz-io-test-#{Process.pid}-#{name}"

  def test_a_write_after_a_read_goes_to_the_read_position
    p = path("read-write")
    File.write(p, "abc")
    begin
      first = File.open(p, "r+") do |f|
        r = f.read(1)
        f.write("Z")
        r
      end
      assert_equal("a", first)
      assert_equal("aZc", File.read(p))
    ensure
      File.delete(p)
    end
  end

  def test_rewind_after_a_read_and_a_write
    p = path("rewind")
    File.write(p, "abc")
    begin
      got = File.open(p, "r+") do |f|
        f.read(1)
        f.write("Z")
        f.rewind
        f.read
      end
      assert_equal("aZc", got)
      assert_equal("aZc", File.read(p))
    ensure
      File.delete(p)
    end
  end

  def test_a_read_after_a_write_comes_after_it
    p = path("write-read")
    File.write(p, "abc")
    begin
      got = File.open(p, "r+") do |f|
        f.write("X")
        f.read(1)
      end
      assert_equal("b", got)
      assert_equal("Xbc", File.read(p))
    ensure
      File.delete(p)
    end
  end
end

# File IO in a cancelled task: in `Task.uncancellable`, it is waited for.
class FileCancelTest < Test::Case
  def test_a_write_in_a_cancelled_task_completes
    p = "#{Dir.tmpdir}/quarz-io-test-#{Process.pid}-cancelled"
    data = "x" * 5_000_000
    begin
      check_cancelled_write(p, data)
    ensure
      File.delete(p) if File.exist?(p)
    end
  end

  def check_cancelled_write(p: String, data: String) -> Void
    started = Channel[Nil].new(capacity: 1)
    t = Task.spawn do
      begin
        started.send(nil)
        Task.sleep(1.second)
      ensure
        Task.uncancellable { File.write(p, data) }
      end
      nil
    end
    started.receive
    t.cancel
    ended = begin
      t.await
      :finished
    rescue Task::Cancelled
      :cancelled
    end
    assert_equal(:cancelled, ended)
    assert_equal(5_000_000, File.size(p))
    nil
  end
end

# `Dir.glob` as Ruby's (#440): `**` does not enter a symbolic link to a
# directory, a wildcard does not match a leading dot unless the segment
# starts with one.
class DirGlobTest < Test::Case
  # A tree of its own for each test (tests run in parallel), removed after.
  def with_tree(name: String, &body: (String) -> Void) -> Void
    root = "#{Dir.tmpdir}/quarz-glob-test-#{Process.pid}-#{name}"
    Dir.rm_rf(root)
    Dir.mkdir_p("#{root}/src/sub")
    Dir.mkdir_p("#{root}/src/.hid")
    ["src/a.qz", "src/sub/b.qz", "src/.dot.qz", "src/.hid/c.qz"].each { |f| File.write("#{root}/#{f}", "") }
    begin
      body.call(root)
    ensure
      Dir.rm_rf(root)
    end
  end

  def link(root: String, target: String, name: String) -> Void
    Process.run("ln", "-s", target, "#{root}/#{name}")
  end

  def test_a_link_to_an_ancestor_is_not_entered
    with_tree("self") do |root|
      link(root, ".", "src/self")
      assert_equal(["src/a.qz", "src/sub/b.qz"], Dir.glob("src/**/*.qz", root))
    end
  end

  def test_two_links_to_ancestors_return_at_once
    with_tree("up") do |root|
      link(root, ".", "src/self")
      link(root, "..", "src/up")
      assert_equal(["src/a.qz", "src/sub/b.qz"], Dir.glob("src/**/*.qz", root))
      assert_equal(["src/sub"], Dir.glob("src/**/", root))
      # (Repeated `**` is walked once.)
      assert_equal(["src/a.qz", "src/sub/b.qz"], Dir.glob("src/**/**/**/**/*.qz", root))
    end
  end

  def test_hidden_names_need_a_dot_in_the_pattern
    with_tree("dots") do |root|
      assert_equal(["src/a.qz", "src/sub"], Dir.glob("src/*", root))
      # (`.*` matches `.`, not `..`, as Ruby's since 3.1.)
      assert_equal(["src/.", "src/.dot.qz", "src/.hid"], Dir.glob("src/.*", root))
      assert_equal(["src/.hid/c.qz"], Dir.glob("src/.hid/*.qz", root))
      assert_equal(["src/.dot.qz"], Dir.glob("src/.d?t.qz", root))
    end
  end

  def test_the_root_and_a_dot_prefix
    assert_equal(["/"], Dir.glob("/"))
    with_tree("prefix") do |root|
      assert_equal(["./src/a.qz"], Dir.glob("./src/*.qz", root))
    end
  end

  def test_a_link_to_a_file_matches_as_a_file
    with_tree("file") do |root|
      link(root, "a.qz", "src/alink.qz")
      assert_equal(["src/a.qz", "src/alink.qz", "src/sub/b.qz"], Dir.glob("src/**/*.qz", root))
    end
  end

  # Ruby: `Dir.glob("{a/{b,lb},d}/*", base: "t")` gives `["a/b/x",
  # "a/lb/y", "d/z"]` (#442).
  def test_nested_braces
    with_tree("braces") do |root|
      Dir.mkdir_p("#{root}/t/a/b")
      Dir.mkdir_p("#{root}/t/a/lb")
      Dir.mkdir_p("#{root}/t/d")
      ["t/a/b/x", "t/a/lb/y", "t/d/z"].each { |f| File.write("#{root}/#{f}", "") }
      assert_equal(["a/b/x", "a/lb/y", "d/z"], Dir.glob("{a/{b,lb},d}/*", "#{root}/t"))
      assert_equal(["a/b/x", "a/lb/y"], Dir.glob("a/{{b},l{b}}/*", "#{root}/t"))
      assert_equal(["t/a", "t/d"], Dir.glob("t/{a,d}", root))
      # (Expanded from a work list: thousands of braces are no deeper.)
      assert_equal(["a"], Dir.glob("{" * 5000 + "a" + "}" * 5000, "#{root}/t"))
    end
  end

  # Escapes and an unclosed `{` (#484), each result Ruby's
  # (`Dir.glob(p, base: "t")` with these names in `t`).
  def test_escapes_and_unclosed_brace
    with_tree("escapes") do |root|
      t = "#{root}/t"
      Dir.mkdir_p("#{t}/a")
      names = ["ac", "{a", "a*", "a]", "a-", "!x", "a\\b", "{,a}", "a,b", "[x]", ".x"]
      (names + ["a!", "a#", "a0", "a_", "a."]).each do |f|
        File.write("#{t}/#{f}", "")
      end
      assert_equal(["{,a}"], Dir.glob("\\{,a}", t))
      assert_empty(Dir.glob("{\\,a}", t))
      assert_equal(["ac"], Dir.glob("a\\c", t))
      assert_equal(["a*"], Dir.glob("a\\*", t))
      assert_equal(["a*"], Dir.glob("a[*]", t))
      assert_equal(["a\\b"], Dir.glob("a\\\\b", t))
      assert_equal(["[x]"], Dir.glob("\\[x\\]", t))
      assert_equal(["{a"], Dir.glob("\\{a", t))
      assert_equal(["a"], Dir.glob("\\a", t))
      assert_equal([".x"], Dir.glob("\\.x", t))
      assert_equal(["a,b"], Dir.glob("{a\\,b,q}", t))
      # (A `\` ending the pattern is dropped.)
      assert_equal(["a"], Dir.glob("a\\", t))
      assert_equal(["a"], Dir.glob("{a,b}\\", t))
      # In a class.
      assert_equal(["a]"], Dir.glob("a[\\]]", t))
      assert_equal(["a-"], Dir.glob("a[\\-]", t))
      assert_equal(["!x"], Dir.glob("[\\!]x", t))
      assert_equal(["!x"], Dir.glob("[\\!\\-]x", t))
      assert_equal(["a-", "a]", "ac"], Dir.glob("a[\\]c\\-]", t))
      # Ranges whose ends are `!`, `-`, `]`; a class never matches a
      # leading dot; `[]` matches nothing, `[!]` any character.
      assert_equal(["a!", "a#"], Dir.glob("a[\\!-#]", t))
      assert_equal(["a-", "a.", "a0", "a_"], Dir.glob("a[_\\--0]", t))
      assert_equal(["a]", "a_", "ac"], Dir.glob("a[c\\]-z]", t))
      assert_equal(["a!", "a#"], Dir.glob("a[#-!]", t))
      assert_empty(Dir.glob("[.]x", t))
      assert_empty(Dir.glob("[\\.]x", t))
      assert_empty(Dir.glob("a[]", t))
      assert_empty(Dir.glob("a[]]", t))
      assert_equal(["a!", "a#", "a*", "a-", "a.", "a0", "a]", "a_", "ac"], Dir.glob("a[!]", t))
      # An unclosed `{` matches nothing, even a file of that name.
      assert_empty(Dir.glob("{a", t))
      assert_empty(Dir.glob("{a,b", t))
      assert_empty(Dir.glob("{a,{b}", t))
      assert_empty(Dir.glob("{a}{", t))
      # Quarz's documented difference: an empty alternative matches
      # nothing (Ruby's gives `["", "a"]`).
      assert_equal(["a"], Dir.glob("{,a}", t))
      assert_empty(Dir.glob("{}", t))
    end
  end

  # The base is a path, walked from, never a pattern (#431). Ruby's
  # `Dir.glob("*.qz", base:)` gives `["a.qz"]` for `./src`,
  # `src//sub/..//` and a directory named `s[1]`, and `""` is the
  # current directory.
  def test_the_base_is_walked_from_as_written
    with_tree("base") do |root|
      # (Not `Dir.chdir`: the tests run in parallel.)
      assert_equal(["a.qz"], Dir.glob("*.qz", "#{root}/./src"))
      assert_equal(["a.qz"], Dir.glob("*.qz", "#{root}/src//sub/..//"))
      assert_equal(Dir.glob("*"), Dir.glob("*", ""))
      Dir.mkdir_p("#{root}/s[1]")
      File.write("#{root}/s[1]/a.qz", "")
      assert_equal(["a.qz"], Dir.glob("*.qz", "#{root}/s[1]"))
      assert_equal(["a.qz"], Dir.glob("*.qz", "#{root}//src"))
    end
  end

  # A base under a directory that can be entered but not listed.
  def test_a_base_whose_parent_cannot_be_listed
    with_tree("noread") do |root|
      Dir.mkdir_p("#{root}/noread/q[1]")
      File.write("#{root}/noread/q[1]/k.txt", "")
      Process.run("chmod", "311", "#{root}/noread")
      begin
        assert_equal(["k.txt"], Dir.glob("*.txt", "#{root}/noread/q[1]"))
      ensure
        Process.run("chmod", "755", "#{root}/noread")
      end
    end
  end

  def test_a_link_named_in_the_pattern_is_followed
    with_tree("named") do |root|
      link(root, "sub", "src/linked")
      assert_equal(["src/linked/b.qz"], Dir.glob("src/linked/*.qz", root))
      assert_equal(["src/linked/b.qz"], Dir.glob("src/l*/*.qz", root))
      assert_equal(["src/a.qz", "src/sub/b.qz"], Dir.glob("src/**/*.qz", root))
    end
  end
end
