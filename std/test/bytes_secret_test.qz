# Bytes::Secret (#963): how it is made, compared, shown and wiped; a
# wipe seen through every reference and by Task.blocking's helper
# thread, which shares the buffer; what raises once wiped.
require "base64"
require "crypto"
require "digest"
require "json"
require "test"

class CryptoSecretTest < Test::Case
  def test_made_from_random_bytes_base64_bytes_and_a_builder
    r = Crypto.random_secret(32)
    assert_equal(32, r.size)
    assert(r.expose_bytes != Crypto.random_secret(32).expose_bytes)
    assert_equal(0, Crypto.random_secret(0).size)
    assert_raise(ArgumentError) { Crypto.random_secret(-1) }
    assert_raise(ArgumentError) { Crypto.random_secret(1024 * 1024 + 1) }

    assert_equal(b"key", Base64.decode_secret("a2V5").expose_bytes)
    assert_equal(b"ke", Base64.decode_secret("a2U=").expose_bytes)
    assert_equal(b"ke", Base64.decode_secret("a2U").expose_bytes)
    assert_equal(b"\xfb\xff", Base64.decode_secret("-_8", urlsafe: true).expose_bytes)
    assert_raise(ArgumentError) { Base64.decode_secret("-_8") }
    assert_raise(ArgumentError) { Base64.decode_secret("a2U==") }

    plain = b"abc"
    assert_equal(b"abc", Bytes::Secret.of(plain).expose_bytes)
    assert_equal(b"abc", plain)

    b = Bytes::Builder.new
    b << 1 << 2 << 3
    s = Bytes::Secret.of(b)
    assert_equal(b"\x01\x02\x03", s.expose_bytes)
    assert_equal(0, b.size)
  end

  def test_equality_by_contents
    a = Bytes::Secret.of(b"same")
    assert(a == Bytes::Secret.of(b"same"))
    assert(!(a == Bytes::Secret.of(b"other")))
    assert(!(a == Bytes::Secret.of(b"sam")))
    assert(!(a == b"same"))
    assert(Bytes::Secret.of(b"") == Bytes::Secret.of(b""))
    # Itself: one buffer, locked once.
    assert(a == a)
  end

  def test_in_collections_and_dup
    s = Bytes::Secret.of(b"same")
    t = Bytes::Secret.of(b"same")
    assert_equal(1, [s, s].uniq.size)
    assert_equal(1, [s, t].uniq.size)
    h = {s => 1}
    h = h.put(s, 2)
    h = h.put(t, 3)
    assert_equal(1, h.size)
    assert_equal(3, h[s])
    d = s.dup
    assert(d.equal?(s))
    s.wipe
    # Collections cannot raise: a wiped secret is still itself there.
    assert_equal(1, [s, s].uniq.size)
    assert_equal(3, h[s])
    assert(d.wiped?)
    assert_raise(Bytes::Secret::WipedError) { s == s }
  end

  def test_shows_nothing_of_it
    s = Bytes::Secret.of(b"hunter2")
    assert_equal("#<Bytes::Secret>", s.inspect)
    assert_equal("#<Bytes::Secret>", s.to_s)
    assert_equal("#<Bytes::Secret>", "#{s}")
    assert_equal("[#<Bytes::Secret>]", [s].inspect)
    assert_raise(JSON::GeneratorError) { JSON.generate([s]) }
  end

  def test_wipe_clears_the_buffer_for_every_reference
    s = Bytes::Secret.of(b"hunter2")
    other = s
    holder = [s]
    assert(!s.__cleared?)
    s.wipe
    assert(other.wiped?)
    assert(holder[0].wiped?)
    assert(other.__cleared?)
    assert_equal(7, other.size)
    s.wipe
    assert(s.wiped?)
    e = assert_raise(Bytes::Secret::WipedError) { other.expose_bytes }
    assert_equal("the secret was wiped", e.message)
    assert_raise(Bytes::Secret::WipedError) { other == Bytes::Secret.of(b"hunter2") }
    assert_raise(Bytes::Secret::WipedError) { Bytes::Secret.of(b"hunter2") == other }
  end

  def test_task_blocking_shares_the_buffer
    s = Bytes::Secret.of(b"hunter2")
    assert_equal(b"hunter2", Task.blocking { s.expose_bytes })
    Task.blocking { s.wipe }
    assert(s.wiped?)
    assert(s.__cleared?)
  end

  def test_shareable
    assert(Crypto.random_secret(4).shareable?)
    s = Crypto.random_secret(4)
    t = Task.spawn { s.size }
    assert_equal(4, t.await)
  end

  def test_aes_gcm_opens_into_a_secret
    gcm = Crypto::AES::GCM.new(Bytes.from((0...32).to_a))
    nonce = Bytes.from((0...12).to_a)
    sealed = gcm.seal(nonce, "a data key", aad: "ctx")
    s = gcm.open_secret(nonce, sealed, aad: "ctx")
    assert_equal(b"a data key", s.expose_bytes)
    assert_nil(gcm.open_secret?(nonce, sealed, aad: "other"))
    e = assert_raise(Crypto::AuthenticationError) { gcm.open_secret(nonce, sealed) }
    assert_equal("the data did not authenticate", e.message)

    token = gcm.encrypt("another key")
    assert_equal(b"another key", gcm.decrypt_secret(token).expose_bytes)
    assert_raise(Crypto::AuthenticationError) { gcm.decrypt_secret(token, aad: "x") }
    assert_raise(Crypto::AuthenticationError) { gcm.decrypt_secret(b"short") }
    assert_equal(0, gcm.open_secret(nonce, gcm.seal(nonce, "")).size)
  end

  def test_argon2_takes_a_secret_password
    cheap = Crypto::Argon2::Params.new(memory_kib: 64, iterations: 1, parallelism: 1)
    salt = Bytes.from((0...16).to_a)
    pw = Bytes::Secret.of(b"correct horse")
    h = Crypto::Argon2.hash(pw, params: cheap, salt: salt)
    assert_equal(Crypto::Argon2.hash("correct horse", params: cheap, salt: salt), h)
    assert(Crypto::Argon2.verify?(pw, h))
    assert(!Crypto::Argon2.verify?(Bytes::Secret.of(b"wrong"), h))
    pw.wipe
    assert_raise(Bytes::Secret::WipedError) { Crypto::Argon2.verify?(pw, h) }
    assert_raise(Bytes::Secret::WipedError) { Crypto::Argon2.hash(pw, params: cheap, salt: salt) }
  end

  def test_hmac_takes_and_gives_a_secret_key
    key = Bytes::Secret.of(b"key")
    msg = "The quick brown fox jumps over the lazy dog"
    assert_equal(Digest::HMAC.sha256("key", msg), Digest::HMAC.sha256(key, msg))
    # A chain of derived keys (as SigV4's), each a secret.
    k1 = Digest::HMAC.sha256_secret(Bytes::Secret.of(b"AWS4secret"), "20150830")
    k2 = Digest::HMAC.sha256_secret(k1, "us-east-1")
    plain = Digest::HMAC.sha256(Digest::HMAC.sha256("AWS4secret", "20150830"), "us-east-1")
    assert_equal(32, k2.size)
    assert_equal(plain, k2.expose_bytes)
    assert_equal(Digest::HMAC.sha256(plain, "x"), Digest::HMAC.sha256(k2, "x"))
    k1.wipe
    assert_raise(Bytes::Secret::WipedError) { Digest::HMAC.sha256(k1, "x") }
    assert_raise(Bytes::Secret::WipedError) { Digest::HMAC.sha256_secret(k1, "x") }
    assert(!k2.wiped?)
  end

  def test_pbkdf2_takes_and_gives_a_secret
    pw = Bytes::Secret.of(b"password")
    assert_equal(Digest::PBKDF2.sha256("password", "salt", 1, 32), Digest::PBKDF2.sha256(pw, "salt", 1, 32))
    k = Digest::PBKDF2.sha256_secret(pw, "salt", 1, 32)
    assert_equal(32, k.size)
    assert_equal(Digest::PBKDF2.sha256("password", "salt", 1, 32), k.expose_bytes)
    assert_equal(0, Digest::PBKDF2.sha256_secret("password", "salt", 1, 0).size)
    assert_raise(ArgumentError) { Digest::PBKDF2.sha256_secret(pw, "salt", 0, 32) }
    pw.wipe
    assert_raise(Bytes::Secret::WipedError) { Digest::PBKDF2.sha256(pw, "salt", 1, 32) }
    assert_raise(Bytes::Secret::WipedError) { Digest::PBKDF2.sha256_secret(pw, "salt", 1, 32) }
  end

  # quarz#1015: joined to other bytes, into one buffer of its size.
  def test_join
    key = Bytes::Secret.of(b"wJalr")
    joined = Bytes::Secret.join(["AWS4", key, b"\x00\xff"])
    assert_equal(b"AWS4wJalr\x00\xff", joined.expose_bytes)
    assert_equal(11, joined.size)
    assert_equal(0, Bytes::Secret.join([]).size)
    assert_equal("ü".to_bytes, Bytes::Secret.join(["ü"]).expose_bytes)
    # Its own buffer: wiping it leaves the parts, wiping a part leaves it.
    joined.wipe
    assert(joined.__cleared?)
    assert(!key.wiped?)
    again = Bytes::Secret.join([key, key])
    key.wipe
    assert_equal(b"wJalrwJalr", again.expose_bytes)
    assert_raise(Bytes::Secret::WipedError) { Bytes::Secret.join(["AWS4", key]) }
  end

  def test_digests_take_a_secret
    s = Bytes::Secret.of(b"abc")
    assert_equal(Digest::SHA256.digest("abc"), Digest::SHA256.digest(s))
    assert_equal(Digest::SHA256.hexdigest("abc"), Digest::SHA256.hexdigest(s))
    assert_equal(Digest::MD5.digest("abc"), Digest::MD5.digest(s))
    assert_equal("900150983cd24fb0d6963f7d28e17f72", Digest::MD5.hexdigest(s))
    h = Digest::MD5.hexdigest_secret(s)
    assert_equal("#<Bytes::Secret>", h.inspect)
    assert_equal(b"900150983cd24fb0d6963f7d28e17f72", h.expose_bytes)
    assert_equal(b"900150983cd24fb0d6963f7d28e17f72", Digest::MD5.hexdigest_secret("abc").expose_bytes)
    # HMAC's data as a secret too, plain or secret result.
    assert_equal(Digest::HMAC.sha256("k", "abc"), Digest::HMAC.sha256("k", s))
    assert_equal(Digest::HMAC.sha256("k", "abc"), Digest::HMAC.sha256_secret(Bytes::Secret.of(b"k"), s).expose_bytes)
    # PostgreSQL's md5 response, nothing of the password plain.
    pw = Bytes::Secret.of(b"pw")
    inner = Digest::MD5.hexdigest_secret(Bytes::Secret.join([pw, "user"]))
    response = "md5" + Digest::MD5.hexdigest(Bytes::Secret.join([inner, b"salt"]))
    assert_equal("md5" + Digest::MD5.hexdigest(Digest::MD5.hexdigest("pwuser") + "salt"), response)
    s.wipe
    [-> { Digest::SHA256.digest(s) }, -> { Digest::SHA256.hexdigest(s) }, -> { Digest::MD5.digest(s) },
     -> { Digest::MD5.hexdigest(s) }, -> { Digest::MD5.hexdigest_secret(s) }, -> { Digest::HMAC.sha256("k", s) },
     -> { Digest::HMAC.sha256_secret("k", s) }].each do |f|
      assert_raise(Bytes::Secret::WipedError) { f.call }
    end
  end

  def test_base64_encodes_a_secret
    s = Bytes::Secret.of(b"\xfb\xffkey")
    assert_equal(Base64.encode(b"\xfb\xffkey"), Base64.encode(s))
    assert_equal(Base64.urlsafe_encode(b"\xfb\xffkey", padding: false), Base64.urlsafe_encode(s, padding: false))
    assert_equal(s, Base64.decode_secret(Base64.encode(s)))
    s.wipe
    assert_raise(Bytes::Secret::WipedError) { Base64.encode(s) }
    assert_raise(Bytes::Secret::WipedError) { Base64.urlsafe_encode(s) }
  end

  def test_secure_compare_takes_secrets
    a = Bytes::Secret.of(b"token")
    b = Bytes::Secret.of(b"token")
    assert(Crypto.secure_compare(a, b))
    assert(Crypto.secure_compare(a, "token"))
    assert(Crypto.secure_compare(b"token", a))
    assert(!Crypto.secure_compare(a, "tokeN"))
    assert(!Crypto.secure_compare(a, Bytes::Secret.of(b"tok")))
    assert(Crypto.secure_compare(a, a))
    a.wipe
    assert_raise(Bytes::Secret::WipedError) { Crypto.secure_compare(a, b) }
    assert_raise(Bytes::Secret::WipedError) { Crypto.secure_compare("token", a) }
    assert(!b.wiped?)
  end

  def test_read_secret
    dir = "#{Dir.tmpdir}/quarz-secret-#{Process.pid}-#{Random.rand(1_000_000_000)}"
    Process.run("mkdir", "-p", dir)
    begin
      path = "#{dir}/password"
      File.write(path, "hunter2\n")
      s = File.read_secret(path)
      # Exactly the file's bytes, the newline kept.
      assert_equal(b"hunter2\n", s.expose_bytes)
      s.wipe
      assert(s.__cleared?)
      # chomp: one trailing line ending left out, the default unchanged.
      [["pw\n", "pw"], ["pw\r\n", "pw"], ["pw", "pw"], ["\n", ""], ["pw\n\n", "pw\n"]].each do |pair|
        File.write("#{dir}/c", pair[0])
        c = File.read_secret("#{dir}/c", chomp: true)
        assert_equal(pair[1].to_bytes, c.expose_bytes, pair[0].inspect)
        assert_equal(pair[0].to_bytes, File.read_secret("#{dir}/c").expose_bytes, pair[0].inspect)
        assert_equal(pair[0].to_bytes, File.read_secret("#{dir}/c", chomp: false).expose_bytes, pair[0].inspect)
      end
      File.write("#{dir}/empty", "")
      assert_equal(0, File.read_secret("#{dir}/empty").size)
      File.write("#{dir}/bytes", b"\x00\xff\xfe")
      assert_equal(b"\x00\xff\xfe", File.read_secret("#{dir}/bytes").expose_bytes)
      # 1 MiB is read; one byte more is refused.
      File.write("#{dir}/max", "a" * (1 << 20))
      assert_equal(1 << 20, File.read_secret("#{dir}/max").size)
      File.write("#{dir}/big", "a" * ((1 << 20) + 1))
      e = assert_raise(IOError) { File.read_secret("#{dir}/big") }
      assert_match(/larger than 1 MiB/, e.message)
      assert_raise(SystemCallError) { File.read_secret("#{dir}/missing") }
      assert_raise(SystemCallError) { File.read_secret(dir) }
      # Not a regular file: a FIFO's size is 0, read to its end.
      fifo = "#{dir}/fifo"
      if Process.run("mkfifo", fifo).success?
        writer = Process.spawn("sh", "-c", "printf %s 0123456789abcdef > #{fifo}")
        assert_equal(b"0123456789abcdef", File.read_secret(fifo).expose_bytes)
        writer.wait
      end
    ensure
      Process.run("rm", "-rf", dir)
    end
  end
end
