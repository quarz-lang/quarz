require "test"

class BytesBasicsTest < Test::Case
  @b: Bytes = b"\x00\xffab\n"

  def test_inspect_size_index
    assert_equal("b\"\\x00\\xffab\\n\"", @b.inspect)
    assert_equal(5, @b.size)
    assert_equal(255, @b[1])
  end

  def test_slice_to_a_hex
    assert_equal("b\"\\x00\\xff\"", @b[0..1].inspect)
    assert_equal("[0, 255, 97, 98, 10]", @b.to_a.inspect)
    assert_equal("\"00ff61620a\"", @b.hex.inspect)
  end

  def test_from_hex
    assert_equal("\"Hello\"", Bytes.from_hex("48 65 6c 6c 6f").decode.inspect)
  end

  def test_single_quoted_literal_is_raw
    assert_equal("b\"\\\\x41\\\\n\"", b'\x41\n'.inspect)
  end
end

class BytesEncodingTest < Test::Case
  def test_utf8
    assert_equal("b\"h\\xc3\\xa9llo\"", "héllo".to_bytes.inspect)
    assert_equal("\"héllo\"", "héllo".to_bytes.decode.inspect)
    assert_nil(b"\xff".decode?)
  end

  def test_invalid_utf8_raises
    e = assert_raise(ArgumentError) { _ = b"\xff".decode; nil }
    assert_equal("invalid UTF-8 byte sequence at offset 0", e.message)
  end

  def test_latin1
    assert_equal("b\"\\xe9\"", "é".encode("ISO-8859-1").inspect)
    assert_equal("\"é\"", b"\xe9".decode("latin1").inspect)
  end
end

class BytesOperationsTest < Test::Case
  def test_build
    assert_equal("b\"\\x01\\x02c\"", Bytes.build { |w| w << 1 << b"\x02" << "c" }.inspect)
  end

  def test_concat_equality_comparison
    assert_equal("b\"\\x01\\x02\\x03\\x04\"", (Bytes[1, 2, 3] + Bytes[4]).inspect)
    assert_true(Bytes[1, 2, 3] == Bytes[1, 2, 3])
    assert_true(Bytes[1, 2] < Bytes[1, 3])
  end

  def test_map_include
    assert_equal("[6, 2, 4]", Bytes[3, 1, 2].map { |x| x * 2 }.inspect)
    assert_true(Bytes[1, 2, 3].include?(2))
  end

  def test_hash_key
    assert_equal("\"one\"", { b"\x01" => "one" }[b"\x01"].inspect)
  end

  def test_reverse_slice_empty
    assert_equal("b\"\\x02\\x01\"", b"\x01\x02".reverse.inspect)
    assert_equal("b\"bc\"", b"abc".slice(1, 5).inspect)
    assert_true(Bytes.new.empty?)
  end
end

# A builder can be changed, as the other builders, and `dup` copies it.
class BytesBuilderStateTest < Test::Case
  def test_frozen_and_dup
    b = Bytes::Builder.new
    b << 1
    assert_false(b.frozen?)
    c = b.dup
    c << 2
    assert_equal(1, b.size)
    assert_equal(2, c.size)
    assert_true(b"x".frozen?)
  end
end
