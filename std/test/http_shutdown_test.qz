# HTTP::Server#shutdown: idle connections closed, a request in a handler
# finished, a stuck one cancelled after the timeout; max_connections;
# with `tls:`, a connection in its handshake closed at once; a UNIX
# socket server.
require "http"
require "test"

class HttpShutdownTest < Test::Case
  # Each handler sends here when a request enters it.
  @entered: Channel[String] = Channel[String].new(capacity: 8)

  # Everything the server sends until it closes, without the Date line
  # and with CR LF shown as `|`. A class method, so that a spawned
  # client can call it.
  def self.raw(port: Int, text: String) -> String
    Socket.tcp("127.0.0.1", port) do |s|
      s.write(text)
      s.read.gsub(/Date: [^\r]*\r\n/, "").gsub("\r\n", "|")
    end
  end

  def raw(port: Int, text: String) -> String = HttpShutdownTest.raw(port, text)

  def test_idle_closed_busy_finished_then_refused
    entered = @entered
    gate = Channel[Nil].new
    handler = HTTP.handler do |req|
      if req.path == "/wait"
        entered.send("wait")
        gate.receive
        HTTP::Server::Response.text("waited")
      else
        HTTP::Server::Response.text("ok")
      end
    end
    server = HTTP::Server.new(handler, host: "127.0.0.1", port: 0)
    port = server.local_address.port
    Task.scope do |scope|
      scope.spawn { server.serve }
      begin
        served = Channel[String].new(capacity: 1)
        idle = scope.spawn do
          Socket.tcp("127.0.0.1", port) do |s|
            s.write("GET / HTTP/1.1\r\n\r\n")
            served.send(s.readpartial(4096).lines[0].chomp)
            s.readpartial?(4096) || "closed"
          end
        end
        assert_equal("HTTP/1.1 200 OK", served.receive)
        waiting = scope.spawn { HttpShutdownTest.raw(port, "GET /wait HTTP/1.1\r\n\r\n") }
        assert_equal("wait", @entered.receive)
        stopper = scope.spawn { server.shutdown(timeout: 5.seconds); "stopped" }
        # The idle connection is closed at once, the busy one answers.
        assert_equal("closed", idle.await)
        gate.send(nil)
        assert_equal("HTTP/1.1 200 OK|Content-Type: text/plain; charset=utf-8|Content-Length: 6|Connection: close||waited", waiting.await)
        assert_equal("stopped", stopper.await)
        refused = begin
                    raw(port, "GET / HTTP/1.1\r\n\r\n")
                  rescue SystemCallError
                    "refused"
                  end
        assert_equal("refused", refused)
      ensure
        server.shutdown
      end
    end
  end

  def test_stuck_handler_cancelled_after_timeout
    entered = @entered
    stuck = HTTP.handler do |req|
      entered.send("stuck")
      Task.sleep(30.seconds)
      HTTP::Server::Response.text("never")
    end
    s2 = HTTP::Server.new(stuck, host: "127.0.0.1", port: 0)
    port2 = s2.local_address.port
    Task.scope do |scope|
      scope.spawn { s2.serve }
      begin
        c = scope.spawn { HttpShutdownTest.raw(port2, "GET / HTTP/1.1\r\n\r\n") }
        assert_equal("stuck", @entered.receive)
        started = Time.monotonic
        s2.shutdown(timeout: 100.ms)
        assert_equal("", c.await)
        s2.wait
        # The stuck handler (30 s) was cancelled after the 100 ms grace.
        assert_true((Time.monotonic - started) < 10.seconds)
      ensure
        s2.shutdown
      end
    end
  end

  def test_serve_task_cancelled_after_shutdown
    # The task running `serve` cancelled while it waits for the accept
    # loop to end: `serve` ends with `Task::Cancelled` (#691's fix lets
    # only the loop's own cancellation through) and closes the listener.
    # With one worker the cancel comes there: `max_connections: 1` keeps
    # the loop waiting for a token, and the handler shuts down and yields,
    # so `serve` reaches its wait for the loop before the handler cancels
    # it. (The connection is still open then, so the wait for the grace
    # would raise the cancellation too: this test does not tell the fix
    # from a `rescue` that drops it, which shows only with no connection.)
    servers = Channel[HTTP::Server].new(capacity: 1)
    tasks = Channel[Task[Nil]].new(capacity: 1)
    handler = HTTP.handler do |req|
      srv = servers.receive
      serving = tasks.receive
      srv.shutdown(timeout: 30.seconds)
      Task.yield
      serving.cancel
      HTTP::Server::Response.text("ok")
    end
    s9 = HTTP::Server.new(handler, host: "127.0.0.1", port: 0, max_connections: 1)
    port9 = s9.local_address.port
    t = Task.spawn { s9.serve; nil }
    servers.send(s9)
    tasks.send(t)
    # (The response, or nothing when the cancellation reached the
    # connection first: `serve`'s scope cancels its tasks as it ends.)
    out = raw(port9, "GET / HTTP/1.1\r\nConnection: close\r\n\r\n")
    assert_true(out.empty? || out.start_with?("HTTP/1.1 200 OK"))
    ended = begin
              t.await
              "returned"
            rescue Task::Cancelled
              "cancelled"
            end
    assert_equal("cancelled", ended)
    s9.wait
    refused = begin
                raw(port9, "GET / HTTP/1.1\r\n\r\n")
              rescue SystemCallError
                "refused"
              end
    assert_equal("refused", refused)
  end

  def test_grace_period_lets_slow_handler_answer
    entered = @entered
    slow = HTTP.handler do |req|
      entered.send("slow")
      Task.sleep(200.ms)
      HTTP::Server::Response.text("slow done")
    end
    s5 = HTTP::Server.new(slow, host: "127.0.0.1", port: 0)
    port5 = s5.local_address.port
    Task.scope do |scope|
      scope.spawn { s5.serve }
      begin
        c = scope.spawn { HttpShutdownTest.raw(port5, "GET / HTTP/1.1\r\n\r\n") }
        assert_equal("slow", @entered.receive)
        s5.shutdown(timeout: 5.seconds)
        s5.wait
        assert_equal("HTTP/1.1 200 OK|Content-Type: text/plain; charset=utf-8|Content-Length: 9|Connection: close||slow done", c.await)
      ensure
        s5.shutdown
      end
    end
  end

  def tls_dir -> String = "crates/quarz-cli/tests/fixtures/tls"

  def server_tls -> TLS::ServerConfig
    dir = tls_dir
    TLS::ServerConfig.new(certificate: File.read("#{dir}/server.pem"),
                          private_key: File.read("#{dir}/server.key"))
  end

  def client_tls -> TLS::Config = TLS::Config.new(roots: TLS::Roots.from_pem(File.read("#{tls_dir}/ca.pem")))

  # A GET over TLS (with `Connection: close` when `close`); the status
  # line, also sent to `got`, then what the server sends after the
  # response until it closes ("closed" for nothing).
  def self.https_get(port: Int, config: TLS::Config, close: Bool, got: Channel[String]? = nil) -> [String, String]
    https_get(Socket.tcp("127.0.0.1", port), config, close, got)
  end

  # The same over a connected socket.
  def self.https_get(sock: TCPSocket, config: TLS::Config, close: Bool, got: Channel[String]? = nil) -> [String, String]
    tls = TLSSocket.connect(sock, "localhost", config)
    begin
      tls.write(close ? "GET / HTTP/1.1\r\nConnection: close\r\n\r\n" : "GET / HTTP/1.1\r\n\r\n")
      status = tls.readpartial(4096).lines[0].chomp
      got.send(status) if got
      [status, tls.readpartial?(4096) || "closed"]
    ensure
      tls.close
    end
  end

  # The server's errors, for the tests that expect none.
  def reporting(errors: Channel[String]) -> shareable (Exception, HTTP::Server::Request?) -> Void
    ->(e: Exception, _: HTTP::Server::Request?) { errors.send("#{e.class.name}: #{e.message}"); nil }
  end

  def test_tls_handshake_closed_at_shutdown
    # A client that connects and sends nothing holds the server in its
    # TLS handshake. Both timeouts are long: before #348, the shutdown
    # waited out the 30 s grace (or `read_header_timeout`).
    errors = Channel[String].new(capacity: 8)
    s6 = HTTP::Server.new(HTTP.handler { |req| HTTP::Server::Response.text("ok") }, host: "127.0.0.1", port: 0,
                          tls: server_tls, read_header_timeout: 30.seconds, on_error: reporting(errors))
    port6 = s6.local_address.port
    Task.scope do |scope|
      scope.spawn { s6.serve }
      begin
        # Its handshakes work.
        assert_equal(["HTTP/1.1 200 OK", "closed"], HttpShutdownTest.https_get(port6, client_tls, true))
        silent = Socket.tcp("127.0.0.1", port6)
        begin
          # (Time for the server to accept it and start the handshake; were
          # it not, the shutdown would refuse it, and pass too.)
          Task.sleep(100.ms)
          started = Time.monotonic
          s6.shutdown(timeout: 30.seconds)
          s6.wait
          assert_true((Time.monotonic - started) < 10.seconds)
          # The connection is closed (after a TLS alert, the handshake's
          # close_notify).
          closed = begin
                     Task.timeout(5.seconds) { silent.read; true }
                   rescue SystemCallError
                     true
                   end
          assert_true(closed)
        ensure
          silent.close
        end
        assert_nil(errors.try_receive)
      ensure
        s6.shutdown
      end
    end
  end

  def test_tls_idle_connection_closed_at_shutdown
    # A handshake that completed: the connection waits for its next
    # request, and the shutdown closes it at once.
    errors = Channel[String].new(capacity: 8)
    s7 = HTTP::Server.new(HTTP.handler { |req| HTTP::Server::Response.text("ok") }, host: "127.0.0.1", port: 0,
                          tls: server_tls, read_header_timeout: 30.seconds, on_error: reporting(errors))
    port7 = s7.local_address.port
    config = client_tls
    Task.scope do |scope|
      scope.spawn { s7.serve }
      begin
        got = Channel[String].new(capacity: 1)
        c = scope.spawn { HttpShutdownTest.https_get(port7, config, false, got) }
        # The response came: the connection is kept alive and waits.
        assert_equal("HTTP/1.1 200 OK", got.receive)
        started = Time.monotonic
        s7.shutdown(timeout: 30.seconds)
        s7.wait
        assert_true((Time.monotonic - started) < 10.seconds)
        assert_equal(["HTTP/1.1 200 OK", "closed"], c.await)
        assert_nil(errors.try_receive)
      ensure
        s7.shutdown
      end
    end
  end

  def test_tls_shutdown_racing_handshakes
    # Handshakes at every stage when the shutdown comes: each client gets
    # a response or a failure, the server returns, and reports nothing.
    errors = Channel[String].new(capacity: 8)
    s8 = HTTP::Server.new(HTTP.handler { |req| HTTP::Server::Response.text("ok") }, host: "127.0.0.1", port: 0,
                          tls: server_tls, read_header_timeout: 30.seconds, on_error: reporting(errors))
    port8 = s8.local_address.port
    config = client_tls
    Task.scope do |scope|
      scope.spawn { s8.serve }
      begin
        socks = 8.times.map { |_| Socket.tcp("127.0.0.1", port8) }
        clients = socks.map do |sock|
          scope.spawn do
            begin
              HttpShutdownTest.https_get(sock, config, true)[0]
            rescue IOError, SystemCallError, TLS::Error
              "failed"
            end
          end
        end
        Task.sleep(5.ms)
        started = Time.monotonic
        s8.shutdown(timeout: 30.seconds)
        s8.wait
        assert_true((Time.monotonic - started) < 10.seconds)
        clients.each { |t| assert_includes(["HTTP/1.1 200 OK", "failed"], t.await) }
        assert_nil(errors.try_receive)
      ensure
        s8.shutdown
      end
    end
  end

  def test_max_connections_one_at_a_time
    # max_connections: 1, so /b is accepted only when /a is done.
    entered = @entered
    order = Channel[String].new(capacity: 4)
    one = HTTP.handler do |req|
      order.send("in #{req.path}")
      entered.send(req.path)
      Task.sleep(50.ms)
      order.send("out #{req.path}")
      HTTP::Server::Response.text(req.path)
    end
    s3 = HTTP::Server.new(one, host: "127.0.0.1", port: 0, max_connections: 1)
    port3 = s3.local_address.port
    Task.scope do |scope|
      scope.spawn { s3.serve }
      begin
        a = scope.spawn { HttpShutdownTest.raw(port3, "GET /a HTTP/1.1\r\nConnection: close\r\n\r\n") }
        @entered.receive
        b = scope.spawn { HttpShutdownTest.raw(port3, "GET /b HTTP/1.1\r\nConnection: close\r\n\r\n") }
        a.await
        b.await
        assert_equal(["in /a", "out /a", "in /b", "out /b"], 4.times.map { |_| order.receive })
      ensure
        s3.shutdown
      end
    end
  end

  def test_unix_socket_peer_is_trusted_proxy
    path = "#{Dir.tmpdir}/quarz-http-test-#{Process.pid}.sock"
    s4 = HTTP::Server.unix(HTTP.handler { |req| HTTP::Server::Response.text("#{req.remote_ip} #{req.scheme}") }, path)
    Task.scope do |scope|
      scope.spawn { s4.serve }
      begin
        out = Socket.unix(path) do |s|
          s.write("GET / HTTP/1.1\r\nX-Forwarded-For: 203.0.113.9\r\nX-Forwarded-Proto: https\r\nConnection: close\r\n\r\n")
          s.read
        end
        assert_equal("HTTP/1.1 200 OK|Content-Type: text/plain; charset=utf-8|Content-Length: 17|Connection: close||203.0.113.9 https",
                     out.gsub(/Date: [^\r]*\r\n/, "").gsub("\r\n", "|"))
      ensure
        s4.shutdown
      end
    end
    # The socket file is removed when the server stops.
    assert_false(File.exist?(path))
  end
end
