# HTTP::Server#shutdown: idle connections closed, a request in a handler
# finished, a stuck one cancelled after the timeout; max_connections;
# a UNIX socket server.
require "http"
require "test"

class HttpShutdownTest < Test::Case
  # Each handler sends here when a request enters it.
  @entered: Channel[String] = Channel[String].new(capacity: 8)

  # Everything the server sends until it closes, without the Date line
  # and with CR LF shown as `|`. A class method, so that a spawned
  # client can call it.
  def self.raw(port: Int, text: String) -> String
    Socket.tcp("127.0.0.1", port) do |s|
      s.write(text)
      s.read.gsub(/Date: [^\r]*\r\n/, "").gsub("\r\n", "|")
    end
  end

  def raw(port: Int, text: String) -> String = HttpShutdownTest.raw(port, text)

  def test_idle_closed_busy_finished_then_refused
    entered = @entered
    gate = Channel[Nil].new
    handler = HTTP.handler do |req|
      if req.path == "/wait"
        entered.send("wait")
        gate.receive
        HTTP::Response.text("waited")
      else
        HTTP::Response.text("ok")
      end
    end
    server = HTTP::Server.new(handler, host: "127.0.0.1", port: 0)
    port = server.local_address.port
    Task.scope do |scope|
      scope.spawn { server.serve }
      begin
        served = Channel[String].new(capacity: 1)
        idle = scope.spawn do
          Socket.tcp("127.0.0.1", port) do |s|
            s.write("GET / HTTP/1.1\r\n\r\n")
            served.send(s.readpartial(4096).lines[0].chomp)
            s.readpartial?(4096) || "closed"
          end
        end
        assert_equal("HTTP/1.1 200 OK", served.receive)
        waiting = scope.spawn { HttpShutdownTest.raw(port, "GET /wait HTTP/1.1\r\n\r\n") }
        assert_equal("wait", @entered.receive)
        stopper = scope.spawn { server.shutdown(timeout: 5.seconds); "stopped" }
        # The idle connection is closed at once, the busy one answers.
        assert_equal("closed", idle.await)
        gate.send(nil)
        assert_equal("HTTP/1.1 200 OK|Content-Type: text/plain; charset=utf-8|Content-Length: 6|Connection: close||waited", waiting.await)
        assert_equal("stopped", stopper.await)
        refused = begin
                    raw(port, "GET / HTTP/1.1\r\n\r\n")
                  rescue SystemCallError
                    "refused"
                  end
        assert_equal("refused", refused)
      ensure
        server.shutdown
      end
    end
  end

  def test_stuck_handler_cancelled_after_timeout
    entered = @entered
    stuck = HTTP.handler do |req|
      entered.send("stuck")
      Task.sleep(30.seconds)
      HTTP::Response.text("never")
    end
    s2 = HTTP::Server.new(stuck, host: "127.0.0.1", port: 0)
    port2 = s2.local_address.port
    Task.scope do |scope|
      scope.spawn { s2.serve }
      begin
        c = scope.spawn { HttpShutdownTest.raw(port2, "GET / HTTP/1.1\r\n\r\n") }
        assert_equal("stuck", @entered.receive)
        started = Time.monotonic
        s2.shutdown(timeout: 100.ms)
        assert_equal("", c.await)
        s2.wait
        # The stuck handler (30 s) was cancelled after the 100 ms grace.
        assert_true((Time.monotonic - started) < 10.seconds)
      ensure
        s2.shutdown
      end
    end
  end

  def test_grace_period_lets_slow_handler_answer
    entered = @entered
    slow = HTTP.handler do |req|
      entered.send("slow")
      Task.sleep(200.ms)
      HTTP::Response.text("slow done")
    end
    s5 = HTTP::Server.new(slow, host: "127.0.0.1", port: 0)
    port5 = s5.local_address.port
    Task.scope do |scope|
      scope.spawn { s5.serve }
      begin
        c = scope.spawn { HttpShutdownTest.raw(port5, "GET / HTTP/1.1\r\n\r\n") }
        assert_equal("slow", @entered.receive)
        s5.shutdown(timeout: 5.seconds)
        s5.wait
        assert_equal("HTTP/1.1 200 OK|Content-Type: text/plain; charset=utf-8|Content-Length: 9|Connection: close||slow done", c.await)
      ensure
        s5.shutdown
      end
    end
  end

  def test_max_connections_one_at_a_time
    # max_connections: 1, so /b is accepted only when /a is done.
    entered = @entered
    order = Channel[String].new(capacity: 4)
    one = HTTP.handler do |req|
      order.send("in #{req.path}")
      entered.send(req.path)
      Task.sleep(50.ms)
      order.send("out #{req.path}")
      HTTP::Response.text(req.path)
    end
    s3 = HTTP::Server.new(one, host: "127.0.0.1", port: 0, max_connections: 1)
    port3 = s3.local_address.port
    Task.scope do |scope|
      scope.spawn { s3.serve }
      begin
        a = scope.spawn { HttpShutdownTest.raw(port3, "GET /a HTTP/1.1\r\nConnection: close\r\n\r\n") }
        @entered.receive
        b = scope.spawn { HttpShutdownTest.raw(port3, "GET /b HTTP/1.1\r\nConnection: close\r\n\r\n") }
        a.await
        b.await
        assert_equal(["in /a", "out /a", "in /b", "out /b"], 4.times.map { |_| order.receive })
      ensure
        s3.shutdown
      end
    end
  end

  def test_unix_socket_peer_is_trusted_proxy
    path = "#{Dir.tmpdir}/quarz-http-test-#{Process.pid}.sock"
    s4 = HTTP::Server.unix(HTTP.handler { |req| HTTP::Response.text("#{req.remote_ip} #{req.scheme}") }, path)
    Task.scope do |scope|
      scope.spawn { s4.serve }
      begin
        out = Socket.unix(path) do |s|
          s.write("GET / HTTP/1.1\r\nX-Forwarded-For: 203.0.113.9\r\nX-Forwarded-Proto: https\r\nConnection: close\r\n\r\n")
          s.read
        end
        assert_equal("HTTP/1.1 200 OK|Content-Type: text/plain; charset=utf-8|Content-Length: 17|Connection: close||203.0.113.9 https",
                     out.gsub(/Date: [^\r]*\r\n/, "").gsub("\r\n", "|"))
      ensure
        s4.shutdown
      end
    end
    # The socket file is removed when the server stops.
    assert_false(File.exist?(path))
  end
end
