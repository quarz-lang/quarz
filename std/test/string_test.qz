# Strings and regular expressions.

class StringTest < Test::Case
  def test_repeat_concat_interpolate
    s = "ab"
    assert_equal("ababab", s * 3)
    assert_equal("abc", s + "c")
    assert_equal("xaby3", "x#{s}y#{1 + 2}")
    assert_equal(2, s.size)
    assert_equal("AB", s.upcase)
  end

  def test_format
    assert_equal("03.14|ab  |ff|+7|", format("%05.2f|%-4s|%x|%+d|%s", 3.14159, "ab", 255, 7, nil))
    assert_equal("3 items", "%d items" % [3])
  end

  def test_split
    assert_equal("[\"hello\", \"world\"]", "hello world".split.inspect)
    assert_equal("[\"a\", \"b\", \"\", \"c\"]", "a,b,,c".split(",").inspect)
  end

  def test_padding_and_swapcase
    assert_equal("**hello**", "hello".center(9, "*"))
    assert_equal("hi  |", "hi".ljust(4) + "|")
    assert_equal("  hi", "hi".rjust(4))
    assert_equal("hELLO wORLD", "Hello World".swapcase)
  end

  def test_indexing_counts_characters
    assert_equal("é", "héllo"[1])
    assert_equal("o", "héllo"[-1])
    assert_equal("éll", "héllo"[1..3])
    assert_equal("olléh", "héllo".reverse)
    assert_equal(6, "héllo".bytesize)
  end

  def test_tr_delete_squeeze_count
    assert_equal("a b c", "a-b_c".tr("-_", "  "))
    assert_equal("heo", "hello".delete("l"))
    assert_equal("ab", "aaabbb".squeeze)
    assert_equal(3, "banana".count("a"))
  end

  def test_succ
    assert_equal("abd", "abc".succ)
    assert_equal("ba", "az".succ)
    assert_equal("aaa", "zz".succ)
    assert_equal("b0", "a9".succ)
  end

  def test_start_with_index_chars
    assert_true("Hello".start_with?("He"))
    assert_equal(2, "Hello".index("l"))
    assert_nil("Hello".index("z"))
    assert_equal("[\"H\", \"e\", \"l\", \"l\", \"o\"]", "Hello".chars.inspect)
  end

  def test_inspect_strings_and_symbols
    assert_equal("\"a\\tb\"", "a\tb".inspect)
    assert_equal(":sym", :sym.inspect)
    assert_equal(":\"with space\"", :"with space".inspect)
    assert_equal("\"single\"", 'single'.inspect)
    assert_equal("\"quote\\\"d\"", "quote\"d".inspect)
  end

  def test_string_build
    s = String.build do |b|
      b << "x" << "y"
      3.times { |i| b << i.to_s }
    end
    assert_equal("xy012", s)
  end

  def test_lines_strip_chomp
    assert_equal("[\"line1\\n\", \"line2\"]", "line1\nline2".lines.inspect)
    assert_equal("pad|", "  pad  ".strip + "|")
    assert_equal("abc", "abc\n".chomp)
  end

  def test_case_conversion_and_comparison
    assert_equal("Camelcase", "CamelCase".downcase.capitalize)
    assert_equal(-1, "abc" <=> "abd")
    assert_true("b" > "a")
  end
end

class RegexpTest < Test::Case
  def test_match_operator
    assert_equal(3, "foo123bar" =~ /\d+/)
    assert_nil("abc" =~ /x/)
  end

  def test_match_data
    m = "John Smith".match(/(\w+) (\w+)/)
    refute_nil(m)
    if m
      assert_equal("John", m[1])
      assert_equal("Smith", m[2])
      assert_equal("\"\"", m.pre_match.inspect)
      assert_equal("[\"John\", \"Smith\"]", m.captures.inspect)
    end
  end

  def test_scan_returns_whole_matches
    assert_equal("[\"1\", \"22\", \"333\"]", "a1b22c333".scan(/\d+/).inspect)
    # The whole matches, as the type says; the groups are in the
    # MatchData a block receives.
    assert_equal("[\"a1\", \"b2\"]", "a1b2".scan(/([a-z])(\d)/).inspect)
  end

  def test_gsub_and_sub
    assert_equal("hell0 w0rld", "hello world".gsub(/o/, "0"))
    assert_equal("heLlo", "hello".sub(/l/, "L"))
    assert_equal("02/01/2024", "2024-01-02".gsub(/(\d+)-(\d+)-(\d+)/, "\\3/\\2/\\1"))
  end

  def test_split_and_match_predicate
    assert_equal("[\"a\", \"b\", \"c\"]", "a, b;c".split(/[,;]\s*/).inspect)
    assert_true("ABC".match?(/b/i))
    assert_false("x".match?(/y/))
  end

  def classify(s: String) -> String?
    case s
    when /^\d+$/ then "digits"
    when /\d/ then "has digit"
    end
  end

  def test_case_when_regexp
    assert_equal("has digit", classify("hello42"))
  end
end

class StringEdgeTest < Test::Case
  def test_to_i_with_a_bad_base
    assert_raise(ArgumentError) { _ = "ff".to_i(1); nil }
    assert_raise(ArgumentError) { _ = "ff".to_i(37); nil }
    assert_raise(ArgumentError) { _ = "ff".to_i(-1); nil }
    assert_equal(255, "ff".to_i(16))
  end

  # As Ruby's: `hex` is `to_i(16)`; `oct` takes the base from a prefix and
  # is octal without one.
  def test_hex_and_oct
    assert_equal(255, "0xff".hex)
    assert_equal(-31, "-0x1f".hex)
    assert_equal(31, "1fg".hex)
    assert_equal(31, "1_f".hex)
    assert_equal(0, "zz".hex)
    assert_equal(15, "17x".oct)
    assert_equal(31, "0x1f".oct)
    assert_equal(3, "0b11".oct)
    assert_equal(15, "0o17".oct)
    assert_equal(19, "0d19".oct)
    assert_equal(-15, "-017".oct)
    assert_equal(1, "19".oct)
    assert_raise(OverflowError) { _ = "ffffffffffffffffff".hex; nil }
  end

  # As Ruby's: the prefix naming the base is skipped, base 0 takes it from
  # the prefix, and a single `_` may stand between digits.
  def test_to_i_with_prefixes
    assert_equal(31, "0x1f".to_i(16))
    assert_equal(-31, "-0X1F".to_i(16))
    assert_equal(5, "0b101".to_i(2))
    assert_equal(15, "0o17".to_i(8))
    assert_equal(19, "0d19".to_i)
    assert_equal(0, "0x1f".to_i(10))
    assert_equal(177, "0b1".to_i(16))
    assert_equal(31, "0x1f".to_i(0))
    assert_equal(5, "0b101".to_i(0))
    assert_equal(15, "0o17".to_i(0))
    assert_equal(15, "017".to_i(0))
    assert_equal(0, "08".to_i(0))
    assert_equal(12, " 12".to_i(0))
    assert_equal(0, "0x".to_i(16))
    assert_equal(0, "0x_1f".to_i(16))
    assert_equal(1000, "1_000".to_i)
    assert_equal(1, "1__2".to_i)
    assert_equal(0, "_1".to_i)
    assert_equal(1, "0x1__f".to_i(16))
  end

  def test_upto_from_after_the_end
    seen = Array::Builder[String].new
    "b".upto("a") { |s| seen << s }
    assert_empty(seen.to_a)
    "b".upto("aa") { |s| seen << s }
    assert_empty(seen.to_a)
    "a8".upto("b1") { |s| seen << s }
    assert_equal(["a8", "a9", "b0", "b1"], seen.to_a)
  end

  def first_five -> String
    "1".upto("9999999999") { |s| return s if s == "5" }
    "none"
  end

  def test_upto_steps_lazily
    assert_equal("5", first_five)
  end

  # As Ruby's: a carry crosses other characters, but not from a letter to
  # a digit or back across them.
  def test_succ
    assert_equal("2.0", "1.9".succ)
    assert_equal("b.a", "a.z".succ)
    assert_equal("1.aa", "1.z".succ)
    assert_equal("a.10a", "a.9z".succ)
    assert_equal("AAa", "Zz".succ)
    assert_equal("*+", "**".succ)
    assert_equal("1ê0", "1é9".succ)
    # Other scripts' letters and digits step within their runs, as in
    # Ruby; the carry stop is between ASCII letters and digits only.
    assert_equal("ê-0", "é-9".succ)
    assert_equal("Ø", "Ö".succ)
    assert_equal("אא", "ת".succ)
    assert_equal("１０", "９".succ)
    assert_equal("b٠", "a٩".succ)
    assert_equal("\u{1}\u{0}", "\u{7f}".succ)
    assert_equal("\u{1}\u{80}", "\u{7ff}".succ)
    assert_equal("", "".succ)
  end
end
