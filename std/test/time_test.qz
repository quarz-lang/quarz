require "test"

class TimeFieldsTest < Test::Case
  @t: Time = Time.utc(2026, 10, 19, 12, 34, 56)

  def test_to_s_and_inspect
    assert_equal("2026-10-19 12:34:56 UTC", @t.to_s)
    assert_equal("2026-10-19 12:34:56 UTC", @t.inspect)
  end

  def test_components
    t = @t
    assert_equal("2026 10 19 12 34 56 1 292 1792413296",
                 [t.year, t.month, t.day, t.hour, t.min, t.sec, t.wday, t.yday, t.to_i].join(" "))
  end

  def test_iso8601
    assert_equal("2026-10-19T12:34:56Z", @t.iso8601)
    assert_equal("2026-10-19T12:34:56.000Z", @t.iso8601(3))
  end

  def test_predicates_zone_offset
    assert_true(@t.monday?)
    assert_true(@t.utc?)
    assert_equal("UTC", @t.zone)
    assert_equal(0, @t.utc_offset)
  end

  def test_getlocal_keeps_the_instant
    assert_true(@t.getlocal.to_i == @t.to_i)
  end
end

class TimeArithmeticTest < Test::Case
  @t: Time = Time.utc(2026, 10, 19, 12, 34, 56)

  def test_add_fractional_seconds
    assert_equal("2026-10-19 12:34:57.5 UTC", (@t + 1.5.seconds).inspect)
  end

  def test_strftime
    assert_equal("2026/10/19 14:04:56 UTC 000 19 Monday 292",
                 (@t + 90.minutes).strftime("%Y/%m/%d %H:%M:%S %Z %L %-d %A %j"))
  end

  def test_difference_is_a_duration
    assert_equal("131696s", (@t - Time.utc(2026, 10, 18)).to_s)
  end

  def test_add_days
    assert_equal(3, (Time.utc(2026, 1, 1) + 2.days).day)
  end

  def test_epoch
    assert_equal("1970-01-01 00:00:00 UTC", Time.at(0).utc.to_s)
  end
end

class TimeParseTest < Test::Case
  def test_parse_utc
    assert_equal("2026-01-02 03:04:05 UTC", Time.parse("2026-01-02T03:04:05Z").inspect)
  end

  def test_parse_offset_and_fraction
    assert_equal("2026-01-02 03:04:05.5 +0900", Time.parse("2026-01-02 03:04:05.5 +0900").inspect)
    assert_equal("2026-01-01T18:04:05Z", Time.parse("2026-01-02 03:04:05 +09:00").utc.iso8601)
  end

  def test_iso8601_round_trip
    assert_equal("2026-01-02T03:04:05.25+09:00", Time.iso8601("2026-01-02T03:04:05.25+09:00").iso8601(2))
  end

  def test_parse_garbage_raises
    e = assert_raise(ArgumentError) { Time.parse("garbage"); nil }
    assert_equal("no time information in \"garbage\"", e.message)
  end
end

class TimeCompareTest < Test::Case
  def test_order_and_min
    assert_true(Time.utc(2026, 1, 1) < Time.utc(2026, 1, 2))
    assert_equal("2026-01-01 00:00:00 UTC", [Time.utc(2026, 1, 2), Time.utc(2026, 1, 1)].min.to_s)
  end

  def test_hash_key
    assert_equal("y2k", { Time.utc(2000) => "y2k" }[Time.utc(2000)])
  end

  def test_now_and_monotonic
    now = Time.now
    assert_true(now.to_f > 1.0e9)
    assert_true((Time.now - now) < 1.second)
    assert_true(Time.monotonic >= 0.ms)
  end
end
