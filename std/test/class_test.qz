# Classes: inheritance, accessors, operators, generics, abstract
# classes, class methods, private methods, modules and recursion.
require "test"

class ClsAnimal
  @name: String
  attr_reader :name
  def initialize(@name: String); end
  def speak -> String = "..."
  def to_s -> String = "#{self.class.name}(#{name}): #{speak}"
end

class ClsDog < ClsAnimal
  def speak -> String = "Woof"
end

class ClsPuppy < ClsDog
  def speak -> String = super + "!"
end

class ClsCounter
  var @n: Int = 0
  attr_accessor :n
  def bump -> ClsCounter
    @n += 1
    self
  end
end

class ClsV
  @x: Int
  @y: Int
  attr_reader :x, :y
  def initialize(@x: Int, @y: Int); end
  def +(o: ClsV) -> ClsV = ClsV.new(x + o.x, y + o.y)
  def ==(o: Object) -> Bool
    case o
    in ClsV then x == o.x && y == o.y
    else false
    end
  end
  def hash -> Int = [x, y].hash
  def -@ -> ClsV = ClsV.new(-x, -y)
  def [](i: Int) -> Int = i == 0 ? x : y
  def to_s -> String = "(#{x}, #{y})"
end

class ClsStack[T]
  @items: Array[T]
  def initialize(items: Array[T] = [])
    @items = items
  end
  def push(x: T) -> ClsStack[T] = ClsStack[T].new(@items.push(x))
  def peek -> T? = @items.last
  def size -> Int = @items.size
end

abstract class ClsShape
  abstract def area -> Float
  def describe -> String = "#{self.class.name} #{area}"
end

class ClsSq < ClsShape
  @s: Float
  def initialize(@s: Float); end
  def area -> Float = @s * @s
end

class ClsA
  def self.create(n: Int) -> ClsA = new(n)
  @n: Int
  def initialize(@n: Int); end
  def n -> Int = @n
  private def secret -> Int = 42
  def reveal -> Int = secret
end

module ClsGreeter
  abstract def name -> String
  def greet -> String = "Hi, #{name}"
end

class ClsP
  include ClsGreeter
  def name -> String = "Bob"
end

class ClsNode
  @val: Int
  @next: ClsNode?
  attr_reader :val, :next
  def initialize(@val: Int, @next: ClsNode? = nil); end
  def sum -> Int
    n = self.next
    n ? val + n.sum : val
  end
end

data ClsPoint = (x: Int, y: Int)
data ClsBox[T] = (v: T)
enum ClsLight
  variant Red
  variant Green(n: Int)
end
enum ClsMaybe[T]
  variant Some(v: T)
  variant None
end
class ClsGen[X] < ClsAnimal
end

# #946's review: a generic module's class method that takes `Type#cast`'s
# parameters only as an includer instantiates it (`include
# ClsCastMod[Object]`) is not in the override table (paired by the
# module's own types), so a call through a `Type[T]` runs `Type#cast`;
# written on the class, it is the module's, typed by its own result.
module ClsCastMod[U]
  def self.cast(value: U) -> Object = value
end
class ClsCastA
  include ClsCastMod[Object]
end
class ClsCastB < ClsCastA
  @n: Int = 7
  def n -> Int = @n
end

# #944: `Type[T]#cast?` and `#cast`, the value back as a `T` where its
# class is the receiver's or below it.
class TypeCastTest < Test::Case
  def through[T](t: Type[T], v: Object) -> T? = t.cast?(v)

  def refused(&f: () -> Object?) -> String
    begin
      f.call
      "not refused"
    rescue ArgumentError => e
      e.message
    end
  end

  def test_classes
    d = ClsDog.new("Rex")
    assert(ClsAnimal.cast?(d).equal?(d))
    assert_equal("Rex", ClsAnimal.cast(d).name)
    assert_nil(ClsDog.cast?(ClsAnimal.new("Tom")))
    # A `Type[Super]` holding a subclass: that subclass's test.
    sup: Type[ClsAnimal] = ClsDog
    assert_nil(sup.cast?(ClsAnimal.new("Tom")))
    assert_equal("Woof", (sup.cast?(ClsPuppy.new("P")) || raise "nil").speak.sub("!", ""))
    # An abstract class; an instance of a generic subclass of a plain
    # class (it is a `ClsAnimal`).
    assert_equal(4.0, ClsShape.cast(ClsSq.new(2.0)).area)
    assert_equal("G", ClsAnimal.cast(ClsGen[Int].new("G")).name)
    # `data` types, an enum and its variants.
    assert_equal(ClsPoint.new(1, 2), ClsPoint.cast?(ClsPoint.new(1, 2)))
    assert(ClsLight.cast?(ClsLight::Red) == ClsLight::Red)
    assert_equal(ClsLight::Green.new(3), ClsLight::Green.cast?(ClsLight::Green.new(3)))
    assert_nil(ClsLight::Green.cast?(ClsLight::Red))
    # Built-in classes, `Object`, nil.
    assert_equal(3, Int.cast?(3))
    assert_nil(Int.cast?("3"))
    assert_equal("s", String.cast("s"))
    assert(Object.cast?(3) == 3)
    assert_nil(ClsAnimal.cast?(nil))
    assert_nil(Nil.cast?(nil))
    # Through a type parameter: generic code gets its `T` back.
    assert_equal(ClsPoint.new(5, 6), through(ClsPoint, ClsPoint.new(5, 6)))
    assert_nil(through(ClsPoint, "x"))
    # A class value typed by a module it includes: the class's test.
    sh: Type[Shareable] = ClsPoint
    assert_equal(ClsPoint.new(1, 1), sh.cast?(ClsPoint.new(1, 1)))
  end

  def through_cast[T](t: Type[T], v: Object) -> T = t.cast(v)

  def test_a_generic_modules_cast_takes_no_place
    e = assert_raise(TypeError) { through_cast(ClsCastB, 1); nil }
    assert_equal("cannot cast Int to ClsCastB", e.message)
    assert_equal(7, through_cast(ClsCastB, ClsCastB.new).n)
    assert(ClsCastA.cast(1) == 1)
  end

  def test_errors
    e = assert_raise(TypeError) { ClsDog.cast(3); nil }
    assert_equal("cannot cast Int to ClsDog", e.message)
    e = assert_raise(TypeError) { ClsDog.cast(Int); nil }
    assert_equal("cannot cast Type[Int] to ClsDog", e.message)
    # A class with type parameters: its values' type arguments are not
    # seen at run time.
    tp = "has type parameters, and a value's type arguments are not seen at run time"
    assert_equal("ClsBox.cast?: ClsBox #{tp}", refused { ClsBox[Int].cast?(ClsBox.new(1)) })
    assert_equal("ClsBox.cast: ClsBox #{tp}", refused { ClsBox[Int].cast(ClsBox.new(1)) })
    assert_equal("Array.cast?: Array #{tp}", refused { Array[Int].cast?(["a"]) })
    assert_equal("ClsMaybe::Some.cast?: ClsMaybe::Some #{tp}", refused { ClsMaybe::Some.cast?(ClsMaybe::Some.new(1)) })
    assert_equal("Type.cast?: Type #{tp}", refused { Int.class.cast?(Int) })
    # A module, for now (quarz-lang/quarz#945).
    assert_equal("ClsGreeter.cast?: ClsGreeter is a module, which a test by class does not decide for every value (for now, quarz-lang/quarz#945)", refused { ClsGreeter.cast?(ClsP.new) })
    assert_match(/\AShareable\.cast\?: Shareable is a module/, refused { Shareable.cast?([1]) })
  end
end

class InheritanceTest < Test::Case
  def test_to_s_and_super
    assert_equal("ClsAnimal(a): ...", ClsAnimal.new("a").to_s)
    assert_equal("ClsDog(d): Woof", ClsDog.new("d").to_s)
    assert_equal("ClsPuppy(p): Woof!", ClsPuppy.new("p").to_s)
  end

  def test_dispatch_through_base_type
    animals: Array[ClsAnimal] = [ClsDog.new("x"), ClsPuppy.new("y")]
    spoken: Array[String] = []
    animals.each { |a| spoken = spoken.push(a.speak) }
    assert_equal(["Woof", "Woof!"], spoken)
  end

  def test_abstract_class
    assert_equal("ClsSq 9.0", ClsSq.new(3.0).describe)
  end
end

class MembersTest < Test::Case
  def test_accessor_and_chaining
    c = ClsCounter.new
    c.bump.bump
    c.n += 10
    assert_equal(12, c.n)
  end

  def test_operators
    a = ClsV.new(1, 2)
    assert_equal("(2, 4)", (a + a).to_s)
    assert_equal("(-1, -2)", (-a).to_s)
    assert_equal(2, a[1])
    assert_true(a == ClsV.new(1, 2))
    assert_false(a == ClsV.new(0, 0))
    assert_false(a != ClsV.new(1, 2))
  end

  def test_generic_class
    s = ClsStack[Int].new.push(1).push(2)
    assert_equal(2, s.size)
    assert_equal("2", s.peek.inspect)
    assert_equal("nil", ClsStack[String].new.peek.inspect)
  end

  def test_class_method_and_private
    assert_equal(5, ClsA.create(5).n)
    assert_equal(42, ClsA.new(1).reveal)
  end

  def welcome(g: ClsGreeter) -> String = g.greet

  def test_module_as_type
    assert_equal("Hi, Bob", welcome(ClsP.new))
  end

  def test_recursive_optional_field
    assert_equal(6, ClsNode.new(1, ClsNode.new(2, ClsNode.new(3))).sum)
  end
end
