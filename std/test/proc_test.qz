# Lambdas, closures, blocks, `&` conversions, method references and
# parameter kinds.
require "test"

class ProcTest < Test::Case
  def test_lambda_call_forms
    add = ->(a: Int, b: Int) { a + b }
    assert_equal(3, add.call(1, 2))
    assert_equal(7, add.(3, 4))
    assert_equal(2, add.arity)
  end

  def make_counter -> () -> Int
    n = 0
    -> { n += 1 }
  end

  def test_closure_keeps_its_variable
    c = make_counter
    c.call
    assert_equal(2, c.call)
    assert_equal(1, make_counter.call)
  end

  def twice(&block: (Int) -> Int) -> Int = yield(yield(1))
  def apply(f: (Int) -> Int, x: Int) -> Int = f.call(x)

  def test_block_proc_argument_and_ampersand
    assert_equal(9, twice { |x| x * 3 })
    assert_equal(42, apply(->(x: Int) { x + 1 }, 41))
    sq = ->(x: Int) { x * x }
    assert_equal([1, 4, 9], [1, 2, 3].map(&sq))
  end

  def each_pair_sum(&block: (Int, Int) -> Void) -> Void
    yield 1, 2
    yield 3, 4
  end

  def test_block_with_two_parameters
    sums: Array[Int] = []
    each_pair_sum { |a, b| sums = sums.push(a + b); nil }
    assert_equal([3, 7], sums)
    assert_equal([2, 12], [[1, 2], [3, 4]].map { |a, b| a * b })
  end

  def test_symbol_procs_and_method_reference
    xs = ["b", "a"]
    assert_equal(["B", "A"], xs.map(&:upcase))
    assert_equal("[:a, :b]", xs.sort.map(&:to_sym).inspect)
    up = "x".:upcase
    assert_equal("X", up.call)
  end

  def run_it(&block: () -> Int) -> Int
    v = yield
    v * 2
  end

  def with_default(x: Int, y: Int = x * 2, *rest: Int, flag: Bool = false, **opts: Int) -> String
    "#{x} #{y} #{rest.inspect} #{flag} #{opts.inspect}"
  end

  def test_yield_value_and_parameter_kinds
    assert_equal(42, run_it { 21 })
    assert_equal("1 2 [] false {}", with_default(1))
    assert_equal("1 5 [7, 8] true {extra: 9}", with_default(1, 5, 7, 8, flag: true, extra: 9))
  end

  def test_block_assigns_outer_and_lambda_return
    total = 0
    [1, 2, 3].each { |x| total += x }
    assert_equal(6, total)
    l = ->(x: Int) { return x * 2 }
    assert_equal(8, l.call(4))
  end
end
