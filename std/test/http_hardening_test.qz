# HTTP: what a client or a handler may get wrong ends one request or one
# connection, never the server; framing is strict where proxies differ.
require "http"
require "test"

class HttpHardeningParseTest < Test::Case
  def parse(text: String) -> String
    r = HTTP::Reader.of(text.to_bytes)
    req = HTTP.read_request(r, 100, 100, nil, HTTP::Proxies.none, false)
    req ? "#{req.method} #{req.path} #{req.query} #{req.body.read.inspect}" : "nil"
  rescue HTTP::Error => e
    "#{e.status} #{e.message}"
  end

  # Strict framing.
  def data_strict_framing -> Hash[String, [String, String]]
    {
      "bare LF after chunk data" => ["POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\n0\r\n\r\n", "400 bare LF"],
      "bare LF after chunk size" => ["POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n3\nabc\r\n0\r\n\r\n", "400 bare LF"],
      "spaces around chunk size" => ["POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n 3 \r\nabc\r\n0\r\n\r\n", "400 bad chunk size"],
      "chunk extension" => ["POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n3;x=y\r\nabc\r\n0\r\n\r\n", "POST /  \"abc\""],
      "two spaces after method" => ["GET  /a HTTP/1.1\r\n\r\n", "400 bad request line"],
      "space before method" => [" GET /a HTTP/1.1\r\n\r\n", "400 bad method"],
      "tab after method" => ["GET\t/a HTTP/1.1\r\n\r\n", "400 bad request line"],
      "control character in target" => ["GET /a\x01b HTTP/1.1\r\n\r\n", "400 bad request target"],
      "CR in header value" => ["GET / HTTP/1.1\r\nX: a\rb\r\n\r\n", "400 bad header value"],
      "NUL in header value" => ["GET / HTTP/1.1\r\nX: a\x00b\r\n\r\n", "400 bad header value"],
      "tab in header value" => ["GET / HTTP/1.1\r\nX: a\tb\r\n\r\n", "GET /  \"\""],
      "many leading empty lines" => ["#{"\r\n" * 60}GET / HTTP/1.1\r\n\r\n", "431 Request Header Fields Too Large"],
      "absolute target without path" => ["GET http://h?x=1 HTTP/1.1\r\n\r\n", "GET / x=1 \"\""],
      "absolute target, host only" => ["GET http://h HTTP/1.1\r\n\r\n", "GET /  \"\""],
      "space after version" => ["GET / HTTP/1.1 \r\n\r\n", "400 bad request line"],
      "lower-case version" => ["GET / http/1.1\r\n\r\n", "400 bad request line"],
      "fragment in target" => ["GET /p#frag HTTP/1.1\r\n\r\n", "400 bad request target"],
      "chunk size with many zeros" => ["POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n#{"0" * 2000}3\r\nabc\r\n0\r\n\r\n", "400 bad chunk size"],
    }
  end

  def test_strict_framing(data: [String, String])
    text, expected = data
    assert_equal(expected, parse(text))
  end

  # Trusted proxies are checked when given.
  def data_bad_proxy_spec -> Hash[String, [String, String]]
    {
      "prefix not a number" => ["10.0.0.0/abc", "bad network prefix: 10.0.0.0/abc"],
      "empty prefix" => ["10.0.0.0/", "bad network prefix: 10.0.0.0/"],
      "negative prefix" => ["10.0.0.0/-8", "bad network prefix: 10.0.0.0/-8"],
      "IPv4 prefix too long" => ["127.0.0.1/33", "bad network prefix: 127.0.0.1/33"],
      "IPv6 prefix too long" => ["::1/129", "bad network prefix: ::1/129"],
      "not an address" => ["nope", "not an address: nope"],
    }
  end

  def test_bad_proxy_spec(data: [String, String])
    spec, expected = data
    e = assert_raise(ArgumentError) { HTTP::Proxies.of([spec]); nil }
    assert_equal(expected, e.message)
  end

  def test_proxy_networks
    assert_true(HTTP::Proxies.of(["10.0.0.0/8", "::1/128"]).include?("10.9.9.9"))
  end

  def test_bad_forwarded_for_ignored
    bad = HTTP::Request.get("/", HTTP::Headers.empty.add("X-Forwarded-For", "<script>, not-an-ip"))
            .with(remote_address: Socket::Address.new("127.0.0.1", 9), proxies: HTTP::Proxies.of(["127.0.0.1"]), trusted: true)
    assert_equal("127.0.0.1", bad.remote_ip)
  end
end

class HttpHardeningServerTest < Test::Case
  # The messages the server reports to on_error.
  @errors: Channel[String] = Channel[String].new(capacity: 8)

  def handler -> HTTP::Handler
    HTTP.handler do |req|
      case req.path
      when "/stream-fails"
        HTTP::Response.stream do |w|
          w.write("x")
          raise "stream broke"
        end
      when "/inject" then HTTP::Response.text("a").header("x-user", "a\r\nSet-Cookie: evil=1")
      when "/inject-field"
        # Past `Headers#put`: the server's own check still refuses it.
        bad = HTTP::Headers.new([HTTP::Field.new("x-user", "a\r\nSet-Cookie: evil=1")])
        HTTP::Response.empty(200, bad)
      when "/te" then HTTP::Response.text("hello").header("transfer-encoding", "chunked")
      when "/cl" then HTTP::Response.empty(200).header("content-length", "5")
      when "/status" then HTTP::Response.text("x", 1000)
      when "/interim" then raise HTTP::Error.new(100)
      else HTTP::Response.text("ok #{req.body.read}")
      end
    end
  end

  # Serves on a port of its own while the block runs, then shuts down.
  def serving(&: (Int) -> Nil) -> Nil
    errors = @errors
    report: shareable (Exception, HTTP::Request?) -> Nil = ->(e: Exception, r: HTTP::Request?) { errors.send(e.message); nil }
    server = HTTP::Server.new(handler, host: "127.0.0.1", port: 0, on_error: report, read_timeout: 200.ms)
    Task.scope do |scope|
      scope.spawn { server.serve }
      begin
        port = server.local_address.port
        yield port
        # Whatever the test sent, the server goes on, and it reported
        # nothing the test did not take.
        alive = HttpHardeningServerTest.raw(port, "GET /alive HTTP/1.1\r\nConnection: close\r\n\r\n")
        assert_match(/\AHTTP\/1\.1 200 OK\|/, alive)
        assert_true(alive.end_with?("||ok "), alive)
        assert_nil(@errors.try_receive)
      ensure
        server.shutdown
      end
    end
    nil
  end

  # Everything the server sends until it closes, without the Date line
  # and with CR LF shown as `|`. A class method, so that a spawned
  # client can call it.
  def self.raw(port: Int, text: String) -> String
    Socket.tcp("127.0.0.1", port) do |s|
      s.write(text)
      s.read.gsub(/Date: [^\r]*\r\n/, "").gsub("\r\n", "|")
    end
  end

  def raw(port: Int, text: String) -> String = HttpHardeningServerTest.raw(port, text)

  def test_failing_stream_ends_its_connection_only
    serving do |port|
      assert_equal("HTTP/1.1 200 OK|Transfer-Encoding: chunked||1|x|", raw(port, "GET /stream-fails HTTP/1.1\r\n\r\n"))
      assert_equal("stream broke", @errors.receive)
      # The server goes on.
      assert_equal("HTTP/1.1 200 OK|Content-Type: text/plain; charset=utf-8|Content-Length: 3|Connection: close||ok ",
                   raw(port, "GET / HTTP/1.1\r\nConnection: close\r\n\r\n"))
    end
  end

  def test_header_with_crlf_not_sent
    serving do |port|
      # `header` raises in the handler, which is a 500.
      assert_equal("HTTP/1.1 500 Internal Server Error|Content-Length: 0|Connection: close||",
                   raw(port, "GET /inject HTTP/1.1\r\nConnection: close\r\n\r\n"))
      assert_equal("invalid header value for x-user (a control character)", @errors.receive)
      assert_equal("HTTP/1.1 500 Internal Server Error|Content-Length: 0|Connection: close||",
                   raw(port, "GET /inject-field HTTP/1.1\r\nConnection: close\r\n\r\n"))
      assert_equal("invalid response header (a control character or a bad name)", @errors.receive)
    end
  end

  def test_http10_with_transfer_encoding_closed
    # Answered, then closed: the second request is not served.
    serving do |port|
      assert_equal("HTTP/1.1 200 OK|Content-Type: text/plain; charset=utf-8|Content-Length: 4|Connection: close||ok a",
                   raw(port, "POST / HTTP/1.0\r\nConnection: keep-alive\r\nTransfer-Encoding: chunked\r\n\r\n1\r\na\r\n0\r\n\r\nGET / HTTP/1.0\r\n\r\n"))
    end
  end

  def test_bad_chunk_size_closes
    # 400 and closed, nothing after it is served.
    serving do |port|
      assert_equal("HTTP/1.1 400 Bad Request|Content-Type: text/plain; charset=utf-8|Content-Length: 14|Connection: close||bad chunk size",
                   raw(port, "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n5 \r\n0\r\n\r\n\r\nGET /smuggled HTTP/1.1\r\n\r\n"))
    end
  end

  # The framing is the server's; statuses are final ones.
  def test_handler_transfer_encoding_replaced
    serving do |port|
      assert_equal("HTTP/1.1 200 OK|Content-Type: text/plain; charset=utf-8|Content-Length: 5|Connection: close||hello",
                   raw(port, "GET /te HTTP/1.1\r\nConnection: close\r\n\r\n"))
    end
  end

  def test_handler_content_length_replaced
    serving do |port|
      assert_equal("HTTP/1.1 200 OK|Content-Length: 0|Connection: close||", raw(port, "GET /cl HTTP/1.1\r\nConnection: close\r\n\r\n"))
    end
  end

  def test_head_keeps_handler_content_length
    serving do |port|
      assert_equal("HTTP/1.1 200 OK|Content-Length: 5|Connection: close||", raw(port, "HEAD /cl HTTP/1.1\r\nConnection: close\r\n\r\n"))
    end
  end

  def test_invalid_status
    serving do |port|
      assert_equal("HTTP/1.1 500 Internal Server Error|Content-Length: 0|Connection: close||",
                   raw(port, "GET /status HTTP/1.1\r\nConnection: close\r\n\r\n"))
      assert_equal("invalid response status 1000", @errors.receive)
    end
  end

  def test_interim_status_raised
    serving do |port|
      assert_equal("HTTP/1.1 500 Internal Server Error|Content-Length: 0|Connection: close||",
                   raw(port, "GET /interim HTTP/1.1\r\nConnection: close\r\n\r\n"))
    end
  end

  def test_body_that_stops_coming
    # Closed after read_timeout.
    serving do |port|
      assert_equal("HTTP/1.1 408 Request Timeout|Content-Type: text/plain; charset=utf-8|Content-Length: 15|Connection: close||Request Timeout",
                   raw(port, "POST / HTTP/1.1\r\nContent-Length: 10\r\n\r\nabc"))
    end
  end

  def test_shutdown_before_serve
    # Twice: serve then returns at once, having served nothing.
    s2 = HTTP::Server.new(handler, host: "127.0.0.1", port: 0)
    s2.shutdown
    s2.shutdown
    assert_nothing_raised do
      s2.serve
      s2.wait
    end
    assert_true(s2.stopping?)
  end

  def test_shutdown_timeout_with_every_slot_taken
    busy = Channel[Nil].new(capacity: 1)
    slow = HTTP.handler do |req|
      busy.send(nil)
      Task.sleep(30.seconds)
      HTTP::Response.text("late")
    end
    s3 = HTTP::Server.new(slow, host: "127.0.0.1", port: 0, max_connections: 1)
    port3 = s3.local_address.port
    Task.scope do |scope|
      scope.spawn { s3.serve }
      begin
        c = scope.spawn { HttpHardeningServerTest.raw(port3, "GET / HTTP/1.1\r\n\r\n") }
        busy.receive
        started = Time.monotonic
        s3.shutdown(timeout: 100.ms)
        s3.wait
        assert_true((Time.monotonic - started) < 10.seconds)
        assert_equal("", c.await)
      ensure
        s3.shutdown
      end
    end
  end
end

# Headers that would split a response are refused where they are set.
class HttpHeaderValidationTest < Test::Case
  def data_bad_value -> Hash[String, String]
    {"CR LF" => "a\r\nSet-Cookie: evil=1", "LF" => "a\nb", "CR" => "a\rb", "NUL" => "a\u0000b", "DEL" => "a\u007fb"}
  end

  def test_bad_value(value: String)
    res = HTTP::Response.text("a")
    e = assert_raise(ArgumentError) { res.header("x-user", value) }
    # The value, which may come from a request, is not in the message.
    assert_equal("invalid header value for x-user (a control character)", e.message)
    assert_raise(ArgumentError) { HTTP::Headers.empty.add("x-user", value) }
    assert_raise(ArgumentError) { HTTP::Headers.empty.put("x-user", value) }
    assert_raise(ArgumentError) { HTTP::Headers.of({"x-user" => value}) }
    assert_raise(ArgumentError) { HTTP::Response.redirect("/a#{value}") }
  end

  def data_bad_name -> Hash[String, String]
    {"space" => "x user", "colon" => "x:user", "CR LF" => "x\r\ny", "empty" => ""}
  end

  def test_bad_name(name: String)
    e = assert_raise(ArgumentError) { HTTP::Response.text("a").header(name, "v") }
    assert_equal("invalid header name #{name.inspect}", e.message)
  end

  def test_htab_and_utf8_are_values
    res = HTTP::Response.text("a").header("x-a", "1\t2").header("x-b", "héllo")
    assert_equal("1\t2", res.headers["x-a"])
    assert_equal("héllo", res.headers["x-b"])
  end
end
