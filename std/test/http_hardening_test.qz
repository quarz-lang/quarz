# HTTP: what a client or a handler may get wrong ends one request or one
# connection, never the server; framing is strict where proxies differ.
require "http"
require "test"

class HttpHardeningParseTest < Test::Case
  def parse(text: String) -> String
    r = HTTP::Reader.of(text.to_bytes)
    req = HTTP.read_request(r, 100, 100, nil, HTTP::Proxies.none, false)
    req ? "#{req.method} #{req.path} #{req.query} #{req.body.read.inspect}" : "nil"
  rescue HTTP::Error => e
    "#{e.status} #{e.message}"
  end

  # Strict framing.
  def data_strict_framing -> Hash[String, [String, String]]
    {
      "bare LF after chunk data" => ["POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\n0\r\n\r\n", "400 bare LF"],
      "bare LF after chunk size" => ["POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\nabc\r\n0\r\n\r\n", "400 bare LF"],
      "spaces around chunk size" => ["POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n 3 \r\nabc\r\n0\r\n\r\n", "400 bad chunk size"],
      "chunk extension" => ["POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3;x=y\r\nabc\r\n0\r\n\r\n", "POST /  \"abc\""],
      "two spaces after method" => ["GET  /a HTTP/1.1\r\nHost: x\r\n\r\n", "400 bad request line"],
      "space before method" => [" GET /a HTTP/1.1\r\n\r\n", "400 bad method"],
      "tab after method" => ["GET\t/a HTTP/1.1\r\n\r\n", "400 bad request line"],
      "control character in target" => ["GET /a\x01b HTTP/1.1\r\n\r\n", "400 bad request target"],
      "CR in header value" => ["GET / HTTP/1.1\r\nHost: x\r\nX: a\rb\r\n\r\n", "400 bad header value"],
      "NUL in header value" => ["GET / HTTP/1.1\r\nHost: x\r\nX: a\x00b\r\n\r\n", "400 bad header value"],
      "tab in header value" => ["GET / HTTP/1.1\r\nHost: x\r\nX: a\tb\r\n\r\n", "GET /  \"\""],
      "many leading empty lines" => ["#{"\r\n" * 60}GET / HTTP/1.1\r\n\r\n", "431 Request Header Fields Too Large"],
      "absolute target without path" => ["GET http://h?x=1 HTTP/1.1\r\nHost: x\r\n\r\n", "GET / x=1 \"\""],
      "absolute target, host only" => ["GET http://h HTTP/1.1\r\nHost: x\r\n\r\n", "GET /  \"\""],
      "space after version" => ["GET / HTTP/1.1 \r\n\r\n", "400 bad request line"],
      "lower-case version" => ["GET / http/1.1\r\n\r\n", "400 bad request line"],
      "fragment in target" => ["GET /p#frag HTTP/1.1\r\nHost: x\r\n\r\n", "400 bad request target"],
      "chunk size with many zeros" => ["POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n#{"0" * 2000}3\r\nabc\r\n0\r\n\r\n", "400 bad chunk size"],
      # #1131: extensions and trailers count as the body's bytes
      # (max_body_bytes 100 here).
      "extensions within the limit" => ["POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n1;#{"e" * 40}\r\na\r\n1;#{"e" * 40}\r\nb\r\n0\r\n\r\n", "POST /  \"ab\""],
      "extensions past the limit" => ["POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n1;#{"e" * 60}\r\na\r\n1;#{"e" * 60}\r\nb\r\n0\r\n\r\n", "413 Payload Too Large"],
      "extensions and data past the limit" => ["POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n5;#{"e" * 60}\r\n#{"d" * 5}\r\n28\r\n#{"d" * 40}\r\n0\r\n\r\n", "413 Payload Too Large"],
      "trailers past the limit" => ["POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n1\r\na\r\n0\r\nX-A: #{"t" * 60}\r\nX-B: #{"t" * 60}\r\n\r\n", "413 Payload Too Large"],
    }
  end

  # #1126: a framing field is trimmed of spaces and tabs only (RFC 9110
  # §5.6.3), so other whitespace makes it no match, as a proxy that does
  # not trim it would read it; only CRLF ends a line of the request head;
  # an HTTP/1.1 request has one Host, any request at most one (RFC 9112
  # §3.2).
  def data_strict_head -> Hash[String, [String, String]]
    {
      "U+00A0 before chunked" => ["POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: \u00a0chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n", "400 bad Transfer-Encoding"],
      "U+3000 after chunked" => ["POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\u3000\r\n\r\n3\r\nabc\r\n0\r\n\r\n", "400 bad Transfer-Encoding"],
      "U+0085 in a coding list" => ["POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: gzip,\u0085chunked\r\n\r\n", "400 bad Transfer-Encoding"],
      "unknown coding" => ["POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: gzip, chunked\r\n\r\n", "501 Not Implemented"],
      "spaces and tabs around chunked" => ["POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: \t chunked \t\r\n\r\n3\r\nabc\r\n0\r\n\r\n", "POST /  \"abc\""],
      "U+00A0 before a length" => ["POST / HTTP/1.1\r\nHost: x\r\nContent-Length: \u00a03\r\n\r\nabc", "400 bad Content-Length"],
      "U+3000 after a length" => ["POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 3\u3000\r\n\r\nabc", "400 bad Content-Length"],
      "spaces and tabs around a length" => ["POST / HTTP/1.1\r\nHost: x\r\nContent-Length: \t 3 \t\r\n\r\nabc", "POST /  \"abc\""],
      "bare LF before the request" => ["\nGET / HTTP/1.1\r\nHost: x\r\n\r\n", "400 bare LF"],
      "bare LF after the request line" => ["GET / HTTP/1.1\nHost: x\r\n\r\n", "400 bare LF"],
      "bare LF after a header" => ["GET / HTTP/1.1\r\nHost: x\n\r\n", "400 bare LF"],
      "bare LF ending the head" => ["GET / HTTP/1.1\r\nHost: x\r\n\n", "400 bare LF"],
      "no Host in HTTP/1.1" => ["GET / HTTP/1.1\r\n\r\n", "400 missing Host header"],
      "two Hosts" => ["GET / HTTP/1.1\r\nHost: a\r\nHost: b\r\n\r\n", "400 more than one Host header"],
      "two Hosts in HTTP/1.0" => ["GET / HTTP/1.0\r\nHost: a\r\nHost: a\r\n\r\n", "400 more than one Host header"],
      "no Host in HTTP/1.0" => ["GET / HTTP/1.0\r\n\r\n", "GET /  \"\""],
      "an empty Host" => ["GET / HTTP/1.1\r\nHost:\r\n\r\n", "GET /  \"\""],
    }
  end

  def test_strict_head(data: [String, String])
    text, expected = data
    assert_equal(expected, parse(text))
  end

  # #1126: other fields keep whitespace that is not a space or a tab.
  def test_field_values_trimmed_of_spaces_and_tabs_only
    r = HTTP::Reader.of("GET / HTTP/1.1\r\nHost: x\r\nA: \t a \t\r\nB: \u0085b\u00a0\r\n\r\n".to_bytes)
    req = HTTP.read_request(r, 100, 100, nil, HTTP::Proxies.none, false)
    raise "no request" if req.nil?
    assert_equal("a", req.headers["a"])
    assert_equal("\u0085b\u00a0", req.headers["b"])
  end

  def test_strict_framing(data: [String, String])
    text, expected = data
    assert_equal(expected, parse(text))
  end

  # Trusted proxies are checked when given.
  def data_bad_proxy_spec -> Hash[String, [String, String]]
    {
      "prefix not a number" => ["10.0.0.0/abc", "bad network prefix: 10.0.0.0/abc"],
      "empty prefix" => ["10.0.0.0/", "bad network prefix: 10.0.0.0/"],
      "negative prefix" => ["10.0.0.0/-8", "bad network prefix: 10.0.0.0/-8"],
      "IPv4 prefix too long" => ["127.0.0.1/33", "bad network prefix: 127.0.0.1/33"],
      "IPv6 prefix too long" => ["::1/129", "bad network prefix: ::1/129"],
      "not an address" => ["nope", "not an address: nope"],
      # Read as octal by some parsers (RFC 6943 section 3.1.1).
      "leading zero" => ["010.0.0.0/8", "not an address: 010.0.0.0/8"],
    }
  end

  def test_bad_proxy_spec(data: [String, String])
    spec, expected = data
    e = assert_raise(ArgumentError) { HTTP::Proxies.of([spec]); nil }
    assert_equal(expected, e.message)
  end

  def test_proxy_networks
    assert_true(HTTP::Proxies.of(["10.0.0.0/8", "::1/128"]).include?("10.9.9.9"))
  end

  # An entry with a leading zero is not an address: it ends the chain.
  def test_forwarded_for_with_a_leading_zero
    req = HTTP::Server::Request.get("/", HTTP::Headers.empty.add("X-Forwarded-For", "1.2.3.4, 010.0.0.5"))
            .with(remote_address: Socket::Address.new("127.0.0.1", 9), proxies: HTTP::Proxies.of(["127.0.0.1", "10.0.0.0/8"]), trusted: true)
    assert_equal("127.0.0.1", req.remote_ip)
  end

  def test_bad_forwarded_for_ignored
    bad = HTTP::Server::Request.get("/", HTTP::Headers.empty.add("X-Forwarded-For", "<script>, not-an-ip"))
            .with(remote_address: Socket::Address.new("127.0.0.1", 9), proxies: HTTP::Proxies.of(["127.0.0.1"]), trusted: true)
    assert_equal("127.0.0.1", bad.remote_ip)
  end
end

class HttpHardeningServerTest < Test::Case
  # The messages the server reports to on_error.
  @errors: Channel[String] = Channel[String].new(capacity: 8)

  def handler -> HTTP::Handler
    HTTP.handler do |req|
      case req.path
      when "/stream-fails"
        HTTP::Server::Response.stream do |w|
          w.write("x")
          raise "stream broke"
        end
      when "/inject" then HTTP::Server::Response.text("a").header("x-user", "a\r\nSet-Cookie: evil=1")
      when "/inject-field"
        # Past `Headers#put`: the server's own check still refuses it.
        bad = HTTP::Headers.new([HTTP::Field.new("x-user", "a\r\nSet-Cookie: evil=1")])
        HTTP::Server::Response.empty(200, bad)
      when "/te" then HTTP::Server::Response.text("hello").header("transfer-encoding", "chunked")
      when "/cl" then HTTP::Server::Response.empty(200).header("content-length", "5")
      when "/status" then HTTP::Server::Response.text("x", 1000)
      when "/interim" then raise HTTP::Error.new(100)
      when "/deep" then HTTP::Server::Response.text("#{HttpHardeningServerTest.deep(0)}")
      when "/deep-stream"
        HTTP::Server::Response.stream do |w|
          w.write("x")
          w.write("#{HttpHardeningServerTest.deep(0)}")
        end
      else HTTP::Server::Response.text("ok #{req.body.read}")
      end
    end
  end

  # Serves on a port of its own while the block runs, then shuts down.
  def serving(&: (Int) -> Void) -> Void
    errors = @errors
    report: shareable (Exception, HTTP::Server::Request?) -> Void = ->(e: Exception, r: HTTP::Server::Request?) { errors.send(e.message); nil }
    server = HTTP::Server.new(handler, host: "127.0.0.1", port: 0, on_error: report, read_timeout: 200.ms)
    Task.scope do |scope|
      scope.spawn { server.serve }
      begin
        port = server.local_address.port
        yield port
        # Whatever the test sent, the server goes on, and it reported
        # nothing the test did not take.
        alive = HttpHardeningServerTest.raw(port, "GET /alive HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
        assert_match(/\AHTTP\/1\.1 200 OK\|/, alive)
        assert_true(alive.end_with?("||ok "), alive)
        assert_nil(@errors.try_receive)
      ensure
        server.shutdown
      end
    end
    nil
  end

  # Everything the server sends until it closes, without the Date line
  # and with CR LF shown as `|`. A class method, so that a spawned
  # client can call it.
  def self.raw(port: Int, text: String) -> String
    Socket.tcp("127.0.0.1", port) do |s|
      s.write(text)
      s.read.gsub(/Date: [^\r]*\r\n/, "").gsub("\r\n", "|")
    end
  end

  def raw(port: Int, text: String) -> String = HttpHardeningServerTest.raw(port, text)

  # Recurses without end: `SystemStackError`.
  def self.deep(n: Int) -> Int = 1 + deep(n + 1)

  def test_on_error_that_overflows_ends_its_report_only
    # `on_error` itself recursing without end: reported to STDERR, the
    # server goes on (#377's review).
    report: shareable (Exception, HTTP::Server::Request?) -> Void = ->(e: Exception, r: HTTP::Server::Request?) { HttpHardeningServerTest.deep(0); nil }
    server = HTTP::Server.new(handler, host: "127.0.0.1", port: 0, on_error: report)
    Task.scope do |scope|
      scope.spawn { server.serve }
      begin
        port = server.local_address.port
        assert_equal("HTTP/1.1 500 Internal Server Error|Content-Length: 0|Connection: close||",
                     raw(port, "GET /deep HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"))
        assert_match(/\AHTTP\/1\.1 200 OK\|/, raw(port, "GET /alive HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"))
      ensure
        server.shutdown
      end
    end
  end

  def test_stack_overflow_ends_its_request_only
    serving do |port|
      # In the handler: a 500, reported (not a `StandardError`, #377).
      assert_equal("HTTP/1.1 500 Internal Server Error|Content-Length: 0|Connection: close||",
                   raw(port, "GET /deep HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"))
      assert_equal("stack level too deep", @errors.receive)
      # In a stream body, once the response started: its connection
      # closed, reported.
      assert_equal("HTTP/1.1 200 OK|Transfer-Encoding: chunked||1|x|", raw(port, "GET /deep-stream HTTP/1.1\r\nHost: x\r\n\r\n"))
      assert_equal("stack level too deep", @errors.receive)
    end
  end

  def test_failing_stream_ends_its_connection_only
    serving do |port|
      assert_equal("HTTP/1.1 200 OK|Transfer-Encoding: chunked||1|x|", raw(port, "GET /stream-fails HTTP/1.1\r\nHost: x\r\n\r\n"))
      assert_equal("stream broke", @errors.receive)
      # The server goes on.
      assert_equal("HTTP/1.1 200 OK|Content-Type: text/plain; charset=utf-8|Content-Length: 3|Connection: close||ok ",
                   raw(port, "GET / HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"))
    end
  end

  def test_header_with_crlf_not_sent
    serving do |port|
      # `header` raises in the handler, which is a 500.
      assert_equal("HTTP/1.1 500 Internal Server Error|Content-Length: 0|Connection: close||",
                   raw(port, "GET /inject HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"))
      assert_equal("invalid header value for x-user (a control character)", @errors.receive)
      assert_equal("HTTP/1.1 500 Internal Server Error|Content-Length: 0|Connection: close||",
                   raw(port, "GET /inject-field HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"))
      assert_equal("invalid response header (a control character or a bad name)", @errors.receive)
    end
  end

  def test_http10_with_transfer_encoding_closed
    # Answered, then closed: the second request is not served.
    serving do |port|
      assert_equal("HTTP/1.1 200 OK|Content-Type: text/plain; charset=utf-8|Content-Length: 4|Connection: close||ok a",
                   raw(port, "POST / HTTP/1.0\r\nConnection: keep-alive\r\nTransfer-Encoding: chunked\r\n\r\n1\r\na\r\n0\r\n\r\nGET / HTTP/1.0\r\n\r\n"))
    end
  end

  def test_bad_chunk_size_closes
    # 400 and closed, nothing after it is served.
    serving do |port|
      assert_equal("HTTP/1.1 400 Bad Request|Content-Type: text/plain; charset=utf-8|Content-Length: 14|Connection: close||bad chunk size",
                   raw(port, "POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n5 \r\n0\r\n\r\n\r\nGET /smuggled HTTP/1.1\r\n\r\n"))
    end
  end

  # The framing is the server's; statuses are final ones.
  def test_handler_transfer_encoding_replaced
    serving do |port|
      assert_equal("HTTP/1.1 200 OK|Content-Type: text/plain; charset=utf-8|Content-Length: 5|Connection: close||hello",
                   raw(port, "GET /te HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"))
    end
  end

  def test_handler_content_length_replaced
    serving do |port|
      assert_equal("HTTP/1.1 200 OK|Content-Length: 0|Connection: close||", raw(port, "GET /cl HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"))
    end
  end

  def test_head_keeps_handler_content_length
    serving do |port|
      assert_equal("HTTP/1.1 200 OK|Content-Length: 5|Connection: close||", raw(port, "HEAD /cl HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"))
    end
  end

  def test_invalid_status
    serving do |port|
      assert_equal("HTTP/1.1 500 Internal Server Error|Content-Length: 0|Connection: close||",
                   raw(port, "GET /status HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"))
      assert_equal("invalid response status 1000", @errors.receive)
    end
  end

  def test_interim_status_raised
    serving do |port|
      assert_equal("HTTP/1.1 500 Internal Server Error|Content-Length: 0|Connection: close||",
                   raw(port, "GET /interim HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"))
    end
  end

  def test_body_that_stops_coming
    # Closed after read_timeout.
    serving do |port|
      assert_equal("HTTP/1.1 408 Request Timeout|Content-Type: text/plain; charset=utf-8|Content-Length: 15|Connection: close||Request Timeout",
                   raw(port, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 10\r\n\r\nabc"))
    end
  end

  def test_shutdown_before_serve
    # Twice: serve then returns at once, having served nothing.
    s2 = HTTP::Server.new(handler, host: "127.0.0.1", port: 0)
    s2.shutdown
    s2.shutdown
    assert_nothing_raised do
      s2.serve
      s2.wait
    end
    assert_true(s2.stopping?)
  end

  def test_shutdown_timeout_with_every_slot_taken
    busy = Channel[Nil].new(capacity: 1)
    slow = HTTP.handler do |req|
      busy.send(nil)
      Task.sleep(30.seconds)
      HTTP::Server::Response.text("late")
    end
    s3 = HTTP::Server.new(slow, host: "127.0.0.1", port: 0, max_connections: 1)
    port3 = s3.local_address.port
    Task.scope do |scope|
      scope.spawn { s3.serve }
      begin
        c = scope.spawn { HttpHardeningServerTest.raw(port3, "GET / HTTP/1.1\r\nHost: x\r\n\r\n") }
        busy.receive
        started = Time.monotonic
        s3.shutdown(timeout: 100.ms)
        s3.wait
        assert_true((Time.monotonic - started) < 10.seconds)
        assert_equal("", c.await)
      ensure
        s3.shutdown
      end
    end
  end
end

# Headers that would split a response are refused where they are set.
class HttpHeaderValidationTest < Test::Case
  def data_bad_value -> Hash[String, String]
    {"CR LF" => "a\r\nSet-Cookie: evil=1", "LF" => "a\nb", "CR" => "a\rb", "NUL" => "a\u0000b", "DEL" => "a\u007fb"}
  end

  def test_bad_value(value: String)
    res = HTTP::Server::Response.text("a")
    e = assert_raise(ArgumentError) { res.header("x-user", value) }
    # The value, which may come from a request, is not in the message.
    assert_equal("invalid header value for x-user (a control character)", e.message)
    assert_raise(ArgumentError) { HTTP::Headers.empty.add("x-user", value) }
    assert_raise(ArgumentError) { HTTP::Headers.empty.put("x-user", value) }
    assert_raise(ArgumentError) { HTTP::Headers.of({"x-user" => value}) }
    assert_raise(ArgumentError) { HTTP::Server::Response.redirect("/a#{value}") }
  end

  def data_bad_name -> Hash[String, String]
    {"space" => "x user", "colon" => "x:user", "CR LF" => "x\r\ny", "empty" => ""}
  end

  def test_bad_name(name: String)
    e = assert_raise(ArgumentError) { HTTP::Server::Response.text("a").header(name, "v") }
    assert_equal("invalid header name #{name.inspect}", e.message)
  end

  def test_htab_and_utf8_are_values
    res = HTTP::Server::Response.text("a").header("x-a", "1\t2").header("x-b", "héllo")
    assert_equal("1\t2", res.headers["x-a"])
    assert_equal("héllo", res.headers["x-b"])
  end
end

# #1131: a request may make the server wait `request_timeout` in all,
# from its first byte: a body sent a byte at a time, each within
# `read_timeout`, is answered 408 once the total runs out; time the
# handler spends before reading does not count.
class HttpRequestTimeoutTest < Test::Case
  def serving(&: (Int) -> Void) -> Void
    handler = HTTP.handler do |req|
      Task.sleep(900.ms) if req.path == "/slow"
      HTTP::Server::Response.text("ok #{req.body.read}")
    end
    server = HTTP::Server.new(handler, host: "127.0.0.1", port: 0, read_timeout: 400.ms, request_timeout: 600.ms)
    Task.scope do |scope|
      scope.spawn { server.serve }
      begin
        yield server.local_address.port
      ensure
        server.shutdown
      end
    end
    nil
  end

  def test_a_body_dripping_past_the_request_timeout
    serving do |port|
      answer = Socket.tcp("127.0.0.1", port) do |s|
        s.write("POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 20\r\nConnection: close\r\n\r\n")
        Task.scope do |scope|
          scope.spawn do
            begin
              20.times { Task.sleep(200.ms); s.write("x") }
            rescue IOError, SystemCallError
              nil
            end
            nil
          end
          s.read
        end
      end
      assert_match(/\AHTTP\/1\.1 408 Request Timeout\r\n/, answer)
    end
  end

  def test_handler_time_does_not_count
    serving do |port|
      answer = Socket.tcp("127.0.0.1", port) do |s|
        s.write("POST /slow HTTP/1.1\r\nHost: x\r\nContent-Length: 3\r\nConnection: close\r\n\r\nabc")
        s.read
      end
      assert_true(answer.end_with?("\r\n\r\nok abc"), answer)
    end
  end
end
