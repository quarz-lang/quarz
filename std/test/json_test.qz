require "json"
require "time"
require "test"

data JsonTestPoint = (x: Int, y: Int)

class JsonTestTemp
  @celsius: Float

  def initialize(celsius: Float)
    @celsius = celsius
  end

  def to_json -> String = JSON.generate({ unit: "C", value: @celsius })
end

data JsonTestArgs = (user_id: Int, template: String = "welcome", tags: Array[String] = [])

data JsonTestPair[T] = (a: T, b: T)

data JsonTestNode = (name: String, kids: Array[JsonTestNode] = [])

data JsonTestAll = (
  i: Int, big: Integer, f: Float, s: String, b: Bool, sym: Symbol, n: Nil,
  opt: Int?, none: String?, list: Array[Int], set: Set[String],
  by_s: Hash[String, Float], by_sym: Hash[Symbol, Array[Bool]],
  at: Time, raw: Bytes, doc: JSON::Value, pair: JsonTestPair[Int]
)

# An `initialize` of its own does not run when decoding.
data JsonTestOwnInit(x: Int)
  def initialize(s: String)
    @x = s.size
  end
end

enum JsonTestColor
  variant Red
  variant Green
end

class JsonParseTest < Test::Case
  @doc: JSON::Value = JSON.parse('{"name": "quarz", "version": 1, "pi": 3.5, "tags": ["lang", "vm"], "ok": true, "none": null, "nested": {"a": [1, {"b": "é😀"}]}}')

  def test_scalars
    assert_equal("\"quarz\"", @doc["name"].as_s.inspect)
    assert_equal(1, @doc["version"].as_i)
    assert_equal(3.5, @doc["pi"].as_f)
    assert_equal("\"vm\"", @doc["tags"][1].as_s.inspect)
  end

  def test_bool_null_unicode
    assert_true(@doc["ok"].as_bool)
    assert_true(@doc["none"].null?)
    assert_equal("\"é😀\"", @doc["nested"]["a"][1]["b"].as_s.inspect)
  end

  def test_missing_size_as_a
    assert_nil(@doc["missing"]?)
    assert_equal(2, @doc["tags"].size)
    assert_equal("[\"lang\", \"vm\"]", @doc["tags"].as_a.map(&:as_s).inspect)
  end

  def test_to_json_round_trip
    assert_equal("{\"name\":\"quarz\",\"version\":1,\"pi\":3.5,\"tags\":[\"lang\",\"vm\"],\"ok\":true,\"none\":null,\"nested\":{\"a\":[1,{\"b\":\"é😀\"}]}}",
                 @doc.to_json)
  end

  def test_pretty_generate_value
    assert_equal("{\n  \"a\": [\n    1,\n    {\n      \"b\": \"é😀\"\n    }\n  ]\n}", JSON.pretty_generate(@doc["nested"]))
  end

  def test_pattern_match_object
    keys = case @doc
           in JSON::Value::Object(members:) then members.keys.join(",")
           else "not a map"
           end
    assert_equal("name,version,pi,tags,ok,none,nested", keys)
  end

  def test_big_numbers_and_escapes
    assert_equal(1234567890123456789, JSON.parse("1234567890123456789").as_i)
    assert_equal("12345678901234567890", JSON.parse("12345678901234567890").as_integer.inspect)
    assert_equal("\"[12345678901234567890]\"", JSON.parse("[12345678901234567890]").to_json.inspect)
    assert_equal(-1500.0, JSON.parse("-1.5e3").as_f)
    assert_equal("\"a\\tb\"", JSON.parse('"a\\tb"').as_s.inspect)
  end

  def test_equality_ignores_spacing
    assert_true(JSON.parse("[1,2,3]") == JSON.parse(" [1, 2, 3] "))
  end

  def test_value_inspect
    assert_equal("JSON::Value::Array(items: [JSON::Value::Number(value: 1), JSON::Value::Null])", JSON.parse("[1, null]").inspect)
  end

  def test_version
    assert_equal("\"0.1.0\"", JSON::VERSION.inspect)
  end
end

class JsonGenerateTest < Test::Case
  def test_mixed_values
    assert_equal("{\"a\":1,\"b\":[true,null,2.5],\"c\":{\"x\":1,\"y\":2},\"d\":\"sym\",\"e\":\"q\\\"\\n\"}",
                 JSON.generate({ a: 1, "b" => [true, nil, 2.5], c: JsonTestPoint.new(x: 1, y: 2), d: :sym, e: "q\"\n" }))
  end

  def test_empty_collections
    assert_equal("[]", JSON.generate([]))
    assert_equal("{}", JSON.generate({}))
  end

  def test_pretty_generate_nested
    assert_equal("{\n  \"a\": [],\n  \"b\": {},\n  \"c\": [\n    1,\n    [\n      2\n    ]\n  ]\n}",
                 JSON.pretty_generate({ a: [], b: {}, c: [1, [2]] }))
  end

  def test_custom_to_json
    assert_equal("[{\"unit\":\"C\",\"value\":21.5}]", JSON.generate([JsonTestTemp.new(21.5)]))
  end

  def test_enum_and_time
    assert_equal("\"Red\"", JSON.generate(JsonTestColor::Red))
    assert_equal("\"2026-01-02T03:04:05Z\"", JSON.generate(Time.utc(2026, 1, 2, 3, 4, 5)))
  end
end

class JsonErrorTest < Test::Case
  def test_bad_key
    e = assert_raise(JSON::ParseError) { JSON.parse("{bad}"); nil }
    assert_equal("expected a string key at line 1 column 2", e.message)
  end

  def test_unexpected_end
    e = assert_raise(JSON::ParseError) { JSON.parse("[1, 2"); nil }
    assert_equal("unexpected end of input at line 1 column 6", e.message)
  end

  def test_too_deep
    e = assert_raise(JSON::ParseError) { JSON.parse("[" * 101 + "]" * 101); nil }
    assert_equal("nesting of 101 is too deep at line 1 column 101", e.message)
  end

  def test_nan
    e = assert_raise(JSON::GeneratorError) { JSON.generate(Float::NAN); nil }
    assert_equal("NaN not allowed in JSON", e.message)
  end

  def test_wrong_type
    doc = JSON.parse('{"name": "quarz"}')
    e = assert_raise(TypeError) { doc["name"].as_i; nil }
    assert_equal("not a JSON number: JSON::Value::String(value: \"quarz\")", e.message)
  end
end

class JsonDecodeTest < Test::Case
  def test_data_with_defaults_and_extra_keys
    args = JSON.decode[JsonTestArgs]('{"user_id": 42, "tags": ["a"], "other": {"x": 1}}')
    assert_equal(JsonTestArgs.new(user_id: 42, template: "welcome", tags: ["a"]), args)
  end

  def test_round_trip_of_every_kind
    all = JsonTestAll.new(
      i: -7, big: 123456789012345678901234567890, f: 2.5, s: "q\"é😀\n", b: true, sym: :sym, n: nil,
      opt: 3, none: nil, list: [1, 2], set: Set["a", "b"],
      by_s: { "x" => 1.5 }, by_sym: { k: [true, false] },
      at: Time.iso8601("2023-11-14T22:13:20.00000012Z"), raw: b"hi\x00\xff",
      doc: JSON.parse('{"z": [null]}'), pair: JsonTestPair[Int].new(a: 1, b: 2)
    )
    assert_equal(all, JSON.decode[JsonTestAll](JSON.generate(all)))
    assert_equal(all, JSON.decode[JsonTestAll](JSON.pretty_generate(all)))
  end

  def test_scalars_and_collections
    expected: Array[Int?] = [1, nil]
    assert_equal(expected, JSON.decode[Array[Int?]]("[1, null]"))
    assert_equal(2.0, JSON.decode[Float]("2"))
    assert_equal(:abc, JSON.decode[Symbol]('"abc"'))
    assert_equal(Set[1, 2], JSON.decode[Set[Int]]("[1, 2, 2]"))
    assert_equal({ "a" => [1] }, JSON.decode[Hash[String, Array[Int]]]('{"a": [1]}'))
    assert_equal(JsonTestPair[Float].new(a: 1.0, b: 2.5), JSON.decode[JsonTestPair[Float]]('{"a": 1, "b": 2.5}'))
  end

  def test_recursive_data
    node = JSON.decode[JsonTestNode]('{"name": "r", "kids": [{"name": "c"}]}')
    assert_equal(JsonTestNode.new(name: "r", kids: [JsonTestNode.new(name: "c", kids: [])]), node)
    assert_equal(node, JSON.decode[JsonTestNode](JSON.generate(node)))
  end

  def test_time_and_bytes_are_generated_to_be_read_back
    assert_equal("\"2023-11-14T22:13:20Z\"", JSON.generate(Time.at(1700000000)))
    assert_equal("\"2023-11-14T22:13:20.5Z\"", JSON.generate(Time.at(1700000000) + 500.ms))
    assert_equal("\"aGkA\"", JSON.generate(b"hi\x00"))
    assert_equal(Time.at(1700000000), JSON.decode[Time]('"2023-11-14T23:13:20+01:00"'))
  end

  def test_from_a_parsed_value
    doc = JSON.parse('{"job": {"user_id": 1}}')
    assert_equal(JsonTestArgs.new(user_id: 1), JSON.decode[JsonTestArgs](doc["job"]))
  end

  def test_own_initialize_does_not_run
    assert_equal(5, JSON.decode[JsonTestOwnInit]('{"x": 5}').x)
  end

  def test_errors_name_the_path
    e = assert_raise(JSON::DecodeError) { JSON.decode[JsonTestArgs]('{"user_id": 1, "tags": ["a", 3]}'); nil }
    assert_equal("$.tags[1]: expected a string, found 3", e.message)
    e = assert_raise(JSON::DecodeError) { JSON.decode[JsonTestArgs]('{"tags": []}'); nil }
    assert_equal("$: missing field `user_id` of JsonTestArgs", e.message)
    e = assert_raise(JSON::DecodeError) { JSON.decode[Array[JsonTestArgs]]('[{"user_id": null}]'); nil }
    assert_equal("$[0].user_id: expected an integer that fits an Int, found null", e.message)
    e = assert_raise(JSON::DecodeError) { JSON.decode[Int]("12345678901234567890123"); nil }
    assert_equal("$: expected an integer that fits an Int, found 12345678901234567890123", e.message)
    e = assert_raise(JSON::DecodeError) { JSON.decode[Hash[String, Int]]('{"a b": {"c": 1}}'); nil }
    assert_equal("$[\"a b\"]: expected an integer that fits an Int, found an object", e.message)
    e = assert_raise(JSON::DecodeError) { JSON.decode[Time]('"yesterday"'); nil }
    assert_equal("$: expected an RFC 3339 time string, found \"yesterday\"", e.message)
    assert_raise(JSON::ParseError) { JSON.decode[Int]("[1,"); nil }
  end

  def test_decode_or_nil
    assert_nil(JSON.decode?[JsonTestArgs]("not json"))
    assert_nil(JSON.decode?[JsonTestArgs]("{}"))
    assert_equal(JsonTestArgs.new(user_id: 3), JSON.decode?[JsonTestArgs]('{"user_id": 3}'))
  end
end
