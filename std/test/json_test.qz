require "json"
require "time"
require "test"

data JsonTestPoint = (x: Int, y: Int)

class JsonTestTemp
  @celsius: Float

  def initialize(celsius: Float)
    @celsius = celsius
  end

  def to_json -> String = JSON.generate({ unit: "C", value: @celsius })
end

data JsonTestArgs = (user_id: Int, template: String = "welcome", tags: Array[String] = [])

data JsonTestPair[T] = (a: T, b: T)

data JsonTestNode = (name: String, kids: Array[JsonTestNode] = [])

data JsonTestAll = (
  i: Int, big: Integer, f: Float, s: String, b: Bool, sym: Symbol, n: Nil,
  opt: Int?, none: String?, list: Array[Int], set: Set[String],
  by_s: Hash[String, Float], by_sym: Hash[Symbol, Array[Bool]],
  at: Time, raw: Bytes, doc: JSON::Value, pair: JsonTestPair[Int]
)

# An `initialize` of its own does not run when decoding.
data JsonTestOwnInit(x: Int)
  def initialize(s: String)
    @x = s.size
  end
end

data JsonTestRef = (id: String)

data JsonTestOwner = (owner: String | JsonTestRef, n: Int = 0)

data JsonTestBox[T] = (v: T | Array[T])

# Named only in a union: the compiled program must keep its class.
data JsonTestOnlyInUnion = (k: String)

enum JsonTestColor
  variant Red
  variant Green
end

class JsonParseTest < Test::Case
  @doc: JSON::Value = JSON.parse('{"name": "quarz", "version": 1, "pi": 3.5, "tags": ["lang", "vm"], "ok": true, "none": null, "nested": {"a": [1, {"b": "é😀"}]}}')

  def test_scalars
    assert_equal("\"quarz\"", @doc["name"].as_s.inspect)
    assert_equal(1, @doc["version"].as_i)
    assert_equal(3.5, @doc["pi"].as_f)
    assert_equal("\"vm\"", @doc["tags"][1].as_s.inspect)
  end

  def test_bool_null_unicode
    assert_true(@doc["ok"].as_bool)
    assert_true(@doc["none"].null?)
    assert_equal("\"é😀\"", @doc["nested"]["a"][1]["b"].as_s.inspect)
  end

  def test_missing_size_as_a
    assert_nil(@doc["missing"]?)
    assert_equal(2, @doc["tags"].size)
    assert_equal("[\"lang\", \"vm\"]", @doc["tags"].as_a.map(&:as_s).inspect)
  end

  def test_to_json_round_trip
    assert_equal("{\"name\":\"quarz\",\"version\":1,\"pi\":3.5,\"tags\":[\"lang\",\"vm\"],\"ok\":true,\"none\":null,\"nested\":{\"a\":[1,{\"b\":\"é😀\"}]}}",
                 @doc.to_json)
  end

  def test_pretty_generate_value
    assert_equal("{\n  \"a\": [\n    1,\n    {\n      \"b\": \"é😀\"\n    }\n  ]\n}", JSON.pretty_generate(@doc["nested"]))
  end

  def test_pattern_match_object
    keys = case @doc
           in JSON::Value::Object(members:) then members.keys.join(",")
           else "not a map"
           end
    assert_equal("name,version,pi,tags,ok,none,nested", keys)
  end

  def test_big_numbers_and_escapes
    assert_equal(1234567890123456789, JSON.parse("1234567890123456789").as_i)
    assert_equal("12345678901234567890", JSON.parse("12345678901234567890").as_integer.inspect)
    assert_equal("\"[12345678901234567890]\"", JSON.parse("[12345678901234567890]").to_json.inspect)
    assert_equal(-1500.0, JSON.parse("-1.5e3").as_f)
    assert_equal("\"a\\tb\"", JSON.parse('"a\\tb"').as_s.inspect)
  end

  # An unpaired surrogate escape, high or low, is read as U+FFFD and the
  # document goes on (#973); a pair is one character.
  def test_unpaired_surrogates
    r = "\u{FFFD}"
    assert_equal(r, JSON.parse('"\ud83d"').as_s)
    assert_equal("x#{r}A", JSON.parse('"x\ud800A"').as_s)
    assert_equal(r, JSON.parse('"\udc00"').as_s)
    assert_equal("😀", JSON.parse('"\ud83d\ude00"').as_s)
    assert_equal("#{r}😀", JSON.parse('"\udc00\ud83d\ude00"').as_s)
    assert_equal("#{r}#{r}", JSON.parse('"\udc00\ud83d"').as_s)
    # A high one followed by another escape, which is read on its own.
    assert_equal("#{r}A", JSON.parse('"\ud83d\u0041"').as_s)
    assert_equal("#{r}\n", JSON.parse('"\ud83d\n"').as_s)
    # Two highs in a row, the second paired.
    assert_equal("#{r}😀", JSON.parse('"\ud83d\ud83d\ude00"').as_s)
    assert_equal("#{r}#{r}", JSON.parse('"\ud83d\ud83d"').as_s)
    # At the end of a string followed by more of the document, and in a key.
    doc = JSON.parse('["a\ud83d", 1]')
    assert_equal("a#{r}", doc[0].as_s)
    assert_equal(1, doc[1].as_i)
    assert_equal(1, JSON.parse('{"k\ud83d": 1}')["k#{r}"].as_i)
    # A bad escape after a high surrogate is still refused.
    assert_raise(JSON::ParseError) { JSON.parse('"\ud83d\uZZZZ"') }
    # JSON.decode reads through the same decoder.
    assert_equal("x#{r}", JSON.decode[String]('"x\ud83d"'))
    assert_equal({"k#{r}" => 1}, JSON.decode[Hash[String, Int]]('{"k\udc00": 1}'))
  end

  def test_equality_ignores_spacing
    assert_true(JSON.parse("[1,2,3]") == JSON.parse(" [1, 2, 3] "))
  end

  def test_value_inspect
    assert_equal("JSON::Value::Array(items: [JSON::Value::Number(value: 1), JSON::Value::Null])", JSON.parse("[1, null]").inspect)
  end

  def test_version
    assert_equal("\"0.1.0\"", JSON::VERSION.inspect)
  end
end

class JsonGenerateTest < Test::Case
  def test_mixed_values
    assert_equal("{\"a\":1,\"b\":[true,null,2.5],\"c\":{\"x\":1,\"y\":2},\"d\":\"sym\",\"e\":\"q\\\"\\n\"}",
                 JSON.generate({ a: 1, "b" => [true, nil, 2.5], c: JsonTestPoint.new(x: 1, y: 2), d: :sym, e: "q\"\n" }))
  end

  def test_empty_collections
    assert_equal("[]", JSON.generate([]))
    assert_equal("{}", JSON.generate({}))
  end

  def test_pretty_generate_nested
    assert_equal("{\n  \"a\": [],\n  \"b\": {},\n  \"c\": [\n    1,\n    [\n      2\n    ]\n  ]\n}",
                 JSON.pretty_generate({ a: [], b: {}, c: [1, [2]] }))
  end

  def test_custom_to_json
    assert_equal("[{\"unit\":\"C\",\"value\":21.5}]", JSON.generate([JsonTestTemp.new(21.5)]))
  end

  def test_enum_and_time
    assert_equal("\"Red\"", JSON.generate(JsonTestColor::Red))
    assert_equal("\"2026-01-02T03:04:05Z\"", JSON.generate(Time.utc(2026, 1, 2, 3, 4, 5)))
  end
end

class JsonErrorTest < Test::Case
  def test_bad_key
    e = assert_raise(JSON::ParseError) { JSON.parse("{bad}"); nil }
    assert_equal("expected a string key at line 1 column 2", e.message)
  end

  def test_unexpected_end
    e = assert_raise(JSON::ParseError) { JSON.parse("[1, 2"); nil }
    assert_equal("unexpected end of input at line 1 column 6", e.message)
  end

  def test_too_deep
    e = assert_raise(JSON::ParseError) { JSON.parse("[" * 101 + "]" * 101); nil }
    assert_equal("nesting of 101 is too deep (max_nesting: 100) at line 1 column 101", e.message)
    assert_equal(100, JSON.parse("[" * 100 + "]" * 100).then { |v| depth(v) })
  end

  # #1125: an integer of more than 10,000 digits is refused (its
  # conversion is quadratic in them); 10,000 digits, a sign, and a float's
  # long mantissa are not.
  def test_integer_digits_bounded
    nines = "9" * 10_000
    assert_equal(Integer.parse(nines), JSON.parse("[#{nines}]")[0].as_integer)
    assert_equal(Integer.parse("-#{nines}"), JSON.parse("-#{nines}").as_integer)
    e = assert_raise(JSON::ParseError) { JSON.parse("[1, #{nines}9]"); nil }
    assert_equal("integer of more than 10000 digits at line 1 column 5", e.message)
    assert_raise(JSON::ParseError) { JSON.parse("-#{nines}9"); nil }
    assert_raise(JSON::ParseError) { JSON.decode[Integer]("#{nines}9"); nil }
    assert_raise(JSON::ParseError) { JSON.decode[Array[Int]]("[#{nines}9]"); nil }
    assert_equal(1.0, JSON.parse("1.#{"0" * 20_000}").as_f)
  end

  # #1133: a number past a Float's range is refused, as JSON.generate
  # refuses to write infinity; below it, zero (finite) is kept.
  def test_float_range
    e = assert_raise(JSON::ParseError) { JSON.parse("1e999"); nil }
    assert_equal("number out of range at line 1 column 1", e.message)
    e = assert_raise(JSON::ParseError) { JSON.parse("[1, -1e999]"); nil }
    assert_equal("number out of range at line 1 column 5", e.message)
    assert_raise(JSON::ParseError) { JSON.parse("1.8e308"); nil }
    largest = JSON.parse("1.7976931348623157e308")
    assert_equal("1.7976931348623157e+308", JSON.generate(largest))
    assert_equal(0.0, JSON.parse("1e-999").as_f)
    e = assert_raise(JSON::ParseError) { JSON.decode[Float]("1e999"); nil }
    assert_equal("number out of range at line 1 column 1", e.message)
    assert_raise(JSON::ParseError) { JSON.decode[Array[Float]]("[1.0, 1e999]"); nil }
    # An integer too large for a Float: valid JSON its target cannot hold.
    e = assert_raise(JSON::DecodeError) { JSON.decode[Float]("9" * 400); nil }
    assert_equal("$: expected a number that fits a Float, found a larger integer", e.message)
    assert_equal(1e300, JSON.decode[Float]("1" + "0" * 300))
  end

  # #1129: a symbol literal written only in a standard-library module the
  # program loads (`std/test.qz`'s, in the set made at first use, #1097)
  # is a symbol of the program; the name is not written here.
  def test_a_std_modules_symbol_decodes
    assert_equal("omis" + "sion", JSON.decode[Symbol]("\"omission\"").to_s)
    assert_nil(JSON.decode?[Symbol]("\"zz_written_nowhere\""))
  end

  def depth(v: JSON::Value) -> Int
    case v
    in JSON::Value::Array(items) then 1 + (items.map { |x| depth(x) }.max || 0)
    in JSON::Value::Object(members) then 1 + (members.values.map { |x| depth(x) }.max || 0)
    else 0
    end
  end

  # `max_nesting:` (#974): arrays and objects count one level each, a
  # top-level scalar none; 1 to 100.
  def test_max_nesting
    assert_equal(1, JSON.parse("1", max_nesting: 1).as_i)
    assert_equal(1, JSON.parse("[1]", max_nesting: 1)[0].as_i)
    assert_equal(1, JSON.parse('{"a": 1}', max_nesting: 1)["a"].as_i)
    e = assert_raise(JSON::ParseError) { JSON.parse("[[1]]", max_nesting: 1) }
    assert_equal("nesting of 2 is too deep (max_nesting: 1) at line 1 column 2", e.message)
    assert_raise(JSON::ParseError) { JSON.parse('{"a": {"b": 1}}', max_nesting: 1) }
    assert_raise(JSON::ParseError) { JSON.parse('[{"a": 1}]', max_nesting: 1) }
    deep = "[" * 33 + "]" * 33
    assert_equal(1, JSON.parse("[" * 32 + "]" * 32, max_nesting: 32).size)
    e = assert_raise(JSON::ParseError) { JSON.parse(deep, max_nesting: 32) }
    assert_equal("nesting of 33 is too deep (max_nesting: 32) at line 1 column 33", e.message)
    # A later value under a repeated key is counted while it is read.
    assert_raise(JSON::ParseError) { JSON.parse('{"a": 1, "a": [[1]]}', max_nesting: 2) }
    [0, -1, 101].each do |n|
      e = assert_raise(ArgumentError) { JSON.parse("1", max_nesting: n) }
      assert_equal("max_nesting: 1 to 100, not #{n}", e.message)
    end

    assert_equal([[1]], JSON.decode[Array[Array[Int]]]("[[1]]", max_nesting: 2))
    assert_raise(JSON::ParseError) { JSON.decode[Array[Array[Int]]]("[[1]]", max_nesting: 1) }
    assert_nil(JSON.decode?[Array[Array[Int]]]("[[1]]", max_nesting: 1))
    assert_equal([[1]], JSON.decode?[Array[Array[Int]]]("[[1]]", max_nesting: 2))
    assert_raise(ArgumentError) { JSON.decode[Int]("1", max_nesting: 0) }
    assert_raise(ArgumentError) { JSON.decode?[Int]("1", max_nesting: 101) }
  end

  def test_nan
    e = assert_raise(JSON::GeneratorError) { JSON.generate(Float::NAN); nil }
    assert_equal("NaN not allowed in JSON", e.message)
  end

  def test_wrong_type
    doc = JSON.parse('{"name": "quarz"}')
    e = assert_raise(TypeError) { doc["name"].as_i; nil }
    assert_equal("not a JSON number: JSON::Value::String(value: \"quarz\")", e.message)
  end
end

class JsonDecodeTest < Test::Case
  def test_data_with_defaults_and_extra_keys
    args = JSON.decode[JsonTestArgs]('{"user_id": 42, "tags": ["a"], "other": {"x": 1}}')
    assert_equal(JsonTestArgs.new(user_id: 42, template: "welcome", tags: ["a"]), args)
  end

  def test_round_trip_of_every_kind
    all = JsonTestAll.new(
      i: -7, big: 123456789012345678901234567890, f: 2.5, s: "q\"é😀\n", b: true, sym: :sym, n: nil,
      opt: 3, none: nil, list: [1, 2], set: Set["a", "b"],
      by_s: { "x" => 1.5 }, by_sym: { k: [true, false] },
      at: Time.iso8601("2023-11-14T22:13:20.00000012Z"), raw: b"hi\x00\xff",
      doc: JSON.parse('{"z": [null]}'), pair: JsonTestPair[Int].new(a: 1, b: 2)
    )
    assert_equal(all, JSON.decode[JsonTestAll](JSON.generate(all)))
    assert_equal(all, JSON.decode[JsonTestAll](JSON.pretty_generate(all)))
  end

  def test_scalars_and_collections
    expected: Array[Int?] = [1, nil]
    assert_equal(expected, JSON.decode[Array[Int?]]("[1, null]"))
    assert_equal(2.0, JSON.decode[Float]("2"))
    assert_equal(:abc, JSON.decode[Symbol]('"abc"'))
    assert_equal(Set[1, 2], JSON.decode[Set[Int]]("[1, 2, 2]"))
    assert_equal({ "a" => [1] }, JSON.decode[Hash[String, Array[Int]]]('{"a": [1]}'))
    assert_equal(JsonTestPair[Float].new(a: 1.0, b: 2.5), JSON.decode[JsonTestPair[Float]]('{"a": 1, "b": 2.5}'))
  end

  def test_recursive_data
    node = JSON.decode[JsonTestNode]('{"name": "r", "kids": [{"name": "c"}]}')
    assert_equal(JsonTestNode.new(name: "r", kids: [JsonTestNode.new(name: "c", kids: [])]), node)
    assert_equal(node, JSON.decode[JsonTestNode](JSON.generate(node)))
  end

  def test_time_and_bytes_are_generated_to_be_read_back
    assert_equal("\"2023-11-14T22:13:20Z\"", JSON.generate(Time.at(1700000000)))
    assert_equal("\"2023-11-14T22:13:20.5Z\"", JSON.generate(Time.at(1700000000) + 500.ms))
    assert_equal("\"aGkA\"", JSON.generate(b"hi\x00"))
    assert_equal(Time.at(1700000000), JSON.decode[Time]('"2023-11-14T23:13:20+01:00"'))
  end

  def test_from_a_parsed_value
    doc = JSON.parse('{"job": {"user_id": 1}}')
    assert_equal(JsonTestArgs.new(user_id: 1), JSON.decode[JsonTestArgs](doc["job"]))
  end

  def test_own_initialize_does_not_run
    assert_equal(5, JSON.decode[JsonTestOwnInit]('{"x": 5}').x)
  end

  def test_errors_name_the_path
    e = assert_raise(JSON::DecodeError) { JSON.decode[JsonTestArgs]('{"user_id": 1, "tags": ["a", 3]}'); nil }
    assert_equal("$.tags[1]: expected a string, found 3", e.message)
    e = assert_raise(JSON::DecodeError) { JSON.decode[JsonTestArgs]('{"tags": []}'); nil }
    assert_equal("$: missing field `user_id` of JsonTestArgs", e.message)
    e = assert_raise(JSON::DecodeError) { JSON.decode[Array[JsonTestArgs]]('[{"user_id": null}]'); nil }
    assert_equal("$[0].user_id: expected an integer that fits an Int, found null", e.message)
    e = assert_raise(JSON::DecodeError) { JSON.decode[Int]("12345678901234567890123"); nil }
    assert_equal("$: expected an integer that fits an Int, found 12345678901234567890123", e.message)
    e = assert_raise(JSON::DecodeError) { JSON.decode[Hash[String, Int]]('{"a b": {"c": 1}}'); nil }
    assert_equal("$[\"a b\"]: expected an integer that fits an Int, found an object", e.message)
    e = assert_raise(JSON::DecodeError) { JSON.decode[Time]('"yesterday"'); nil }
    assert_equal("$: expected an RFC 3339 time string, found \"yesterday\"", e.message)
    assert_raise(JSON::ParseError) { JSON.decode[Int]("[1,"); nil }
  end

  def test_decode_or_nil
    assert_nil(JSON.decode?[JsonTestArgs]("not json"))
    assert_nil(JSON.decode?[JsonTestArgs]("{}"))
    assert_equal(JsonTestArgs.new(user_id: 3), JSON.decode?[JsonTestArgs]('{"user_id": 3}'))
  end
end

class JsonDecodeUnionTest < Test::Case
  def test_the_kind_picks_the_member
    assert_equal(JsonTestOwner.new(owner: "x"), JSON.decode[JsonTestOwner]('{"owner": "x"}'))
    assert_equal(JsonTestOwner.new(owner: JsonTestRef.new(id: "r"), n: 2),
                 JSON.decode[JsonTestOwner]('{"owner": {"id": "r"}, "n": 2}'))
    five: Int | String | Bool | Array[Float] | Hash[String, Int] = 5
    assert_equal[Int | String | Bool | Array[Float] | Hash[String, Int]](five, JSON.decode[Int | String | Bool | Array[Float] | Hash[String, Int]]("5"))
    vals: Array[Int | String | Bool | Array[Float] | Hash[String, Int]] = [1, "s", true, [1.0, 2.5], { "k" => 1 }]
    assert_equal[Array[Int | String | Bool | Array[Float] | Hash[String, Int]]](vals, JSON.decode[Array[Int | String | Bool | Array[Float] | Hash[String, Int]]]('[1, "s", true, [1, 2.5], {"k": 1}]'))
  end

  def test_string_like_members
    t: Time | Int = Time.at(1700000000)
    assert_equal[Time | Int](t, JSON.decode[Time | Int]('"2023-11-14T22:13:20Z"'))
    sym: Symbol | Array[Int] = :abc
    assert_equal[Symbol | Array[Int]](sym, JSON.decode[Symbol | Array[Int]]('"abc"'))
    raw: Bytes | Bool = b"hi"
    assert_equal[Bytes | Bool](raw, JSON.decode[Bytes | Bool]('"aGk="'))
    big: Integer | String = 123456789012345678901234567890
    assert_equal[Integer | String](big, JSON.decode[Integer | String]("123456789012345678901234567890"))
  end

  def test_one_or_many
    one: String | Array[String] = "a"
    many: String | Array[String] = ["a", "b"]
    assert_equal[String | Array[String]](one, JSON.decode[String | Array[String]]('"a"'))
    assert_equal[String | Array[String]](many, JSON.decode[String | Array[String]]('["a", "b"]'))
  end

  def test_with_nil
    expected: Array[(String | JsonTestRef)?] = [nil, "a", JsonTestRef.new(id: "b")]
    assert_equal[Array[(String | JsonTestRef)?]](expected, JSON.decode[Array[(String | JsonTestRef)?]]('[null, "a", {"id": "b"}]'))
    h: Hash[Symbol, Int | Array[Int] | Nil] = { a: 1, b: [2], c: nil }
    assert_equal[Hash[Symbol, Int | Array[Int] | Nil]](h, JSON.decode[Hash[Symbol, Int | Array[Int] | Nil]]('{"a": 1, "b": [2], "c": null}'))
  end

  def test_through_a_generic_data_type
    assert_equal(JsonTestBox[Int].new(v: 1), JSON.decode[JsonTestBox[Int]]('{"v": 1}'))
    assert_equal(JsonTestBox[Int].new(v: [1, 2]), JSON.decode[JsonTestBox[Int]]('{"v": [1, 2]}'))
    assert_equal(JsonTestBox[JsonTestRef].new(v: [JsonTestRef.new(id: "a")]),
                 JSON.decode[JsonTestBox[JsonTestRef]]('{"v": [{"id": "a"}]}'))
  end

  def test_a_data_type_named_only_in_a_union
    v = JSON.decode[Int | JsonTestOnlyInUnion]('{"k": "a"}')
    assert_equal("JsonTestOnlyInUnion(k: \"a\")", v.inspect)
    assert_equal(JSON.generate(v), '{"k":"a"}')
  end

  def test_round_trip
    owners = [JsonTestOwner.new(owner: "x"), JsonTestOwner.new(owner: JsonTestRef.new(id: "r"), n: 3)]
    assert_equal[Array[JsonTestOwner]](owners, JSON.decode[Array[JsonTestOwner]](JSON.generate(owners)))
  end

  def test_errors_name_the_members
    e = assert_raise(JSON::DecodeError) { JSON.decode[JsonTestOwner]('{"owner": 1}'); nil }
    assert_equal("$.owner: expected a string or an object (for JsonTestRef), found 1", e.message)
    e = assert_raise(JSON::DecodeError) { JSON.decode[JsonTestOwner]('{"owner": null}'); nil }
    assert_equal("$.owner: expected a string or an object (for JsonTestRef), found null", e.message)
    e = assert_raise(JSON::DecodeError) { JSON.decode[Array[Time | Array[Int] | Bool]]('[true, 1]'); nil }
    assert_equal("$[1]: expected an RFC 3339 time string, a boolean or an array, found 1", e.message)
    e = assert_raise(JSON::DecodeError) { JSON.decode[Bool]("1"); nil }
    assert_equal("$: expected true or false, found 1", e.message)
    # (A member the kind picked fails with its own error.)
    e = assert_raise(JSON::DecodeError) { JSON.decode[Time | Int]('"yesterday"'); nil }
    assert_equal("$: expected an RFC 3339 time string, found \"yesterday\"", e.message)
    e = assert_raise(JSON::DecodeError) { JSON.decode[Int | String]("1.5"); nil }
    assert_equal("$: expected an integer that fits an Int, found 1.5", e.message)
    e = assert_raise(JSON::DecodeError) { JSON.decode[JsonTestOwner]('{"owner": {"name": "r"}}'); nil }
    assert_equal("$.owner: missing field `id` of JsonTestRef", e.message)
  end

  def test_decode_or_nil_on_a_kind_no_member_takes
    assert_nil(JSON.decode?[String | JsonTestRef]("1"))
    assert_nil(JSON.decode?[String | JsonTestRef]("null"))
    assert_equal[String | JsonTestRef]("a", JSON.decode?[String | JsonTestRef]('"a"'))
  end
end
