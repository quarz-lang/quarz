# raise, rescue, else, ensure, retry and exception classes.

class ExcTestError < StandardError
  @code: Int
  attr_reader :code
  def initialize(message: String, @code: Int)
    super(message)
  end
end

class ExceptionTest < Test::Case
  var @log: Array[String] = []

  def record(s: String) -> Nil
    @log = @log.push(s)
    nil
  end

  def test_rescue_picks_matching_clause_then_ensure
    begin
      raise ArgumentError, "bad"
    rescue TypeError
      record("type")
    rescue ArgumentError => e
      record("arg: #{e.message}")
    ensure
      record("ensure")
    end
    assert_equal(["arg: bad", "ensure"], @log)
  end

  def test_custom_exception_class
    rescued = false
    begin
      raise ExcTestError.new("boom", 7)
    rescue ExcTestError => e
      rescued = true
      assert_equal("boom", e.message)
      assert_equal(7, e.code)
      assert_equal("ExcTestError", e.class.name)
      assert_true(e.is_a?(StandardError))
    end
    assert_true(rescued)
  end

  def test_retry
    tries = 0
    begin
      tries += 1
      raise "fail" if tries < 3
      record("ok after #{tries}")
    rescue
      retry
    end
    assert_equal(["ok after 3"], @log)
  end

  def test_rescue_value
    x = begin
      Integer("zz")
    rescue ArgumentError
      -1
    end
    assert_equal(-1, x)
    y = Integer("zz") rescue -2
    assert_equal(-2, y)
  end

  def returns_with_ensure -> Int
    return 1
  ensure
    record("cleanup")
  end

  def test_ensure_runs_before_return
    r = returns_with_ensure
    record(r.to_s)
    assert_equal(["cleanup", "1"], @log)
  end

  def test_else_runs_when_nothing_raised
    begin
      record("body")
    rescue
      record("never")
    else
      record("else")
    ensure
      record("ensure")
    end
    assert_equal(["body", "else", "ensure"], @log)
  end

  def risky -> Nil
    raise KeyError, "k"
  end

  def test_rescue_superclass
    caught: String? = nil
    begin
      risky
    rescue IndexError => e
      caught = "caught #{e.class.name}: #{e.message}"
    end
    assert_equal("caught KeyError: k", caught)
  end

  def test_index_and_key_errors
    r = [1, 2, 3].first(2)
    e = assert_raise(IndexError) { puts [1][5]; nil }
    assert_equal("index 5 out of bounds (size 1)", e.message)
    k = assert_raise(KeyError) { _v = { a: 1 }[:b]; nil }
    assert_equal("key not found: :b", k.message)
    assert_equal("[1, 2]", r.inspect)
  end
end

# The exception being rescued becomes the cause of one raised (or rescued
# again) in the clause, as Ruby's `$!`.
class ExceptionCauseTest < Test::Case
  def caught(&: () -> Nil) -> Exception
    begin
      yield
    rescue Exception => e
      return e
    end
    raise "nothing raised"
  end

  def test_raised_in_a_clause
    e = caught do
      begin
        raise ArgumentError, "inner"
      rescue
        raise "outer"
      end
    end
    assert_equal("outer", e.message)
    assert_equal("#<ArgumentError: inner>", e.cause.inspect)
  end

  def test_a_native_raising_in_a_clause
    e = caught do
      begin
        raise ArgumentError, "a"
      rescue
        _ = Integer("x")
        nil
      end
    end
    assert_equal("#<ArgumentError: a>", e.cause.inspect)
  end

  def test_rescued_inside_a_clause
    got = ""
    begin
      raise ArgumentError, "a"
    rescue
      begin
        raise "b"
      rescue => b
        got = b.cause.inspect
      end
    end
    assert_equal("#<ArgumentError: a>", got)
  end

  def test_chains_and_raising_again
    e = caught do
      begin
        begin
          raise "1"
        rescue
          raise "2"
        end
      rescue
        raise "3"
      end
    end
    c = e.cause
    assert_equal("2", c ? c.message : "")
    assert_equal("#<RuntimeError: 1>", c&.cause.inspect)
    same = caught do
      begin
        raise ArgumentError, "same"
      rescue => x
        raise x
      end
    end
    assert_nil(same.cause)
    bare = caught do
      begin
        raise ArgumentError, "bare"
      rescue
        raise
      end
    end
    assert_nil(bare.cause)
    assert_nil(caught { raise "plain" }.cause)
  end
end

# `exit` raises SystemExit, which a plain rescue lets through.
class SystemExitTest < Test::Case
  def test_rescued
    status = begin
      exit 3
    rescue SystemExit => e
      e.status
    end
    assert_equal(3, status)
  end

  def test_not_a_standard_error
    through = false
    begin
      begin
        exit 0
      rescue
        flunk("a plain rescue caught SystemExit")
      end
    rescue SystemExit => e
      through = e.success?
    end
    assert_true(through)
  end

  def test_made
    e = SystemExit.new(2, "stop")
    assert_equal(2, e.status)
    assert_equal("stop", e.message)
    assert_false(e.success?)
    assert_equal("exit", SystemExit.new.message)
  end
end

# A NaN or an infinity has no integer, as in Ruby.
class FloatDomainErrorTest < Test::Case
  def test_raised
    e = assert_raise(FloatDomainError) { _ = Float::NAN.to_i; nil }
    assert_equal("NaN", e.message)
    assert_raise(RangeError) { _ = Float::INFINITY.round; nil }
    assert_raise(FloatDomainError) { _ = (-Float::INFINITY).floor; nil }
  end
end
