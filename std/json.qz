# JSON: parsing into `JSON::Value` and generation from any value.
#
# ```
# require "json"
# doc = JSON.parse('{"name": "quarz", "tags": ["lang", "vm"]}')
# doc["name"].as_s                          # => "quarz"
# doc["tags"][1].as_s                       # => "vm"
# doc["missing"]                            # raises KeyError
# JSON.generate({ a: 1, b: [true, nil] })   # => "{\"a\":1,\"b\":[true,null]}"
# ```
#
# `JSON.generate` accepts `nil`, booleans, numbers, strings, symbols, arrays,
# hashes, sets, `data` values and `JSON::Value`. Other objects are
# generated from their fields, unless they define `to_json -> String`.
module JSON
  # The version of the library.
  VERSION = "0.1.0"

  # Raised by `JSON.parse` on malformed input; the message gives the line
  # and column.
  class ParseError < StandardError
  end

  # Raised by `JSON.generate` on a value JSON cannot represent, such as a
  # `Float` infinity or NaN.
  #
  # ```
  # JSON.generate(1.0 / 0.0)   # raises JSON::GeneratorError
  # ```
  class GeneratorError < StandardError
  end

  # A parsed JSON document, its variants named as Rust's serde_json
  # names them. A `Number` holds any number: an `Int`, an `Integer` when
  # too large for an `Int` (kept exact), or a `Float` when it has a
  # fraction or an exponent. Inside the enum the names are the variants:
  # the types are `::Bool`, `::String` and so on.
  enum Value
    # JSON `null`.
    variant Null
    # JSON `true` or `false`.
    variant Bool(value: ::Bool)
    # A JSON number: an `Int`, an `Integer` when too large for an `Int`, or
    # a `Float` when it has a fraction or an exponent.
    variant Number(value: ::Int | ::Integer | ::Float)
    # A JSON string.
    variant String(value: ::String)
    # A JSON array.
    variant Array(items: ::Array[Value])
    # A JSON object, its members in document order.
    variant Object(members: ::Hash[::String, Value])

    # Whether the value is `Null`.
    def null? -> ::Bool
      case self
      in Null then true
      else false
      end
    end

    # Whether the value is a `Bool`.
    def bool? -> ::Bool
      case self
      in Bool then true
      else false
      end
    end

    # Whether the value is a `Number`.
    def number? -> ::Bool
      case self
      in Number then true
      else false
      end
    end

    # Whether the value is a `String`.
    def string? -> ::Bool
      case self
      in String then true
      else false
      end
    end

    # Whether the value is an `Array`.
    def array? -> ::Bool
      case self
      in Array then true
      else false
      end
    end

    # Whether the value is an `Object`.
    def object? -> ::Bool
      case self
      in Object then true
      else false
      end
    end

    # The member named `key` of an object.
    #
    # ## Raises
    #
    # `KeyError` when the object has no such member, `TypeError` when the
    # value is not an `Object`.
    def [](key: ::String) -> Value
      case self
      in Object(members:) then members[key]
      else raise TypeError, "not a JSON object: #{inspect}"
      end
    end

    # The element at `index` of an array; a negative `index` counts from
    # the end.
    #
    # ## Raises
    #
    # `IndexError` when `index` is out of range, `TypeError` when the
    # value is not an `Array`.
    #
    # ```
    # JSON.parse("[1, 2]")[-1]   # => JSON::Value::Number(value: 2)
    # JSON.parse("[1, 2]")[5]    # raises IndexError
    # ```
    def [](index: ::Int) -> Value
      case self
      in Array(items:) then items[index]
      else raise TypeError, "not a JSON array: #{inspect}"
      end
    end

    # Member of an object, or `nil` when it is missing or the value is not
    # an `Object`.
    #
    # ```
    # doc = JSON.parse('{"a": 1}')
    # doc["a"]?          # => JSON::Value::Number(value: 1)
    # doc["b"]?          # => nil
    # doc[0]?            # => nil
    # ```
    def []?(key: ::String) -> Value?
      case self
      in Object(members:) then members[key]?
      else nil
      end
    end

    # Element of an array, or `nil` when out of range or the value is not an
    # `Array`. A negative `index` counts from the end.
    def []?(index: ::Int) -> Value?
      case self
      in Array(items:) then items[index]?
      else nil
      end
    end

    # The boolean of a `Bool`; raises `TypeError` on any other value.
    def as_bool -> ::Bool
      case self
      in Bool(value:) then value
      else raise TypeError, "not a JSON boolean: #{inspect}"
      end
    end

    # The number as an `Int` (a `Float` truncated); `OverflowError` when
    # it does not fit.
    def as_i -> ::Int
      case self
      in Number(value:) then value.to_i
      else raise TypeError, "not a JSON number: #{inspect}"
      end
    end

    # The number as an `Integer`, exact whatever its size (a `Float`
    # truncated).
    def as_integer -> ::Integer
      case self
      in Number(value:) then JSON.integer_of(value)
      else raise TypeError, "not a JSON number: #{inspect}"
      end
    end

    # The number as a `Float`; raises `TypeError` on anything but a
    # `Number`.
    def as_f -> ::Float
      case self
      in Number(value:) then value.to_f
      else raise TypeError, "not a JSON number: #{inspect}"
      end
    end

    # The string of a `String`; raises `TypeError` on any other value.
    def as_s -> ::String
      case self
      in String(value:) then value
      else raise TypeError, "not a JSON string: #{inspect}"
      end
    end

    # The elements of an `Array`; raises `TypeError` on any other value.
    def as_a -> ::Array[Value]
      case self
      in Array(items:) then items
      else raise TypeError, "not a JSON array: #{inspect}"
      end
    end

    # The members of an `Object`; raises `TypeError` on any other value.
    def as_h -> ::Hash[::String, Value]
      case self
      in Object(members:) then members
      else raise TypeError, "not a JSON object: #{inspect}"
      end
    end

    # The boolean of a `Bool`, or `nil` for any other value.
    def as_bool? -> ::Bool?
      case self
      in Bool(value:) then value
      else nil
      end
    end

    # The number as an `Int` (a `Float` truncated), or `nil` when the value
    # is not a `Number`. A number too large for an `Int` still raises
    # `OverflowError`.
    #
    # ```
    # JSON.parse("2.5").as_i?     # => 2
    # JSON.parse('"2"').as_i?     # => nil
    # ```
    def as_i? -> ::Int?
      case self
      in Number(value:) then value.to_i
      else nil
      end
    end

    # The number as an `Integer` (a `Float` truncated), or `nil` when the
    # value is not a `Number`.
    def as_integer? -> ::Integer?
      case self
      in Number(value:) then JSON.integer_of(value)
      else nil
      end
    end

    # The number as a `Float`, or `nil` when the value is not a `Number`.
    def as_f? -> ::Float?
      case self
      in Number(value:) then value.to_f
      else nil
      end
    end

    # The string of a `String`, or `nil` for any other value.
    def as_s? -> ::String?
      case self
      in String(value:) then value
      else nil
      end
    end

    # The elements of an `Array`, or `nil` for any other value.
    def as_a? -> ::Array[Value]?
      case self
      in Array(items:) then items
      else nil
      end
    end

    # The members of an `Object`, or `nil` for any other value.
    def as_h? -> ::Hash[::String, Value]?
      case self
      in Object(members:) then members
      else nil
      end
    end

    # The number of elements of an array or members of an object.
    #
    # ## Raises
    #
    # `TypeError` for any other value.
    def size -> ::Int
      case self
      in Array(items:) then items.size
      in Object(members:) then members.size
      else raise TypeError, "not a JSON array or object: #{inspect}"
      end
    end

    # The compact JSON text of the value, as `JSON.generate` gives it.
    #
    # ```
    # JSON.parse("[1, true, null]").to_json   # => "[1,true,null]"
    # ```
    def to_json -> ::String = JSON.generate(self)

    # The compact JSON text of the value, as `#to_json`.
    def to_s -> ::String = to_json
  end

  # :nodoc:
  # A JSON number as an `Integer` (a `Float` truncated).
  def self.integer_of(n: Int | Integer | Float) -> Integer
    case n
    in Int then n.to_integer
    in Integer then n
    in Float then n.to_i.to_integer
    end
  end

  # The JSON document `text` as a `JSON::Value`; whitespace around the
  # value is allowed.
  #
  # ## Raises
  #
  # `JSON::ParseError` on malformed input (anything but one value
  # included), with the line and column in its message.
  #
  # ```
  # JSON.parse(" null ")       # => JSON::Value::Null
  # JSON.parse("[1,")          # raises JSON::ParseError
  # JSON.parse("1 2")          # raises JSON::ParseError
  # ```
  native def self.parse(text: String) -> Value

  # The compact JSON text of a value.
  native def self.generate(value: Object) -> String

  # Indented JSON text (two spaces per level).
  native def self.pretty_generate(value: Object) -> String

  # The compact JSON text of a value: `JSON.generate` under Ruby's other
  # name.
  def self.dump(value: Object) -> String = generate(value)

  # Parses a document: `JSON.parse` under Ruby's other name.
  def self.load(text: String) -> Value = parse(text)
end
