# Cryptography: `require "crypto"`. RSA keys (PEM and DER, PKCS#8, PKCS#1
# and SPKI) and signatures (PKCS#1 v1.5 and PSS), as HTTP Signatures, JWT
# RS256 and webhook signatures need; AES-GCM, to encrypt a secret at rest
# or seal a cookie; argon2id ([Crypto::Argon2]), to store passwords; and
# [Crypto.random_bytes], for keys and nonces.
#
# ```
# require "crypto"
# key = Crypto::RSA::PrivateKey.from_pem(File.read("std/test/fixtures/crypto/rsa2048_pkcs8.pem"))
# sig = key.sign("hello", :sha256)
# key.public_key.verify("hello", sig, :sha256)   # => true
# key.public_key.verify("hullo", sig, :sha256)   # => false
# ```
#
# Keys are `data` values holding their DER, so they are immutable and
# Shareable, and two readings of one key are `==`; their `inspect` and
# `to_s` never show the key. The runtime keeps the keys it parsed (by
# contents), so signing again with one key does not parse it again.
# Keys of 1024 to 8192 bits are read (`generate` makes 2048 to 4096).
# There is no RSA encryption, no encrypted PEM, no EC or Ed25519 key, no
# other cipher mode (CBC, CTR), and no key derivation but
# [Digest::PBKDF2] (argon2id makes password hashes, not keys) yet.
module Crypto
  # A key that does not parse, is of another kind, or is too small; a
  # PEM text that is not one key.
  class Error < StandardError
  end

  # Data that did not authenticate: the key, the nonce or the associated
  # data is not the one it was sealed with, or the data was changed. The
  # message never includes the data.
  class AuthenticationError < Error
  end

  # `n` bytes (0 to 1 MiB, [ArgumentError] otherwise) from the operating
  # system's cryptographic random source (`getrandom`): for keys, nonces
  # and tokens; [Crypto::Error] if that source fails. Not a replacement
  # for [Random], which is reproducible.
  #
  # ```
  # Crypto.random_bytes(16).size                               # => 16
  # Crypto.random_bytes(16) == Crypto.random_bytes(16)         # => false
  # ```
  native def self.random_bytes(n: Int) -> Bytes

  # Whether `a` and `b` hold the same bytes, a [String] compared as its
  # UTF-8 bytes (so `"ab"` equals `b"ab"`). For a token, a MAC or a digest
  # received, compared with the one expected.
  #
  # When the lengths are equal, the time taken does not depend on the
  # contents: not on where the first difference is, nor on whether there
  # is one (`==` stops at the first difference, which shows through
  # timing). Different lengths answer `false` at once, so the length is
  # not hidden: compare values of a fixed length, such as digests.
  #
  # ```
  # Crypto.secure_compare("token", "token")    # => true
  # Crypto.secure_compare("token", "tokeN")    # => false
  # Crypto.secure_compare("ab", b"ab")         # => true
  # Crypto.secure_compare("ab", "abc")         # => false
  # ```
  native def self.secure_compare(a: Bytes | String, b: Bytes | String) -> Bool

  # [n] bytes (0 to 1 MiB, [ArgumentError] otherwise) from the
  # operating system's cryptographic random source, as [random_bytes]
  # draws them, straight into a [Bytes::Secret]: no [Bytes] of them is
  # made.
  #
  # ```
  # Crypto.random_secret(32).size    # => 32
  # ```
  native def self.random_secret(n: Int) -> Bytes::Secret

  # AES, in its authenticated mode GCM.
  module AES
    # AES-GCM with one key: authenticated encryption, which keeps data
    # secret and detects any change to it. The key is held natively
    # (#963): never as a [Bytes] in the value, cleared when the last
    # reference goes or wiped, shown by [inspect] and [to_s] only by its
    # size; [export_key] gives it as a [Bytes::Secret], asked for
    # explicitly. Immutable but for [wipe], and Shareable: tasks hold the
    # same key, never a copy.
    #
    # [wipe] ends the key for every holder at once: [wiped?] is true at
    # once, and every later use but [bits] and [wiped?] raises
    # [Bytes::Secret::WipedError]. Its memory is cleared at once, or,
    # while a [seal] or [open] begun before on another worker is still
    # running, when that one ends (it completes with the whole key), never
    # later.
    #
    # ```
    # aead = Crypto::AES::GCM.generate(256)
    # token = aead.encrypt("a secret", aad: "user 42")
    # aead.decrypt(token, aad: "user 42").decode   # => "a secret"
    # aead.decrypt(token, aad: "user 43")          # raises Crypto::AuthenticationError
    # aead.inspect                                 # => "#<Crypto::AES::GCM 256 bits>"
    # ```
    #
    # A nonce must never be used twice with one key: that is the one way
    # to break GCM. [encrypt] draws a random 12-byte nonce each time and
    # puts it in front of what it returns, which is safe for about 2^32
    # messages per key; past that, rotate the key, or give [seal] a
    # counter as the nonce. [seal] and [open] are for protocols that fix
    # the nonce (a counter, one from the peer).
    class GCM
      include Shareable

      # The key: 16, 24 or 32 bytes (AES-128, -192, -256), [ArgumentError]
      # otherwise. A [Bytes::Secret] key is read without a copy that stays;
      # a [Bytes] one stays as it is.
      native def self.new(key: Bytes | Bytes::Secret) -> GCM

      # A fresh random key of [bits] bits: 128, 192 or 256.
      def self.generate(bits: Int = 256) -> GCM
        unless bits == 128 || bits == 192 || bits == 256
          raise ArgumentError, "an AES key has 128, 192 or 256 bits, not #{bits}"
        end
        GCM.new(Crypto.random_secret(bits / 8))
      end

      # The key's size in bits, wiped or not.
      native def bits -> Int

      # `plaintext` encrypted with `nonce` (12 bytes, used once with this
      # key; [ArgumentError] for another length), followed by the 16-byte
      # tag that authenticates it and `aad` (associated data:
      # authenticated, not encrypted, and not included).
      native def seal(nonce: Bytes, plaintext: Bytes | String, *, aad: Bytes | String = "") -> Bytes

      # The plaintext of `sealed` (what [seal] gave for `nonce` and `aad`);
      # [Crypto::AuthenticationError] when it does not authenticate, and
      # then nothing of it is returned.
      def open(nonce: Bytes, sealed: Bytes, *, aad: Bytes | String = "") -> Bytes
        opened = open?(nonce, sealed, aad: aad)
        raise AuthenticationError, "the data did not authenticate" if opened.nil?
        opened
      end

      # As [open], nil instead of raising: for a caller to whom a bad
      # token is a normal case (an expired cookie).
      native def open?(nonce: Bytes, sealed: Bytes, *, aad: Bytes | String = "") -> Bytes?

      # As [open], the plaintext as a [Bytes::Secret]: decrypted into the
      # secret's own buffer, with no [Bytes] of it made. For key material
      # sealed under this key (a data key, a private key's DER).
      #
      # ```
      # gcm = Crypto::AES::GCM.new(Bytes.from((0...32).to_a))
      # nonce = Bytes.from((0...12).to_a)
      # gcm.open_secret(nonce, gcm.seal(nonce, "key")) == Bytes::Secret.of(b"key")   # => true
      # ```
      def open_secret(nonce: Bytes, sealed: Bytes, *, aad: Bytes | String = "") -> Bytes::Secret
        opened = open_secret?(nonce, sealed, aad: aad)
        raise AuthenticationError, "the data did not authenticate" if opened.nil?
        opened
      end

      # As [open_secret], nil instead of raising.
      native def open_secret?(nonce: Bytes, sealed: Bytes, *, aad: Bytes | String = "") -> Bytes::Secret?

      # `plaintext` sealed with a fresh random nonce: the nonce (12
      # bytes), the ciphertext and the tag (16 bytes), as one [Bytes] to
      # store or send.
      def encrypt(plaintext: Bytes | String, *, aad: Bytes | String = "") -> Bytes
        nonce = Crypto.random_bytes(12)
        nonce + seal(nonce, plaintext, aad: aad)
      end

      # The plaintext of `token` (what [encrypt] gave for `aad`);
      # [Crypto::AuthenticationError] when it does not authenticate.
      def decrypt(token: Bytes, *, aad: Bytes | String = "") -> Bytes
        opened = token.size < 28 ? nil : open?(token.slice(0, 12), token.slice(12, token.size - 12), aad: aad)
        raise AuthenticationError, "the data did not authenticate" if opened.nil?
        opened
      end

      # As [decrypt], the plaintext as a [Bytes::Secret] ([open_secret]).
      def decrypt_secret(token: Bytes, *, aad: Bytes | String = "") -> Bytes::Secret
        opened = token.size < 28 ? nil : open_secret?(token.slice(0, 12), token.slice(12, token.size - 12), aad: aad)
        raise AuthenticationError, "the data did not authenticate" if opened.nil?
        opened
      end

      # The key, as a [Bytes::Secret]: asked for explicitly.
      native def export_key -> Bytes::Secret

      # Ends the key for every holder (above). Wiping again does nothing.
      native def wipe -> Void

      # Whether it was wiped.
      native def wiped? -> Bool

      # Whether [other] is an AES key of the same bytes, compared in
      # constant time. Raises [Bytes::Secret::WipedError] when either was
      # wiped.
      native def ==(other: Object) -> Bool

      # `#<Crypto::AES::GCM 256 bits>`: never the key.
      def inspect -> String = "#<Crypto::AES::GCM #{bits} bits>"

      # :ditto:
      def to_s -> String = inspect
    end
  end

  # argon2id password hashes (RFC 9106), through the RustCrypto `argon2`
  # crate: what a server stores for a password, as a PHC string such as
  # `$argon2id$v=19$m=19456,t=2,p=1$<salt>$<hash>` (the salt and the
  # 32-byte hash in unpadded Base64), which names its parameters, so that
  # stored hashes stay readable when the parameters change.
  #
  # ```
  # hash = Crypto::Argon2.hash("correct horse")
  # hash.start_with?("$argon2id$v=19$m=19456,t=2,p=1$")   # => true
  # Crypto::Argon2.verify?("correct horse", hash)         # => true
  # Crypto::Argon2.verify?("wrong horse", hash)           # => false
  # Crypto::Argon2.needs_rehash?(hash)                    # => false
  # ```
  #
  # A hash with `Params::DEFAULT` takes tens of milliseconds and 19 MiB
  # (`memory_kib`), on a helper thread: only the calling task waits. Each
  # hash at once holds its memory, so a server that hashes many passwords
  # at once (logins) should bound how many it runs together.
  #
  # Only argon2id, version 19, without a secret or associated data:
  # `verify?` refuses argon2i and argon2d hashes. bcrypt and scrypt are
  # not here; [Digest::PBKDF2] is, where PBKDF2 is required.
  module Argon2
    # The cost of a hash: [memory_kib] KiB of memory, [iterations] passes
    # over it, [parallelism] lanes. A `data` value: immutable and
    # Shareable.
    #
    # ```
    # p = Crypto::Argon2::Params.new(memory_kib: 47_104, iterations: 1, parallelism: 1)
    # p.inspect                                             # => "#<Crypto::Argon2::Params m=47104 t=1 p=1>"
    # Crypto::Argon2::Params::DEFAULT.memory_kib            # => 19456
    # ```
    data Params(
      # The memory in KiB: 8 to 4_194_304 (4 GiB), and at least
      # 8 * [parallelism].
      memory_kib: Int,
      # The passes: 1 to 2^32 - 1.
      iterations: Int,
      # The lanes: 1 to 255. (They are computed one after the other: the
      # hash runs on one thread.)
      parallelism: Int
    )
      # Raises [ArgumentError] for a parameter outside its bounds.
      def initialize(memory_kib: Int, iterations: Int, parallelism: Int)
        unless memory_kib >= 8 && memory_kib <= 4_194_304
          raise ArgumentError, "memory_kib: 8 to 4194304, not #{memory_kib}"
        end
        unless iterations >= 1 && iterations <= 4_294_967_295
          raise ArgumentError, "iterations: 1 to 4294967295, not #{iterations}"
        end
        unless parallelism >= 1 && parallelism <= 255
          raise ArgumentError, "parallelism: 1 to 255, not #{parallelism}"
        end
        if memory_kib < 8 * parallelism
          raise ArgumentError, "memory_kib must be at least 8 * parallelism (#{8 * parallelism}), not #{memory_kib}"
        end
        @memory_kib = memory_kib
        @iterations = iterations
        @parallelism = parallelism
      end

      # OWASP's first recommended setting: m=19456 (19 MiB), t=2, p=1.
      DEFAULT = Params.new(19_456, 2, 1)

      # The parameters of the argon2id PHC string [hash];
      # [Crypto::Error] when it is not one (another scheme, another
      # version, a string that does not parse).
      def self.of(hash: String) -> Params
        found = Argon2.params_with(hash)
        raise Error, "not an argon2id hash" if found.nil?
        Params.new(found[0], found[1], found[2])
      end

      # `#<Crypto::Argon2::Params m=19456 t=2 p=1>`.
      def inspect -> String = "#<Crypto::Argon2::Params m=#{memory_kib} t=#{iterations} p=#{parallelism}>"

      # :ditto:
      def to_s -> String = inspect
    end

    # The argon2id PHC string of `password` with `params`, and `salt`
    # (16 to 48 bytes, [ArgumentError] otherwise), a fresh random 16 bytes
    # unless given. Two hashes of one password differ by their salts.
    # A [Bytes::Secret] password is read without a copy that stays (a
    # wiped one raises [Bytes::Secret::WipedError]).
    #
    # ```
    # salt = Bytes.from((0...16).to_a)
    # cheap = Crypto::Argon2::Params.new(memory_kib: 64, iterations: 1, parallelism: 1)
    # Crypto::Argon2.hash("pw", params: cheap, salt: salt) == Crypto::Argon2.hash("pw", params: cheap, salt: salt)   # => true
    # ```
    def self.hash(password: String | Bytes | Bytes::Secret, params: Params = Params::DEFAULT, salt: Bytes? = nil) -> String
      s = salt || Crypto.random_bytes(16)
      unless s.size >= 16 && s.size <= 48
        raise ArgumentError, "an argon2 salt has 16 to 48 bytes, not #{s.size}"
      end
      hash_with(password, s, params.memory_kib, params.iterations, params.parallelism)
    end

    # Whether `password` is the one `hash` (an argon2id PHC string, with
    # the parameters it names) was made of: false for a wrong password,
    # and the comparison takes the same time wherever they differ.
    # [Crypto::Error] for a string that is not an argon2id `v=19` hash
    # (another scheme or variant, another version, a parameter other than
    # m, t and p, one out of [Params]'s bounds, a string that does not
    # parse), so that stored garbage is noticed rather than taken for a
    # wrong password; its message never includes the password. Runs on a
    # helper thread, as `hash` does. A [Bytes::Secret] password is read as
    # by [hash].
    def self.verify?(password: String | Bytes | Bytes::Secret, hash: String) -> Bool = verify_with(password, hash)

    # Whether `hash` should be made again with `params`, the next time
    # the password is at hand (after `verify?` succeeds): true when one of
    # its parameters is below `params`'s, and for a string of another
    # scheme (a `$pbkdf2-sha256$` one, argon2i), so that a caller rehashes
    # whatever it finds. [Crypto::Error] for an argon2id string that does
    # not parse.
    #
    # ```
    # old = "$argon2id$v=19$m=4096,t=3,p=1$c2FsdHNhbHRzYWx0c2FsdA$fxbFVdPGPQ1NJoy87CaTabyrXOKZepZ9SGBFwPkPJ28"
    # Crypto::Argon2.needs_rehash?(old)                                  # => true
    # Crypto::Argon2.needs_rehash?(old, Crypto::Argon2::Params.of(old))  # => false
    # Crypto::Argon2.needs_rehash?("$pbkdf2-sha256$...")                 # => true
    # ```
    def self.needs_rehash?(hash: String, params: Params = Params::DEFAULT) -> Bool
      found = params_with(hash)
      return true if found.nil?
      found[0] < params.memory_kib || found[1] < params.iterations || found[2] < params.parallelism
    end

    # :nodoc:
    # The PHC string of `password` (on a helper thread).
    native def self.hash_with(password: String | Bytes | Bytes::Secret, salt: Bytes, memory_kib: Int, iterations: Int, parallelism: Int) -> String
    # :nodoc:
    # Whether `password` matches `hash` (on a helper thread).
    native def self.verify_with(password: String | Bytes | Bytes::Secret, hash: String) -> Bool
    # :nodoc:
    # `[memory_kib, iterations, parallelism]` of an argon2id hash; nil for
    # another scheme.
    native def self.params_with(hash: String) -> Array[Int]?
  end

  # RSA keys and signatures, through the RustCrypto `rsa` crate. A hash
  # is named by a symbol: `:sha256`, `:sha384` or `:sha512`
  # ([ArgumentError] otherwise).
  module RSA
    # An RSA private key, held natively (#963): parsed once, never as a
    # [Bytes] in the value, cleared when the last reference goes or wiped;
    # [inspect] and [to_s] show its size only. [export_der] and
    # [export_pem] give it as a [Bytes::Secret], asked for explicitly.
    # Immutable but for [wipe], and Shareable: tasks hold the same key,
    # never a copy.
    #
    # [wipe] ends the key for every holder at once: [wiped?] is true at
    # once, and every later use but [bits] and [wiped?] raises
    # [Bytes::Secret::WipedError]. Its memory is cleared at once, or,
    # while a [sign] begun before on another worker is still running, when
    # that one ends (it completes with the whole key), never later.
    #
    # ```quarz no_run
    # key = Crypto::RSA::PrivateKey.generate(2048)
    # File.write("key.pem", key.export_pem.expose_bytes)
    # File.write("key.pub.pem", key.public_key.to_pem)
    # ```
    class PrivateKey
      include Shareable

      # The key in [der]: PKCS#8 or PKCS#1 ([Crypto::Error] otherwise, as
      # for a key of another kind or size). A [Bytes::Secret] is read
      # without a copy that stays; a [Bytes] stays as it is.
      native def self.new(der: Bytes | Bytes::Secret) -> PrivateKey

      # A new key of [bits] bits: 2048, 3072 or 4096 ([ArgumentError]
      # otherwise). It is made on a helper thread: only the calling task
      # waits (hundreds of milliseconds for 4096 bits).
      def self.generate(bits: Int = 2048) -> PrivateKey
        unless bits == 2048 || bits == 3072 || bits == 4096
          raise ArgumentError, "an RSA key has 2048, 3072 or 4096 bits, not #{bits}"
        end
        generate_with(bits)
      end

      # The key in `pem`: one PKCS#8 (`PRIVATE KEY`) or PKCS#1
      # (`RSA PRIVATE KEY`) block, alone but for whitespace, not encrypted
      # ([Crypto::Error] otherwise, as for a key of another kind or size).
      # A [Bytes::Secret] is read without a copy that stays.
      #
      # ```
      # pem = File.read("std/test/fixtures/crypto/rsa2048_pkcs1.pem")
      # Crypto::RSA::PrivateKey.from_pem(pem).bits   # => 2048
      # ```
      native def self.from_pem(pem: String | Bytes | Bytes::Secret) -> PrivateKey

      # The key in [der]: PKCS#8 or PKCS#1 (as [new]).
      def self.from_der(der: Bytes | Bytes::Secret) -> PrivateKey = PrivateKey.new(der)

      # The key as PKCS#8 DER, in a [Bytes::Secret]: asked for explicitly.
      native def export_der -> Bytes::Secret

      # The key as PEM text, in a [Bytes::Secret]: PKCS#8
      # (`PRIVATE KEY`), or PKCS#1 (`RSA PRIVATE KEY`) with
      # `format: :pkcs1`. `export_pem.expose_bytes` is the text as
      # [Bytes], which nothing clears.
      native def export_pem(format: Symbol = :pkcs8) -> Bytes::Secret

      # The public half.
      def public_key -> PublicKey = PublicKey.new(public_der)

      # The modulus's size in bits, wiped or not.
      native def bits -> Int

      # The RSASSA-PKCS1-v1_5 signature of `data` with [hash].
      native def sign(data: Bytes | String, hash: Symbol) -> Bytes

      # The RSASSA-PSS signature of `data` with [hash] (MGF1 with the same
      # hash, a salt as long as the hash). Each signature differs: the
      # salt is random.
      native def sign_pss(data: Bytes | String, hash: Symbol) -> Bytes

      # Ends the key for every holder (above). Wiping again does nothing.
      native def wipe -> Void

      # Whether it was wiped.
      native def wiped? -> Bool

      # Whether [other] is the same private key, whatever it was read from
      # (PKCS#8 or PKCS#1, DER or PEM), its secret parts compared in
      # constant time. Raises [Bytes::Secret::WipedError] when either was
      # wiped.
      native def ==(other: Object) -> Bool

      # `#<Crypto::RSA::PrivateKey 2048 bits>`: never the key.
      def inspect -> String = "#<Crypto::RSA::PrivateKey #{bits} bits>"

      # :ditto:
      def to_s -> String = inspect

      private native def self.generate_with(bits: Int) -> PrivateKey
      private native def public_der -> Bytes
    end

    # An RSA public key.
    #
    # ```
    # pem = File.read("std/test/fixtures/crypto/rsa2048_spki.pem")
    # pub = Crypto::RSA::PublicKey.from_pem(pem)
    # pub.bits                  # => 2048
    # pub.fingerprint.size      # => 32
    # ```
    data PublicKey(
      # The key as SPKI DER, whatever it was read from.
      der: Bytes
    )
      # Raises [Crypto::Error] when [der] is not an RSA public key (SPKI
      # or PKCS#1); it is kept as SPKI.
      def initialize(der: Bytes)
        @der = RSA.public_der(der)
      end

      # The key in `pem`: one SPKI (`PUBLIC KEY`) or PKCS#1
      # (`RSA PUBLIC KEY`) block.
      def self.from_pem(pem: String | Bytes) -> PublicKey
        PublicKey.new(RSA.public_pem(pem.is_a?(String) ? pem.to_bytes : pem))
      end

      # The key in [der]: SPKI or PKCS#1.
      def self.from_der(der: Bytes) -> PublicKey = PublicKey.new(der)

      # The key as DER: SPKI.
      def to_der -> Bytes = der

      # The key as PEM: SPKI (`PUBLIC KEY`).
      native def to_pem -> String

      # The modulus's size in bits.
      native def bits -> Int

      # Whether `signature` is the RSASSA-PKCS1-v1_5 signature of `data`
      # with [hash]: false for any wrong signature, never an exception.
      native def verify(data: Bytes | String, signature: Bytes, hash: Symbol) -> Bool

      # Whether `signature` is the RSASSA-PSS signature of `data` with
      # [hash] (MGF1 with the same hash), whatever the salt's length: it
      # is read from the signature, as OpenSSL's saltlen:auto and Go's
      # PSSSaltLengthAuto verify. False for any wrong signature.
      native def verify_pss(data: Bytes | String, signature: Bytes, hash: Symbol) -> Bool

      # The SHA-256 of the SPKI DER: a key's identity, for key ids and
      # pinning.
      native def fingerprint -> Bytes

      # `#<Crypto::RSA::PublicKey 2048 bits, fingerprint ab12cd34…>`.
      def inspect -> String
        hex = fingerprint.slice(0, 4).to_a.map { |b| b.to_s(16).rjust(2, "0") }.join
        "#<Crypto::RSA::PublicKey #{bits} bits, fingerprint #{hex}…>"
      end

      # :ditto:
      def to_s -> String = inspect
    end

    # :nodoc:
    # `der` (SPKI or PKCS#1) as SPKI.
    native def self.public_der(der: Bytes) -> Bytes
    # :nodoc:
    # The one public key block of `pem`, as SPKI DER.
    native def self.public_pem(pem: Bytes) -> Bytes
  end
end
