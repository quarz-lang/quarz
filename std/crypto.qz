# Cryptography: `require "crypto"`. RSA keys (PEM and DER, PKCS#8, PKCS#1
# and SPKI) and signatures (PKCS#1 v1.5 and PSS), as HTTP Signatures, JWT
# RS256 and webhook signatures need; AES-GCM, to encrypt a secret at rest
# or seal a cookie; and `Crypto.random_bytes`, for keys and nonces.
#
# ```
# require "crypto"
# key = Crypto::RSA::PrivateKey.from_pem(File.read("std/test/fixtures/crypto/rsa2048_pkcs8.pem"))
# sig = key.sign("hello", :sha256)
# key.public_key.verify("hello", sig, :sha256)   # => true
# key.public_key.verify("hullo", sig, :sha256)   # => false
# ```
#
# Keys are `data` values holding their DER, so they are immutable and
# Shareable, and two readings of one key are `==`; their `inspect` and
# `to_s` never show the key. The runtime keeps the keys it parsed (by
# contents), so signing again with one key does not parse it again.
# Keys of 1024 to 8192 bits are read (`generate` makes 2048 to 4096).
# There is no RSA encryption, no encrypted PEM, no EC or Ed25519 key, no
# other cipher mode (CBC, CTR) and no key derivation but
# `Digest::PBKDF2` yet.
module Crypto
  # A key that does not parse, is of another kind, or is too small; a
  # PEM text that is not one key.
  class Error < StandardError
  end

  # Data that did not authenticate: the key, the nonce or the associated
  # data is not the one it was sealed with, or the data was changed. The
  # message never includes the data.
  class AuthenticationError < Error
  end

  # `n` bytes (0 to 1 MiB, `ArgumentError` otherwise) from the operating
  # system's cryptographic random source (`getrandom`): for keys, nonces
  # and tokens; `Crypto::Error` if that source fails. Not a replacement
  # for `Random`, which is reproducible.
  #
  # ```
  # Crypto.random_bytes(16).size                               # => 16
  # Crypto.random_bytes(16) == Crypto.random_bytes(16)         # => false
  # ```
  native def self.random_bytes(n: Int) -> Bytes

  # AES, in its authenticated mode GCM.
  module AES
    # AES-GCM with one key: authenticated encryption, which keeps data
    # secret and detects any change to it. A `data` value holding the
    # key: immutable and Shareable; `inspect` and `to_s` never show the
    # key (`key` and `to_h` do, asked for explicitly).
    #
    # ```
    # aead = Crypto::AES::GCM.generate(256)
    # token = aead.encrypt("a secret", aad: "user 42")
    # aead.decrypt(token, aad: "user 42").decode   # => "a secret"
    # aead.decrypt(token, aad: "user 43")          # raises Crypto::AuthenticationError
    # ```
    #
    # A nonce must never be used twice with one key: that is the one way
    # to break GCM. `encrypt` draws a random 12-byte nonce each time and
    # puts it in front of what it returns, which is safe for about 2^32
    # messages per key; past that, rotate the key, or give `seal` a
    # counter as the nonce. `seal` and `open` are for protocols that fix
    # the nonce (a counter, one from the peer).
    data GCM(
      # The key: 16, 24 or 32 bytes (AES-128, -192, -256).
      key: Bytes
    )
      # Raises `ArgumentError` for a key that is not 16, 24 or 32 bytes.
      def initialize(key: Bytes)
        unless key.size == 16 || key.size == 24 || key.size == 32
          raise ArgumentError, "an AES key has 16, 24 or 32 bytes, not #{key.size}"
        end
        @key = key
      end

      # A fresh random key of `bits` bits: 128, 192 or 256.
      def self.generate(bits: Int = 256) -> GCM
        unless bits == 128 || bits == 192 || bits == 256
          raise ArgumentError, "an AES key has 128, 192 or 256 bits, not #{bits}"
        end
        GCM.new(Crypto.random_bytes(bits / 8))
      end

      # The key's size in bits.
      def bits -> Int = key.size * 8

      # `plaintext` encrypted with `nonce` (12 bytes, used once with this
      # key), followed by the 16-byte tag that authenticates it and `aad`
      # (associated data: authenticated, not encrypted, and not included).
      def seal(nonce: Bytes, plaintext: Bytes | String, *, aad: Bytes | String = "") -> Bytes
        AES.seal_with(key, nonce, plaintext, aad)
      end

      # The plaintext of `sealed` (what `seal` gave for `nonce` and `aad`);
      # `Crypto::AuthenticationError` when it does not authenticate, and
      # then nothing of it is returned.
      def open(nonce: Bytes, sealed: Bytes, *, aad: Bytes | String = "") -> Bytes
        opened = AES.open_with(key, nonce, sealed, aad)
        raise AuthenticationError, "the data did not authenticate" if opened.nil?
        opened
      end

      # As `open`, nil instead of raising: for a caller to whom a bad
      # token is a normal case (an expired cookie).
      def open?(nonce: Bytes, sealed: Bytes, *, aad: Bytes | String = "") -> Bytes?
        AES.open_with(key, nonce, sealed, aad)
      end

      # `plaintext` sealed with a fresh random nonce: the nonce (12
      # bytes), the ciphertext and the tag (16 bytes), as one `Bytes` to
      # store or send.
      def encrypt(plaintext: Bytes | String, *, aad: Bytes | String = "") -> Bytes
        nonce = Crypto.random_bytes(12)
        nonce + seal(nonce, plaintext, aad: aad)
      end

      # The plaintext of `token` (what `encrypt` gave for `aad`);
      # `Crypto::AuthenticationError` when it does not authenticate.
      def decrypt(token: Bytes, *, aad: Bytes | String = "") -> Bytes
        opened = if token.size < 28
          nil
        else
          AES.open_with(key, token.slice(0, 12), token.slice(12, token.size - 12), aad)
        end
        raise AuthenticationError, "the data did not authenticate" if opened.nil?
        opened
      end

      # `#<Crypto::AES::GCM 256 bits>`: never the key.
      def inspect -> String = "#<Crypto::AES::GCM #{bits} bits>"

      # :ditto:
      def to_s -> String = inspect
    end

    # :nodoc:
    # `plaintext` sealed with `key` and `nonce` (GCM, a 16-byte tag).
    native def self.seal_with(key: Bytes, nonce: Bytes, plaintext: Bytes | String, aad: Bytes | String) -> Bytes
    # :nodoc:
    # The plaintext of `sealed`, nil when it does not authenticate.
    native def self.open_with(key: Bytes, nonce: Bytes, sealed: Bytes, aad: Bytes | String) -> Bytes?
  end

  # RSA keys and signatures, through the RustCrypto `rsa` crate. A hash
  # is named by a symbol: `:sha256`, `:sha384` or `:sha512`
  # (`ArgumentError` otherwise).
  module RSA
    # An RSA private key.
    #
    # ```quarz no_run
    # key = Crypto::RSA::PrivateKey.generate(2048)
    # File.write("key.pem", key.to_pem)
    # File.write("key.pub.pem", key.public_key.to_pem)
    # ```
    data PrivateKey(
      # The key as PKCS#8 DER, whatever it was read from.
      der: Bytes
    )
      # Raises `Crypto::Error` when `der` is not an RSA private key
      # (PKCS#8 or PKCS#1); it is kept as PKCS#8.
      def initialize(der: Bytes)
        @der = RSA.private_der(der)
      end

      # A new key of `bits` bits: 2048, 3072 or 4096 (`ArgumentError`
      # otherwise). It is made on a helper thread: only the calling task
      # waits (hundreds of milliseconds for 4096 bits).
      def self.generate(bits: Int = 2048) -> PrivateKey
        unless bits == 2048 || bits == 3072 || bits == 4096
          raise ArgumentError, "an RSA key has 2048, 3072 or 4096 bits, not #{bits}"
        end
        PrivateKey.new(RSA.generate_der(bits))
      end

      # The key in `pem`: one PKCS#8 (`PRIVATE KEY`) or PKCS#1
      # (`RSA PRIVATE KEY`) block, alone but for whitespace, not encrypted
      # (`Crypto::Error` otherwise, as for a key of another kind or size).
      #
      # ```
      # pem = File.read("std/test/fixtures/crypto/rsa2048_pkcs1.pem")
      # Crypto::RSA::PrivateKey.from_pem(pem).bits   # => 2048
      # ```
      def self.from_pem(pem: String | Bytes) -> PrivateKey
        PrivateKey.new(RSA.private_pem(pem.is_a?(String) ? pem.to_bytes : pem))
      end

      # The key in `der`: PKCS#8 or PKCS#1.
      def self.from_der(der: Bytes) -> PrivateKey = PrivateKey.new(der)

      # The key as DER: PKCS#8.
      def to_der -> Bytes = der

      # The key as PEM: PKCS#8 (`PRIVATE KEY`), or PKCS#1
      # (`RSA PRIVATE KEY`) with `format: :pkcs1`.
      native def to_pem(format: Symbol = :pkcs8) -> String

      # The public half.
      def public_key -> PublicKey = PublicKey.new(RSA.public_of(der))

      # The modulus's size in bits.
      native def bits -> Int

      # The RSASSA-PKCS1-v1_5 signature of `data` with `hash`.
      native def sign(data: Bytes | String, hash: Symbol) -> Bytes

      # The RSASSA-PSS signature of `data` with `hash` (MGF1 with the same
      # hash, a salt as long as the hash). Each signature differs: the
      # salt is random.
      native def sign_pss(data: Bytes | String, hash: Symbol) -> Bytes

      # `#<Crypto::RSA::PrivateKey 2048 bits>`: never the key.
      def inspect -> String = "#<Crypto::RSA::PrivateKey #{bits} bits>"

      # :ditto:
      def to_s -> String = inspect
    end

    # An RSA public key.
    #
    # ```
    # pem = File.read("std/test/fixtures/crypto/rsa2048_spki.pem")
    # pub = Crypto::RSA::PublicKey.from_pem(pem)
    # pub.bits                  # => 2048
    # pub.fingerprint.size      # => 32
    # ```
    data PublicKey(
      # The key as SPKI DER, whatever it was read from.
      der: Bytes
    )
      # Raises `Crypto::Error` when `der` is not an RSA public key (SPKI
      # or PKCS#1); it is kept as SPKI.
      def initialize(der: Bytes)
        @der = RSA.public_der(der)
      end

      # The key in `pem`: one SPKI (`PUBLIC KEY`) or PKCS#1
      # (`RSA PUBLIC KEY`) block.
      def self.from_pem(pem: String | Bytes) -> PublicKey
        PublicKey.new(RSA.public_pem(pem.is_a?(String) ? pem.to_bytes : pem))
      end

      # The key in `der`: SPKI or PKCS#1.
      def self.from_der(der: Bytes) -> PublicKey = PublicKey.new(der)

      # The key as DER: SPKI.
      def to_der -> Bytes = der

      # The key as PEM: SPKI (`PUBLIC KEY`).
      native def to_pem -> String

      # The modulus's size in bits.
      native def bits -> Int

      # Whether `signature` is the RSASSA-PKCS1-v1_5 signature of `data`
      # with `hash`: false for any wrong signature, never an exception.
      native def verify(data: Bytes | String, signature: Bytes, hash: Symbol) -> Bool

      # Whether `signature` is the RSASSA-PSS signature of `data` with
      # `hash` (MGF1 with the same hash), whatever the salt's length: it
      # is read from the signature, as OpenSSL's saltlen:auto and Go's
      # PSSSaltLengthAuto verify. False for any wrong signature.
      native def verify_pss(data: Bytes | String, signature: Bytes, hash: Symbol) -> Bool

      # The SHA-256 of the SPKI DER: a key's identity, for key ids and
      # pinning.
      native def fingerprint -> Bytes

      # `#<Crypto::RSA::PublicKey 2048 bits, fingerprint ab12cd34…>`.
      def inspect -> String
        hex = fingerprint.slice(0, 4).to_a.map { |b| b.to_s(16).rjust(2, "0") }.join
        "#<Crypto::RSA::PublicKey #{bits} bits, fingerprint #{hex}…>"
      end

      # :ditto:
      def to_s -> String = inspect
    end

    # :nodoc:
    # `der` (PKCS#8 or PKCS#1) as PKCS#8.
    native def self.private_der(der: Bytes) -> Bytes
    # :nodoc:
    # The one private key block of `pem`, as PKCS#8 DER.
    native def self.private_pem(pem: Bytes) -> Bytes
    # :nodoc:
    # `der` (SPKI or PKCS#1) as SPKI.
    native def self.public_der(der: Bytes) -> Bytes
    # :nodoc:
    # The one public key block of `pem`, as SPKI DER.
    native def self.public_pem(pem: Bytes) -> Bytes
    # :nodoc:
    # The SPKI DER of the public half of the private key `der` (PKCS#8).
    native def self.public_of(der: Bytes) -> Bytes
    # :nodoc:
    # A new key's PKCS#8 DER (on a helper thread).
    native def self.generate_der(bits: Int) -> Bytes
  end
end
