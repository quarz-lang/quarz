require "socket"

# (The overview is the comment of `module TLS`, below.)

# A TLS connection over a TCP connection: `TLSSocket.connect` makes a
# client's, `TLSSocket.accept` a server's. Every `IO` method works on it,
# so whatever takes an `IO` takes it.
#
# ```quarz no_run
# sock = TCPSocket.new("example.com", 443)
# tls = TLSSocket.connect(sock, "example.com")
# tls.write("GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n")
# puts tls.gets
# tls.close
# ```
class TLSSocket < IO
  # Takes `socket` over and runs the TLS handshake with its peer, as
  # `server_name` (the name sent as SNI and the one its certificate is
  # verified against; an IP address is allowed). When it returns, the
  # handshake is done. `socket` is closed for the program from then on:
  # its descriptor belongs to the `TLSSocket`. Only the calling task
  # waits; `Task.timeout` and `cancel` interrupt the handshake, closing
  # the connection. Raises `TLS::CertificateError` when the peer's
  # certificate is refused, `TLS::Error` for another failure.
  def self.connect(socket: TCPSocket, server_name: String, config: TLS::Config = TLS::Config.default) -> TLSSocket = handshake(socket, server_name, config)
  private native def self.handshake(socket: TCPSocket, server_name: String, config: TLS::Config) -> TLSSocket

  # Takes `socket` (an accepted connection) over and runs the TLS
  # handshake with its peer as the server, as `config` says. As `connect`
  # does: when it returns, the handshake is done, `socket` is closed for
  # the program, only the calling task waits, and `Task.timeout` and
  # `cancel` interrupt it, closing the connection. Raises `TLS::Error`
  # when the handshake fails (the client refused the certificate, spoke
  # something else than TLS, shared no protocol version), and the
  # socket's `SystemCallError` or `IOError` when the connection does (a
  # reset); the connection is closed. The same as
  # `config.accept(socket)`.
  #
  # ```quarz no_run
  # config = TLS::ServerConfig.new(certificate: File.read("server.pem"),
  #                                private_key: File.read("server.key"))
  # listener = TCPServer.new("0.0.0.0", 8443)
  # loop do
  #   sock = listener.accept
  #   Task.spawn do
  #     tls = TLSSocket.accept(sock, config)
  #     tls.puts "hello"
  #     tls.close
  #   end
  # end
  # ```
  def self.accept(socket: TCPSocket, config: TLS::ServerConfig) -> TLSSocket = config.accept(socket)

  # The protocol agreed on by ALPN (`"h2"`, `"http/1.1"`), nil when none
  # was.
  native def alpn -> String?
  # The peer's certificate (DER), nil when it sent none (a server's peer
  # sends none: client certificates are not asked for).
  native def peer_certificate -> Bytes?
  # Whether the peer was authenticated by its certificate: false with
  # `verify: false` in the config, and on the server's side (no client
  # certificate is asked for).
  native def verified? -> Bool
  # The server's name: the one given to `connect`; on the server's side,
  # the one the client sent (SNI), nil when it sent none.
  native def server_name -> String?
end

# TLS: `require "tls"`. A `TLSSocket` is a TLS connection over a
# `TCPSocket`, through rustls, a client's or a server's; `TLS::Config`
# says what a client trusts and offers, `TLS::ServerConfig` what a server
# presents and offers. Reads, writes and the handshake suspend only the calling task,
# as a socket's do, and a `TLSSocket` is Shareable as every `IO`: one
# write call goes out whole (in records of its own), one read call takes
# a whole unit.
module TLS
  # A TLS failure: a handshake the peer refused, a protocol error.
  class Error < IOError
  end

  # A peer certificate refused: the message names the reason (unknown
  # issuer, name mismatch, expired).
  class CertificateError < Error
  end

  # The certificates trusted as roots.
  data Roots(
    # A PEM bundle, nil for the system's store.
    pem: Bytes?
  )
    # The system's store, read once at the first connection that uses it
    # (the environment variables SSL_CERT_FILE and SSL_CERT_DIR override
    # where it is looked for).
    # Without one, that connection raises `TLS::Error` naming the places
    # tried.
    def self.system -> Roots = new(nil)

    # The certificates of a PEM bundle (a database's CA, say). Raises
    # `TLS::Error` when it holds none, or one that does not parse.
    def self.from_pem(pem: Bytes) -> Roots = new(check(pem))
    # :ditto:
    def self.from_pem(pem: String) -> Roots = new(check(pem.to_bytes))

    private native def self.check(pem: Bytes) -> Bytes
  end

  # What a client connection trusts and offers. Immutable, so one config
  # serves any number of connections and tasks; the configuration built
  # from it is kept, so connecting again does not read the roots again.
  #
  # ```quarz no_run
  # config = TLS::Config.new(roots: TLS::Roots.from_pem(File.read("ca.pem")),
  #                          alpn: ["h2", "http/1.1"], min_version: :tls13)
  # ```
  data Config(
    # The roots the peer's certificate must chain to.
    roots: Roots,
    # The protocols offered by ALPN, preferred first.
    alpn: Array[String],
    # The oldest version accepted: `:tls12` or `:tls13`.
    min_version: Symbol,
    # Whether the peer's certificate is verified. `false` keeps the
    # connection encrypted but drops the peer's authentication: for tests
    # and local setups only (`TLSSocket#verified?` says so).
    verify: Bool
  )
    def initialize(*, roots: Roots = Roots.system, alpn: Array[String] = [], min_version: Symbol = :tls12, verify: Bool = true)
      unless min_version == :tls12 || min_version == :tls13
        raise ArgumentError, "min_version: :tls12 or :tls13, not #{min_version.inspect}"
      end
      @roots = roots
      @alpn = alpn
      @min_version = min_version
      @verify = verify
    end

    # The system's roots, no ALPN, TLS 1.2 and later, verified.
    def self.default -> Config = new
  end

  # What a server presents and offers: its certificate chain and private
  # key (PEM), the protocols it accepts by ALPN, the oldest version.
  # Immutable, so one config serves any number of connections and tasks;
  # the configuration built from it is kept, with its cache of sessions
  # to resume (rustls's default). Client certificates, OCSP stapling and
  # settings for resumption are not supported yet.
  #
  # Its `inspect` and `to_s` never show the private key.
  #
  # ```quarz no_run
  # config = TLS::ServerConfig.new(certificate: File.read("server.pem"),
  #                                private_key: File.read("server.key"),
  #                                alpn: ["http/1.1"])
  # ```
  data ServerConfig(
    # The certificate chain (PEM), the server's own certificate first.
    certificate: Bytes,
    # The private key of the certificate (PEM: PKCS#8, PKCS#1 or SEC1).
    private_key: Bytes,
    # The protocols accepted by ALPN, preferred first; a client offering
    # none of them is refused, one offering none is served.
    alpn: Array[String],
    # The oldest version accepted: `:tls12` or `:tls13`.
    min_version: Symbol
  )
    # Raises `TLS::Error` when the certificate or the key does not parse,
    # or the key is not the certificate's; the message names which.
    def initialize(*, certificate: Bytes | String, private_key: Bytes | String,
                   alpn: Array[String] = [], min_version: Symbol = :tls12)
      unless min_version == :tls12 || min_version == :tls13
        raise ArgumentError, "min_version: :tls12 or :tls13, not #{min_version.inspect}"
      end
      @certificate = certificate.is_a?(String) ? certificate.to_bytes : certificate
      @private_key = private_key.is_a?(String) ? private_key.to_bytes : private_key
      @alpn = alpn
      @min_version = min_version
      check
    end

    # Runs the TLS handshake as the server on `socket`: `TLSSocket.accept`.
    native def accept(socket: TCPSocket) -> TLSSocket

    # The config, its private key hidden.
    def inspect -> String
      "#<TLS::ServerConfig certificate: (#{certificate.size} bytes), private_key: <hidden>, " +
        "alpn: #{alpn.inspect}, min_version: #{min_version.inspect}>"
    end

    # :ditto:
    def to_s -> String = inspect

    private native def check -> Nil
  end
end
