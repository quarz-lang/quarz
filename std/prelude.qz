module Enumerable[out T]
  abstract def each(&block: (T) -> Nil) -> Nil

  def map[U](&block: (T) -> U) -> Array[U]
    Array.build do |out|
      each { |x| out << yield(x) }
    end
  end

  def flat_map[U](&block: (T) -> Array[U]) -> Array[U]
    Array.build do |out|
      each { |x| out.concat(yield(x)) }
    end
  end

  def filter_map[U](&block: (T) -> U?) -> Array[U]
    Array.build do |out|
      each do |x|
        y = yield(x)
        out << y if y
      end
    end
  end

  def select(&block: (T) -> Object) -> Array[T]
    Array.build do |out|
      each { |x| out << x if yield(x) }
    end
  end

  def filter(&block: (T) -> Object) -> Array[T] = select { |x| yield(x) }

  def reject(&block: (T) -> Object) -> Array[T]
    Array.build do |out|
      each { |x| out << x unless yield(x) }
    end
  end

  def reduce[U](initial: U, &block: (U, T) -> U) -> U
    acc = initial
    each { |x| acc = yield(acc, x) }
    acc
  end

  def inject[U](initial: U, &block: (U, T) -> U) -> U = reduce(initial) { |a, x| yield(a, x) }

  def each_with_index(&block: (T, Int) -> Nil) -> Nil
    i = 0
    each do |x|
      yield x, i
      i += 1
    end
  end

  def each_with_object[U](memo: U, &block: (T, U) -> Nil) -> U
    each { |x| yield x, memo }
    memo
  end

  def find(&block: (T) -> Object) -> T?
    each { |x| return x if yield(x) }
    nil
  end

  def detect(&block: (T) -> Object) -> T? = find { |x| yield(x) }

  def find_index(&block: (T) -> Object) -> Int?
    i = 0
    each do |x|
      return i if yield(x)
      i += 1
    end
    nil
  end

  def include?(value: Object) -> Bool
    each { |x| return true if x == value }
    false
  end

  def count -> Int
    n = 0
    each { |_x| n += 1 }
    n
  end

  def count(&block: (T) -> Object) -> Int
    n = 0
    each { |x| n += 1 if yield(x) }
    n
  end

  def any? -> Bool
    each { |x| return true if x }
    false
  end

  def any?(&block: (T) -> Object) -> Bool
    each { |x| return true if yield(x) }
    false
  end

  def all? -> Bool
    each { |x| return false unless x }
    true
  end

  def all?(&block: (T) -> Object) -> Bool
    each { |x| return false unless yield(x) }
    true
  end

  def none?(&block: (T) -> Object) -> Bool = !any? { |x| yield(x) }

  def one?(&block: (T) -> Object) -> Bool = count { |x| yield(x) } == 1

  def first -> T?
    each { |x| return x }
    nil
  end

  def first(n: Int) -> Array[T]
    Array.build do |out|
      each do |x|
        break if out.size >= n
        out << x
      end
    end
  end

  def take(n: Int) -> Array[T] = first(n)

  def drop(n: Int) -> Array[T]
    Array.build do |out|
      i = 0
      each do |x|
        out << x if i >= n
        i += 1
      end
    end
  end

  def take_while(&block: (T) -> Object) -> Array[T]
    Array.build do |out|
      each do |x|
        break unless yield(x)
        out << x
      end
    end
  end

  def drop_while(&block: (T) -> Object) -> Array[T]
    Array.build do |out|
      dropping = true
      each do |x|
        dropping = false if dropping && !yield(x)
        out << x unless dropping
      end
    end
  end

  def to_a -> Array[T] = map { |x| x }

  def to_set -> Set[T]
    Set.build { |b| each { |x| b << x } }
  end

  def tally -> Hash[T, Int]
    Hash.build do |counts|
      each { |x| counts[x] = counts.fetch(x, 0) + 1 }
    end
  end

  def group_by[K](&block: (T) -> K) -> Hash[K, Array[T]]
    groups = Hash::Builder[K, Array::Builder[T]].new
    each do |x|
      key = yield(x)
      bucket = groups[key]?
      if bucket
        bucket << x
      else
        groups[key] = Array::Builder[T].new.push(x)
      end
    end
    Hash.build do |out|
      groups.each { |k, b| out[k] = b.to_a }
    end
  end

  def partition(&block: (T) -> Object) -> [Array[T], Array[T]]
    yes = Array::Builder[T].new
    no = Array::Builder[T].new
    each do |x|
      if yield(x)
        yes << x
      else
        no << x
      end
    end
    [yes.to_a, no.to_a]
  end

  def each_slice(n: Int, &block: (Array[T]) -> Nil) -> Nil
    chunk = Array::Builder[T].new
    each do |x|
      chunk << x
      if chunk.size == n
        yield chunk.to_a
        chunk = Array::Builder[T].new
      end
    end
    yield chunk.to_a unless chunk.empty?
  end

  def uniq -> Array[T]
    seen = Set::Builder[T].new
    Array.build do |out|
      each do |x|
        unless seen.include?(x)
          seen << x
          out << x
        end
      end
    end
  end

  def zip[U](other: Array[U]) -> Array[[T, U]]
    i = 0
    Array.build do |out|
      each do |x|
        out << [x, other[i]]
        i += 1
      end
    end
  end

  def min_by[U: Comparable[U]](&block: (T) -> U) -> T?
    best: T? = nil
    best_key: U? = nil
    each do |x|
      key = yield(x)
      if best_key.nil? || key < best_key
        best = x
        best_key = key
      end
    end
    best
  end

  def max_by[U: Comparable[U]](&block: (T) -> U) -> T?
    best: T? = nil
    best_key: U? = nil
    each do |x|
      key = yield(x)
      if best_key.nil? || key > best_key
        best = x
        best_key = key
      end
    end
    best
  end

  def sort_by[U: Comparable[U]](&block: (T) -> U) -> Array[T]
    map { |x| [yield(x), x] }.sort_pairs.map { |pair| pair[1] }
  end

  def lazy -> Array[T] = to_a
end

extension Enumerable[T: Comparable[T]]
  native def sort -> Array[T]
  native def min -> T?
  native def max -> T?
  native def minmax -> [T?, T?]
end

extension Enumerable[T: Int]
  def sum -> Int = reduce(0) { |acc, x| acc + x }
end

extension Enumerable[T: Float]
  def sum -> Float = reduce(0.0) { |acc, x| acc + x }
end

extension Array[T: Comparable[T]]
  native def <=>(other: Array[T]) -> Int
end

class Enumerator[out T]
  include Shareable
  include Enumerable[T]

  native def each(&block: (T) -> Nil) -> Nil
  native def next -> T
  native def size -> Int
  native def with_index(&block: (T, Int) -> Nil) -> Nil
end

class Array[out T]
  include Shareable
  include Enumerable[T]

  native def self.new -> Array[T]
  native def self.new(size: Int, &block: (Int) -> T) -> Array[T]
  native def self.build(&block: (Array::Builder[T]) -> Nil) -> Array[T]

  native def each(&block: (T) -> Nil) -> Nil
  native def each_index(&block: (Int) -> Nil) -> Nil
  native def reverse_each(&block: (T) -> Nil) -> Nil
  native def [](index: Int) -> T
  native def [](range: Range[Int]) -> Array[T]
  native def []?(index: Int) -> T?
  native def at(index: Int) -> T?
  native def fetch(index: Int, default: T) -> T
  native def first -> T?
  native def first(n: Int) -> Array[T]
  native def last -> T?
  native def last(n: Int) -> Array[T]
  native def size -> Int
  native def length -> Int
  native def empty? -> Bool
  native def push(value: T) -> Array[T]
  native def pop -> Array[T]
  native def shift -> Array[T]
  native def unshift(value: T) -> Array[T]
  native def insert(index: Int, value: T) -> Array[T]
  native def set(index: Int, value: T) -> Array[T]
  native def delete(value: T) -> Array[T]
  native def delete_at(index: Int) -> Array[T]
  native def concat(other: Array[T]) -> Array[T]
  native def +(other: Array[T]) -> Array[T]
  native def -(other: Array[T]) -> Array[T]
  native def *(count: Int) -> Array[T]
  native def &(other: Array[T]) -> Array[T]
  native def |(other: Array[T]) -> Array[T]
  native def reverse -> Array[T]
  native def rotate(count: Int = 1) -> Array[T]
  native def index(value: T) -> Int?
  native def rindex(value: T) -> Int?
  native def include?(value: Object) -> Bool
  native def join(separator: String = "") -> String
  native def sample -> T?
  native def shuffle -> Array[T]
  native def flatten -> Array[Object]
  native def compact -> Array[T]
  native def to_a -> Array[T]
  native def to_s -> String
  native def inspect -> String
  native def ==(other: Object) -> Bool
  native def hash -> Int
  native def map[U](&block: (T) -> U) -> Array[U]
  native def select(&block: (T) -> Object) -> Array[T]
  native def sort_pairs -> Array[T]

  class Builder[T]
    include Unshareable

    native def self.new -> Array::Builder[T]
    native def self.new(size: Int, fill: T) -> Array::Builder[T]
    native def <<(value: T) -> self
    native def push(value: T) -> self
    native def pop -> T?
    native def shift -> T?
    native def unshift(value: T) -> self
    native def insert(index: Int, value: T) -> self
    native def concat(other: Array[T]) -> self
    native def [](index: Int) -> T
    native def []?(index: Int) -> T?
    native def []=(index: Int, value: T) -> T
    native def first -> T?
    native def last -> T?
    native def size -> Int
    native def length -> Int
    native def empty? -> Bool
    native def include?(value: Object) -> Bool
    native def delete(value: T) -> self
    native def delete_at(index: Int) -> T?
    native def clear -> self
    native def reverse! -> self
    native def sort! -> self
    native def map!(&block: (T) -> T) -> self
    native def select!(&block: (T) -> Object) -> self
    native def reject!(&block: (T) -> Object) -> self
    native def each(&block: (T) -> Nil) -> Nil
    native def each_with_index(&block: (T, Int) -> Nil) -> Nil
    native def to_a -> Array[T]
    native def snapshot -> Array[T]
    native def to_s -> String
    native def inspect -> String
  end
end

class Hash[K, out V]
  include Shareable
  include Enumerable[[K, V]]

  native def self.new -> Hash[K, V]
  native def self.build(&block: (Hash::Builder[K, V]) -> Nil) -> Hash[K, V]

  native def each(&block: ([K, V]) -> Nil) -> Nil
  native def each_pair(&block: (K, V) -> Nil) -> Nil
  native def each_key(&block: (K) -> Nil) -> Nil
  native def each_value(&block: (V) -> Nil) -> Nil
  native def [](key: K) -> V
  native def []?(key: K) -> V?
  native def fetch(key: K, default: V) -> V
  native def fetch(key: K, &block: (K) -> V) -> V
  native def dig(key: K) -> V?
  native def key?(key: K) -> Bool
  native def has_key?(key: K) -> Bool
  native def value?(value: V) -> Bool
  native def key(value: V) -> K?
  native def keys -> Array[K]
  native def values -> Array[V]
  native def size -> Int
  native def length -> Int
  native def empty? -> Bool
  native def put(key: K, value: V) -> Hash[K, V]
  native def delete(key: K) -> Hash[K, V]
  native def merge(other: Hash[K, V]) -> Hash[K, V]
