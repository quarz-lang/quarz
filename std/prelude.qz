module Enumerable[out T]
  abstract def each(&: (T) -> Nil) -> Nil

  def map[U](&: (T) -> U) -> Array[U]
    Array.build do |out|
      each { |x| out << yield(x) }
    end
  end

  def flat_map[U](&: (T) -> Array[U]) -> Array[U]
    Array.build do |out|
      each { |x| out.concat(yield(x)) }
    end
  end

  def filter_map[U](&: (T) -> U?) -> Array[U]
    Array.build do |out|
      each do |x|
        y = yield(x)
        out << y if y
      end
    end
  end

  def select(&: (T) -> Object) -> Array[T]
    Array.build do |out|
      each { |x| out << x if yield(x) }
    end
  end

  def filter(&: (T) -> Object) -> Array[T] = select { |x| yield(x) }

  def reject(&: (T) -> Object) -> Array[T]
    Array.build do |out|
      each { |x| out << x unless yield(x) }
    end
  end

  def reduce[U](initial: U, &: (U, T) -> U) -> U
    acc = initial
    each { |x| acc = yield(acc, x) }
    acc
  end

  def inject[U](initial: U, &: (U, T) -> U) -> U = reduce(initial) { |a, x| yield(a, x) }

  def each_with_index(&: (T, Int) -> Nil) -> Nil
    i = 0
    each do |x|
      yield x, i
      i += 1
    end
  end

  def each_with_object[U](memo: U, &: (T, U) -> Nil) -> U
    each { |x| yield x, memo }
    memo
  end

  def find(&: (T) -> Object) -> T?
    each { |x| return x if yield(x) }
    nil
  end

  def detect(&: (T) -> Object) -> T? = find { |x| yield(x) }

  def find_index(&: (T) -> Object) -> Int?
    i = 0
    each do |x|
      return i if yield(x)
      i += 1
    end
    nil
  end

  def include?(value: Object) -> Bool
    each { |x| return true if x == value }
    false
  end

  def count -> Int
    n = 0
    each { |_x| n += 1 }
    n
  end

  def count(&: (T) -> Object) -> Int
    n = 0
    each { |x| n += 1 if yield(x) }
    n
  end

  def any? -> Bool
    each { |x| return true if x }
    false
  end

  def any?(&: (T) -> Object) -> Bool
    each { |x| return true if yield(x) }
    false
  end

  def all? -> Bool
    each { |x| return false unless x }
    true
  end

  def all?(&: (T) -> Object) -> Bool
    each { |x| return false unless yield(x) }
    true
  end

  def none?(&: (T) -> Object) -> Bool = !any? { |x| yield(x) }

  def one?(&: (T) -> Object) -> Bool = count { |x| yield(x) } == 1

  def first -> T?
    each { |x| return x }
    nil
  end

  def first(n: Int) -> Array[T]
    Array.build do |out|
      each do |x|
        break if out.size >= n
        out << x
      end
    end
  end

  def take(n: Int) -> Array[T] = first(n)

  def drop(n: Int) -> Array[T]
    Array.build do |out|
      i = 0
      each do |x|
        out << x if i >= n
        i += 1
      end
    end
  end

  def take_while(&: (T) -> Object) -> Array[T]
    Array.build do |out|
      each do |x|
        break unless yield(x)
        out << x
      end
    end
  end

  def drop_while(&: (T) -> Object) -> Array[T]
    Array.build do |out|
      dropping = true
      each do |x|
        dropping = false if dropping && !yield(x)
        out << x unless dropping
      end
    end
  end

  def to_a -> Array[T] = map { |x| x }

  def to_set -> Set[T]
    Set.build { |b| each { |x| b << x } }
  end

  def tally[U >: T] -> Hash[U, Int]
    Hash.build do |counts|
      each { |x| counts[x] = counts.fetch(x, 0) + 1 }
    end
  end

  def group_by[K](&: (T) -> K) -> Hash[K, Array[T]]
    groups = Hash::Builder[K, Array::Builder[T]].new
    each do |x|
      key = yield(x)
      bucket = groups[key]?
      if bucket
        bucket << x
      else
        groups[key] = Array::Builder[T].new.push(x)
      end
    end
    Hash.build do |out|
      groups.each { |k, b| out[k] = b.to_a }
    end
  end

  def partition(&: (T) -> Object) -> [Array[T], Array[T]]
    yes = Array::Builder[T].new
    no = Array::Builder[T].new
    each do |x|
      if yield(x)
        yes << x
      else
        no << x
      end
    end
    [yes.to_a, no.to_a]
  end

  def each_slice(n: Int, &: (Array[T]) -> Nil) -> Nil
    chunk = Array::Builder[T].new
    each do |x|
      chunk << x
      if chunk.size == n
        yield chunk.to_a
        chunk = Array::Builder[T].new
      end
    end
    yield chunk.to_a unless chunk.empty?
  end

  def uniq -> Array[T]
    seen = Set::Builder[T].new
    Array.build do |out|
      each do |x|
        unless seen.include?(x)
          seen << x
          out << x
        end
      end
    end
  end

  def zip[U](other: Array[U]) -> Array[[T, U]]
    i = 0
    Array.build do |out|
      each do |x|
        out << [x, other[i]]
        i += 1
      end
    end
  end

  def min_by[U: Comparable[U]](&: (T) -> U) -> T?
    best: T? = nil
    best_key: U? = nil
    each do |x|
      key = yield(x)
      if best_key.nil? || key < best_key
        best = x
        best_key = key
      end
    end
    best
  end

  def max_by[U: Comparable[U]](&: (T) -> U) -> T?
    best: T? = nil
    best_key: U? = nil
    each do |x|
      key = yield(x)
      if best_key.nil? || key > best_key
        best = x
        best_key = key
      end
    end
    best
  end

  def sort_by[U: Comparable[U]](&: (T) -> U) -> Array[T]
    pairs: Array[[U, T]] = map { |x| [yield(x), x] }
    sort_pairs(pairs).map { |pair| pair[1] }
  end

  def lazy -> Array[T] = to_a

  # Aliases that Ruby programs use.
  def collect[U](&: (T) -> U) -> Array[U] = map { |x| yield(x) }
  def collect_concat[U](&: (T) -> Array[U]) -> Array[U] = flat_map { |x| yield(x) }
  def find_all(&: (T) -> Object) -> Array[T] = select { |x| yield(x) }
  def member?(value: Object) -> Bool = include?(value)
  def entries -> Array[T] = to_a

  def reduce[U >: T](&: (U, T) -> U) -> U?
    acc: U? = nil
    each do |x|
      current = acc
      acc = current.nil? ? x : yield(current, x)
    end
    acc
  end

  def inject[U >: T](&: (U, T) -> U) -> U? = reduce[U]() { |a, x| yield(a, x) }

  def count(value: Object) -> Int = count { |x| x == value }

  def none? -> Bool = !any?

  def one? -> Bool = count { |x| x } == 1

  def find_index(value: Object) -> Int? = find_index { |x| x == value }

  def reverse_each(&: (T) -> Nil) -> Nil
    to_a.reverse_each { |x| yield(x) }
  end

  def each_cons(n: Int, &: (Array[T]) -> Nil) -> Nil
    raise ArgumentError, "invalid size" if n <= 0
    window = Array::Builder[T].new
    each do |x|
      window << x
      window.shift if window.size > n
      yield window.snapshot if window.size == n
    end
  end

  # Consecutive elements for which the block holds stay in one chunk.
  def chunk_while(&: (T, T) -> Object) -> Array[Array[T]]
    chunks = Array::Builder[Array[T]].new
    chunk = Array::Builder[T].new
    previous: T? = nil
    started = false
    each do |x|
      last = previous
      if started && !last.nil? && !yield(last, x)
        chunks << chunk.to_a
        chunk = Array::Builder[T].new
      end
      chunk << x
      previous = x
      started = true
    end
    chunks << chunk.to_a if started
    chunks.to_a
  end

  # The chunk is cut where the block holds.
  def slice_when(&: (T, T) -> Object) -> Array[Array[T]]
    chunk_while { |a, b| !yield(a, b) }
  end

  def uniq[U](&: (T) -> U) -> Array[T]
    seen = Set::Builder[U].new
    Array.build do |out|
      each do |x|
        key = yield(x)
        unless seen.include?(key)
          seen << key
          out << x
        end
      end
    end
  end

  def tally_by[K](&: (T) -> K) -> Hash[K, Int]
    Hash.build do |counts|
      each do |x|
        key = yield(x)
        counts[key] = counts.fetch(key, 0) + 1
      end
    end
  end

  def to_h[K, V](&: (T) -> [K, V]) -> Hash[K, V]
    Hash.build do |out|
      each do |x|
        pair = yield(x)
        out[pair[0]] = pair[1]
      end
    end
  end

  def cycle(n: Int, &: (T) -> Nil) -> Nil
    items = to_a
    return nil if items.empty?
    n.times { items.each { |x| yield(x) } }
  end

  def cycle(&: (T) -> Nil) -> Nil
    items = to_a
    return nil if items.empty?
    while true
      items.each { |x| yield(x) }
    end
  end

  def each_entry(&: (T) -> Nil) -> Nil = each { |x| yield(x) }

  def sum(&: (T) -> Int) -> Int = reduce(0) { |acc, x| acc + yield(x) }
  def sum(&: (T) -> Float) -> Float = reduce(0.0) { |acc, x| acc + yield(x) }

  # Ordering by a block (`sort { |a, b| b <=> a }`); `sort_by` is usually
  # simpler.
  native def sort(&: (T, T) -> Int) -> Array[T]
  native def min(&: (T, T) -> Int) -> T?
  native def max(&: (T, T) -> Int) -> T?

  # Without a block these return an enumerator, as in Ruby:
  # `xs.each_with_index.map { |x, i| }`, `xs.map.with_index { |x, i| }`.
  native def to_enum -> Enumerator[T]
  native def map -> Enumerator[T]
  native def each_with_index -> Enumerator[[T, Int]]
  private native def each_with_index_pairs(&: ([T, Int]) -> Nil) -> Nil
  # `[key, value]` pairs sorted by key (for `sort_by`).
  private native def sort_pairs[K, V](pairs: Array[[K, V]]) -> Array[[K, V]]
  native def each_slice(n: Int) -> Enumerator[Array[T]]
  native def each_cons(n: Int) -> Enumerator[Array[T]]
end

extension Enumerable[T: Comparable[T]]
  native def sort -> Array[T]
  native def min -> T?
  native def max -> T?
  native def minmax -> [T?, T?]
  def min(n: Int) -> Array[T] = sort.first(n)
  def max(n: Int) -> Array[T] = sort.reverse.first(n)
end

extension Enumerable[T: Int]
  def sum -> Int = reduce(0) { |acc, x| acc + x }
end

extension Enumerable[T: Float]
  def sum -> Float = reduce(0.0) { |acc, x| acc + x }
end

extension Enumerable[T: Integer]
  def sum -> Integer = reduce(0.to_integer) { |acc, x| acc + x }
end

extension Array[T: Comparable[T]]
  native def <=>(other: Array[T]) -> Int
end

class Enumerator[out T]
  # It has a position, and its receiver may be a mutable object: it
  # stays in its task.
  include Unshareable
  include Enumerable[T]

  native def each(&: (T) -> Nil) -> Nil
  native def next -> T
  native def peek -> T
  native def rewind -> Self
  native def size -> Int
  # Collects the block's results: `xs.map.with_index { |x, i| ... }`.
  native def with_index[U](&: (T, Int) -> U) -> Array[U]
  native def with_index[U](offset: Int, &: (T, Int) -> U) -> Array[U]
end

class Array[out T]
  include Shareable
  include Enumerable[T]

  native def self.new -> Array[T]
  native def self.new(size: Int, &: (Int) -> T) -> Array[T]
  native def self.build(&: (Array::Builder[T]) -> Nil) -> Array[T]

  native def each(&: (T) -> Nil) -> Nil
  native def each_index(&: (Int) -> Nil) -> Nil
  native def reverse_each(&: (T) -> Nil) -> Nil
  native def [](index: Int) -> T
  native def [](range: Range[Int]) -> Array[T]
  native def []?(index: Int) -> T?
  native def at(index: Int) -> T?
  native def fetch[U >: T](index: Int, default: U) -> U
  native def first -> T?
  native def first? -> T?
  native def first(n: Int) -> Array[T]
  native def last -> T?
  native def last? -> T?
  native def last(n: Int) -> Array[T]
  native def size -> Int
  native def length -> Int
  native def empty? -> Bool
  native def push[U >: T](value: U) -> Array[U]
  native def pop -> Array[T]
  native def shift -> Array[T]
  native def unshift[U >: T](value: U) -> Array[U]
  native def insert[U >: T](index: Int, value: U) -> Array[U]
  native def set[U >: T](index: Int, value: U) -> Array[U]
  native def delete(value: Object) -> Array[T]
  native def delete_at(index: Int) -> Array[T]
  native def concat[U >: T](other: Array[U]) -> Array[U]
  native def +[U >: T](other: Array[U]) -> Array[U]
  native def -(other: Array[Object]) -> Array[T]
  native def *(count: Int) -> Array[T]
  native def &(other: Array[Object]) -> Array[T]
  native def |[U >: T](other: Array[U]) -> Array[U]
  native def reverse -> Array[T]
  native def rotate(count: Int = 1) -> Array[T]
  native def index(value: Object) -> Int?
  native def rindex(value: Object) -> Int?
  native def include?(value: Object) -> Bool
  native def join(separator: String = "") -> String
  native def sample -> T?
  native def shuffle -> Array[T]
  native def flatten -> Array[Object]
  native def compact -> Array[T]
  native def to_a -> Array[T]
  native def to_s -> String
  native def inspect -> String
  native def ==(other: Object) -> Bool
  native def hash -> Int
  native def map[U](&: (T) -> U) -> Array[U]
  native def select(&: (T) -> Object) -> Array[T]
  native def each -> Enumerator[T]
  native def fetch[U >: T](index: Int, &: (Int) -> U) -> U
  native def slice(start: Int, length: Int) -> Array[T]
  native def take(n: Int) -> Array[T]
  native def drop(n: Int) -> Array[T]
  native def values_at(*indices: Int) -> Array[T?]
  native def index(&: (T) -> Object) -> Int?
  native def rindex(&: (T) -> Object) -> Int?
  native def push[U >: T](*values: U) -> Array[U]
  native def fill[U >: T](value: U) -> Array[U]
  native def fill[U >: T](value: U, start: Int, length: Int) -> Array[U]
  native def flatten(depth: Int) -> Array[Object]
  native def sample(n: Int) -> Array[T]
  native def *(separator: String) -> String
  native def product[U](other: Array[U]) -> Array[[T, U]]
  native def combination(n: Int) -> Array[Array[T]]
  native def permutation(n: Int) -> Array[Array[T]]
  native def permutation -> Array[Array[T]]
  # Binary search over a sorted array: the block is false for a prefix and
  # true from some element on; that element is returned.
  native def bsearch(&: (T) -> Bool) -> T?
  def delete_if(&: (T) -> Object) -> Array[T] = reject { |x| yield(x) }
  def keep_if(&: (T) -> Object) -> Array[T] = select { |x| yield(x) }
  def union[U >: T](other: Array[U]) -> Array[U] = self | other
  def intersection(other: Array[Object]) -> Array[T] = self & other
  def difference(other: Array[Object]) -> Array[T] = self - other
  def intersect?(other: Array[Object]) -> Bool = !(self & other).empty?

  class Builder[T]
    include Unshareable
    include Enumerable[T]

    native def self.new -> Array::Builder[T]
    native def self.new(size: Int, fill: T) -> Array::Builder[T]
    native def <<(value: T) -> Self
    native def push(value: T) -> Self
    native def pop -> T?
    native def shift -> T?
    native def unshift(value: T) -> Self
    native def insert(index: Int, value: T) -> Self
    native def concat(other: Array[T]) -> Self
    native def [](index: Int) -> T
    native def []?(index: Int) -> T?
    native def []=(index: Int, value: T) -> T
    native def first -> T?
    native def last -> T?
    native def size -> Int
    native def length -> Int
    native def empty? -> Bool
    native def include?(value: Object) -> Bool
    native def delete(value: T) -> Self
    native def delete_at(index: Int) -> T?
    native def clear -> Self
    native def reverse! -> Self
    native def sort! -> Self
    native def map!(&: (T) -> T) -> Self
    native def select!(&: (T) -> Object) -> Self
    native def reject!(&: (T) -> Object) -> Self
    native def each(&: (T) -> Nil) -> Nil
    native def each_with_index(&: (T, Int) -> Nil) -> Nil
    native def push(*values: T) -> Self
    native def [](range: Range[Int]) -> Array[T]
    native def first(n: Int) -> Array[T]
    native def last(n: Int) -> Array[T]
    native def index(value: T) -> Int?
    native def join(separator: String = "") -> String
    native def sort!(&: (T, T) -> Int) -> Self
    native def sort_by![U: Comparable[U]](&: (T) -> U) -> Self
    native def uniq! -> Self
    native def compact! -> Self
    native def shuffle! -> Self
    native def rotate!(count: Int = 1) -> Self
    native def fill(value: T) -> Self
    native def fill(value: T, start: Int, length: Int) -> Self
    native def replace(other: Array[T]) -> Self
    native def slice!(start: Int, length: Int) -> Array[T]
    native def delete_if(&: (T) -> Object) -> Self
    native def keep_if(&: (T) -> Object) -> Self
    def freeze -> Array[T] = to_a
    native def to_a -> Array[T]
    native def snapshot -> Array[T]
    native def to_s -> String
    native def inspect -> String
  end
end

# Arrays of comparable elements compare element by element (as tuples
# do, whose elements may differ in type; the checker handles those).
extension Array[T: Comparable[T]]
  include Comparable[Array[T]]
  native def <=>(other: Array[T]) -> Int
end

class Hash[K, out V]
  include Shareable
  include Enumerable[[K, V]]

  native def self.new -> Hash[K, V]
  native def self.build(&: (Hash::Builder[K, V]) -> Nil) -> Hash[K, V]

  native def each(&: ([K, V]) -> Nil) -> Nil
  native def each_pair(&: (K, V) -> Nil) -> Nil
  native def each_key(&: (K) -> Nil) -> Nil
  native def each_value(&: (V) -> Nil) -> Nil
  native def [](key: K) -> V
  native def []?(key: K) -> V?
  native def fetch[W >: V](key: K, default: W) -> W
  native def fetch[W >: V](key: K, &: (K) -> W) -> W
  native def dig(key: K) -> V?
  native def key?(key: K) -> Bool
  native def has_key?(key: K) -> Bool
  native def include?(key: Object) -> Bool
  native def member?(key: Object) -> Bool
  native def value?(value: Object) -> Bool
  native def has_value?(value: Object) -> Bool
  native def key(value: Object) -> K?
  native def values_at(*keys: K) -> Array[V?]
  native def fetch_values(*keys: K) -> Array[V]
  native def compact -> Hash[K, V]
  native def except(*keys: K) -> Hash[K, V]
  native def slice(*keys: K) -> Hash[K, V]
  def filter(&: (K, V) -> Object) -> Hash[K, V] = select { |k, v| yield(k, v) }
  def delete_if(&: (K, V) -> Object) -> Hash[K, V] = reject { |k, v| yield(k, v) }
  def keep_if(&: (K, V) -> Object) -> Hash[K, V] = select { |k, v| yield(k, v) }
  native def keys -> Array[K]
  native def values -> Array[V]
  native def size -> Int
  native def length -> Int
  native def empty? -> Bool
  native def put[W >: V](key: K, value: W) -> Hash[K, W]
  native def delete(key: K) -> Hash[K, V]
  native def merge[W >: V](other: Hash[K, W]) -> Hash[K, W]
  native def merge[W >: V](other: Hash[K, W], &: (K, W, W) -> W) -> Hash[K, W]
  native def update[W >: V](key: K, &: (V?) -> W) -> Hash[K, W]
  native def select(&: (K, V) -> Object) -> Hash[K, V]
  native def reject(&: (K, V) -> Object) -> Hash[K, V]
  native def transform_values[U](&: (V) -> U) -> Hash[K, U]
  native def transform_keys[U](&: (K) -> U) -> Hash[U, V]
  native def invert[W >: V] -> Hash[W, K]
  native def to_a -> Array[[K, V]]
  native def to_h -> Hash[K, V]
  native def to_s -> String
  native def inspect -> String
  native def ==(other: Object) -> Bool
  native def hash -> Int

  class Builder[K, V]
    include Unshareable
    include Enumerable[[K, V]]

    native def self.new -> Hash::Builder[K, V]
    native def [](key: K) -> V
    native def []?(key: K) -> V?
    native def []=(key: K, value: V) -> V
    native def store(key: K, value: V) -> V
    native def fetch(key: K, default: V) -> V
    native def delete(key: K) -> V?
    native def key?(key: K) -> Bool
    native def keys -> Array[K]
    native def values -> Array[V]
    native def size -> Int
    native def empty? -> Bool
    native def clear -> Self
    native def merge!(other: Hash[K, V]) -> Self
    native def merge!(other: Hash[K, V], &: (K, V, V) -> V) -> Self
    native def update(key: K, &: (V?) -> V) -> Self
    native def each(&: ([K, V]) -> Nil) -> Nil
    native def each_pair(&: (K, V) -> Nil) -> Nil
    native def each_key(&: (K) -> Nil) -> Nil
    native def each_value(&: (V) -> Nil) -> Nil
    native def fetch(key: K, &: (K) -> V) -> V
    native def has_key?(key: K) -> Bool
    native def include?(key: Object) -> Bool
    native def value?(value: V) -> Bool
    native def length -> Int
    native def select!(&: (K, V) -> Object) -> Self
    native def reject!(&: (K, V) -> Object) -> Self
    native def delete_if(&: (K, V) -> Object) -> Self
    native def keep_if(&: (K, V) -> Object) -> Self
    native def transform_values!(&: (V) -> V) -> Self
    native def compact! -> Self
    native def replace(other: Hash[K, V]) -> Self
    def freeze -> Hash[K, V] = to_h
    native def to_h -> Hash[K, V]
    native def snapshot -> Hash[K, V]
    native def to_s -> String
    native def inspect -> String
  end
end

class Set[out T]
  include Shareable
  include Enumerable[T]

  native def self.new -> Set[T]
  native def self.[](*items: T) -> Set[T]
  native def self.build(&: (Set::Builder[T]) -> Nil) -> Set[T]

  native def each(&: (T) -> Nil) -> Nil
  native def add[U >: T](value: U) -> Set[U]
  native def delete(value: Object) -> Set[T]
  native def include?(value: Object) -> Bool
  native def size -> Int
  native def length -> Int
  native def empty? -> Bool
  native def |[U >: T](other: Set[U]) -> Set[U]
  native def &(other: Set[Object]) -> Set[T]
  native def -(other: Set[Object]) -> Set[T]
  native def ^[U >: T](other: Set[U]) -> Set[U]
  native def subset?(other: Set[Object]) -> Bool
  native def superset?(other: Set[Object]) -> Bool
  native def proper_subset?(other: Set[Object]) -> Bool
  native def proper_superset?(other: Set[Object]) -> Bool
  native def disjoint?(other: Set[Object]) -> Bool
  native def intersect?(other: Set[Object]) -> Bool
  native def merge[U >: T](items: Array[U]) -> Set[U]
  # The set with the value added, or `nil` when it was already a member.
  native def add?[U >: T](value: U) -> Set[U]?
  native def select(&: (T) -> Object) -> Set[T]
  native def reject(&: (T) -> Object) -> Set[T]
  native def to_a -> Array[T]
  native def to_s -> String
  native def inspect -> String
  native def ==(other: Object) -> Bool
  native def hash -> Int
  def self.new(items: Array[T]) -> Set[T] = Set[T].new.merge(items)
  def +[U >: T](other: Set[U]) -> Set[U] = self | other
  def union[U >: T](other: Set[U]) -> Set[U] = self | other
  def intersection(other: Set[Object]) -> Set[T] = self & other
  def difference(other: Set[Object]) -> Set[T] = self - other
  def <=(other: Set[Object]) -> Bool = subset?(other)
  def >=(other: Set[Object]) -> Bool = superset?(other)
  def <(other: Set[Object]) -> Bool = proper_subset?(other)
  def >(other: Set[Object]) -> Bool = proper_superset?(other)
  def member?(value: Object) -> Bool = include?(value)
  def filter(&: (T) -> Object) -> Set[T] = select { |x| yield(x) }
  def delete_if(&: (T) -> Object) -> Set[T] = reject { |x| yield(x) }
  def keep_if(&: (T) -> Object) -> Set[T] = select { |x| yield(x) }

  class Builder[T]
    include Unshareable
    include Enumerable[T]

    native def self.new -> Set::Builder[T]
    native def add?(value: T) -> Bool
    native def merge(items: Array[T]) -> Self
    native def merge(other: Set[T]) -> Self
    native def subtract(items: Array[T]) -> Self
    native def subtract(other: Set[T]) -> Self
    native def clear -> Self
    native def replace(other: Set[T]) -> Self
    native def select!(&: (T) -> Object) -> Self
    native def reject!(&: (T) -> Object) -> Self
    native def delete_if(&: (T) -> Object) -> Self
    native def keep_if(&: (T) -> Object) -> Self
    native def length -> Int
    def freeze -> Set[T] = to_set
    native def <<(value: T) -> Self
    native def add(value: T) -> Self
    native def delete(value: T) -> Self
    native def include?(value: Object) -> Bool
    native def size -> Int
    native def empty? -> Bool
    native def each(&: (T) -> Nil) -> Nil
    native def to_set -> Set[T]
    native def to_a -> Array[T]
    native def to_s -> String
    native def inspect -> String
  end
end

class Range[T]
  include Shareable
  include Enumerable[T]

  native def each(&: (T) -> Nil) -> Nil
  native def begin -> T?
  native def end -> T?
  native def first -> T?
  native def last -> T?
  native def exclude_end? -> Bool
  native def include?(value: Object) -> Bool
  native def cover?(value: T) -> Bool
  native def size -> Int
  native def empty? -> Bool
  native def step(step: Int, &: (T) -> Nil) -> Nil
  native def step(step: Int) -> Enumerator[T]
  native def each -> Enumerator[T]
  native def reverse_each(&: (T) -> Nil) -> Nil
  native def to_a -> Array[T]
  native def to_s -> String
  native def inspect -> String
  native def ==(other: Object) -> Bool
  native def hash -> Int
  def last(n: Int) -> Array[T] = to_a.last(n)
end

class Proc
  include Unshareable
  native def arity -> Int
  # Lowering calls it on a block or lambda made as a shareable procedure.
  native def __copy_captures -> Proc
end

class Exception
  include Shareable

  @message: String

  attr_reader :message

  def initialize(message: String = "")
    @message = message
  end

  native def backtrace -> Array[String]
  native def full_message -> String
  native def cause -> Exception?
  def to_s -> String = message
  native def inspect -> String
end

class StandardError < Exception
end

class RuntimeError < StandardError
end

class ArgumentError < StandardError
end

class TypeError < StandardError
end

class IndexError < StandardError
end

class KeyError < IndexError
end

class RangeError < StandardError
end

# An `Int` operation whose result does not fit in 64 bits.
class OverflowError < RangeError
end

class ZeroDivisionError < StandardError
end

class FrozenError < StandardError
end

class IOError < StandardError
end

class EOFError < IOError
end

class SystemCallError < StandardError
end

class NoMatchingPatternError < StandardError
end

class NotImplementedError < StandardError
end

class StopIteration < StandardError
end

class SystemExit < Exception
end

class SystemStackError < Exception
end

class NoMemoryError < Exception
end

class FloatDomainError < RangeError
end

class DeadlockError < Exception
end

enum Result[T, E]
  variant Ok(value: T)
  variant Err(error: E)

  def ok? -> Bool
    case self
    in Ok then true
    in Err then false
    end
  end

  def err? -> Bool = !ok?

  def unwrap -> T
    case self
    in Ok(value:) then value
    in Err(error:) then raise RuntimeError, "unwrap called on an Err: #{error}"
    end
  end

  def unwrap_or(default: T) -> T
    case self
    in Ok(value:) then value
    in Err then default
    end
  end

  def map[U](&: (T) -> U) -> Result[U, E]
    case self
    in Ok(value:) then Result::Ok[U, E].new(yield(value))
    in Err(error:) then Result::Err[U, E].new(error)
    end
  end

  def and_then[U](&: (T) -> Result[U, E]) -> Result[U, E]
    case self
    in Ok(value:) then yield(value)
    in Err(error:) then Result::Err[U, E].new(error)
    end
  end

  # `and_then` under the name `for` comprehensions desugar to.
  def flat_map[U](&: (T) -> Result[U, E]) -> Result[U, E] = and_then { |v| yield(v) }
end

class Task[out T: Shareable]
  include Shareable

  native def self.scope[R](&: (Scope) -> R) -> R
  native def self.sleep(duration: Duration) -> Nil
  native def self.yield -> Nil
  native def self.current -> Task[Object]
  native def self.timeout[R](duration: Duration, &: () -> R) -> R
  native def self.blocking[R](&: () -> R) -> R
  native def self.check_cancel -> Nil

  native def await -> T
  native def cancel -> Nil
  native def done? -> Bool
  native def cancelled? -> Bool

  class Cancelled < Exception
  end

  class Timeout < StandardError
  end
end

class Scope
  include Shareable

  native def spawn[T](&: () -> T) -> Task[T]
  native def cancel -> Nil
end

class Channel[T: Shareable]
  include Shareable
  include Enumerable[T]

  native def self.new(capacity: Int = 0) -> Channel[T]
  native def self.select_loop(&: (Selector) -> Nil) -> Nil

  native def send(value: T) -> Nil
  native def receive -> T
  native def receive? -> T?
  native def try_send(value: T) -> Bool
  native def try_receive -> T?
  native def close -> Nil
  native def closed? -> Bool
  native def empty? -> Bool
  native def size -> Int
  native def each(&: (T) -> Nil) -> Nil

  class Closed < StandardError
  end
end

class Selector
  include Unshareable

  native def receive[T](channel: Channel[T], &: (T) -> Nil) -> Nil
  native def send[T](channel: Channel[T], value: T, &: () -> Nil) -> Nil
  native def after(duration: Duration, &: () -> Nil) -> Nil
  native def default(&: () -> Nil) -> Nil
  native def stop -> Nil
end

class Atom[T: Shareable]
  include Shareable

  native def self.new(value: T) -> Atom[T]
  native def value -> T
  native def get -> T
  native def set(value: T) -> Nil
  native def update(&: (T) -> T) -> T
  native def compare_and_set(expected: T, replacement: T) -> Bool
end

# A stream: the standard streams and open files. `gets`/`read`/`readline`
# raise EOFError at the end; `gets?`/`read?` return nil.
class IO
  include Shareable

  native def puts(*args: Object) -> Nil
  native def print(*args: Object) -> Nil
  native def printf(format: String, *args: Object) -> Nil
  native def write(*args: Object) -> Int
  native def <<(value: Object) -> Self
  native def gets -> String
  native def gets? -> String?
  native def readline -> String
  native def readlines -> Array[String]
  native def read -> String
  native def read(length: Int) -> String
  native def read? -> String?
  native def read?(length: Int) -> String?
  native def getc -> String?
  # What is available now, up to `length` bytes (at least one byte, or
  # EOFError / nil at the end).
  native def readpartial(length: Int) -> String
  native def readpartial?(length: Int) -> String?
  # Raw bytes, up to `length` (empty at the end). `write` accepts Bytes.
  native def read_bytes(length: Int) -> Bytes
  native def each_line(&: (String) -> Nil) -> Nil
  native def close_write -> Nil
  native def close_read -> Nil
  native def flush -> Nil
  native def close -> Nil
  native def closed? -> Bool
  native def eof? -> Bool
  native def rewind -> Nil
  native def tty? -> Bool
  native def path -> String?
  native def to_s -> String
  native def inspect -> String
end

# Files, by path. Operating-system failures (a missing file, say) raise
# SystemCallError; `File.open` with a block closes the file afterwards.
class File
  include Unshareable

  SEPARATOR = "/"

  native def self.open(path: String, mode: String = "r") -> IO
  native def self.open[R](path: String, mode: String = "r", &: (IO) -> R) -> R
  native def self.read(path: String) -> String
  native def self.read_bytes(path: String) -> Bytes
  native def self.write(path: String, content: String) -> Int
  native def self.write(path: String, content: Bytes) -> Int
  native def self.append(path: String, content: String) -> Int
  native def self.append(path: String, content: Bytes) -> Int
  native def self.exist?(path: String) -> Bool
  native def self.file?(path: String) -> Bool
  native def self.directory?(path: String) -> Bool
  native def self.symlink?(path: String) -> Bool
  native def self.readable?(path: String) -> Bool
  native def self.writable?(path: String) -> Bool
  native def self.executable?(path: String) -> Bool
  native def self.size(path: String) -> Int
  native def self.mtime(path: String) -> Time
  native def self.delete(*paths: String) -> Int
  native def self.rename(from: String, to: String) -> Int
  native def self.copy(from: String, to: String) -> Int
  native def self.readlines(path: String, chomp: Bool = false) -> Array[String]
  native def self.each_line(path: String, &: (String) -> Nil) -> Nil
  native def self.foreach(path: String, &: (String) -> Nil) -> Nil
  native def self.basename(path: String, suffix: String = "") -> String
  native def self.dirname(path: String) -> String
  native def self.extname(path: String) -> String
  native def self.split(path: String) -> [String, String]
  native def self.join(*parts: String) -> String
  native def self.expand_path(path: String, directory: String? = nil) -> String
  native def self.absolute_path(path: String) -> String
end

module Dir
  native def self.pwd -> String
  native def self.getwd -> String
  native def self.home -> String
  native def self.tmpdir -> String
  native def self.chdir(path: String) -> Int
  native def self.chdir[R](path: String, &: (String) -> R) -> R
  native def self.exist?(path: String) -> Bool
  native def self.empty?(path: String) -> Bool
  native def self.mkdir(path: String) -> Int
  # Creates the missing parents too (`mkdir -p`).
  native def self.mkdir_p(path: String) -> Int
  native def self.rmdir(path: String) -> Int
  # Removes a directory and everything in it (`rm -rf`).
  native def self.rm_rf(path: String) -> Int
  native def self.entries(path: String) -> Array[String]
  native def self.children(path: String) -> Array[String]
  native def self.each_child(path: String, &: (String) -> Nil) -> Nil
  # `*`, `?`, `[...]`, `**` and `{a,b}`; the results are sorted.
  native def self.glob(pattern: String, base: String? = nil) -> Array[String]
  native def self.glob(patterns: Array[String], base: String? = nil) -> Array[String]
end

module Process
  # What a child process produced: `Process.run("ls", "-l")`,
  # `Process.sh("ls | wc -l")`.
  data Output(status: Int, stdout: String, stderr: String)
    native def success? -> Bool
  end

  native def self.argv -> Array[String]
  native def self.env -> Hash[String, String]
  native def self.pid -> Int
  native def self.stdin -> IO
  native def self.stdout -> IO
  native def self.stderr -> IO
  native def self.clock -> Float
  native def self.run(*command: String) -> Process::Output
  native def self.sh(script: String) -> Process::Output
end

