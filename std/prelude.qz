# The Quarz prelude: declarations of the built-in classes.
#
# `native def` declares a method implemented by the runtime (registered under
# the key `Class#method` or `Class.method`). Methods with bodies are ordinary
# Quarz code. Extensions declared here are active everywhere.

# A marker: values of the class can be shared between tasks. Derived
# automatically for user classes; the built-in classes declare it.
module Shareable
end

# A marker: the builders, which no other task may see.
module Unshareable
end

# A marker for DSL receivers: inside a block whose receiver includes it,
# the receivers of enclosing blocks that include it are not implicit
# (a call must name them), so nested builders do not leak into each
# other. The enclosing method's `self` stays implicit.
module DslScope
end

# The root of the class hierarchy: every value is an `Object`, and the
# methods here apply to all of them. It includes `Kernel`, whose private
# functions (`puts`, `rand`, `exit`) are called without a receiver.
class Object
  include Kernel

  # Whether the value equals `other`. Built-in values (numbers, strings,
  # arrays, hashes, `data` values, enum variants) compare by contents; an
  # instance of a class compares by identity unless the class defines `==`.
  #
  # ```
  # [1, "a"] == [1, "a"]   # => true
  # Object.new == Object.new   # => false
  # ```
  native def ==(other: Object) -> Bool
  # The negation of `==`.
  native def !=(other: Object) -> Bool
  # Whether the value is the same object as `other`: identity, whatever
  # `==` says. Meaningful for instances of classes and builders: numbers,
  # `nil` and symbols are the same object when they are equal, and equal
  # immutable values (strings from the same literal) may be shared.
  native def equal?(other: Object) -> Bool
  # A hash code: values that are `==` have the same one. A class that
  # defines `==` defines `hash` to agree with it.
  native def hash -> Int
  # The value as a string, for `puts` and interpolation. For an instance of
  # a class, the class name in the form `#<Point>`; for an exception, its
  # message; for a `data` value or an enum variant, the default `inspect`.
  # It does not call an `inspect` the class defines.
  native def to_s -> String
  # A developer-readable representation, as `p` prints it: strings quoted,
  # collections with their elements' `inspect`, an object with its fields
  # (`#<Point @x=1, @y=2>`).
  native def inspect -> String
  # Whether the value is `nil`. Narrows the receiver's type in the branch
  # where it is not.
  native def nil? -> Bool
  # The class of the value, as a `Class` value.
  #
  # ```
  # 1.class.name        # => "Int"
  # [1].class.name      # => "Array"
  # ```
  native def class -> Class
  # `x.is_a?(klass)` with a class value: whether `x` is an instance of it
  # or of a subclass. (`x.is_a?(Int)`, with a type, narrows `x`.)
  native def is_a?(klass: Class) -> Bool
  # Whether the value cannot be changed: false only for the builders
  # `Array::Builder`, `Hash::Builder`, `Set::Builder`, `String::Builder`
  # and `Bytes::Builder`. `true` for every other value, instances of
  # classes with `var` fields included.
  native def frozen? -> Bool
  # A copy of the value. A builder or an instance of a class is copied
  # (shallowly: the fields refer to the same values); an immutable built-in
  # value (an array, a string, ...) is returned as it is.
  native def dup -> Self
  # Run a block with a receiver (`self.(...) -> R`) with `self` = this object.
  #
  # ```
  # 5.instance_exec { self + 1 }              # => 6
  # 5.instance_exec(2) { |n| self * n }       # => 10
  # ```
  native def instance_exec[R](&: Self.() -> R) -> R
  # :ditto:
  native def instance_exec[A, R](a: A, &: Self.(A) -> R) -> R
  # :ditto:
  native def instance_exec[A, B, R](a: A, b: B, &: Self.(A, B) -> R) -> R

  # Yields the receiver to the block and returns the receiver, to look at a
  # value in the middle of a chain.
  def tap(&: (Self) -> Nil) -> Self
    yield self
    self
  end

  # The block's result for the receiver.
  #
  # ```
  # "hello".then { |s| s.size }   # => 5
  # ```
  def then[U](&: (Self) -> U) -> U = yield(self)
end

# A class as a value, as `x.class` returns it and `is_a?` takes it.
class Class
  include Shareable
  # The class's full name, with its namespace (`"Task::Cancelled"`) and
  # without type arguments (`[1].class.name` is `"Array"`).
  native def name -> String
end

# The class of `nil`, the absence of a value. A type `T?` is `T` or `Nil`.
class Nil
  include Shareable
  # An empty array.
  native def to_a -> Array[Nothing]
  # Always `false`: `nil` is falsy. Unlike `&&`, it evaluates `other`.
  native def &(other: Object) -> Bool
  # Whether `other` is truthy (neither `nil` nor `false`). Unlike `||`, it
  # evaluates `other` and returns a `Bool`.
  native def |(other: Object) -> Bool
end

# The class of `true` and `false`.
class Bool
  include Shareable
  # Logical and. Unlike `&&`, both operands are evaluated.
  native def &(other: Bool) -> Bool
  # Logical or. Unlike `||`, both operands are evaluated.
  native def |(other: Bool) -> Bool
  # Exclusive or: whether exactly one of the operands is `true`.
  native def ^(other: Bool) -> Bool
end

# The comparison operators, `between?` and `clamp`, for a class that
# includes it and defines `<=>`. `T` is the type compared with, usually
# the class itself (`include Comparable[Version]`).
#
# ```
# class DocVersion_Comparable
#   include Comparable[DocVersion_Comparable]
#   @n: Int
#   attr_reader :n
#   def initialize(n: Int)
#     @n = n
#   end
#   def <=>(other: DocVersion_Comparable) -> Int = n <=> other.n
# end
# DocVersion_Comparable.new(1) < DocVersion_Comparable.new(2)   # => true
# ```
module Comparable[T]
  # Compares with `other`: negative when the receiver is less, zero when
  # equal, positive when greater. The class including `Comparable` defines
  # it.
  abstract def <=>(other: T) -> Int

  # Whether the receiver is less than `other`.
  def <(other: T) -> Bool = (self <=> other) < 0
  # Whether the receiver is less than or equal to `other`.
  def <=(other: T) -> Bool = (self <=> other) <= 0
  # Whether the receiver is greater than `other`.
  def >(other: T) -> Bool = (self <=> other) > 0
  # Whether the receiver is greater than or equal to `other`.
  def >=(other: T) -> Bool = (self <=> other) >= 0
  # Whether the receiver is in `min..max`, both ends included.
  def between?(min: T, max: T) -> Bool = self >= min && self <= max

  # The receiver if it is between `min` and `max`, otherwise the nearer
  # bound. Unlike Ruby, `min` greater than `max` is not an error: a
  # receiver below `min` gives `min`, otherwise one above `max` gives
  # `max`.
  #
  # ```
  # 5.clamp(1, 3)   # => 3
  # 0.clamp(1, 3)   # => 1
  # 2.clamp(1, 3)   # => 2
  # ```
  native def clamp(min: T, max: T) -> Self
  # The receiver limited to `range`, whose ends may be open (`1..`,
  # `..3`).
  #
  # ## Raises
  #
  # `ArgumentError` for an exclusive range (`1...3`).
  native def clamp(range: Range[T]) -> Self
end

# A 64-bit integer: arithmetic that leaves the range raises
# `OverflowError`. `Integer` is the integer of any size.
#
# An integer literal is an `Int` (an `Integer` where one is expected, or
# when it is too large for an `Int`). Arithmetic with a `Float` gives a
# `Float`, with an `Integer` an `Integer`. As in Ruby, `/` rounds toward
# negative infinity and `%` takes the divisor's sign, so that
# `a == (a / b) * b + a % b`.
#
# ```
# 9223372036854775807 + 1        # raises OverflowError
# 9223372036854775807.to_integer + 1
# # => 9223372036854775808
# -7 / 2                         # => -4
# -7 % 2                         # => 1
# 7 / 2.0                        # => 3.5
# ```
class Int
  include Shareable
  include Comparable[Int]

  # The sum; `OverflowError` when it leaves the `Int` range.
  native def +(other: Int) -> Int
  # The sum, as a `Float`.
  native def +(other: Float) -> Float
  # The sum, as an `Integer`.
  native def +(other: Integer) -> Integer
  # The difference; `OverflowError` when it leaves the `Int` range.
  native def -(other: Int) -> Int
  # The difference, as a `Float`.
  native def -(other: Float) -> Float
  # The difference, as an `Integer`.
  native def -(other: Integer) -> Integer
  # The product; `OverflowError` when it leaves the `Int` range.
  native def *(other: Int) -> Int
  # The product, as a `Float`.
  native def *(other: Float) -> Float
  # The product, as an `Integer`.
  native def *(other: Integer) -> Integer
  # The quotient, rounded toward negative infinity (Ruby's floored
  # division, not C's truncating one).
  #
  # ## Raises
  #
  # `ZeroDivisionError` when `other` is 0, and `OverflowError` for the
  # smallest `Int` divided by -1.
  #
  # ```
  # 7 / 2     # => 3
  # -7 / 2    # => -4
  # 7 / -2    # => -4
  # 7 / 0     # raises ZeroDivisionError
  # ```
  native def /(other: Int) -> Int
  # The quotient, as a `Float`: dividing by 0.0 gives an infinity or NaN
  # and raises nothing (`7 / 0.0` is `Float::INFINITY`).
  native def /(other: Float) -> Float
  # The quotient, as an `Integer`, rounded toward negative infinity;
  # `ZeroDivisionError` when `other` is 0.
  native def /(other: Integer) -> Integer
  # The modulo: the remainder of `/`, with the sign of `other` (Ruby's,
  # not C's). `ZeroDivisionError` when `other` is 0.
  #
  # ```
  # 7 % 3     # => 1
  # -7 % 3    # => 2
  # 7 % -3    # => -2
  # 7 % 0     # raises ZeroDivisionError
  # ```
  native def %(other: Int) -> Int
  # The modulo, as a `Float`, with the sign of `other`; NaN when `other`
  # is 0.0 (`-7 % 2.5` is 0.5).
  native def %(other: Float) -> Float
  # The modulo, as an `Integer`, with the sign of `other`;
  # `ZeroDivisionError` when `other` is 0.
  native def %(other: Integer) -> Integer
  # `self` raised to the power `other`. `0 ** 0` is 1.
  #
  # ## Raises
  #
  # `OverflowError` when the power leaves the `Int` range (use
  # `to_integer` first for a large one), `ArgumentError` for a negative
  # `other` (write `2.0 ** -1` for a fraction).
  #
  # ```
  # 2 ** 10                 # => 1024
  # 2 ** 63                 # raises OverflowError
  # 2.to_integer ** 64      # => 18446744073709551616
  # 2 ** -1                 # raises ArgumentError
  # ```
  native def **(other: Int) -> Int
  # `self` raised to the power `other`, as a `Float`; NaN for a negative
  # `self` and a fractional `other` (where Ruby gives a complex number).
  native def **(other: Float) -> Float
  # The negation; `OverflowError` for the smallest `Int`, whose negation
  # does not fit.
  native def -@ -> Int
  # `self`.
  native def +@ -> Int
  # The bitwise complement, `-self - 1`.
  native def ~ -> Int
  # The bitwise AND, in two's complement.
  native def &(other: Int) -> Int
  # The bitwise OR, in two's complement.
  native def |(other: Int) -> Int
  # The bitwise exclusive OR, in two's complement.
  native def ^(other: Int) -> Int
  # `self` shifted left by `other` bits (right by `-other` when `other` is
  # negative); `OverflowError` when the result leaves the `Int` range.
  #
  # ```
  # 1 << 10       # => 1024
  # 1 << 63       # raises OverflowError
  # 8 << -2       # => 2
  # ```
  native def <<(other: Int) -> Int
  # `self` shifted right by `other` bits, an arithmetic shift: the sign is
  # kept, so a negative number rounds toward negative infinity
  # (`-7 >> 1` is -4) and a shift of 64 or more gives 0 or -1. A negative
  # `other` shifts left, as `<<` by `-other` does, with its
  # `OverflowError` when the result leaves the `Int` range.
  #
  # ```
  # -7 >> 1       # => -4
  # 5 >> -1       # => 10
  # 1 >> -63      # raises OverflowError
  # ```
  native def >>(other: Int) -> Int
  # -1, 0 or 1 as `self` is less than, equal to or greater than `other`.
  native def <=>(other: Int) -> Int
  # -1, 0 or 1 as `self` is less than, equal to or greater than `other`.
  # NaN comes after every number, as in `Float#<=>`: `1 <=> Float::NAN`
  # is -1 (where Ruby gives nil).
  native def <=>(other: Float) -> Int
  # -1, 0 or 1 as `self` is less than, equal to or greater than `other`.
  native def <=>(other: Integer) -> Int
  # Int's own `==`/`!=` (numeric equality): compiled code compares inline.

  # Whether `other` is a number of the same value: `1 == 1.0` and
  # `1 == 1.to_integer` are true, `1 == "1"` is false.
  native def ==(other: Object) -> Bool
  # Whether `other` is not a number of the same value (`!(self == other)`).
  native def !=(other: Object) -> Bool
  # Whether `self` is less than `other`.
  native def <(other: Int) -> Bool
  # Whether `self` is less than or equal to `other`.
  native def <=(other: Int) -> Bool
  # Whether `self` is greater than `other`.
  native def >(other: Int) -> Bool
  # Whether `self` is greater than or equal to `other`.
  native def >=(other: Int) -> Bool
  # Whether `self` is less than `other`; false when `other` is NaN
  # (although `<=>` orders NaN last).
  native def <(other: Float) -> Bool
  # Whether `self` is less than or equal to `other`; false when `other` is
  # NaN.
  native def <=(other: Float) -> Bool
  # Whether `self` is greater than `other`; false when `other` is NaN
  # (although `<=>` orders NaN last).
  native def >(other: Float) -> Bool
  # Whether `self` is greater than or equal to `other`; false when `other`
  # is NaN.
  native def >=(other: Float) -> Bool
  # Whether `self` is less than `other`.
  native def <(other: Integer) -> Bool
  # Whether `self` is less than or equal to `other`.
  native def <=(other: Integer) -> Bool
  # Whether `self` is greater than `other`.
  native def >(other: Integer) -> Bool
  # Whether `self` is greater than or equal to `other`.
  native def >=(other: Integer) -> Bool
  # The absolute value; `OverflowError` for the smallest `Int`, whose
  # absolute value does not fit.
  native def abs -> Int
  # Whether `self` is less than 0.
  native def negative? -> Bool
  # Whether `self` is greater than 0.
  native def positive? -> Bool
  # Whether `self` is 0.
  native def zero? -> Bool
  # Whether `self` is divisible by 2 (negative numbers included).
  native def even? -> Bool
  # Whether `self` is not divisible by 2.
  native def odd? -> Bool
  # `self + 1`; `OverflowError` for the largest `Int`.
  native def succ -> Int
  # `self - 1`; `OverflowError` for the smallest `Int`.
  native def pred -> Int
  # `self`.
  native def to_i -> Int
  # `self` as an `Integer`, whose arithmetic does not overflow.
  #
  # ```
  # 9223372036854775807.to_integer * 2   # => 18446744073709551614
  # ```
  native def to_integer -> Integer
  # The nearest `Float`. Beyond 2**53 not every `Int` has one of its own:
  # `9007199254740993.to_f` is 9007199254740992.0.
  native def to_f -> Float
  # The decimal digits, after a `-` for a negative number.
  native def to_s -> String
  # The digits in `base`, from 2 to 36, with lowercase letters for the
  # digits above 9, after a `-` for a negative number; `ArgumentError`
  # for another base.
  #
  # ```
  # 255.to_s(16)      # => "ff"
  # 255.to_s(2)       # => "11111111"
  # (-255).to_s(16)   # => "-ff"
  # 255.to_s(37)      # raises ArgumentError
  # ```
  native def to_s(base: Int) -> String
  # The character of code point `self`, as a one-character `String`.
  # Unlike Ruby, a code point from 128 to 255 is a Unicode character too
  # (`233.chr` is "é"), not a byte.
  #
  # ## Raises
  #
  # `RangeError` for a negative number, a surrogate (0xD800 to 0xDFFF),
  # or a number above 0x10FFFF.
  #
  # ```
  # 65.chr        # => "A"
  # 0x3042.chr    # => "あ"
  # -1.chr        # raises RangeError
  # ```
  native def chr -> String
  # `self`: an `Int` is already whole.
  native def floor -> Int
  # :ditto:
  native def ceil -> Int
  # :ditto:
  native def round -> Int
  # :ditto:
  native def truncate -> Int
  # `[self / other, self % other]`: the quotient rounded toward negative
  # infinity and the modulo with the sign of `other`. `ZeroDivisionError`
  # when `other` is 0.
  #
  # ```
  # 7.divmod(2)       # => [3, 1]
  # (-7).divmod(2)    # => [-4, 1]
  # 7.divmod(-2)      # => [-4, -1]
  # ```
  native def divmod(other: Int) -> [Int, Int]
  # `self ** exp`, as `**`: `OverflowError` when it does not fit,
  # `ArgumentError` for a negative `exp`.
  native def pow(exp: Int) -> Int
  # `self ** exp` modulo `mod`, computed without the whole power: the
  # result has the sign of `mod`, as with `%`.
  #
  # ## Raises
  #
  # `RangeError` for a negative `exp` (as in Ruby), `ZeroDivisionError`
  # when `mod` is 0.
  #
  # ```
  # 2.pow(100, 1_000_000_007)   # => 976371285
  # 3.pow(4, -5)                # => -4
  # 2.pow(-1, 5)                # raises RangeError
  # ```
  native def pow(exp: Int, mod: Int) -> Int
  # The greatest common divisor, never negative; `0.gcd(0)` is 0.
  # `OverflowError` when it does not fit, which is only when it is 2**63:
  # the smallest `Int`'s with 0 or with itself.
  native def gcd(other: Int) -> Int
  # The least common multiple, never negative; 0 when either is 0.
  # `OverflowError` when it leaves the `Int` range (use `to_integer`
  # first for a large one).
  #
  # ```
  # 12.gcd(-18)                     # => 6
  # 4.lcm(-6)                       # => 12
  # 9223372036854775807.lcm(2)      # raises OverflowError
  # ```
  native def lcm(other: Int) -> Int
  # The number of bits `self` takes in two's complement, besides the sign
  # bit: 8 for 255 and for -256, 0 for 0 and for -1.
  native def bit_length -> Int
  # The decimal digits, the least significant first; `ArgumentError` for
  # a negative number.
  #
  # ```
  # 1234.digits   # => [4, 3, 2, 1]
  # 0.digits      # => [0]
  # ```
  native def digits -> Array[Int]
  # The digits in `base` (2 or more), the least significant first;
  # `ArgumentError` for a negative number or a `base` below 2.
  native def digits(base: Int) -> Array[Int]
  # Calls the block with each of 0 up to `self - 1`; with none when
  # `self` is not positive.
  native def times(&: (Int) -> Nil) -> Nil
  # An `Enumerator` of 0 up to `self - 1`.
  #
  # ```
  # 3.times.to_a                  # => [0, 1, 2]
  # 4.times.map { |i| i * i }     # => [0, 1, 4, 9]
  # ```
  native def times -> Enumerator[Int]
  # Calls the block with each of `self` up to `limit`, both included;
  # with none when `limit` is below `self`.
  native def upto(limit: Int, &: (Int) -> Nil) -> Nil
  # An `Enumerator` of `self` up to `limit`, both included.
  #
  # ```
  # 1.upto(4).to_a    # => [1, 2, 3, 4]
  # 3.upto(1).to_a    # => []
  # ```
  native def upto(limit: Int) -> Enumerator[Int]
  # Calls the block with each of `self` down to `limit`, both included;
  # with none when `limit` is above `self`.
  native def downto(limit: Int, &: (Int) -> Nil) -> Nil
  # An `Enumerator` of `self` down to `limit`, both included.
  native def downto(limit: Int) -> Enumerator[Int]
  # Calls the block with `self`, `self + step`, `self + 2 * step` and so on
  # while not past `limit` (above it for a positive `step`, below it for a
  # negative one); `ArgumentError` when `step` is 0.
  native def step(limit: Int, step: Int, &: (Int) -> Nil) -> Nil
  # An `Enumerator` of `self`, `self + step` and so on while not past
  # `limit`; `ArgumentError` when `step` is 0.
  #
  # ```
  # 1.step(10, 3).to_a    # => [1, 4, 7, 10]
  # 10.step(1, -4).to_a   # => [10, 6, 2]
  # ```
  native def step(limit: Int, step: Int) -> Enumerator[Int]
  # `Int.sqrt(n)` is the integer square root (Ruby's `Integer.sqrt`):
  # the largest `Int` whose square is at most `n`. `ArgumentError` for a
  # negative `n`.
  #
  # ```
  # Int.sqrt(24)    # => 4
  # Int.sqrt(25)    # => 5
  # Int.sqrt(-1)    # raises ArgumentError
  # ```
  native def self.sqrt(n: Int) -> Int
  # The quotient as a `Float`: `7.fdiv(2)` is 3.5, and dividing by 0 gives
  # an infinity or NaN instead of raising.
  native def fdiv(other: Int) -> Float
  # :ditto:
  native def fdiv(other: Float) -> Float
  # The quotient rounded toward positive infinity; `ZeroDivisionError`
  # when `other` is 0.
  #
  # ```
  # 7.ceildiv(2)      # => 4
  # (-7).ceildiv(2)   # => -3
  # ```
  native def ceildiv(other: Int) -> Int
  # Rounding to a negative number of digits: `1234.round(-2)` is 1200.
  #
  # `self` rounded to a multiple of `10 ** -digits`: `floor` toward
  # negative infinity, `ceil` toward positive infinity, `truncate` toward
  # 0, and `round` to the nearest, a half away from 0. A `digits` of 0 or
  # more gives `self`. `OverflowError` when the result leaves the `Int`
  # range.
  #
  # ```
  # 1234.floor(-2)        # => 1200
  # (-1234).floor(-2)     # => -1300
  # 1234.ceil(-2)         # => 1300
  # (-1234).truncate(-2)  # => -1200
  # 1250.round(-2)        # => 1300
  # (-1250).round(-2)     # => -1300
  # 1234.round(2)         # => 1234
  # ```
  native def floor(digits: Int) -> Int
  # :ditto:
  native def ceil(digits: Int) -> Int
  # :ditto:
  native def round(digits: Int) -> Int
  # :ditto:
  native def truncate(digits: Int) -> Int
  # The bit at position `bit` (0 is the lowest), 0 or 1, in two's
  # complement: a negative number has 1s above its highest bit
  # (`-1[100]` is 1). A negative `bit` gives 0.
  #
  # ```
  # 6[1]    # => 1
  # 6[0]    # => 0
  # ```
  native def [](bit: Int) -> Int
  # Whether the bit at position `bit` is 1 (`self[bit] == 1`).
  native def bit_set?(bit: Int) -> Bool
  # Whether every bit set in `mask` is set in `self` (true for a `mask`
  # of 0).
  native def allbits?(mask: Int) -> Bool
  # Whether some bit set in `mask` is set in `self`.
  native def anybits?(mask: Int) -> Bool
  # Whether no bit set in `mask` is set in `self`.
  native def nobits?(mask: Int) -> Bool
  # True: an `Int` is an integer (`Float#integer?` is false).
  def integer? -> Bool = true
  # `self`, the code point of `chr` (as in Ruby).
  def ord -> Int = self
  # A `Duration` of `self` milliseconds.
  #
  # ```
  # 1500.ms                # => 1500ms
  # 2.seconds + 500.ms     # => 2500ms
  # 3.minutes.to_f         # => 180.0
  # ```
  native def ms -> Duration
  # :ditto:
  native def milliseconds -> Duration
  # A `Duration` of `self` seconds.
  native def second -> Duration
  # :ditto:
  native def seconds -> Duration
  # A `Duration` of `self` minutes.
  native def minute -> Duration
  # :ditto:
  native def minutes -> Duration
  # A `Duration` of `self` hours.
  native def hour -> Duration
  # :ditto:
  native def hours -> Duration
  # A `Duration` of `self` days of 24 hours.
  native def day -> Duration
  # :ditto:
  native def days -> Duration
end

# An integer of any size: arithmetic with an `Int` gives an `Integer`
# (an `Int` becomes one only by `to_integer`, or as a literal where an
# `Integer` is expected, or too large for an `Int`).
#
# An `Integer` stays an `Integer` whatever its value; `to_i` gives the
# `Int` back. Division and modulo round as `Int`'s do.
#
# ```
# big = 2.to_integer ** 100
# big                     # => 1267650600228229401496703205376
# big.bit_length          # => 101
# (big + 1) % 7           # => 3
# big.to_i                # raises OverflowError
# 5.to_integer.to_i       # => 5
# ```
class Integer
  include Shareable
  include Comparable[Integer]

  # The sum.
  native def +(other: Int) -> Integer
  # :ditto:
  native def +(other: Integer) -> Integer
  # The sum, as a `Float`.
  native def +(other: Float) -> Float
  # The difference.
  native def -(other: Int) -> Integer
  # :ditto:
  native def -(other: Integer) -> Integer
  # The difference, as a `Float`.
  native def -(other: Float) -> Float
  # The product.
  native def *(other: Int) -> Integer
  # :ditto:
  native def *(other: Integer) -> Integer
  # The product, as a `Float`.
  native def *(other: Float) -> Float
  # The quotient, rounded toward negative infinity, as `Int#/`;
  # `ZeroDivisionError` when `other` is 0.
  native def /(other: Int) -> Integer
  # :ditto:
  native def /(other: Integer) -> Integer
  # The quotient, as a `Float`: dividing by 0.0 gives an infinity or NaN.
  native def /(other: Float) -> Float
  # The modulo, with the sign of `other`, as `Int#%`;
  # `ZeroDivisionError` when `other` is 0.
  native def %(other: Int) -> Integer
  # :ditto:
  native def %(other: Integer) -> Integer
  # The modulo, as a `Float`, with the sign of `other`; NaN when `other`
  # is 0.0.
  native def %(other: Float) -> Float
  # `self` raised to the power `other`; `ArgumentError` for a negative
  # `other`.
  native def **(other: Int) -> Integer
  # `self` raised to the power `other`, as a `Float`.
  native def **(other: Float) -> Float
  # The negation.
  native def -@ -> Integer
  # `self`.
  native def +@ -> Integer
  # -1, 0 or 1 as `self` is less than, equal to or greater than `other`.
  native def <=>(other: Int) -> Int
  # :ditto:
  native def <=>(other: Integer) -> Int
  # -1, 0 or 1 as `self` is less than, equal to or greater than `other`.
  # NaN comes after every number, as in `Float#<=>`: the result is -1
  # when `other` is NaN.
  native def <=>(other: Float) -> Int
  # Whether `other` is an `Int` or an `Integer` of the same value. Unlike
  # `Int#==`, a `Float` is never equal: `5.to_integer == 5.0` is false.
  native def ==(other: Object) -> Bool
  # Whether `other` is not equal to `self` (`!(self == other)`).
  native def !=(other: Object) -> Bool
  # Whether `self` is less than `other`.
  native def <(other: Int) -> Bool
  # Whether `self` is less than or equal to `other`.
  native def <=(other: Int) -> Bool
  # Whether `self` is greater than `other`.
  native def >(other: Int) -> Bool
  # Whether `self` is greater than or equal to `other`.
  native def >=(other: Int) -> Bool
  # Whether `self` is less than `other`.
  native def <(other: Integer) -> Bool
  # Whether `self` is less than or equal to `other`.
  native def <=(other: Integer) -> Bool
  # Whether `self` is greater than `other`.
  native def >(other: Integer) -> Bool
  # Whether `self` is greater than or equal to `other`.
  native def >=(other: Integer) -> Bool
  # Whether `self` is less than `other`; false when `other` is NaN
  # (although `<=>` orders NaN last).
  native def <(other: Float) -> Bool
  # Whether `self` is less than or equal to `other`; false when `other` is
  # NaN.
  native def <=(other: Float) -> Bool
  # Whether `self` is greater than `other`; false when `other` is NaN
  # (although `<=>` orders NaN last).
  native def >(other: Float) -> Bool
  # Whether `self` is greater than or equal to `other`; false when `other`
  # is NaN.
  native def >=(other: Float) -> Bool
  # The absolute value.
  native def abs -> Integer
  # Whether `self` is less than 0.
  native def negative? -> Bool
  # Whether `self` is greater than 0.
  native def positive? -> Bool
  # Whether `self` is 0.
  native def zero? -> Bool
  # Whether `self` is divisible by 2.
  native def even? -> Bool
  # Whether `self` is not divisible by 2.
  native def odd? -> Bool
  # `self + 1`.
  native def succ -> Integer
  # `self - 1`.
  native def pred -> Integer
  # The `Int`, or `OverflowError` when it does not fit.
  native def to_i -> Int
  # `self`.
  native def to_integer -> Integer
  # The nearest `Float`; `Float::INFINITY` (or its negation) beyond
  # `Float::MAX`.
  native def to_f -> Float
  # The decimal digits, after a `-` for a negative number.
  native def to_s -> String
  # The digits in `base`, from 2 to 36, with lowercase letters for the
  # digits above 9, after a `-` for a negative number; `ArgumentError`
  # for another base.
  native def to_s(base: Int) -> String
  # `[self / other, self % other]`, rounded as `Int#divmod`;
  # `ZeroDivisionError` when `other` is 0.
  native def divmod(other: Integer) -> [Integer, Integer]
  # `self ** exp` modulo `mod`, computed without the whole power: the
  # result has the sign of `mod`. `RangeError` for a negative `exp`,
  # `ZeroDivisionError` when `mod` is 0.
  native def pow(exp: Integer, mod: Integer) -> Integer
  # The greatest common divisor, never negative.
  native def gcd(other: Integer) -> Integer
  # The least common multiple, never negative; 0 when either is 0.
  native def lcm(other: Integer) -> Integer
  # The number of bits `self` takes in two's complement, besides the sign
  # bit, as `Int#bit_length`.
  native def bit_length -> Int
  # The integer square root: the largest `Integer` whose square is at
  # most `n`; `ArgumentError` for a negative `n`.
  #
  # ```
  # Integer.sqrt(10.to_integer ** 40)   # => 100000000000000000000
  # ```
  native def self.sqrt(n: Integer) -> Integer
  # The integer `text` writes in decimal: an optional sign, then digits
  # and `_`s, with whitespace around it ignored.
  #
  # ## Raises
  #
  # `ArgumentError` for any other text, an empty one or one with a prefix
  # such as `0x` included.
  #
  # ```
  # Integer.parse("123456789012345678901234567890")
  # # => 123456789012345678901234567890
  # Integer.parse(" -42 ")   # => -42
  # Integer.parse("1_000")   # => 1000
  # Integer.parse("0x1f")    # raises ArgumentError
  # ```
  native def self.parse(text: String) -> Integer
  # The integer `text` writes in `base` (2 to 36, letters in either
  # case), as `.parse` reads a decimal one; `ArgumentError` for an
  # invalid text or base.
  #
  # ```
  # Integer.parse("ff", 16)    # => 255
  # Integer.parse("-101", 2)   # => -5
  # ```
  native def self.parse(text: String, base: Int) -> Integer
  # True: an `Integer` is an integer.
  def integer? -> Bool = true
end

# A double-precision (IEEE 754 binary64) floating-point number.
#
# Unlike integer arithmetic, a `Float`'s raises nothing: it gives an
# infinity on overflow or division by zero, and `NAN` for an undefined
# result. Converting either to an integer (`to_i`, `floor`, `round`)
# raises `RangeError`. `inspect` and `to_s` write the shortest decimal
# that reads back as the same `Float`.
#
# ```
# 0.1 + 0.2              # => 0.30000000000000004
# 1.0 / 0                # => Infinity
# (0.0 / 0.0).nan?       # => true
# Float::INFINITY.to_i   # raises RangeError
# ```
class Float
  include Shareable
  include Comparable[Float]

  # Positive infinity, above every finite `Float`; `-INFINITY` is below
  # them all.
  INFINITY = 1.0 / 0.0
  # Not a number, the result of `0.0 / 0.0`: `==`, `<`, `<=`, `>` and `>=`
  # are false with it, `NAN == NAN` included, so test for it with `nan?`.
  # `<=>` puts it after every other number, so it sorts last.
  NAN = 0.0 / 0.0
  # The difference between 1.0 and the next `Float` above it, 2**-52.
  EPSILON = 2.220446049250313e-16
  # The largest finite `Float`; the most negative one is `-MAX`.
  MAX = 1.7976931348623157e308
  # The smallest positive normal `Float` (not the most negative one,
  # which is `-MAX`): subnormals go further down, to
  # `0.0.next_float`.
  MIN = 2.2250738585072014e-308
  # The number of decimal digits a `Float` always keeps: 15.
  DIG = 15

  # The sum.
  native def +(other: Float) -> Float
  # :ditto:
  native def +(other: Int) -> Float
  # The difference.
  native def -(other: Float) -> Float
  # :ditto:
  native def -(other: Int) -> Float
  # The product.
  native def *(other: Float) -> Float
  # :ditto:
  native def *(other: Int) -> Float
  # The quotient: dividing by zero gives `INFINITY`, `-INFINITY` or `NAN`
  # and raises nothing.
  #
  # ```
  # 7.5 / 2      # => 3.75
  # -1.0 / 0     # => -Infinity
  # ```
  native def /(other: Float) -> Float
  # :ditto:
  native def /(other: Int) -> Float
  # The modulo, with the sign of `other` as `Int#%`; NaN when `other` is
  # zero.
  #
  # ```
  # 7.5 % 2      # => 1.5
  # -7.5 % 2     # => 0.5
  # 7.5 % -2     # => -0.5
  # ```
  native def %(other: Float) -> Float
  # :ditto:
  native def %(other: Int) -> Float
  # `self` raised to the power `other`; NaN for a negative `self` and a
  # fractional `other` (where Ruby gives a complex number).
  native def **(other: Float) -> Float
  # :ditto:
  native def **(other: Int) -> Float
  # The negation.
  native def -@ -> Float
  # `self`.
  native def +@ -> Float
  # -1, 0 or 1 as `self` is less than, equal to or greater than `other`.
  #
  # This is a total order, where Ruby gives nil for NaN: NaN comes after
  # every other number, infinity included, and is equal to itself
  # (`NAN <=> NAN` is 0). So sorting puts NaN last, `min` ignores it
  # unless every element is NaN, and `max` gives NaN when there is one.
  # The operators `<`, `<=`, `>` and `>=` keep IEEE 754's comparisons
  # instead: each is false when either side is NaN. -0.0 and 0.0 are
  # equal.
  #
  # ```
  # 1.0 <=> 2                          # => -1
  # Float::NAN <=> Float::INFINITY     # => 1
  # Float::NAN <=> Float::NAN          # => 0
  # [3.0, Float::NAN, 1.0].sort        # => [1.0, 3.0, NaN]
  # [3.0, Float::NAN, 1.0].min         # => 1.0
  # [3.0, Float::NAN, 1.0].max         # => NaN
  # Float::NAN > 1.0                   # => false
  # ```
  native def <=>(other: Float) -> Int
  # :ditto:
  native def <=>(other: Int) -> Int
  # Whether `other` is a `Float` or an `Int` of the same value
  # (`1.0 == 1` is true; an `Integer` is never equal). NaN equals
  # nothing, itself included; `0.0 == -0.0` is true.
  native def ==(other: Object) -> Bool
  # Whether `other` is not equal to `self` (`!(self == other)`): true for
  # NaN.
  native def !=(other: Object) -> Bool
  # Whether `self` is less than `other`; false when either is NaN
  # (although `<=>` orders NaN last).
  native def <(other: Float) -> Bool
  # Whether `self` is less than or equal to `other`; false when either is
  # NaN.
  native def <=(other: Float) -> Bool
  # Whether `self` is greater than `other`; false when either is NaN
  # (although `<=>` orders NaN last).
  native def >(other: Float) -> Bool
  # Whether `self` is greater than or equal to `other`; false when either
  # is NaN.
  native def >=(other: Float) -> Bool
  # Whether `self` is less than `other`; false when `self` is NaN.
  native def <(other: Int) -> Bool
  # Whether `self` is less than or equal to `other`; false when `self` is
  # NaN.
  native def <=(other: Int) -> Bool
  # Whether `self` is greater than `other`; false when `self` is NaN.
  native def >(other: Int) -> Bool
  # Whether `self` is greater than or equal to `other`; false when `self`
  # is NaN.
  native def >=(other: Int) -> Bool
  # The absolute value (0.0 for -0.0).
  native def abs -> Float
  # Whether `self` is less than 0: false for -0.0 and for NaN.
  native def negative? -> Bool
  # Whether `self` is greater than 0: false for NaN.
  native def positive? -> Bool
  # Whether `self` is 0.0 or -0.0.
  native def zero? -> Bool
  # Whether `self` is NaN.
  native def nan? -> Bool
  # Whether `self` is `INFINITY` or `-INFINITY`. A `Bool`, where Ruby
  # gives 1, -1 or nil.
  native def infinite? -> Bool
  # Whether `self` is neither an infinity nor NaN.
  native def finite? -> Bool
  # The largest `Int` not above `self`.
  #
  # ## Raises
  #
  # `FloatDomainError` for NaN or an infinity, `OverflowError` beyond the
  # `Int` range.
  #
  # ```
  # 3.7.floor       # => 3
  # -3.2.floor      # => -4
  # Float::NAN.floor   # raises RangeError
  # ```
  native def floor -> Int
  # The smallest `Int` not below `self`; `FloatDomainError` for NaN or an
  # infinity, `OverflowError` beyond the `Int` range.
  native def ceil -> Int
  # The nearest `Int`, a half away from zero (not to even);
  # `FloatDomainError` for NaN or an infinity, `OverflowError` beyond the
  # `Int` range.
  #
  # ```
  # 2.5.round     # => 3
  # 3.5.round     # => 4
  # -2.5.round    # => -3
  # 2.49.round    # => 2
  # ```
  native def round -> Int
  # `self` rounded to `digits` decimal places (to tens, hundreds, ... for
  # a negative `digits`), a half away from zero; NaN and the infinities
  # are returned as they are.
  #
  # As in Ruby, places after the point are those of the decimal form
  # `inspect` shows, the shortest that reads back as `self`: 1.005 rounds
  # to 1.01, though the binary number is a little below 1.005. Tens,
  # hundreds, ... round the integer part exactly. The same holds for
  # `floor`, `ceil` and `truncate` with `digits`, whose result is never on
  # the wrong side of `self`; with more digits than `self` shows, `self`
  # comes back.
  #
  # ```
  # 3.14159.round(2)    # => 3.14
  # 1.005.round(2)      # => 1.01
  # 1234.5.round(-2)    # => 1200.0
  # ```
  native def round(digits: Int) -> Float
  # The `Int` toward zero; `FloatDomainError` for NaN or an infinity,
  # `OverflowError` beyond the `Int` range.
  native def truncate -> Int
  # `self` rounded toward negative infinity to `digits` decimal places
  # (to tens, hundreds, ... for a negative `digits`), as a `Float`: use
  # `floor` without `digits` for an `Int`. NaN and the infinities are
  # returned as they are.
  #
  # ```
  # 3.14159.floor(2)     # => 3.14
  # -3.14159.floor(2)    # => -3.15
  # 15.5.floor(0)        # => 15.0
  # 15.5.floor(-1)       # => 10.0
  # ```
  native def floor(digits: Int) -> Float
  # `self` rounded toward positive infinity to `digits` decimal places,
  # as a `Float`, as `#floor(digits)` rounds down: `15.5.ceil(-1)` is
  # 20.0. Use `ceil` without `digits` for an `Int`.
  native def ceil(digits: Int) -> Float
  # `self` rounded toward zero to `digits` decimal places, as a `Float`,
  # as `#floor(digits)` rounds down: `-15.5.truncate(-1)` is -10.0. Use
  # `truncate` without `digits` for an `Int`.
  native def truncate(digits: Int) -> Float
  # `[(self / other).floor, self % other]`, the modulo with the sign of
  # `other`. Unlike `/`, `ZeroDivisionError` when `other` is zero.
  #
  # ```
  # 7.5.divmod(2)       # => [3, 1.5]
  # (-7.5).divmod(2)    # => [-4, 0.5]
  # 7.5.divmod(0.0)     # raises ZeroDivisionError
  # ```
  native def divmod(other: Float) -> [Int, Float]
  # :ditto:
  native def divmod(other: Int) -> [Int, Float]
  # The quotient, as `/`.
  native def fdiv(other: Float) -> Float
  # :ditto:
  native def fdiv(other: Int) -> Float
  # The next `Float` above `self`: `INFINITY` after `MAX`, the smallest
  # subnormal after 0.0.
  #
  # ```
  # 1.0.next_float    # => 1.0000000000000002
  # ```
  native def next_float -> Float
  # The next `Float` below `self`.
  native def prev_float -> Float
  # Calls the block with `self`, `self + step`, `self + 2 * step` and so on
  # while not past `limit` (above it for a positive `step`, below it for a
  # negative one); `ArgumentError` when `step` is 0.0. The number of steps
  # is counted first, as in Ruby, so that rounding errors do not lose the
  # last one: `0.0.step(1.0, 0.1)` calls the block 11 times.
  native def step(limit: Float, step: Float, &: (Float) -> Nil) -> Nil
  # False: a `Float` is not an integer, even a whole one.
  def integer? -> Bool = false
  # The `Int` toward zero (`-3.9.to_i` is -3); `FloatDomainError` for NaN
  # or an infinity, `OverflowError` beyond the `Int` range.
  native def to_i -> Int
  # `self`.
  native def to_f -> Float
  # The shortest decimal that reads back as `self`, with `.0` for a whole
  # number, in scientific notation below 0.0001 and from 1e16 on;
  # `"NaN"`, `"Infinity"` or `"-Infinity"` for those.
  #
  # ```
  # 100.0.to_s      # => "100.0"
  # 1e16.to_s       # => "1.0e+16"
  # 0.00001.to_s    # => "1.0e-05"
  # (-0.0).to_s     # => "-0.0"
  # ```
  native def to_s -> String
  # A `Duration` of `self` milliseconds, to the nearest nanosecond.
  native def ms -> Duration
  # :ditto:
  native def milliseconds -> Duration
  # A `Duration` of `self` seconds, to the nearest nanosecond.
  #
  # ```
  # 1.5.seconds     # => 1500ms
  # 0.25.minutes    # => 15s
  # ```
  native def second -> Duration
  # :ditto:
  native def seconds -> Duration
  # A `Duration` of `self` minutes, to the nearest nanosecond.
  native def minute -> Duration
  # :ditto:
  native def minutes -> Duration
end

# A span of time, kept as a signed 64-bit count of nanoseconds: about 292
# years either way. Made by `Int#ms`, `Int#seconds`, `Float#minutes` and
# the like; `sleep` and timeouts take one.
#
# ```
# d = 1.minute + 30.seconds
# d               # => 90s
# d.to_f          # => 90.0
# d * 2           # => 180s
# d > 1.minute    # => true
# ```
class Duration
  include Shareable
  include Comparable[Duration]

  # The sum; `OverflowError` when it leaves the range a `Duration` holds.
  #
  # ```
  # 1.minute + 30.seconds          # => 90s
  # 100000.days + 100000.days      # raises OverflowError
  # ```
  native def +(other: Duration) -> Duration
  # The difference, negative when `other` is longer; `OverflowError`
  # when it leaves the range a `Duration` holds.
  native def -(other: Duration) -> Duration
  # The duration `factor` times as long; `OverflowError` when it leaves
  # the range a `Duration` holds.
  native def *(factor: Int) -> Duration
  # The duration `factor` times as long, truncated to a whole nanosecond;
  # `OverflowError` when it leaves the range (or for a NaN `factor`).
  native def *(factor: Float) -> Duration
  # -1, 0 or 1 as `self` is shorter than, as long as or longer than
  # `other`.
  native def <=>(other: Duration) -> Int
  # The length in seconds.
  native def to_f -> Float
  # The length in whole milliseconds, truncated toward zero.
  #
  # ```
  # 1500.ms.to_ms     # => 1500
  # 1.9.ms.to_ms      # => 1
  # ```
  native def to_ms -> Int
  # The length in the largest unit that holds it whole, of seconds,
  # milliseconds and nanoseconds, as `inspect` shows it.
  #
  # ```
  # 2.seconds.to_s    # => "2s"
  # 1500.ms.to_s      # => "1500ms"
  # 2.5.ms.to_s       # => "2500000ns"
  # ```
  native def to_s -> String
end

# A pseudo-random number generator with its own state; `Random.rand` and
# `Kernel#rand` draw from a default generator that `srand` seeds.
#
# Two generators made with the same seed give the same numbers. A
# `Random` belongs to the task that made it (`Unshareable`); the default
# generator is one for the whole program.
#
# ```
# a = Random.new(42)
# b = Random.new(42)
# a.rand(100) == b.rand(100)   # => true
# r = a.rand(1..6)
# r >= 1 && r <= 6             # => true
# ```
class Random
  include Unshareable

  # A generator seeded from the clock, as `.new_seed` makes one: `#seed`
  # tells which.
  native def self.new -> Random
  # A generator seeded with `seed`.
  native def self.new(seed: Int) -> Random
  # A new seed from the clock and the process, different at each call.
  native def self.new_seed -> Int
  # A `Float` from 0.0 up to, not including, 1.0, from the default
  # generator.
  native def self.rand -> Float
  # An `Int` from 0 up to `max - 1`, from the default generator;
  # `ArgumentError` unless `max` is positive.
  native def self.rand(max: Int) -> Int
  # A `Float` from 0.0 up to, not including, `max`, from the default
  # generator; `ArgumentError` unless `max` is positive.
  native def self.rand(max: Float) -> Float
  # An `Int` in `range`, from the default generator; `ArgumentError` for
  # an empty range.
  native def self.rand(range: Range[Int]) -> Int
  # A `Float` from the start of `range` up to, not including, its end
  # (`..` or `...`), from the default generator; `ArgumentError` when the
  # end is below the start. A range whose ends are equal, even an empty
  # one (`5.0...5.0`), gives its start.
  native def self.rand(range: Range[Float]) -> Float
  # `size` random bytes from the default generator; empty for a `size` of
  # 0 or less.
  native def self.bytes(size: Int) -> Bytes

  # The seed this generator started from.
  native def seed -> Int
  # A `Float` from 0.0 up to, not including, 1.0.
  native def rand -> Float
  # An `Int` from 0 up to `max - 1`; `ArgumentError` unless `max` is
  # positive.
  #
  # ```
  # r = Random.new(1)
  # n = r.rand(10)
  # n >= 0 && n < 10    # => true
  # r.rand(0)           # raises ArgumentError
  # ```
  native def rand(max: Int) -> Int
  # A `Float` from 0.0 up to, not including, `max`; `ArgumentError` unless
  # `max` is positive.
  native def rand(max: Float) -> Float
  # An `Int` in `range`; `ArgumentError` for an empty range.
  native def rand(range: Range[Int]) -> Int
  # A `Float` from the start of `range` up to, not including, its end
  # (`..` or `...`); `ArgumentError` when the end is below the start. A
  # range whose ends are equal, even an empty one (`5.0...5.0`), gives its
  # start.
  #
  # ```
  # Random.new(1).rand(5.0...5.0)   # => 5.0
  # ```
  native def rand(range: Range[Float]) -> Float
  # `size` random bytes; empty for a `size` of 0 or less.
  native def bytes(size: Int) -> Bytes
  # Whether `other` is this same generator. Unlike Ruby, two generators in
  # the same state are not equal.
  native def ==(other: Object) -> Bool
end

# An immutable sequence of bytes: binary data, which a `String` (always
# UTF-8) does not hold.
#
# The elements are `Int`s from 0 to 255. Indices, sizes and the positions
# the searching methods take and return are byte offsets, never characters.
# A literal is written `b"\x00\xff"`; `Bytes::Builder` builds one piece by
# piece, and `String#to_bytes` and `#decode` convert between text and bytes.
#
# ```
# data = b"h\xc3\xa9llo"
# data.size                # => 6
# data.decode.size         # => 5
# data[1]                  # => 195
# data.index(b"l")         # => 3
# ```
class Bytes
  include Shareable
  include Comparable[Bytes]
  include Enumerable[Int]

  # Empty bytes.
  native def self.new -> Bytes
  # The bytes given, in order.
  #
  # Raises `RangeError` for a value outside 0..255.
  #
  # ```
  # Bytes[104, 105]          # => b"hi"
  # Bytes[256]               # raises RangeError
  # ```
  native def self.[](*bytes: Int) -> Bytes
  # The elements of `bytes`, in order. Raises `RangeError` for a value
  # outside 0..255.
  native def self.from(bytes: Array[Int]) -> Bytes
  # The bytes the hexadecimal digits of `hex` spell, two digits a byte, in
  # either case: the inverse of `#hex`.
  #
  # Whitespace is ignored, even between the two digits of a byte. An odd
  # number of digits or any other character (a `0x` prefix too) raises
  # `ArgumentError`.
  #
  # ```
  # Bytes.from_hex("00ff 7F")   # => b"\x00\xff\x7f"
  # Bytes.from_hex("abc")       # raises ArgumentError
  # ```
  native def self.from_hex(hex: String) -> Bytes
  # Calls the block with a new `Bytes::Builder` and returns what it holds
  # afterwards.
  #
  # ```
  # Bytes.build { |b| b << 104 << "é" }   # => b"h\xc3\xa9"
  # ```
  native def self.build(&: (Bytes::Builder) -> Nil) -> Bytes

  # Calls the block with each byte, first to last.
  native def each(&: (Int) -> Nil) -> Nil
  # Calls the block with each byte, first to last: the same as `#each`.
  native def each_byte(&: (Int) -> Nil) -> Nil
  # The number of bytes.
  native def size -> Int
  # The number of bytes: the same as `#size`.
  native def length -> Int
  # The number of bytes: the same as `#size`.
  native def bytesize -> Int
  # Whether there is no byte.
  native def empty? -> Bool
  # The byte at `index`, counted from the end when negative.
  #
  # Raises `IndexError` when `index` is out of range; `#[]?` returns `nil`
  # instead.
  #
  # ```
  # b"abc"[-1]               # => 99
  # b"abc"[3]                # raises IndexError
  # ```
  native def [](index: Int) -> Int
  # The bytes in `range`, whose ends count from the end when negative. The
  # end is cut to the size; a start equal to the size gives empty bytes.
  #
  # ## Raises
  #
  # `IndexError` when the start is beyond the size or before the
  # beginning.
  #
  # ```
  # b"abcd"[1..2]            # => b"bc"
  # b"abcd"[-2..]            # => b"cd"
  # b"abcd"[2..10]           # => b"cd"
  # b"abcd"[4..]             # => b""
  # b"abcd"[6..8]            # raises IndexError
  # ```
  native def [](range: Range[Int]) -> Bytes
  # The byte at `index`, counted from the end when negative, or `nil` when
  # it is out of range.
  native def []?(index: Int) -> Int?
  # The `length` bytes from `start` (counted from the end when negative), or
  # fewer when the end comes first.
  #
  # `start` may be the size, giving empty bytes; beyond it raises
  # `IndexError`. A negative `length` gives empty bytes.
  #
  # ```
  # b"abcd".slice(1, 2)      # => b"bc"
  # b"abcd".slice(-1, 5)     # => b"d"
  # b"abcd".slice(5, 1)      # raises IndexError
  # ```
  native def slice(start: Int, length: Int) -> Bytes
  # The bytes of `self` followed by those of `other`.
  native def +(other: Bytes) -> Bytes
  # Whether `other` is `Bytes` with the same bytes. A `String` is never
  # equal to `Bytes`, whatever its bytes.
  native def ==(other: Object) -> Bool
  # Compares byte by byte as unsigned values, a prefix first: -1, 0 or 1.
  #
  # ```
  # b"ab" <=> b"abc"         # => -1
  # b"\xff" > b"a"           # => true
  # ```
  native def <=>(other: Bytes) -> Int
  # A hash code consistent with `#==`, so that `Bytes` can be a `Hash` key or
  # a `Set` member.
  native def hash -> Int
  # The bytes in reverse order.
  native def reverse -> Bytes
  # The bytes as an array of `Int`s.
  native def to_a -> Array[Int]
  # The bytes read as UTF-8 text.
  #
  # Raises `ArgumentError`, naming the byte offset of the first invalid
  # sequence, when they are not valid UTF-8; `#decode?` returns `nil`
  # instead.
  #
  # ```
  # b"h\xc3\xa9".decode      # => "hé"
  # b"\xff".decode           # raises ArgumentError
  # ```
  native def decode -> String
  # The bytes read as text in `encoding`.
  #
  # The encodings are `"UTF-8"` (or `"UTF8"`), `"ASCII"` (or `"US-ASCII"`)
  # and `"ISO-8859-1"` (or `"LATIN1"`, `"LATIN-1"`), in either case. Raises
  # `ArgumentError` for another name, or for a byte sequence invalid in the
  # encoding (a byte above 0x7F in ASCII); every byte is valid in ISO-8859-1.
  #
  # ```
  # b"\xe9".decode("ISO-8859-1")   # => "é"
  # b"\xe9".decode("ASCII")        # raises ArgumentError
  # ```
  native def decode(encoding: String) -> String
  # The bytes read as UTF-8 text, or `nil` when they are not valid UTF-8.
  native def decode? -> String?
  # The bytes in lowercase hexadecimal, two digits a byte. `Bytes.from_hex`
  # reads it back.
  #
  # ```
  # b"\x00\xff".hex          # => "00ff"
  # ```
  native def hex -> String
  # The literal form, as `#inspect`: `puts` shows `b"..."`. Use `#decode`
  # for the text the bytes hold.
  native def to_s -> String
  # The literal form, `b"..."`: printable ASCII as is (with `\"` and `\\`),
  # `\n`, `\t` and `\r`, and any other byte as `\xNN` in lowercase.
  #
  # ```
  # b"a\n\xff".inspect       # => "b\"a\\n\\xff\""
  # ```
  native def inspect -> String

  # Searching, as String's but byte by byte: positions are byte offsets, a
  # Regexp's `.` is any byte and `\xFF` the byte 0xFF, its classes ASCII.

  # Whether the bytes start with `prefix`.
  native def start_with?(prefix: Bytes) -> Bool
  # Whether `pattern` matches at the start of the bytes.
  native def start_with?(pattern: Regexp) -> Bool
  # Whether the bytes end with `suffix`.
  native def end_with?(suffix: Bytes) -> Bool
  # Whether `other` occurs in the bytes. With an `Int`, `include?` is
  # `Enumerable#include?`: whether that byte occurs.
  native def include?(other: Bytes) -> Bool
  # The byte offset of the first occurrence of `other` at or after `start`
  # (counted from the end when negative), or `nil` when there is none.
  #
  # ```
  # b"h\xc3\xa9llo".index(b"l")      # => 3
  # b"h\xc3\xa9llo".index(b"l", 4)   # => 4
  # b"h\xc3\xa9llo".index(b"x")      # => nil
  # ```
  native def index(other: Bytes, start: Int = 0) -> Int?
  # The byte offset of the first match of `pattern` at or after `start`
  # (counted from the end when negative), or `nil` when there is none.
  native def index(pattern: Regexp, start: Int = 0) -> Int?
  # The byte offset of the last occurrence of `other`, or `nil` when there
  # is none.
  native def rindex(other: Bytes) -> Int?
  # The byte offset of the last occurrence of `other` that starts at or
  # before `start` (counted from the end when negative), or `nil`.
  native def rindex(other: Bytes, start: Int) -> Int?
  # The byte offset of the last match of `pattern`, or `nil` when there is
  # none.
  native def rindex(pattern: Regexp) -> Int?
  # The byte offset of the last match of `pattern` that starts at or before
  # `start` (counted from the end when negative), or `nil`.
  native def rindex(pattern: Regexp, start: Int) -> Int?
  # The pieces between the occurrences of `separator`, as `String#split`.
  #
  # Trailing empty pieces are dropped unless `limit` is negative; a positive
  # `limit` gives at most that many pieces, the last holding the rest. An
  # empty `separator` splits into single bytes, and empty bytes give no
  # piece.
  #
  # ```
  # b"a,b,,".split(b",")             # => [b"a", b"b"]
  # b"a,b,,".split(b",", -1)         # => [b"a", b"b", b"", b""]
  # b"a,b,c".split(b",", 2)          # => [b"a", b"b,c"]
  # ```
  native def split(separator: Bytes, limit: Int = 0) -> Array[Bytes]
  # The pieces between the matches of `separator`, as `String#split` with a
  # `Regexp`: `limit` as with a `Bytes` separator, and the groups of a match
  # after the piece before it.
  #
  # ```
  # b"a1b".split(/(\d)/)             # => [b"a", b"1", b"b"]
  # ```
  native def split(separator: Regexp, limit: Int = 0) -> Array[Bytes]
  # The bytes before the first occurrence of `separator`, the separator, and
  # the bytes after it; `[self, b"", b""]` when it does not occur.
  native def partition(separator: Bytes) -> [Bytes, Bytes, Bytes]
  # The bytes before the first match of `pattern`, the match, and the bytes
  # after it; `[self, b"", b""]` when it does not match.
  native def partition(pattern: Regexp) -> [Bytes, Bytes, Bytes]
  # The bytes before the last occurrence of `separator`, the separator, and
  # the bytes after it; `[b"", b"", self]` when it does not occur.
  native def rpartition(separator: Bytes) -> [Bytes, Bytes, Bytes]
  # The bytes before the last match of `pattern`, the match, and the bytes
  # after it; `[b"", b"", self]` when it does not match.
  native def rpartition(pattern: Regexp) -> [Bytes, Bytes, Bytes]
  # The byte offset of the first match of `pattern`, or `nil` when it does
  # not match.
  native def =~(pattern: Regexp) -> Int?
  # The first match of `pattern`, or `nil` when it does not match.
  native def match(pattern: Regexp) -> Bytes::MatchData?
  # Whether `pattern` matches somewhere in the bytes.
  #
  # A `Regexp` matches bytes byte by byte: `\w`, `\d` and `\s` are ASCII, so
  # the UTF-8 bytes of `é` are no word character.
  #
  # ```
  # b"h\xc3\xa9".match?(/\xC3/)      # => true
  # b"\xc3\xa9".match?(/\w/)         # => false
  # ```
  native def match?(pattern: Regexp) -> Bool
  # Every match of `pattern`, first to last.
  native def matches(pattern: Regexp) -> Array[Bytes::MatchData]
  # The bytes of every match of `pattern`, first to last: the whole matches,
  # even when the pattern has groups (`#matches` gives the groups).
  #
  # ```
  # b"a1b2".scan(/[a-z](\d)/)        # => [b"a1", b"b2"]
  # ```
  native def scan(pattern: Regexp) -> Array[Bytes]
  # Calls the block with the bytes of every match of `pattern`, first to
  # last.
  native def scan(pattern: Regexp, &: (Bytes) -> Nil) -> Nil
  # Calls the block with the bytes and the `Bytes::MatchData` of every match
  # of `pattern`, first to last.
  native def scan(pattern: Regexp, &: (Bytes, Bytes::MatchData) -> Nil) -> Nil
  # The bytes with the first occurrence of `pattern` replaced by
  # `replacement`, read as `String#sub` reads it: `\0` (or `\&`) is the
  # match, `\1` to `\9` and `\k<name>` are groups, `\\` is a backslash.
  #
  # ```
  # b"aaa".sub(b"a", b"<\\0>")      # => b"<a>aa"
  # ```
  native def sub(pattern: Bytes, replacement: Bytes) -> Bytes
  # The bytes with the first match of `pattern` replaced by `replacement`,
  # read as `String#sub` reads it (`\0`, `\1`, `\k<name>` ...).
  native def sub(pattern: Regexp, replacement: Bytes) -> Bytes
  # The bytes with the first occurrence of `pattern` replaced by the block's
  # result, called with it.
  native def sub(pattern: Bytes, &: (Bytes) -> Bytes) -> Bytes
  # The bytes with the first match of `pattern` replaced by the block's
  # result, called with the match.
  native def sub(pattern: Regexp, &: (Bytes) -> Bytes) -> Bytes
  # The bytes with the first match of `pattern` replaced by the block's
  # result, called with the match and its `Bytes::MatchData`.
  native def sub(pattern: Regexp, &: (Bytes, Bytes::MatchData) -> Bytes) -> Bytes
  # The bytes with every occurrence of `pattern` replaced by `replacement`,
  # read as `#sub` reads it.
  native def gsub(pattern: Bytes, replacement: Bytes) -> Bytes
  # The bytes with every match of `pattern` replaced by `replacement`, read
  # as `#sub` reads it.
  #
  # ```
  # b"a1b22".gsub(/\d+/, b"#")       # => b"a#b#"
  # ```
  native def gsub(pattern: Regexp, replacement: Bytes) -> Bytes
  # The bytes with every occurrence of `pattern` replaced by the block's
  # result, called with it.
  native def gsub(pattern: Bytes, &: (Bytes) -> Bytes) -> Bytes
  # The bytes with every match of `pattern` replaced by the block's result,
  # called with the match.
  native def gsub(pattern: Regexp, &: (Bytes) -> Bytes) -> Bytes
  # The bytes with every match of `pattern` replaced by the block's result,
  # called with the match and its `Bytes::MatchData`.
  native def gsub(pattern: Regexp, &: (Bytes, Bytes::MatchData) -> Bytes) -> Bytes
  # The bytes with every match of `pattern` replaced by its value in
  # `replacements`; a match that is no key there is removed.
  #
  # ```
  # b"lol".gsub(/[lo]/, {b"l" => b"1"})   # => b"11"
  # ```
  native def gsub(pattern: Regexp, replacements: Hash[Bytes, Bytes]) -> Bytes

  # A match in Bytes: as MatchData, with Bytes and byte offsets.
  #
  # `Bytes#match` and `Bytes#matches` return them, and the blocks of
  # `Bytes#scan`, `Bytes#sub` and `Bytes#gsub` with two parameters receive
  # them. As in Ruby, a pattern with a named group captures with its named
  # groups only. A negative index is no group (`nil`), unlike Ruby's.
  #
  # ```
  # m = b"key=v\xff".matches(/(\w+)=(.*)/)[0]
  # m[1]                   # => b"key"
  # m[2]                   # => b"v\xff"
  # m.begin(2)             # => 4
  # m[-1]                  # => nil
  # ```
  class MatchData
    include Shareable

    # The bytes of group `index` (0 is the whole match), or `nil` when the
    # group took no part in the match, or there is no such group (a negative
    # `index` included).
    native def [](index: Int) -> Bytes?
    # The bytes of the group named `name`, or `nil` when it took no part in
    # the match. Raises `IndexError` when the pattern has no group of that
    # name.
    native def [](name: String) -> Bytes?
    # The bytes before the match.
    native def pre_match -> Bytes
    # The bytes after the match.
    native def post_match -> Bytes
    # The bytes of each group, without the whole match: `nil` for a group that
    # took no part.
    native def captures -> Array[Bytes?]
    # The bytes of each named group by its name, `nil` for one that took no
    # part.
    native def named_captures -> Hash[String, Bytes?]
    # The names of the pattern's named groups, in order.
    native def names -> Array[String]
    # The bytes of the groups at `indices`, as `#[]` gives each.
    native def values_at(*indices: Int) -> Array[Bytes?]
    # The whole match followed by the bytes of each group.
    native def to_a -> Array[Bytes?]
    # The number of groups plus one, for the whole match.
    native def size -> Int
    # The whole match in its literal form, as `Bytes#to_s` gives it.
    native def to_s -> String
    # The whole match and each group, as `#<Bytes::MatchData b"ab" 1:b"a">`.
    native def inspect -> String
    # The byte offset where group `index` starts (0 is the whole match), or
    # `nil` when the group took no part. Raises `IndexError` when the pattern
    # has no such group.
    native def begin(index: Int) -> Int?
    # The byte offset just past the end of group `index` (0 is the whole
    # match), or `nil` when the group took no part. Raises `IndexError` when
    # the pattern has no such group.
    native def end(index: Int) -> Int?
  end

  # A mutable buffer of bytes, for building `Bytes` piece by piece.
  #
  # It is not `Shareable`. Unlike the other builders', `#to_bytes` copies and
  # leaves the contents in place, as `#snapshot` does.
  #
  # ```
  # b = Bytes::Builder.new
  # b << 0x68 << b"\xc3\xa9" << "llo"
  # b.size                   # => 6
  # b.to_bytes               # => b"h\xc3\xa9llo"
  # b.size                   # => 6
  # ```
  class Builder
    include Unshareable

    # An empty builder.
    native def self.new -> Bytes::Builder
    # Appends `byte` and returns the builder. Raises `RangeError` for a value
    # outside 0..255.
    native def <<(byte: Int) -> Self
    # Appends `bytes` and returns the builder.
    native def <<(bytes: Bytes) -> Self
    # Appends the UTF-8 bytes of `text` and returns the builder.
    native def <<(text: String) -> Self
    # Appends `byte` and returns the builder, as `#<<`. Raises `RangeError` for
    # a value outside 0..255.
    native def push(byte: Int) -> Self
    # The number of bytes held.
    native def size -> Int
    # Whether the builder holds no byte.
    native def empty? -> Bool
    # Removes every byte and returns the builder.
    native def clear -> Self
    # The bytes held, as `Bytes`. The builder keeps them: the result is a copy.
    native def to_bytes -> Bytes
    # A copy of the bytes held, as `Bytes`; the builder keeps them.
    native def snapshot -> Bytes
    # The literal form of the bytes held, as `Bytes#to_s`.
    native def to_s -> String
    # The literal form of the bytes held, as `Bytes#inspect`.
    native def inspect -> String
  end
end

# A point in time, to the nanosecond, with the UTC offset it is shown in.
# Immutable.
#
# A time is either in UTC (`Time.utc`, `#utc`, a parsed `Z`) or carries a
# fixed offset: `Time.now`, `Time.at`, `Time.local` and `#getlocal` take
# the local time zone's offset for that instant (from the TZ environment
# variable or the system), `Time.parse` and `Time.iso8601` the offset
# written in the text. The offset is fixed when the time is made: `#+`
# and `#-` keep it, even across a daylight-saving change. Two times are
# equal when they are the same instant, whatever their offsets.
#
# The range is that of a 64-bit count of nanoseconds since 1970: from
# 1677-09-21 00:12:44 UTC to 2262-04-11 23:47:16 UTC. `Time.at`,
# `Time.utc`, `Time.local`, `Time.iso8601` and `#+` raise `RangeError`
# outside it.
#
# ```
# t = Time.utc(2024, 3, 5, 14, 7, 9)
# t                    # => 2024-03-05 14:07:09 UTC
# t.iso8601            # => "2024-03-05T14:07:09Z"
# (t + 1.day).day      # => 6
# t == Time.iso8601("2024-03-05T23:07:09+09:00")   # => true
# ```
class Time
  include Shareable
  include Comparable[Time]

  # The current time, in the local time zone.
  native def self.now -> Time
  # The time `seconds` after 1970-01-01 00:00:00 UTC, in the local time
  # zone.
  #
  # A negative `seconds` is before 1970. `Time.at(0).utc` is the epoch in
  # UTC.
  #
  # ## Raises
  #
  # `RangeError` when the time is out of range.
  native def self.at(seconds: Int) -> Time
  # :ditto:
  native def self.at(seconds: Float) -> Time
  # The time of the given date and time of day in UTC.
  #
  # ## Raises
  #
  # `ArgumentError` when a part is out of range (month 13, February 30,
  # hour 24, second 60); `RangeError` for a time outside the range `Time`
  # can hold (before 1677-09-21 00:12:44 or after 2262-04-11 23:47:16
  # UTC).
  #
  # ```
  # Time.utc(2024)              # => 2024-01-01 00:00:00 UTC
  # Time.utc(2262, 4, 11)       # => 2262-04-11 00:00:00 UTC
  # Time.utc(2024, 2, 30)       # raises ArgumentError
  # Time.utc(3000)              # raises RangeError
  # ```
  native def self.utc(year: Int, month: Int = 1, day: Int = 1, hour: Int = 0, min: Int = 0, sec: Int = 0) -> Time
  # The time of the given date and time of day in the local time zone.
  #
  # A time that occurs twice (when clocks go back) is the earlier one.
  #
  # ## Raises
  #
  # `ArgumentError` when a part is out of range (month 13, hour 24), or
  # the time does not occur locally (skipped when clocks go forward);
  # `RangeError` for a time outside the range `Time` can hold, as in
  # `Time.utc`.
  native def self.local(year: Int, month: Int = 1, day: Int = 1, hour: Int = 0, min: Int = 0, sec: Int = 0) -> Time
  # The time written in `text`.
  #
  # The forms are RFC 3339 (`2024-03-05T14:07:09+09:00`),
  # `YYYY-MM-DD HH:MM[:SS[.fraction]]` followed by an offset (`+09:00`,
  # `+0900`) or `Z`, or without one in the local time zone, or a date
  # alone (`YYYY-MM-DD`, midnight local time). A `T` may separate the date
  # and the time; whitespace at the ends is ignored. A time ending in `Z`
  # is in UTC, one with an offset keeps that offset.
  #
  # `#to_s`'s and `#inspect`'s own forms are read too: the offset may
  # follow the time after a space (`2024-03-05 14:07:09 +0900`), and
  # ` UTC` stands for `Z` (`2024-03-05 14:07:09 UTC`), so `#to_s` reads
  # back as the same time.
  #
  # ## Raises
  #
  # `ArgumentError` when `text` is in none of these forms, `RangeError`
  # when it is a time outside the range a `Time` holds.
  #
  # ```
  # Time.parse("2024-03-05 14:07:09Z")         # => 2024-03-05 14:07:09 UTC
  # Time.parse("2024-03-05T14:07:09+09:00").utc_offset   # => 32400
  # Time.parse("2024-03-05 14:07:09 UTC")      # => 2024-03-05 14:07:09 UTC
  # t = Time.utc(2024, 3, 5, 14, 7, 9)
  # Time.parse(t.to_s) == t                    # => true
  # Time.parse("yesterday")                    # raises ArgumentError
  # ```
  native def self.parse(text: String) -> Time
  # The time written in `text` in RFC 3339 form.
  #
  # That is the profile of ISO 8601 that `#iso8601` writes: a date, a
  # time, an optional fraction and an offset or `Z` (in UTC).
  #
  # ## Raises
  #
  # `ArgumentError` for any other form, a date alone included;
  # `RangeError` for a time outside the range `Time` can hold.
  #
  # ```
  # Time.iso8601("2024-03-05T14:07:09Z")   # => 2024-03-05 14:07:09 UTC
  # Time.iso8601("3000-01-01T00:00:00Z")   # raises RangeError
  # ```
  native def self.iso8601(text: String) -> Time
  # The time elapsed since the program started, from a clock that never
  # goes back.
  #
  # Subtract two readings to time something: unlike `.now`, it does not
  # jump when the system clock is set.
  native def self.monotonic -> Duration

  # The year, in the time's own offset (as are the other parts).
  native def year -> Int
  # The month, 1 to 12.
  native def month -> Int
  # The day of the month, 1 to 31.
  native def day -> Int
  # The hour, 0 to 23.
  native def hour -> Int
  # The minute, 0 to 59.
  native def min -> Int
  # The second, 0 to 59.
  native def sec -> Int
  # The microseconds within the second, 0 to 999999.
  native def usec -> Int
  # The nanoseconds within the second, 0 to 999999999.
  native def nsec -> Int
  # The day of the week, 0 (Sunday) to 6 (Saturday).
  native def wday -> Int
  # The day of the year, 1 to 366.
  native def yday -> Int
  # Whether the day is a Sunday.
  native def sunday? -> Bool
  # Whether the day is a Monday.
  native def monday? -> Bool
  # Whether the day is a Tuesday.
  native def tuesday? -> Bool
  # Whether the day is a Wednesday.
  native def wednesday? -> Bool
  # Whether the day is a Thursday.
  native def thursday? -> Bool
  # Whether the day is a Friday.
  native def friday? -> Bool
  # Whether the day is a Saturday.
  native def saturday? -> Bool
  # The whole seconds since 1970-01-01 00:00:00 UTC, rounded down.
  native def to_i -> Int
  # The seconds since 1970-01-01 00:00:00 UTC, with the fraction.
  native def to_f -> Float
  # The time `duration` later, in the same offset.
  #
  # ## Raises
  #
  # `RangeError` when the result is out of range.
  native def +(duration: Duration) -> Time
  # The time `duration` earlier, in the same offset.
  #
  # ## Raises
  #
  # `RangeError` when the result is out of range.
  native def -(duration: Duration) -> Time
  # The time from `other` to this time (negative when `other` is later).
  #
  # ## Raises
  #
  # `RangeError` when the difference does not fit a `Duration` (about 292
  # years either way).
  #
  # ```
  # Time.utc(2024, 1, 2) - Time.utc(2024, 1, 1) == 1.day   # => true
  # Time.utc(2262) - Time.utc(1678)                        # raises RangeError
  # ```
  native def -(other: Time) -> Duration
  # Compares the instants, whatever the offsets: -1, 0 or 1.
  native def <=>(other: Time) -> Int
  # Whether `other` is a `Time` at the same instant (the offsets may
  # differ).
  native def ==(other: Object) -> Bool
  # A hash of the instant, consistent with `#==`.
  native def hash -> Int
  # The same instant in UTC.
  native def utc -> Time
  # The same instant in the local time zone.
  native def getlocal -> Time
  # The same instant in the local time zone (Ruby changes the receiver;
  # this returns a new time, as `#getlocal` does).
  native def localtime -> Time
  # Whether the time is in UTC. A local time whose offset is zero is not.
  native def utc? -> Bool
  # The offset from UTC in seconds, east positive (0 in UTC).
  native def utc_offset -> Int
  # `"UTC"` for a time in UTC; otherwise the offset as `"+09:00"` (not a
  # zone's abbreviation such as JST).
  native def zone -> String
  # The time formatted by `format`, with the directives of C's `strftime`
  # (`%Y-%m-%d %H:%M:%S`, `%a`, `%j`, `%z`, ...) and Ruby's `%L`
  # (milliseconds), `%N` (nanoseconds; `%3N`, `%6N` for fewer digits) and
  # `%Z` (`"UTC"` in UTC, the offset otherwise).
  #
  # ## Raises
  #
  # `ArgumentError` for an unknown directive.
  #
  # ```
  # Time.utc(2024, 3, 5, 14, 7, 9).strftime("%Y/%m/%d %a %H:%M %Z")
  # # => "2024/03/05 Tue 14:07 UTC"
  # ```
  native def strftime(format: String) -> String
  # The time in ISO 8601 (RFC 3339) form: `2024-03-05T14:07:09Z` in UTC,
  # `2024-03-05T14:07:09+09:00` otherwise.
  native def iso8601 -> String
  # The same, with `fraction_digits` digits of the second's fraction
  # (clamped to 0 to 9): `2024-03-05T14:07:09.000Z`.
  native def iso8601(fraction_digits: Int) -> String
  # The time as `2024-03-05 14:07:09 +0900`, or `... UTC` in UTC.
  native def to_s -> String
  # As `#to_s`, with the fraction of the second when it is not zero:
  # `2024-03-05 14:07:09.5 UTC`.
  native def inspect -> String
end

# A sequence of characters, always valid UTF-8. Immutable: methods that
# change a string (`#upcase`, `#sub`, `#insert`) return a new one, and
# `String::Builder` is the mutable buffer to build one piece by piece.
#
# Indices and lengths count characters (Unicode code points), not bytes:
# `size` is the number of characters and `bytesize` the number of bytes.
# Only `#bytes`, `#getbyte`, `#each_byte` and `#bytesize` work on bytes.
# A negative index counts from the end. Binary data is `Bytes`: convert
# with `#to_bytes` and `Bytes#decode`.
#
# ```
# s = "héllo"
# s.size                  # => 5
# s.bytesize              # => 6
# s[1]                    # => "é"
# s.upcase                # => "HÉLLO"
# s.sub(/l+/, "L")        # => "héLo"
# ```
class String
  include Shareable
  include Comparable[String]

  # The string the block builds: it receives an empty `String::Builder`
  # and the result is the builder's contents.
  #
  # ```
  # String.build { |b| b << "a" << "b"; b.push("c") }   # => "abc"
  # ```
  native def self.build(&: (String::Builder) -> Nil) -> String

  # The string followed by `other`.
  native def +(other: String) -> String
  # The string repeated `count` times; empty when `count` is 0 or
  # negative.
  #
  # ```
  # "ab" * 3                # => "ababab"
  # ```
  native def *(count: Int) -> String
  # The string as a format, with `args` as the values of its
  # conversions, as `Kernel#format` formats them: `%d %i %s %f %e %g %x
  # %X %o %b %c %%`, with the flags `-`, `0`, `+` and space, a width and
  # a precision. A conversion without a value formats `nil`.
  #
  # ## Raises
  #
  # `ArgumentError` for a conversion it does not know (`%p`).
  #
  # ```
  # "%s-%05d" % ["a", 42]   # => "a-00042"
  # "%.2f" % 3.14159        # => "3.14"
  # ```
  native def %(args: Array[Object]) -> String
  # Compares by code points (the order of the UTF-8 bytes): -1, 0 or 1.
  # Upper case comes before lower case; `#casecmp` ignores case.
  native def <=>(other: String) -> Int
  # Whether `other` is a string with the same characters (a `Symbol` is
  # not equal to a string).
  native def ==(other: Object) -> Bool
  # The number of characters (code points), not bytes.
  native def size -> Int
  # The number of characters: the same as `size`.
  native def length -> Int
  # The number of bytes of the UTF-8 encoding.
  native def bytesize -> Int
  # Whether the string has no character.
  native def empty? -> Bool
  # The character at character index `index`, counting from the end when
  # negative.
  #
  # ## Raises
  #
  # `IndexError` when `index` is out of range: `#[]?` returns `nil`
  # instead.
  #
  # ```
  # "héllo"[1]              # => "é"
  # "héllo"[-1]             # => "o"
  # "héllo"[5]              # raises IndexError
  # ```
  native def [](index: Int) -> String
  # The characters in `range` (character indices, negative ones from the
  # end). The end is cut to the string's; a start equal to the size gives
  # an empty string.
  #
  # ## Raises
  #
  # `IndexError` when the start is beyond the size or before the
  # beginning.
  #
  # ```
  # "hello"[1..2]           # => "el"
  # "hello"[1...-1]         # => "ell"
  # "hello"[3..10]          # => "lo"
  # "hello"[6..]            # raises IndexError
  # ```
  native def [](range: Range[Int]) -> String
  # The character at character index `index`, or `nil` when it is out of
  # range.
  native def []?(index: Int) -> String?
  # The characters, each a string of one code point (`#graphemes` keeps
  # a combining mark with its base).
  native def chars -> Array[String]
  # The bytes of the UTF-8 encoding, each 0 to 255.
  #
  # ```
  # "hé".bytes              # => [104, 195, 169]
  # ```
  native def bytes -> Array[Int]
  # The lines, each with its `"\n"` (or `"\r\n"`); the last has none when
  # the string does not end with one. Only `"\n"` ends a line. Empty for
  # an empty string.
  native def lines -> Array[String]
  # The fields separated by runs of whitespace (Unicode whitespace),
  # without empty fields at either end.
  #
  # ```
  # " a  b\tc\n".split      # => ["a", "b", "c"]
  # ```
  native def split -> Array[String]
  # The fields separated by `separator`. Empty fields at the end are
  # dropped; those between separators are kept. A separator of one space
  # splits on whitespace as `split` without one does, and an empty one
  # gives the characters.
  #
  # ```
  # "a,b,,c,,".split(",")   # => ["a", "b", "", "c"]
  # "abc".split("")         # => ["a", "b", "c"]
  # ```
  native def split(separator: String) -> Array[String]
  # The fields separated by matches of `separator`, as Ruby splits: the
  # groups of the separator, if it has any, follow the field before it,
  # an empty match where a field starts separates nothing, and empty
  # fields at the end are dropped.
  #
  # ```
  # "a1b22c".split(/\d+/)   # => ["a", "b", "c"]
  # "a1b2c".split(/(\d)/)   # => ["a", "1", "b", "2", "c"]
  # ```
  native def split(separator: Regexp) -> Array[String]
  # The text of every match of `pattern`, in order. Unlike Ruby's, the
  # result is the whole matches even when `pattern` has groups: use
  # `#matches` for the groups.
  #
  # ```
  # "a1b22".scan(/\d+/)       # => ["1", "22"]
  # "a1b22".scan(/(\w)(\d)/)  # => ["a1", "b2"]
  # ```
  native def scan(pattern: Regexp) -> Array[String]
  # The first match of `pattern`, or `nil` when there is none.
  #
  # ```
  # m = "on 2024-10".match(/(\d+)-(\d+)/)
  # m.nil?                  # => false
  # "abc".match(/\d/)       # => nil
  # ```
  native def match(pattern: Regexp) -> MatchData?
  # Every match, with its groups (`scan` gives the matched text only).
  #
  # ```
  # "a1b2".matches(/(\w)(\d)/).map { |m| m[2] }   # => ["1", "2"]
  # ```
  native def matches(pattern: Regexp) -> Array[MatchData]
  # Whether `pattern` matches somewhere in the string.
  native def match?(pattern: Regexp) -> Bool
  # The character index of the first match of `pattern`, or `nil` when
  # there is none.
  #
  # ```
  # "héllo" =~ /l/          # => 2
  # "héllo" =~ /z/          # => nil
  # ```
  native def =~(pattern: Regexp) -> Int?
  # The string with the first occurrence of `pattern` replaced by
  # `replacement`; the string itself when there is none. The replacement
  # is read as with a `Regexp`: `\0` and `\&` are the match, `` \` `` and
  # `\'` the text before and after it, `\\` a backslash.
  native def sub(pattern: String, replacement: String) -> String
  # The string with the first match of `pattern` replaced by
  # `replacement`; the string itself when there is none. In
  # `replacement`, `\1` to `\9` and `\k<name>` are the groups (empty when
  # a group took no part), `\0` and `\&` the match, `` \` `` and `\'` the
  # text before and after it, and `\\` a backslash.
  #
  # ```
  # "a1b2".sub(/\d/, "<\\0>")                  # => "a<1>b2"
  # "a=1".sub(/(\w)=(\w)/, "\\2=\\1")          # => "1=a"
  # "a=1".sub(/(?<k>\w)=(?<v>\w)/, "\\k<v>")  # => "1"
  # ```
  native def sub(pattern: Regexp, replacement: String) -> String
  # The string with every occurrence of `pattern` replaced by
  # `replacement`, read as `#sub` reads it. An empty `pattern` matches
  # before each character and at the end.
  #
  # ```
  # "a.b.c".gsub(".", "-")  # => "a-b-c"
  # "abc".gsub("", "-")     # => "-a-b-c-"
  # ```
  native def gsub(pattern: String, replacement: String) -> String
  # The string with every match of `pattern` replaced by `replacement`,
  # read as `#sub` reads it.
  #
  # ```
  # "a1b2".gsub(/(\w)(\d)/, "\\2\\1")   # => "1a2b"
  # ```
  native def gsub(pattern: Regexp, replacement: String) -> String
  # The string in upper case, with Unicode's full mappings (`"ß"` becomes
  # `"SS"`).
  #
  # ```
  # "héllo ß".upcase        # => "HÉLLO SS"
  # ```
  native def upcase -> String
  # The string in lower case (Unicode).
  native def downcase -> String
  # The string with its first character in upper case and the rest in
  # lower case (Unicode).
  #
  # ```
  # "hÉLLO wORLD".capitalize  # => "Héllo world"
  # ```
  native def capitalize -> String
  # The string with upper case changed to lower case and lower case to
  # upper case (Unicode).
  native def swapcase -> String
  # The string without leading and trailing whitespace. Whitespace is
  # Unicode's (a no-break space is one); unlike Ruby's, a trailing NUL is
  # kept.
  #
  # ```
  # "\t a b \n".strip       # => "a b"
  # ```
  native def strip -> String
  # The string without leading whitespace (Unicode's, as `strip`).
  native def lstrip -> String
  # The string without trailing whitespace (Unicode's, as `strip`).
  native def rstrip -> String
  # The string without one trailing `"\n"`, `"\r\n"` or `"\r"`.
  #
  # ```
  # "a\r\n".chomp           # => "a"
  # "a\n\n".chomp           # => "a\n"
  # ```
  native def chomp -> String
  # The string without its last character; empty for an empty string.
  # Unlike Ruby's, a final `"\r\n"` loses only its `"\n"`.
  native def chop -> String
  # Whether the string starts with `prefix` (always for an empty one).
  native def start_with?(prefix: String) -> Bool
  # Whether the string ends with `suffix` (always for an empty one).
  native def end_with?(suffix: String) -> Bool
  # Whether `other` occurs in the string (always for an empty one).
  native def include?(other: String) -> Bool
  # The character index of the first occurrence of `other`, or `nil` when
  # there is none.
  #
  # ```
  # "héllo".index("l")      # => 2
  # "héllo".index("z")      # => nil
  # ```
  native def index(other: String) -> Int?
  # The character index of the last occurrence of `other`, or `nil` when
  # there is none.
  native def rindex(other: String) -> Int?
  # The string centered in `width` characters, padded on both sides with
  # `pad` repeated (the right side takes the odd one); the string itself
  # when it is already as wide.
  #
  # ```
  # "ab".center(6, "*")     # => "**ab**"
  # "a".center(4)           # => " a  "
  # ```
  native def center(width: Int, pad: String = " ") -> String
  # The string padded on the right to `width` characters with `pad`
  # repeated; the string itself when it is already as wide.
  native def ljust(width: Int, pad: String = " ") -> String
  # The string padded on the left to `width` characters with `pad`
  # repeated; the string itself when it is already as wide.
  #
  # ```
  # "7".rjust(3, "0")       # => "007"
  # ```
  native def rjust(width: Int, pad: String = " ") -> String
  # The string with each character of `from` replaced by the character at
  # the same place in `to`, the last one of `to` standing for those past
  # its end. Both may hold ranges (`"a-y"`), and a `from` starting with
  # `^` means every character not in it. An empty `to` deletes them.
  #
  # ```
  # "hello".tr("el", "ip")    # => "hippo"
  # "hello".tr("a-y", "b-z")  # => "ifmmp"
  # "hello".tr("^l", "*")     # => "**ll*"
  # ```
  native def tr(from: String, to: String) -> String
  # The string without the characters in `chars`, a set written as
  # `#tr`'s `from` (ranges, `^` for the complement).
  #
  # ```
  # "hello".delete("l")     # => "heo"
  # ```
  native def delete(chars: String) -> String
  # The string with each run of the same character made one.
  #
  # ```
  # "aaabbb  c".squeeze     # => "ab c"
  # ```
  native def squeeze -> String
  # The number of characters in the string that are in `chars`, a set
  # written as `#tr`'s `from`.
  #
  # ```
  # "hello world".count("lo")   # => 5
  # ```
  native def count(chars: String) -> Int
  # The characters in reverse order (a combining mark is a character of
  # its own here).
  native def reverse -> String
  # Calls the block with each character.
  native def each_char(&: (String) -> Nil) -> Nil
  # Calls the block with each line, as `#lines` gives them.
  native def each_line(&: (String) -> Nil) -> Nil
  # The integer at the start of the string, in base 10, as Ruby reads it:
  # leading whitespace, a sign and a `0d` prefix are allowed, a single `_`
  # may stand between digits (`"1_000"`; `"1__2"` is 1), and the first
  # other character ends it. 0 when there is no digit.
  #
  # ## Raises
  #
  # `OverflowError` when the number does not fit in an `Int`.
  #
  # ```
  # "  42abc".to_i          # => 42
  # "1_000".to_i            # => 1000
  # "abc".to_i              # => 0
  # ```
  native def to_i -> Int
  # The integer at the start of the string in `base` (2 to 36, or 0),
  # read as `#to_i` reads it. As in Ruby, the prefix naming `base` is
  # skipped (`0x` for 16, `0b` for 2, `0o` for 8, `0d` for 10, in either
  # case), and base 0 takes the base from the prefix: octal for a bare
  # leading `0`, decimal without one.
  #
  # ## Raises
  #
  # `OverflowError` when the number does not fit in an `Int`,
  # `ArgumentError` for a `base` that is not 0 or within 2..36.
  #
  # ```
  # "ff".to_i(16)           # => 255
  # "0xff".to_i(16)         # => 255
  # "1012".to_i(2)          # => 5
  # "0b101".to_i(0)         # => 5
  # "017".to_i(0)           # => 15
  # "0x1f".to_i(10)         # => 0
  # "10".to_i(37)           # raises ArgumentError
  # ```
  native def to_i(base: Int) -> Int
  # The decimal number at the start of the string (leading whitespace, a
  # sign, a fraction and an exponent); 0.0 when there is none. `_` is not
  # read, nor `"Infinity"` or `"NaN"`.
  #
  # ```
  # " 3.5e2xyz".to_f        # => 350.0
  # "x".to_f                # => 0.0
  # ```
  native def to_f -> Float
  # The symbol of this name.
  native def to_sym -> Symbol
  # The UTF-8 bytes.
  #
  # ```
  # "é".to_bytes            # => b"\xc3\xa9"
  # ```
  native def to_bytes -> Bytes
  # Ruby's name for the same: the UTF-8 bytes (`"é".b`).
  native def b -> Bytes
  # The string encoded in `encoding`: `"UTF-8"`, `"ASCII"` or
  # `"ISO-8859-1"`. `Bytes#decode` converts back.
  #
  # ## Raises
  #
  # `ArgumentError` for another encoding, or a character the encoding
  # cannot hold.
  #
  # ```
  # "é".encode("ISO-8859-1")  # => b"\xe9"
  # "é".encode("ASCII")       # raises ArgumentError
  # ```
  native def encode(encoding: String = "UTF-8") -> Bytes
  # The string itself.
  native def to_s -> String
  # The string as a literal: in double quotes, with `"`, `\` and control
  # characters escaped. Characters beyond ASCII are kept, and unlike
  # Ruby's, `#{` is not escaped.
  #
  # ```
  # "a\"b\n".inspect        # => "\"a\\\"b\\n\""
  # ```
  native def inspect -> String
  # A hash code: equal strings have equal ones.
  native def hash -> Int
  # The successor, as Ruby's: the rightmost letter or digit is
  # incremented, carrying to the left (`"az"` is followed by `"ba"`, `"zz"`
  # by `"aaa"`) across other characters (`"1.9"` by `"2.0"`), but not from
  # a letter across them to a digit or back (`"1.z"` by `"1.aa"`); a
  # string without one increments its last character.
  #
  # ```
  # "az".succ               # => "ba"
  # "Zz9".succ              # => "AAa0"
  # "1.9".succ              # => "2.0"
  # ```
  native def succ -> String
  # The successor: the same as `succ`.
  native def next -> String
  # The code point of the first character.
  #
  # ## Raises
  #
  # `ArgumentError` for an empty string.
  #
  # ```
  # "é".ord                 # => 233
  # ```
  native def ord -> Int
  # The string read as a hexadecimal number.
  #
  # As Ruby's, the same as `to_i(16)`: the number at the start, after
  # whitespace, a sign and a `0x` prefix, with a single `_` allowed between
  # digits; 0 when there is none.
  #
  # ## Raises
  #
  # `OverflowError` when the number does not fit in an `Int`.
  #
  # ```
  # "0x1A".hex              # => 26
  # "-ff".hex               # => -255
  # "1fg".hex               # => 31
  # "-0x1f".hex             # => -31
  # "zz".hex                # => 0
  # ```
  native def hex -> Int
  # The string read as an octal number.
  #
  # As Ruby's: the number at the start, read as `#to_i` reads it, in the
  # base its prefix names (`0x`, `0b`, `0o`, `0d`) and in octal without
  # one; 0 when there is none.
  #
  # ## Raises
  #
  # `OverflowError` when the number does not fit in an `Int`.
  #
  # ```
  # "777".oct               # => 511
  # "-17".oct               # => -15
  # "17x".oct               # => 15
  # "0x1f".oct              # => 31
  # "0b11".oct              # => 3
  # "19".oct                # => 1
  # ```
  native def oct -> Int
  # The string as a format with one value, `arg`, as `%(args)` formats
  # an array of values.
  #
  # ```
  # "%d items" % 3          # => "3 items"
  # ```
  native def %(arg: Object) -> String
  # The `length` characters from character index `start` (from the end
  # when negative); fewer at the end of the string, and empty when
  # `start` is the size.
  #
  # ## Raises
  #
  # `IndexError` when `start` is out of range or `length` is negative.
  #
  # ```
  # "héllo"[1, 2]           # => "él"
  # "héllo"[-2, 5]          # => "lo"
  # ```
  native def [](start: Int, length: Int) -> String
  # The text of the first match of `pattern`, or `nil` when there is
  # none.
  #
  # ```
  # "héllo"[/l+/]           # => "ll"
  # "héllo"[/z/]            # => nil
  # ```
  native def [](pattern: Regexp) -> String?
  # The same as `self[start, length]`.
  native def slice(start: Int, length: Int) -> String
  # The same as `self[range]`.
  native def slice(range: Range[Int]) -> String
  # The code point of each character.
  native def codepoints -> Array[Int]
  # The byte at byte index `index` (from the end when negative), or `nil`
  # when it is out of range.
  #
  # ```
  # "é".getbyte(0)          # => 195
  # "é".getbyte(2)          # => nil
  # ```
  native def getbyte(index: Int) -> Int?
  # Calls the block with each byte of the UTF-8 encoding.
  native def each_byte(&: (Int) -> Nil) -> Nil
  # An enumerator of the characters.
  native def each_char -> Enumerator[String]
  # The extended grapheme clusters: what a reader sees as one character,
  # a base with its combining marks, an emoji sequence.
  #
  # ```
  # "éx".chars.size      # => 3
  # "éx".graphemes.size  # => 2
  # ```
  native def graphemes -> Array[String]
  # Calls the block with each grapheme cluster, as `#graphemes` gives
  # them.
  native def each_grapheme(&: (String) -> Nil) -> Nil
  # The lines, without their line ending when `chomp` is true.
  #
  # ```
  # "a\nb\r\nc\n".lines(chomp: true)   # => ["a", "b", "c"]
  # ```
  native def lines(chomp: Bool) -> Array[String]
  # The fields separated by `separator`, at most `limit` of them when it
  # is positive (the last holds the rest). A negative `limit` keeps the
  # empty fields at the end; 0 is as no limit.
  #
  # ```
  # "a,b,c".split(",", 2)    # => ["a", "b,c"]
  # "a,b,,".split(",", -1)   # => ["a", "b", "", ""]
  # ```
  native def split(separator: String, limit: Int) -> Array[String]
  # The fields separated by matches of `separator`, with `limit` as
  # `split(String, Int)` reads it.
  native def split(separator: Regexp, limit: Int) -> Array[String]
  # The text before the first occurrence of `separator`, the separator,
  # and the text after it; the string and two empty strings when there
  # is none.
  #
  # ```
  # "a=b=c".partition("=")  # => ["a", "=", "b=c"]
  # "abc".partition("=")    # => ["abc", "", ""]
  # ```
  native def partition(separator: String) -> [String, String, String]
  # The text before the first match of `pattern`, the match, and the text
  # after it; the string and two empty strings when there is none.
  native def partition(pattern: Regexp) -> [String, String, String]
  # The text before the last occurrence of `separator`, the separator,
  # and the text after it; two empty strings and the string when there
  # is none.
  #
  # ```
  # "a=b=c".rpartition("=")  # => ["a=b", "=", "c"]
  # "abc".rpartition("=")    # => ["", "", "abc"]
  # ```
  native def rpartition(separator: String) -> [String, String, String]
  # The text before the last match of `pattern` (the last position a
  # match starts at), the match, and the text after it; two empty
  # strings and the string when there is none.
  native def rpartition(pattern: Regexp) -> [String, String, String]
  # The string without `prefix` at its start; the string itself when it
  # does not start with it.
  native def delete_prefix(prefix: String) -> String
  # The string without `suffix` at its end; the string itself when it
  # does not end with it.
  native def delete_suffix(suffix: String) -> String
  # Whether the strings are equal ignoring case (Unicode case folding).
  #
  # ```
  # "HÉllo".casecmp?("héLLO")   # => true
  # ```
  native def casecmp?(other: String) -> Bool
  # Compares as `<=>` does after folding case (Unicode): -1, 0 or 1.
  native def casecmp(other: String) -> Int
  # The string with `other` inserted before character index `index`.
  # A negative `index` counts from the end, so that -1 appends.
  #
  # ## Raises
  #
  # `IndexError` when `index` is beyond the size.
  #
  # ```
  # "héllo".insert(1, "X")   # => "hXéllo"
  # "héllo".insert(-1, "X")  # => "hélloX"
  # ```
  native def insert(index: Int, other: String) -> String
  # The string with `other` in front of it.
  native def prepend(other: String) -> String
  # Whether every character is ASCII.
  native def ascii_only? -> Bool
  # Calls the block with the strings from this one to `last`, one at a
  # time, as Ruby steps them: two single ASCII characters by character;
  # two strings of digits as numbers of any size, padded to this one's
  # width (`"9".upto("10")` gives "9" and "10"); otherwise this string and
  # each `#succ` after it, up to `last` or until one is longer than `last`
  # in bytes or is `last.succ`. Nothing is yielded when this string sorts
  # after `last` (`"c".upto("a")`, `"b".upto("aa")`).
  #
  # ```
  # r: Array[String] = []
  # "a8".upto("b1") { |s| r = r.push(s) }
  # r                       # => ["a8", "a9", "b0", "b1"]
  # ```
  native def upto(last: String, &: (String) -> Nil) -> Nil
  # The string with each run of the same character made one, for the
  # characters in `chars` only (a set written as `#tr`'s `from`).
  #
  # ```
  # "aaabbbccc".squeeze("a-b")  # => "abccc"
  # ```
  native def squeeze(chars: String) -> String
  # The string without `suffix` at its end; the string itself when it
  # does not end with it. Unlike Ruby's, an empty `suffix` removes
  # nothing.
  native def chomp(suffix: String) -> String
  # Whether the string starts with any of the prefixes given.
  native def start_with?(first: String, second: String, *rest: String) -> Bool
  # Whether `pattern` matches at the start of the string.
  #
  # ```
  # "hello".start_with?(/h.l/)  # => true
  # "xhello".start_with?(/h/)   # => false
  # ```
  native def start_with?(pattern: Regexp) -> Bool
  # Whether the string ends with any of the suffixes given.
  native def end_with?(first: String, second: String, *rest: String) -> Bool
  # The character index of the first occurrence of `other` at or after
  # character index `start` (from the end when negative), or `nil` when
  # there is none.
  native def index(other: String, start: Int) -> Int?
  # The character index of the first match of `pattern`, or `nil` when
  # there is none.
  native def index(pattern: Regexp) -> Int?
  # The character index of the first match of `pattern` at or after
  # character index `start` (from the end when negative), or `nil` when
  # there is none.
  native def index(pattern: Regexp, start: Int) -> Int?
  # The character index of the last occurrence of `other` that starts at
  # or before character index `start` (from the end when negative), or
  # `nil` when there is none.
  native def rindex(other: String, start: Int) -> Int?
  # The character index of the last position a match of `pattern` starts
  # at, or `nil` when there is none.
  native def rindex(pattern: Regexp) -> Int?
  # The character index of the last position at or before character
  # index `start` where a match of `pattern` starts, or `nil` when there
  # is none.
  native def rindex(pattern: Regexp, start: Int) -> Int?
  # The string with the first occurrence of `pattern` replaced by what
  # the block returns for it; the block receives the matched text.
  native def sub(pattern: String, &: (String) -> String) -> String
  # The string with the first match of `pattern` replaced by what the
  # block returns for the matched text.
  native def sub(pattern: Regexp, &: (String) -> String) -> String
  # The string with the first match of `pattern` replaced by what the
  # block returns; the block receives the matched text and its
  # `MatchData`, since there is no `$~`.
  #
  # ```
  # "a1b2".sub(/(\w)(\d)/) { |s, m| "#{m[2]}#{m[1]}" }   # => "1ab2"
  # ```
  native def sub(pattern: Regexp, &: (String, MatchData) -> String) -> String
  # The string with every occurrence of `pattern` replaced by what the
  # block returns for it; the block receives the matched text.
  #
  # ```
  # "abcb".gsub("b") { |s| s.upcase }   # => "aBcB"
  # ```
  native def gsub(pattern: String, &: (String) -> String) -> String
  # The string with every match of `pattern` replaced by what the block
  # returns for the matched text.
  native def gsub(pattern: Regexp, &: (String) -> String) -> String
  # The string with every match of `pattern` replaced by what the block
  # returns; the block receives the matched text and its `MatchData`.
  #
  # ```
  # "a=1 b=2".gsub(/(\w)=(\w)/) { |s, m| "#{m[2]}=#{m[1]}" }
  # # => "1=a 2=b"
  # ```
  native def gsub(pattern: Regexp, &: (String, MatchData) -> String) -> String
  # The string with every match of `pattern` replaced by the value of
  # the matched text in `replacements`; a text that is not a key is
  # removed.
  #
  # ```
  # "cat hat".gsub(/[ch]/, {"c" => "b", "h" => "m"})   # => "bat mat"
  # ```
  native def gsub(pattern: Regexp, replacements: Hash[String, String]) -> String
  # Calls the block with the text of every match of `pattern`.
  native def scan(pattern: Regexp, &: (String) -> Nil) -> Nil
  # Calls the block with the text and the `MatchData` of every match of
  # `pattern`, for its groups.
  native def scan(pattern: Regexp, &: (String, MatchData) -> Nil) -> Nil

  # A mutable buffer of text, to build a `String` in pieces without
  # copying at each step. `to_s` (and `freeze`) hand the contents over
  # without copying and leave the builder empty; `snapshot` copies.
  # Indices count characters, as a string's do. A builder is
  # `Unshareable`: it stays in the task that made it.
  #
  # ```
  # b = String::Builder.new
  # b << "hé" << "llo"
  # b.size                  # => 5
  # b.to_s                  # => "héllo"
  # b.empty?                # => true
  # ```
  class Builder
    include Unshareable

    # An empty builder.
    native def self.new -> String::Builder
    # Appends `piece`; returns the builder, so that calls chain.
    native def <<(piece: String) -> Self
    # Appends `piece`: the same as `<<`.
    native def push(piece: String) -> Self
    # Appends `piece`: the same as `<<`.
    native def append(piece: String) -> Self
    # Puts `piece` in front of the contents.
    native def prepend(piece: String) -> Self
    # Inserts `piece` before character index `index` (from the end when
    # negative, so that -1 appends).
    #
    # ## Raises
    #
    # `IndexError` when `index` is beyond the size.
    native def insert(index: Int, piece: String) -> Self
    # Removes the character at character index `index` (from the end when
    # negative) and returns it; `nil`, removing nothing, when `index` is
    # out of range.
    #
    # ```
    # b = String::Builder.new
    # b << "héllo"
    # b.delete_at(1)          # => "é"
    # b.delete_at(9)          # => nil
    # b.to_s                  # => "hllo"
    # ```
    native def delete_at(index: Int) -> String?
    # Replaces the contents with `text`.
    native def replace(text: String) -> Self
    # Reverses the characters in place.
    native def reverse! -> Self
    # The contents, handed over without copying: the builder is left empty
    # and can be filled again.
    #
    # ```
    # b = String::Builder.new
    # b << "ab"
    # b.to_s                  # => "ab"
    # b.to_s                  # => ""
    # ```
    native def to_s -> String
    # A copy of the contents; the builder keeps them.
    #
    # ```
    # b = String::Builder.new
    # b << "ab"
    # b.snapshot              # => "ab"
    # b << "c"
    # b.to_s                  # => "abc"
    # ```
    native def snapshot -> String
    # The contents, handed over as `to_s` does: the builder is left empty.
    def freeze -> String = to_s
    # The number of characters.
    native def size -> Int
    # The number of bytes of the UTF-8 contents.
    native def bytesize -> Int
    # Whether the builder holds no character.
    native def empty? -> Bool
    # Removes the contents.
    native def clear -> Self
  end
end

# A name, written `:name` (or `:"any text"`): interned, so equal symbols
# are the same value and compare in constant time. Used for hash keys,
# options and enum-like values.
class Symbol
  include Shareable
  include Comparable[Symbol]

  # Compares the names as strings.
  native def <=>(other: Symbol) -> Int
  # The name, without the colon.
  native def to_s -> String
  # The symbol itself.
  native def to_sym -> Symbol
  # The literal: `:abc`, quoted when the name is not an identifier.
  #
  # ```
  # :abc.inspect       # => ":abc"
  # :"a b".inspect     # => ":\"a b\""
  # ```
  native def inspect -> String
  # The number of characters in the name.
  native def size -> Int
  # :ditto:
  native def length -> Int
  # Whether the name is empty (`:""`).
  native def empty? -> Bool
  # The symbol with the name in upper case.
  native def upcase -> Symbol
  # The symbol with the name in lower case.
  native def downcase -> Symbol
  # The symbol with the name's first character in upper case and the rest
  # in lower case.
  native def capitalize -> Symbol
  # The symbol whose name is the name's successor, as `String#succ`.
  #
  # ```
  # :az.succ   # => :ba
  # ```
  native def succ -> Symbol
  # Whether the name starts with one of `prefixes`.
  native def start_with?(*prefixes: String) -> Bool
  # Whether the name ends with one of `suffixes`.
  native def end_with?(*suffixes: String) -> Bool
end

# A regular expression: a literal `/.../imx` or `.new`. Searches go
# through `String`'s methods (`String#match`, `String#scan`,
# `String#gsub`, ...) or this class's `match`, `match?` and `=~`;
# positions are character indices. `Bytes` are searched with the same
# patterns, byte by byte.
#
# The syntax is Ruby's, as far as Rust's `regex` engine has it: no
# backtracking, so a search takes time linear in the text.
#
# - Characters, classes `[a-z]` (`[^...]`, nested, `&&` intersection),
#   `.`, the escapes `\d \w \s \h \b` and their negations, `\p{L}`,
#   `\p{Han}` and `\P{...}`, POSIX classes `[[:alpha:]]` (Unicode, as
#   in Ruby), `\x{e9}` and `é`.
# - Anchors: `^` and `$` at the start and end of every line, as in
#   Ruby; `\A` and `\z` at the text's.
# - Quantifiers `* + ? {n} {n,} {n,m}` and their lazy forms (`*?`).
# - Groups `(...)`, `(?:...)`, named `(?<name>...)` (a pattern with a
#   named group captures with its named groups only, as in Ruby), and
#   flags `(?i)`, `(?i:...)`, `(?-i:...)`.
# - Flags: `i` ignores case (Unicode), `m` makes `.` match a newline,
#   `x` ignores whitespace and `#` comments.
#
# Unlike Ruby's, `\d` and `\s` are Unicode too. Look-ahead and
# look-behind, backreferences (`\1` in a pattern), atomic groups,
# possessive quantifiers, `(?#...)`, `\G`, `\K`, `\R`, `\X`, `\Z` and
# `{,n}` are not supported: such a pattern raises `ArgumentError` when
# it is made, which for a literal is when it is evaluated.
#
# ```
# /(\d+)-(\d+)/.match?("10-20")        # => true
# "2024-10-25"[/\d+/]                  # => "2024"
# "aé1"[/\p{L}+/]                      # => "aé"
# "a\nb".match?(/^b$/)                 # => true
# "a\nb".match?(/\Ab/)                 # => false
# Regexp.new("a(?=b)")                 # raises ArgumentError
# ```
class Regexp
  include Shareable

  # The regular expression whose pattern is `source`, with `options` the
  # literal's flags (`i`, `m`, `x`): `Regexp.new("a+b", "i")` is `/a+b/i`.
  #
  # ## Raises
  #
  # `ArgumentError` when `source` is not a pattern the engine supports
  # (see `Regexp`), or for an option other than `i`, `m` and `x`.
  #
  # ```
  # Regexp.new("a+b", "i").match?("AAB")  # => true
  # Regexp.new("a(")                      # raises ArgumentError
  # ```
  native def self.new(source: String, options: String = "") -> Regexp
  # `text` with the characters that have a meaning in a pattern escaped
  # by a backslash, so that it matches itself. Unlike Ruby's, whitespace
  # is left as it is.
  #
  # ```
  # Regexp.escape("a.b*c")  # => "a\\.b\\*c"
  # ```
  native def self.escape(text: String) -> String
  # A pattern matching any of `patterns`: a string matches itself
  # (escaped), a `Regexp` its pattern, without its flags. With no
  # pattern, the result is `//`, which matches everywhere (Ruby's matches
  # nothing).
  #
  # ## Raises
  #
  # `TypeError` for a pattern that is neither a `String` nor a `Regexp`.
  #
  # ```
  # Regexp.union("a.b", /c+/)    # => /a\.b|(?:c+)/
  # ```
  native def self.union(*patterns: Object) -> Regexp

  # The first match in `text`, or `nil` when there is none.
  #
  # ```
  # /(\d+)/.match("ab12")&.captures  # => ["12"]
  # /x/.match("ab")                  # => nil
  # ```
  native def match(text: String) -> MatchData?
  # Whether the pattern matches somewhere in `text`.
  native def match?(text: String) -> Bool
  # The character index of the first match in `text`, or `nil` when there
  # is none.
  native def =~(text: String) -> Int?
  # The pattern as written, without the slashes and the flags.
  #
  # ```
  # /a\/b/i.source          # => "a/b"
  # ```
  native def source -> String
  # The flags, as a string of `i`, `m` and `x` (empty for none). Unlike
  # Ruby's, not an integer.
  #
  # ```
  # /a/mi.options           # => "mi"
  # ```
  native def options -> String
  # The names of the named groups, in order.
  #
  # ```
  # /(?<y>\d+)-(?<m>\d+)/.names   # => ["y", "m"]
  # ```
  native def names -> Array[String]
  # The pattern as a literal, `/a+/i`: the same as `inspect`.
  native def to_s -> String
  # The pattern as a literal, `/a+/i`.
  native def inspect -> String
  # Whether `other` is a `Regexp` with the same source and flags.
  native def ==(other: Object) -> Bool
  # A hash code: equal patterns have equal ones.
  native def hash -> Int
end

# A match of a `Regexp` in a string: the matched text, its groups and
# where they are. Positions are character indices. Made by
# `String#match`, `String#matches`, `Regexp#match` and given to the
# blocks of `String#sub`, `String#gsub` and `String#scan`.
#
# ```
# m = "on 2024-10 now".matches(/(?<y>\d+)-(?<m>\d+)/)[0]
# m[0]                    # => "2024-10"
# m["y"]                  # => "2024"
# m.pre_match             # => "on "
# m.begin(0)              # => 3
# ```
class MatchData
  include Shareable

  # The text of group `index` (0 is the whole match), or `nil` when the
  # group took no part or there is no such group. Unlike Ruby's, a
  # negative index gives `nil`.
  native def [](index: Int) -> String?
  # The text of the group named `name`, or `nil` when it took no part.
  #
  # ## Raises
  #
  # `IndexError` when the pattern has no group of that name.
  native def [](name: String) -> String?
  # The text before the match.
  native def pre_match -> String
  # The text after the match.
  native def post_match -> String
  # The texts of the groups (not the whole match), `nil` for one that
  # took no part.
  #
  # ```
  # "aé".match(/(é)(x)?/)&.captures   # => ["é", nil]
  # ```
  native def captures -> Array[String?]
  # The named groups' texts by name, `nil` for one that took no part.
  native def named_captures -> Hash[String, String?]
  # The names of the named groups, in order.
  native def names -> Array[String]
  # The texts of the groups at `indices`, as `#[]` gives them.
  native def values_at(*indices: Int) -> Array[String?]
  # The whole match followed by the groups' texts.
  native def to_a -> Array[String?]
  # The number of groups plus one (for the whole match).
  native def size -> Int
  # The matched text.
  native def to_s -> String
  # The match and its groups, as `#<MatchData "2024-10" y:"2024" m:"10">`.
  native def inspect -> String
  # The character index where group `index` starts (0: the whole match),
  # or `nil` when the group took no part.
  #
  # ## Raises
  #
  # `IndexError` when there is no group `index`.
  #
  # ```
  # m = "aéb".match(/(é)(x)?/)
  # m&.begin(1)             # => 1
  # m&.end(1)               # => 2
  # m&.begin(2)             # => nil
  # ```
  native def begin(index: Int) -> Int?
  # The character index just after the end of group `index` (0: the
  # whole match), or `nil` when the group took no part.
  #
  # ## Raises
  #
  # `IndexError` when there is no group `index`.
  native def end(index: Int) -> Int?
end

# A module of collection methods built on `each`. A class that includes
# `Enumerable[T]` and defines `each` gets every other method here: mapping
# and filtering (`#map`, `#select`, `#filter_map`, `#flat_map`), folding
# (`#reduce`, `#sum`, `#count`, `#tally`), searching (`#find`,
# `#include?`, `#any?`), slicing (`#first`, `#take_while`,
# `#each_slice`), grouping (`#group_by`, `#partition`, `#chunk_while`)
# and ordering (`#sort_by`, `#min_by`). `#sort`, `#min`, `#max`,
# `minmax`, `min(n)` and `max(n)` need either a comparator block or
# elements that are `Comparable`, and `#sum` without a block needs `Int`,
# `Float` or `Integer` elements.
#
# The methods that collect return an immutable `Array`, whatever the
# receiver is. `#map`, `#each_with_index`, `#each_slice`, `#each_cons`
# and `#to_enum` without a block return an `Enumerator`.
#
# ```
# class DocDigits_Enumerable
#   include Enumerable[Int]
#
#   def each(&: (Int) -> Nil) -> Nil
#     yield 3
#     yield 1
#     yield 2
#   end
# end
#
# d = DocDigits_Enumerable.new
# d.map { |x| x * 10 }   # => [30, 10, 20]
# d.sort                 # => [1, 2, 3]
# d.max                  # => 3
# d.sum                  # => 6
# d.each_slice(2).to_a   # => [[3, 1], [2]]
# ```
module Enumerable[out T]
  # Calls the block with each element in turn. The one method an includer
  # must define.
  abstract def each(&: (T) -> Nil) -> Nil

  # The block's results for each element, in order.
  #
  # ```
  # (1..3).map { |x| x * x }   # => [1, 4, 9]
  # ```
  def map[U](&: (T) -> U) -> Array[U]
    Array.build do |out|
      each { |x| out << yield(x) }
    end
  end

  # The concatenation of the arrays the block returns for each element.
  #
  # ```
  # [1, 2].flat_map { |x| [x, x * 10] }   # => [1, 10, 2, 20]
  # ```
  def flat_map[U](&: (T) -> Array[U]) -> Array[U]
    Array.build do |out|
      each { |x| out.concat(yield(x)) }
    end
  end

  # The block's results that are truthy (neither `nil` nor `false`).
  #
  # ```
  # [1, 2, 3, 4].filter_map { |x| x * 10 if x.even? }   # => [20, 40]
  # ```
  def filter_map[U](&: (T) -> U?) -> Array[U]
    Array.build do |out|
      each do |x|
        y = yield(x)
        out << y if y
      end
    end
  end

  # The elements for which the block is truthy, in order.
  def select(&: (T) -> Object) -> Array[T]
    Array.build do |out|
      each { |x| out << x if yield(x) }
    end
  end

  # The elements for which the block is truthy: `#select`.
  def filter(&: (T) -> Object) -> Array[T] = select { |x| yield(x) }

  # The elements for which the block is falsy (`nil` or `false`).
  def reject(&: (T) -> Object) -> Array[T]
    Array.build do |out|
      each { |x| out << x unless yield(x) }
    end
  end

  # Combines the elements with the block, starting from `initial`: the
  # block receives the accumulated value and the next element. `initial` on
  # an empty collection.
  #
  # ```
  # [1, 2, 3].reduce(10) { |acc, x| acc + x }   # => 16
  # ```
  def reduce[U](initial: U, &: (U, T) -> U) -> U
    acc = initial
    each { |x| acc = yield(acc, x) }
    acc
  end

  # Combines the elements with the block, starting from `initial`: `#reduce`.
  def inject[U](initial: U, &: (U, T) -> U) -> U = reduce(initial) { |a, x| yield(a, x) }

  # Calls the block with each element and its index, from 0.
  def each_with_index(&: (T, Int) -> Nil) -> Nil
    i = 0
    each do |x|
      yield x, i
      i += 1
    end
  end

  # Calls the block with each element and `memo`, then returns `memo`: for
  # filling a builder or another mutable object.
  #
  # ```
  # [1, 2].each_with_object(Array::Builder[Int].new) { |x, b| b << x * 3 }.to_a
  # # => [3, 6]
  # ```
  def each_with_object[U](memo: U, &: (T, U) -> Nil) -> U
    each { |x| yield x, memo }
    memo
  end

  # The first element for which the block is truthy, or `nil`.
  def find(&: (T) -> Object) -> T?
    each { |x| return x if yield(x) }
    nil
  end

  # The first element for which the block is truthy, or `nil`: `#find`.
  def detect(&: (T) -> Object) -> T? = find { |x| yield(x) }

  # The index of the first element for which the block is truthy, or `nil`.
  def find_index(&: (T) -> Object) -> Int?
    i = 0
    each do |x|
      return i if yield(x)
      i += 1
    end
    nil
  end

  # Whether an element is `==` to `value`.
  def include?(value: Object) -> Bool
    each { |x| return true if x == value }
    false
  end

  # The number of elements. Iterates over them all.
  def count -> Int
    n = 0
    each { |_x| n += 1 }
    n
  end

  # The number of elements for which the block is truthy.
  def count(&: (T) -> Object) -> Int
    n = 0
    each { |x| n += 1 if yield(x) }
    n
  end

  # Whether some element is truthy (neither `nil` nor `false`). False for an
  # empty collection.
  def any? -> Bool
    each { |x| return true if x }
    false
  end

  # Whether the block is truthy for some element. False for an empty
  # collection; stops at the first match.
  def any?(&: (T) -> Object) -> Bool
    each { |x| return true if yield(x) }
    false
  end

  # Whether every element is truthy. True for an empty collection.
  def all? -> Bool
    each { |x| return false unless x }
    true
  end

  # Whether the block is truthy for every element. True for an empty
  # collection; stops at the first miss.
  def all?(&: (T) -> Object) -> Bool
    each { |x| return false unless yield(x) }
    true
  end

  # Whether the block is truthy for no element. True for an empty collection.
  def none?(&: (T) -> Object) -> Bool = !any? { |x| yield(x) }

  # Whether the block is truthy for exactly one element.
  def one?(&: (T) -> Object) -> Bool = count { |x| yield(x) } == 1

  # The first element, or `nil` when there is none.
  #
  # ```
  # (1..).first                       # => 1
  # Set[Int].new.first               # => nil
  # ```
  def first -> T?
    each { |x| return x }
    nil
  end

  # The first `n` elements, or all of them when there are fewer. Stops
  # iterating once it has them, so it works on an endless range; a negative
  # `n` gives `[]`.
  #
  # ```
  # (1..).first(3)   # => [1, 2, 3]
  # ```
  def first(n: Int) -> Array[T]
    Array.build do |out|
      each do |x|
        break if out.size >= n
        out << x
      end
    end
  end

  # The first `n` elements: `first(n)`.
  def take(n: Int) -> Array[T] = first(n)

  # The elements after the first `n`; `[]` when there are no more than `n`.
  def drop(n: Int) -> Array[T]
    Array.build do |out|
      i = 0
      each do |x|
        out << x if i >= n
        i += 1
      end
    end
  end

  # The elements before the first one for which the block is falsy.
  #
  # ```
  # [1, 2, 5, 1].take_while { |x| x < 3 }   # => [1, 2]
  # ```
  def take_while(&: (T) -> Object) -> Array[T]
    Array.build do |out|
      each do |x|
        break unless yield(x)
        out << x
      end
    end
  end

  # The elements from the first one for which the block is falsy on.
  #
  # ```
  # [1, 2, 5, 1].drop_while { |x| x < 3 }   # => [5, 1]
  # ```
  def drop_while(&: (T) -> Object) -> Array[T]
    Array.build do |out|
      dropping = true
      each do |x|
        dropping = false if dropping && !yield(x)
        out << x unless dropping
      end
    end
  end

  # The elements as an array.
  def to_a -> Array[T] = map { |x| x }

  # The elements as a `Set`, without duplicates.
  def to_set -> Set[T]
    Set.build { |b| each { |x| b << x } }
  end

  # How many times each distinct element occurs, in order of first
  # appearance.
  #
  # ```
  # %w[a b a].tally   # => {"a" => 2, "b" => 1}
  # ```
  def tally[U >: T] -> Hash[U, Int]
    Hash.build do |counts|
      each { |x| counts[x] = counts.fetch(x, 0) + 1 }
    end
  end

  # The elements grouped by the block's result: each key maps to the
  # elements that gave it, in order.
  #
  # ```
  # %w[ant bee cow dog].group_by { |s| s[0] == "a" || s[0] == "b" }
  # # => {true => ["ant", "bee"], false => ["cow", "dog"]}
  # ```
  def group_by[K](&: (T) -> K) -> Hash[K, Array[T]]
    groups = Hash::Builder[K, Array::Builder[T]].new
    each do |x|
      key = yield(x)
      bucket = groups[key]?
      if bucket
        bucket << x
      else
        groups[key] = Array::Builder[T].new.push(x)
      end
    end
    Hash.build do |out|
      groups.each { |k, b| out[k] = b.to_a }
    end
  end

  # The elements for which the block is truthy, and those for which it is
  # falsy.
  #
  # ```
  # (1..5).partition { |x| x.odd? }   # => [[1, 3, 5], [2, 4]]
  # ```
  def partition(&: (T) -> Object) -> [Array[T], Array[T]]
    yes = Array::Builder[T].new
    no = Array::Builder[T].new
    each do |x|
      if yield(x)
        yes << x
      else
        no << x
      end
    end
    [yes.to_a, no.to_a]
  end

  # Calls the block with consecutive slices of `n` elements; the last one may
  # be shorter. Nothing is yielded for an empty collection.
  def each_slice(n: Int, &: (Array[T]) -> Nil) -> Nil
    chunk = Array::Builder[T].new
    each do |x|
      chunk << x
      if chunk.size == n
        yield chunk.to_a
        chunk = Array::Builder[T].new
      end
    end
    yield chunk.to_a unless chunk.empty?
  end

  # The elements without duplicates (by `==` and `hash`), each at its first
  # occurrence.
  def uniq -> Array[T]
    seen = Set::Builder[T].new
    Array.build do |out|
      each do |x|
        unless seen.include?(x)
          seen << x
          out << x
        end
      end
    end
  end

  # Pairs of each element with the element of `other` at the same index.
  #
  # ## Raises
  #
  # `IndexError` when `other` is shorter than the receiver (Ruby pads with
  # `nil`); a longer `other`'s extra elements are ignored.
  #
  # ```
  # [1, 2].zip(["a", "b", "c"])   # => [[1, "a"], [2, "b"]]
  # [1, 2].zip(["a"])             # raises IndexError
  # ```
  def zip[U](other: Array[U]) -> Array[[T, U]]
    i = 0
    Array.build do |out|
      each do |x|
        out << [x, other[i]]
        i += 1
      end
    end
  end

  # The element for which the block's result is smallest (the first one on a
  # tie), or `nil` when there is none. Results compare with `<=>`, as in
  # `#min`: a NaN result is the largest.
  #
  # ```
  # %w[ccc a bb].min_by { |s| s.size }   # => "a"
  # [Float::NAN, 1.0].min_by { |x| x }   # => 1.0
  # ```
  def min_by[U: Comparable[U]](&: (T) -> U) -> T?
    best: T? = nil
    best_key: U? = nil
    each do |x|
      key = yield(x)
      # `<=>`, which orders a NaN key (after every number), as `min`
      # and `max` do.
      if best_key.nil? || (key <=> best_key) < 0
        best = x
        best_key = key
      end
    end
    best
  end

  # The element for which the block's result is largest (the first one on a
  # tie), or `nil` when there is none. Results compare with `<=>`, as in
  # `#max`: a NaN result is the largest.
  def max_by[U: Comparable[U]](&: (T) -> U) -> T?
    best: T? = nil
    best_key: U? = nil
    each do |x|
      key = yield(x)
      # `<=>`, which orders a NaN key (after every number), as `min`
      # and `max` do.
      if best_key.nil? || (key <=> best_key) > 0
        best = x
        best_key = key
      end
    end
    best
  end

  # The elements sorted by the block's result. The sort is stable: elements
  # with equal keys keep their order.
  #
  # ```
  # %w[ccc a bb].sort_by { |s| s.size }   # => ["a", "bb", "ccc"]
  # ```
  def sort_by[U: Comparable[U]](&: (T) -> U) -> Array[T]
    pairs: Array[[U, T]] = map { |x| [yield(x), x] }
    sort_pairs(pairs).map { |pair| pair[1] }
  end

  # The elements as an array. Evaluation is not lazy yet: this is `#to_a`,
  # and a lazy enumerator is planned.
  def lazy -> Array[T] = to_a

  # Aliases that Ruby programs use.

  # The block's results for each element: `#map`.
  def collect[U](&: (T) -> U) -> Array[U] = map { |x| yield(x) }
  # The concatenation of the arrays the block returns: `#flat_map`.
  def collect_concat[U](&: (T) -> Array[U]) -> Array[U] = flat_map { |x| yield(x) }
  # The elements for which the block is truthy: `#select`.
  def find_all(&: (T) -> Object) -> Array[T] = select { |x| yield(x) }
  # Whether an element is `==` to `value`: `#include?`.
  def member?(value: Object) -> Bool = include?(value)
  # The elements as an array: `#to_a`.
  def entries -> Array[T] = to_a

  # Combines the elements with the block, starting from the first element;
  # `nil` for an empty collection, and the element itself for a single one.
  #
  # ```
  # [1, 2, 3].reduce { |acc, x| acc * x }   # => 6
  # Array[Int].new.reduce { |acc, x| acc + x }   # => nil
  # ```
  def reduce[U >: T](&: (U, T) -> U) -> U?
    acc: U? = nil
    each do |x|
      current = acc
      acc = current.nil? ? x : yield(current, x)
    end
    acc
  end

  # Combines the elements with the block, from the first one: `#reduce`.
  def inject[U >: T](&: (U, T) -> U) -> U? = reduce[U]() { |a, x| yield(a, x) }

  # The number of elements `==` to `value`.
  def count(value: Object) -> Int = count { |x| x == value }

  # Whether no element is truthy. True for an empty collection.
  def none? -> Bool = !any?

  # Whether exactly one element is truthy.
  def one? -> Bool = count { |x| x } == 1

  # The index of the first element `==` to `value`, or `nil`.
  def find_index(value: Object) -> Int? = find_index { |x| x == value }

  # Calls the block with each element, last first. Collects them first.
  def reverse_each(&: (T) -> Nil) -> Nil
    to_a.reverse_each { |x| yield(x) }
  end

  # Calls the block with each run of `n` consecutive elements (a sliding
  # window); nothing when there are fewer than `n`.
  #
  # ## Raises
  #
  # `ArgumentError` when `n` is not positive.
  #
  # ```
  # (1..4).each_cons(2).to_a   # => [[1, 2], [2, 3], [3, 4]]
  # ```
  def each_cons(n: Int, &: (Array[T]) -> Nil) -> Nil
    raise ArgumentError, "invalid size" if n <= 0
    window = Array::Builder[T].new
    each do |x|
      window << x
      window.shift if window.size > n
      yield window.snapshot if window.size == n
    end
  end

  # Consecutive elements for which the block holds stay in one chunk.
  #
  # The result is the list of chunks; `[]` for an empty collection.
  #
  # ```
  # [1, 2, 4, 5, 7].chunk_while { |a, b| b == a + 1 }
  # # => [[1, 2], [4, 5], [7]]
  # ```
  def chunk_while(&: (T, T) -> Object) -> Array[Array[T]]
    chunks = Array::Builder[Array[T]].new
    chunk = Array::Builder[T].new
    previous: T? = nil
    started = false
    each do |x|
      last = previous
      if started && !last.nil? && !yield(last, x)
        chunks << chunk.to_a
        chunk = Array::Builder[T].new
      end
      chunk << x
      previous = x
      started = true
    end
    chunks << chunk.to_a if started
    chunks.to_a
  end

  # The chunk is cut where the block holds.
  #
  # The block receives each pair of neighbours; the result is a list of the
  # chunks.
  #
  # ```
  # [1, 2, 4, 5, 7].slice_when { |a, b| b != a + 1 }
  # # => [[1, 2], [4, 5], [7]]
  # ```
  def slice_when(&: (T, T) -> Object) -> Array[Array[T]]
    chunk_while { |a, b| !yield(a, b) }
  end

  # The elements without duplicates by the block's result, each at the first
  # element that gave its key.
  #
  # ```
  # [1, 2, 3, 4].uniq { |x| x % 2 }   # => [1, 2]
  # ```
  def uniq[U](&: (T) -> U) -> Array[T]
    seen = Set::Builder[U].new
    Array.build do |out|
      each do |x|
        key = yield(x)
        unless seen.include?(key)
          seen << key
          out << x
        end
      end
    end
  end

  # How many elements give each result of the block, in order of first
  # appearance.
  def tally_by[K](&: (T) -> K) -> Hash[K, Int]
    Hash.build do |counts|
      each do |x|
        key = yield(x)
        counts[key] = counts.fetch(key, 0) + 1
      end
    end
  end

  # A hash of the `[key, value]` pairs the block returns; a later pair
  # replaces an earlier one with the same key.
  #
  # ```
  # %w[a bb].to_h { |s| [s, s.size] }   # => {"a" => 1, "bb" => 2}
  # ```
  def to_h[K, V](&: (T) -> [K, V]) -> Hash[K, V]
    Hash.build do |out|
      each do |x|
        pair = yield(x)
        out[pair[0]] = pair[1]
      end
    end
  end

  # Calls the block with each element, `n` times over. Collects the
  # elements first; does nothing when there are none.
  def cycle(n: Int, &: (T) -> Nil) -> Nil
    items = to_a
    return nil if items.empty?
    n.times { items.each { |x| yield(x) } }
  end

  # Calls the block with each element, over and over, until the block
  # breaks or raises. Returns `nil` at once when there are no elements.
  def cycle(&: (T) -> Nil) -> Nil
    items = to_a
    return nil if items.empty?
    while true
      items.each { |x| yield(x) }
    end
  end

  # Calls the block with each element: `#each`.
  def each_entry(&: (T) -> Nil) -> Nil = each { |x| yield(x) }

  # The sum of the block's results; 0 for an empty collection.
  def sum(&: (T) -> Int) -> Int = reduce(0) { |acc, x| acc + yield(x) }
  # The sum of the block's results; 0.0 for an empty collection.
  def sum(&: (T) -> Float) -> Float = reduce(0.0) { |acc, x| acc + yield(x) }

  # The elements sorted by the comparator block, which returns a negative
  # number, zero or a positive number as `<=>` does. The sort is stable.
  #
  # To order by a key, `#sort_by` is usually simpler.
  #
  # ```
  # [1, 3, 2].sort { |a, b| b <=> a }   # => [3, 2, 1]
  # ```
  native def sort(&: (T, T) -> Int) -> Array[T]
  # The smallest element by the comparator block (negative, zero or
  # positive, as `<=>`), or `nil` when there is none.
  native def min(&: (T, T) -> Int) -> T?
  # The largest element by the comparator block, or `nil` when there is
  # none.
  native def max(&: (T, T) -> Int) -> T?

  # An enumerator over the elements, for `Enumerator`'s methods
  # (`Enumerator#next`, `Enumerator#with_index`).
  #
  # The iterating methods given no block return one too, as in Ruby:
  # `xs.each_with_index.map { |x, i| }`, `xs.map.with_index { |x, i| }`.
  #
  # ```
  # [1, 2].to_enum.next    # => 1
  # ```
  native def to_enum -> Enumerator[T]
  # An enumerator over the elements, for `Enumerator#with_index`: `xs.map.with_index { |x, i| }`.
  native def map -> Enumerator[T]
  # An enumerator of `[element, index]` pairs:
  # `xs.each_with_index.map { |x, i| }`.
  #
  # ```
  # %w[a b].each_with_index.to_a   # => [["a", 0], ["b", 1]]
  # ```
  native def each_with_index -> Enumerator[[T, Int]]
  private native def each_with_index_pairs(&: ([T, Int]) -> Nil) -> Nil
  # `[key, value]` pairs sorted by key (for `sort_by`).
  private native def sort_pairs[K, V](pairs: Array[[K, V]]) -> Array[[K, V]]
  # An enumerator of the slices `each_slice(n) { }` would yield.
  native def each_slice(n: Int) -> Enumerator[Array[T]]
  # An enumerator of the windows `each_cons(n) { }` would yield.
  native def each_cons(n: Int) -> Enumerator[Array[T]]
end

extension Enumerable[T: Comparable[T]]
  # The elements in ascending order (by `<=>`). The sort is stable.
  #
  # ```
  # [3, 1, 2].sort       # => [1, 2, 3]
  # %w[b c a].sort       # => ["a", "b", "c"]
  # ```
  native def sort -> Array[T]
  # The smallest element, or `nil` when there is none.
  #
  # ```
  # [3, 1, 2].min          # => 1
  # Array[Int].new.min     # => nil
  # ```
  native def min -> T?
  # The largest element, or `nil` when there is none.
  native def max -> T?
  # The smallest and the largest elements; `[nil, nil]` when there are none.
  #
  # ```
  # [3, 1, 2].minmax   # => [1, 3]
  # ```
  native def minmax -> [T?, T?]
  # The `n` smallest elements, smallest first (all of them when there are
  # fewer).
  def min(n: Int) -> Array[T] = sort.first(n)
  # The `n` largest elements, largest first (all of them when there are
  # fewer).
  #
  # ```
  # [3, 1, 2].max(2)   # => [3, 2]
  # ```
  def max(n: Int) -> Array[T] = sort.reverse.first(n)
end

extension Enumerable[T: Int]
  # The sum of the elements; 0 for an empty collection.
  def sum -> Int = reduce(0) { |acc, x| acc + x }
end

extension Enumerable[T: Float]
  # The sum of the elements; 0.0 for an empty collection.
  def sum -> Float = reduce(0.0) { |acc, x| acc + x }
end

extension Enumerable[T: Integer]
  # The sum of the elements; 0 for an empty collection.
  def sum -> Integer = reduce(0.to_integer) { |acc, x| acc + x }
end

extension Array[T: Comparable[T]]
  # Compares element by element, as `Array#<=>` does.
  native def <=>(other: Array[T]) -> Int
end

# An external iterator over what a method yields: `xs.each`, `xs.map`,
# `xs.each_with_index`, `xs.each_slice(n)`, `range.step(n)` without a
# block return one. It is `Enumerable`, so `xs.each_with_index.map { }`
# works, and `#with_index` collects with an index (`xs.map.with_index`).
#
# `#next` and `#peek` walk it one element at a time; `#each` and the
# `Enumerable` methods run the underlying method again from the start and
# do not move that position. An enumerator is not `Shareable`: it stays in
# the task that made it.
#
# ```
# e = [1, 2].each
# e.next   # => 1
# e.peek   # => 2
# e.next   # => 2
# e.next   # raises StopIteration
# e.rewind.next   # => 1
# ```
class Enumerator[out T]
  # It has a position, and its receiver may be a mutable object: it
  # stays in its task.
  include Unshareable
  include Enumerable[T]

  # Calls the block with each element, by calling the underlying method
  # from the start. Leaves the position of `#next` as it is.
  native def each(&: (T) -> Nil) -> Nil
  # The element at the position, and moves past it.
  #
  # The first call (and the first after `#rewind`) collects every element,
  # so later changes to the source are not seen until `#rewind`, and on an
  # endless source (`(1..).each`) it never returns.
  #
  # ## Raises
  #
  # `StopIteration` past the last element.
  native def next -> T
  # The element at the position, without moving past it: what `#next`
  # would return.
  #
  # ## Raises
  #
  # `StopIteration` past the last element.
  native def peek -> T
  # Moves back to the first element, and returns the enumerator. The next
  # `#next` collects the elements again.
  native def rewind -> Self
  # The number of elements. Iterates over them (an endless source never
  # returns).
  native def size -> Int
  # Collects the block's results: `xs.map.with_index { |x, i| ... }`.
  #
  # The index starts at `offset` (0 without one).
  #
  # ```
  # %w[a b].each.with_index(1) { |s, i| "#{i}. #{s}" }   # => ["1. a", "2. b"]
  # ```
  native def with_index[U](&: (T, Int) -> U) -> Array[U]
  # :ditto:
  native def with_index[U](offset: Int, &: (T, Int) -> U) -> Array[U]
end

# An ordered, immutable sequence of `T`s: `[1, 2, 3]`, `%w[a b]`,
# `Array[Int].new`.
#
# Methods that "change" an array, `#push`, `#pop`, `#set`, `#delete`
# and the others, return a new one and leave the receiver as it was. An
# update assigned back to the same variable, `xs = xs.push(v)`, happens in
# place without copying when nothing else refers to the array, so a loop
# that builds an array this way is linear. `Array::Builder` is the
# mutable array, and `Array.build` fills one and hands over the result.
#
# An index counts from 0; a negative index counts from the end, -1 being
# the last element. `xs[i]` raises `IndexError` out of range, while
# `xs[i]?` and `#at` return `nil`, and `#fetch` a default. `#pop` and
# `#shift` return the array without its last or first element, not the
# element: read it with `#last` or `#first`.
#
# ```
# xs = [1, 2, 3]
# ys = xs.push(4)
# xs        # => [1, 2, 3]
# ys        # => [1, 2, 3, 4]
# xs[-1]    # => 3
# xs[5]?    # => nil
# xs[5]     # raises IndexError
# xs.pop    # => [1, 2]
# ```
class Array[out T]
  include Shareable
  include Enumerable[T]

  # An empty array: `Array[Int].new`.
  native def self.new -> Array[T]
  # An array of `size` elements, the block's result for each index from 0.
  # Empty when `size` is 0 or negative.
  #
  # ```
  # Array.new(4) { |i| i * i }   # => [0, 1, 4, 9]
  # ```
  native def self.new(size: Int, &: (Int) -> T) -> Array[T]
  # The array a block fills: the block receives an `Array::Builder`, whose
  # contents become the result without copying.
  #
  # ```
  # Array.build { |b| 3.times { |i| b << i * 2 } }   # => [0, 2, 4]
  # ```
  native def self.build(&: (Array::Builder[T]) -> Nil) -> Array[T]

  # Calls the block with each element in order.
  native def each(&: (T) -> Nil) -> Nil
  # Calls the block with each index, from 0.
  native def each_index(&: (Int) -> Nil) -> Nil
  # Calls the block with each element, last first.
  native def reverse_each(&: (T) -> Nil) -> Nil
  # The element at `index`; a negative `index` counts from the end.
  #
  # ## Raises
  #
  # `IndexError` when `index` is out of range (not in `-size...size`): use
  # `#[]?` or `#fetch` to get `nil` or a default instead.
  #
  # ```
  # xs = [10, 20, 30]
  # xs[0]    # => 10
  # xs[-1]   # => 30
  # xs[3]    # raises IndexError
  # ```
  native def [](index: Int) -> T
  # The elements in `range`. A negative bound counts from the end, an end
  # past the last element is cut there, and a range that ends before it
  # starts gives `[]`; endless and beginless ranges reach the end and the
  # start.
  #
  # ## Raises
  #
  # `IndexError` when the start is past the end of the array (a start of
  # exactly `size` gives `[]`), or is negative and before its first
  # element.
  #
  # ```
  # xs = [10, 20, 30]
  # xs[1..]      # => [20, 30]
  # xs[0...-1]   # => [10, 20]
  # xs[1..10]    # => [20, 30]
  # xs[3..]      # => []
  # xs[4..]      # raises IndexError
  # ```
  native def [](range: Range[Int]) -> Array[T]
  # The element at `index`, or `nil` when it is out of range; a negative
  # `index` counts from the end.
  #
  # ```
  # [10, 20][-1]?   # => 20
  # [10, 20][2]?    # => nil
  # ```
  native def []?(index: Int) -> T?
  # The element at `index`, or `nil` when it is out of range: `#[]?`.
  native def at(index: Int) -> T?
  # The element at `index`, or `default` when it is out of range; a
  # negative `index` counts from the end.
  #
  # ```
  # [10, 20].fetch(5, 0)   # => 0
  # ```
  native def fetch[U >: T](index: Int, default: U) -> U
  # The first element, or `nil` when the array is empty.
  native def first -> T?
  # The first element, or `nil` when the array is empty: `#first`.
  native def first? -> T?
  # The first `n` elements, or all of them when there are fewer; `[]` when
  # `n` is 0 or negative.
  native def first(n: Int) -> Array[T]
  # The last element, or `nil` when the array is empty.
  native def last -> T?
  # The last element, or `nil` when the array is empty: `#last`.
  native def last? -> T?
  # The last `n` elements, or all of them when there are fewer; `[]` when
  # `n` is 0 or negative.
  #
  # ```
  # [1, 2, 3].last(2)   # => [2, 3]
  # ```
  native def last(n: Int) -> Array[T]
  # The number of elements.
  native def size -> Int
  # The number of elements: `#size`.
  native def length -> Int
  # Whether the array has no element.
  native def empty? -> Bool
  # The array with `value` appended. The element type widens to take
  # `value`'s (`[1].push("a")` is an `Array[Int | String]`).
  #
  # `xs = xs.push(v)` appends in place when nothing else refers to `xs`;
  # otherwise the elements are copied once and `xs`'s other holders keep
  # the old array.
  #
  # ```
  # xs = [1, 2]
  # xs.push(3)   # => [1, 2, 3]
  # xs           # => [1, 2]
  # ```
  native def push[U >: T](value: U) -> Array[U]
  # The array without its last element (`[]` for an empty array). Unlike
  # Ruby's, it returns the array, not the element: read that with `#last`
  # first.
  #
  # ```
  # [1, 2, 3].pop   # => [1, 2]
  # ```
  native def pop -> Array[T]
  # The array without its first element (`[]` for an empty array), not the
  # element: read that with `#first` first.
  native def shift -> Array[T]
  # The array with `value` in front.
  native def unshift[U >: T](value: U) -> Array[U]
  # The array with `value` inserted before the element at `index`. `index`
  # may be `size` (appends); a negative `index` counts from the end and
  # inserts after that element, so -1 appends.
  #
  # ## Raises
  #
  # `IndexError` when `index` is not in `-(size + 1)..size`.
  #
  # ```
  # [1, 2].insert(1, 9)    # => [1, 9, 2]
  # [1, 2].insert(-1, 9)   # => [1, 2, 9]
  # [1, 2].insert(3, 9)    # raises IndexError
  # ```
  native def insert[U >: T](index: Int, value: U) -> Array[U]
  # The array with the element at `index` replaced by `value`: the immutable
  # `[]=`. A negative `index` counts from the end.
  #
  # ## Raises
  #
  # `IndexError` when `index` is out of range: `set` does not extend the
  # array.
  #
  # ```
  # [1, 2, 3].set(-1, 0)   # => [1, 2, 0]
  # [1, 2, 3].set(3, 0)    # raises IndexError
  # ```
  native def set[U >: T](index: Int, value: U) -> Array[U]
  # The array without the elements `==` to `value` (all of them); the same
  # elements when there is none.
  native def delete(value: Object) -> Array[T]
  # The array without the element at `index` (negative counts from the end);
  # the same elements when `index` is out of range.
  native def delete_at(index: Int) -> Array[T]
  # The array followed by `other`'s elements.
  native def concat[U >: T](other: Array[U]) -> Array[U]
  # The array followed by `other`'s elements: `#concat`.
  #
  # ```
  # [1, 2] + [3]   # => [1, 2, 3]
  # ```
  native def +[U >: T](other: Array[U]) -> Array[U]
  # The elements that are not `==` to an element of `other`, in order
  # (duplicates included).
  #
  # ```
  # [1, 2, 2, 3] - [2]   # => [1, 3]
  # ```
  native def -(other: Array[Object]) -> Array[T]
  # The elements repeated `count` times; `[]` when `count` is 0 or
  # negative.
  #
  # ```
  # [1, 2] * 2   # => [1, 2, 1, 2]
  # ```
  native def *(count: Int) -> Array[T]
  # The elements also in `other`, without duplicates, in the receiver's
  # order.
  #
  # ```
  # [1, 1, 2, 3] & [3, 1]   # => [1, 3]
  # ```
  native def &(other: Array[Object]) -> Array[T]
  # The elements of both arrays without duplicates: the receiver's first,
  # then `other`'s new ones.
  #
  # ```
  # [1, 2] | [2, 3]   # => [1, 2, 3]
  # ```
  native def |[U >: T](other: Array[U]) -> Array[U]
  # The elements in reverse order.
  native def reverse -> Array[T]
  # The elements rotated left by `count`: the element at `count` comes
  # first. A negative `count` rotates right, and `count` may exceed the size.
  #
  # ```
  # [1, 2, 3].rotate       # => [2, 3, 1]
  # [1, 2, 3].rotate(-1)   # => [3, 1, 2]
  # ```
  native def rotate(count: Int = 1) -> Array[T]
  # The index of the first element `==` to `value`, or `nil`.
  native def index(value: Object) -> Int?
  # The index of the last element `==` to `value`, or `nil`.
  native def rindex(value: Object) -> Int?
  # Whether an element is `==` to `value`.
  native def include?(value: Object) -> Bool
  # The elements' `to_s` joined with `separator` between them. A `nil`
  # element gives an empty string, and a nested array its `inspect` (Ruby
  # joins nested arrays recursively).
  #
  # ```
  # [1, 2, 3].join("-")      # => "1-2-3"
  # [1, nil, "a"].join(",")  # => "1,,a"
  # ```
  native def join(separator: String = "") -> String
  # A random element, or `nil` when the array is empty.
  native def sample -> T?
  # The elements in a random order.
  native def shuffle -> Array[T]
  # The elements with nested arrays replaced by their elements, at every
  # depth.
  #
  # ```
  # [1, [2, [3]]].flatten   # => [1, 2, 3]
  # ```
  native def flatten -> Array[Object]
  # The elements that are not `nil`.
  #
  # ```
  # [1, nil, 2].compact   # => [1, 2]
  # ```
  native def compact -> Array[T]
  # The array itself.
  native def to_a -> Array[T]
  # The elements' `inspect` in brackets: `#inspect`.
  native def to_s -> String
  # The elements' `inspect` in brackets.
  #
  # ```
  # ["a", 1].inspect   # => "[\"a\", 1]"
  # ```
  native def inspect -> String
  # Whether `other` is an array of the same size whose elements are `==`
  # to these, position by position (`[1] == [1.0]` holds).
  native def ==(other: Object) -> Bool
  # A hash code: arrays that are `==` have the same one.
  native def hash -> Int
  # The block's results for each element, in order.
  native def map[U](&: (T) -> U) -> Array[U]
  # The elements for which the block is truthy, in order.
  native def select(&: (T) -> Object) -> Array[T]
  # An enumerator over the elements.
  #
  # ```
  # e = [1, 2].each
  # e.next   # => 1
  # ```
  native def each -> Enumerator[T]
  # The element at `index`, or the block's result for `index` when it is out
  # of range; a negative `index` counts from the end.
  #
  # ```
  # [10, 20].fetch(5) { |i| i * 100 }   # => 500
  # ```
  native def fetch[U >: T](index: Int, &: (Int) -> U) -> U
  # The `length` elements from `start` (fewer at the end); a negative
  # `start` counts from the end. `[]` when `start` is out of range or
  # `length` is negative.
  #
  # ```
  # [1, 2, 3, 4].slice(1, 2)    # => [2, 3]
  # [1, 2, 3, 4].slice(-1, 5)   # => [4]
  # ```
  native def slice(start: Int, length: Int) -> Array[T]
  # The first `n` elements, or all of them when there are fewer.
  #
  # ## Raises
  #
  # `ArgumentError` when `n` is negative (`first(n)` returns `[]` then).
  native def take(n: Int) -> Array[T]
  # The elements after the first `n`; `[]` when there are no more than `n`.
  #
  # ## Raises
  #
  # `ArgumentError` when `n` is negative.
  native def drop(n: Int) -> Array[T]
  # The elements at `indices`, in their order; `nil` for an index out of
  # range. Negative indices count from the end.
  #
  # ```
  # [10, 20, 30].values_at(0, -1, 5)   # => [10, 30, nil]
  # ```
  native def values_at(*indices: Int) -> Array[T?]
  # The index of the first element for which the block is truthy, or `nil`.
  native def index(&: (T) -> Object) -> Int?
  # The index of the last element for which the block is truthy, or `nil`.
  native def rindex(&: (T) -> Object) -> Int?
  # The array with `values` appended, in order.
  #
  # ```
  # [1].push(2, 3)   # => [1, 2, 3]
  # ```
  native def push[U >: T](*values: U) -> Array[U]
  # The array with every element replaced by `value`.
  native def fill[U >: T](value: U) -> Array[U]
  # The array with the `length` elements from `start` replaced by `value`;
  # a negative `start` counts from the end. The array grows when
  # `start + length` passes its end, and a `start` equal to the size
  # appends. `IndexError` when `start` is past the end (where Ruby fills
  # the gap with nil).
  #
  # ```
  # [1, 2, 3].fill(0, 1, 1)   # => [1, 0, 3]
  # [1, 2].fill(0, 1, 3)      # => [1, 0, 0, 0]
  # [1, 2].fill(0, 2, 2)      # => [1, 2, 0, 0]
  # [1, 2].fill(0, 3, 1)      # raises IndexError
  # ```
  native def fill[U >: T](value: U, start: Int, length: Int) -> Array[U]
  # The elements with nested arrays replaced by their elements, `depth`
  # levels deep; every level when `depth` is negative.
  #
  # ```
  # [1, [2, [3]]].flatten(1)   # => [1, 2, [3]]
  # ```
  native def flatten(depth: Int) -> Array[Object]
  # `n` elements at distinct random positions, or all of them shuffled when
  # there are fewer; `[]` when `n` is 0 or negative.
  native def sample(n: Int) -> Array[T]
  # The elements joined with `separator`: `#join`.
  #
  # ```
  # [1, 2] * ", "   # => "1, 2"
  # ```
  native def *(separator: String) -> String
  # Every pair of an element and an element of `other`, the receiver's
  # order outermost.
  #
  # ```
  # [1, 2].product(["a", "b"])
  # # => [[1, "a"], [1, "b"], [2, "a"], [2, "b"]]
  # ```
  native def product[U](other: Array[U]) -> Array[[T, U]]
  # Every combination of `n` elements, in the order of their positions:
  # `[[]]` when `n` is 0, `[]` when `n` exceeds the size.
  #
  # ```
  # [1, 2, 3].combination(2)   # => [[1, 2], [1, 3], [2, 3]]
  # ```
  native def combination(n: Int) -> Array[Array[T]]
  # Every ordered arrangement of `n` elements: `[[]]` when `n` is 0, `[]`
  # when `n` exceeds the size.
  native def permutation(n: Int) -> Array[Array[T]]
  # Every ordering of all the elements.
  #
  # ```
  # [1, 2].permutation   # => [[1, 2], [2, 1]]
  # ```
  native def permutation -> Array[Array[T]]
  # Binary search over a sorted array: the block is false for a prefix and
  # true from some element on; that element is returned.
  #
  # `nil` when the block is false for every element; the array must be
  # sorted for the block's answers to make sense.
  #
  # ```
  # [1, 3, 5, 7].bsearch { |x| x >= 4 }   # => 5
  # [1, 3, 5, 7].bsearch { |x| x >= 9 }   # => nil
  # ```
  native def bsearch(&: (T) -> Bool) -> T?
  # The elements for which the block is falsy: `#reject`.
  def delete_if(&: (T) -> Object) -> Array[T] = reject { |x| yield(x) }
  # The elements for which the block is truthy: `#select`.
  def keep_if(&: (T) -> Object) -> Array[T] = select { |x| yield(x) }
  # The elements of both arrays without duplicates: `#|`.
  def union[U >: T](other: Array[U]) -> Array[U] = self | other
  # The elements also in `other`, without duplicates: `#&`.
  def intersection(other: Array[Object]) -> Array[T] = self & other
  # The elements not in `other`: `#-`.
  def difference(other: Array[Object]) -> Array[T] = self - other
  # Whether the arrays have an element in common.
  #
  # ```
  # [1, 2].intersect?([2, 3])   # => true
  # ```
  def intersect?(other: Array[Object]) -> Bool = !(self & other).empty?

  # A mutable array: Ruby's destructive `Array` API, for building an array
  # step by step. Its methods change it in place and most return the builder
  # itself, so calls chain (`b << 1 << 2`).
  #
  # `#to_a` (or `#freeze`) hands the contents over as an immutable `Array`
  # without copying and leaves the builder empty, ready to be filled again;
  # `#snapshot` copies them and leaves the builder as it was. A builder is
  # not `Shareable`: it stays in the task that made it. `Array.build` is the
  # usual way to use one.
  #
  # Indices follow `Array`'s: a negative one counts from the end, `b[i]`
  # raises `IndexError` out of range and `b[i]?` returns `nil`. `#pop`,
  # `#shift` and `#delete_at` return the element removed, or `nil`.
  #
  # ```
  # b = Array::Builder[Int].new
  # b << 3 << 1 << 2
  # b.sort!
  # b.pop       # => 3
  # b[-1]       # => 2
  # xs = b.to_a
  # xs          # => [1, 2]
  # b.empty?    # => true
  # ```
  class Builder[T]
    include Unshareable
    include Enumerable[T]

    # An empty builder: `Array::Builder[Int].new`.
    native def self.new -> Array::Builder[T]
    # A builder holding `size` copies of `fill`; empty when `size` is 0 or
    # negative.
    native def self.new(size: Int, fill: T) -> Array::Builder[T]
    # Appends `value`, and returns the builder.
    native def <<(value: T) -> Self
    # Appends `value`, and returns the builder: `#<<`.
    native def push(value: T) -> Self
    # Removes the last element and returns it, or `nil` when there is none.
    native def pop -> T?
    # Removes the first element and returns it, or `nil` when there is none.
    native def shift -> T?
    # Puts `value` in front, and returns the builder.
    native def unshift(value: T) -> Self
    # Inserts `value` before the element at `index`, and returns the builder.
    # `index` may be `size` (appends); a negative `index` counts from the end
    # and inserts after that element, so -1 appends.
    #
    # ## Raises
    #
    # `IndexError` when `index` is not in `-(size + 1)..size`.
    native def insert(index: Int, value: T) -> Self
    # Appends `other`'s elements, and returns the builder.
    native def concat(other: Array[T]) -> Self
    # The element at `index`; a negative `index` counts from the end.
    #
    # ## Raises
    #
    # `IndexError` when `index` is out of range: use `#[]?` for `nil`.
    native def [](index: Int) -> T
    # The element at `index`, or `nil` when it is out of range; a negative
    # `index` counts from the end.
    native def []?(index: Int) -> T?
    # Replaces the element at `index` with `value`, and returns `value`. A
    # negative `index` counts from the end; an `index` equal to `size`
    # appends.
    #
    # ## Raises
    #
    # `IndexError` when `index` is past the end (where Ruby fills the gap
    # with nil) or, negative, before the start.
    #
    # ```
    # b = Array::Builder[Int].new.push(1, 2)
    # b[-1] = 5
    # b[2] = 6
    # b.to_a   # => [1, 5, 6]
    # b[4] = 7   # raises IndexError
    # ```
    native def []=(index: Int, value: T) -> T
    # The first element, or `nil` when the builder is empty.
    native def first -> T?
    # The last element, or `nil` when the builder is empty.
    native def last -> T?
    # The number of elements.
    native def size -> Int
    # The number of elements: `#size`.
    native def length -> Int
    # Whether the builder has no element.
    native def empty? -> Bool
    # Whether an element is `==` to `value`.
    native def include?(value: Object) -> Bool
    # Removes every element `==` to `value`, and returns the builder.
    native def delete(value: T) -> Self
    # Removes the element at `index` (negative counts from the end) and
    # returns it, or `nil` when `index` is out of range.
    native def delete_at(index: Int) -> T?
    # Removes every element, and returns the builder.
    native def clear -> Self
    # Reverses the elements in place, and returns the builder.
    native def reverse! -> Self
    # Sorts the elements in ascending order (by `<=>`), and returns the builder.
    native def sort! -> Self
    # Replaces each element with the block's result for it, and returns the builder.
    native def map!(&: (T) -> T) -> Self
    # Keeps the elements for which the block is truthy, and returns the builder.
    native def select!(&: (T) -> Object) -> Self
    # Removes the elements for which the block is truthy, and returns the builder.
    native def reject!(&: (T) -> Object) -> Self
    # Calls the block with each element in order.
    native def each(&: (T) -> Nil) -> Nil
    # Calls the block with each element and its index, from 0.
    native def each_with_index(&: (T, Int) -> Nil) -> Nil
    # Appends `values` in order, and returns the builder.
    native def push(*values: T) -> Self
    # The elements in `range`, as an immutable array (a copy). A negative
    # bound counts from the end. Unlike `Array#[]`, it raises nothing: a
    # start past the end gives `[]`, and one before the start is cut there.
    native def [](range: Range[Int]) -> Array[T]
    # The first `n` elements (all of them when there are fewer), as an
    # immutable array.
    native def first(n: Int) -> Array[T]
    # The last `n` elements (all of them when there are fewer), as an
    # immutable array.
    native def last(n: Int) -> Array[T]
    # The index of the first element `==` to `value`, or `nil`.
    native def index(value: T) -> Int?
    # The elements' `to_s` joined with `separator`: `Array#join`.
    native def join(separator: String = "") -> String
    # Sorts the elements by the comparator block (negative, zero or positive,
    # as `<=>`), and returns the builder.
    native def sort!(&: (T, T) -> Int) -> Self
    # Sorts the elements by the block's result (stable), and returns the
    # builder.
    native def sort_by![U: Comparable[U]](&: (T) -> U) -> Self
    # Removes duplicate elements, keeping the first of each, and returns the builder.
    native def uniq! -> Self
    # Removes the `nil` elements, and returns the builder.
    native def compact! -> Self
    # Puts the elements in a random order, and returns the builder.
    native def shuffle! -> Self
    # Rotates the elements left by `count` (right when negative), and returns
    # the builder.
    native def rotate!(count: Int = 1) -> Self
    # Replaces every element with `value`, and returns the builder.
    native def fill(value: T) -> Self
    # Replaces the `length` elements from `start` with `value`, growing the
    # builder when `start + length` passes its end; a negative `start` counts
    # from the end, and a `start` equal to the size appends. Returns the
    # builder. `IndexError` when `start` is past the end, as in
    # `Array#fill`.
    native def fill(value: T, start: Int, length: Int) -> Self
    # Replaces the contents with `other`'s elements, and returns the builder.
    native def replace(other: Array[T]) -> Self
    # Removes the `length` elements from `start` (fewer at the end) and
    # returns them; a negative `start` counts from the end. `[]` when `start`
    # is out of range.
    #
    # ```
    # b = Array::Builder[Int].new.push(1, 2, 3, 4)
    # b.slice!(1, 2)   # => [2, 3]
    # b.to_a           # => [1, 4]
    # ```
    native def slice!(start: Int, length: Int) -> Array[T]
    # Removes the elements for which the block is truthy, and returns the builder.
    native def delete_if(&: (T) -> Object) -> Self
    # Keeps the elements for which the block is truthy, and returns the builder.
    native def keep_if(&: (T) -> Object) -> Self
    # The contents as an immutable array, leaving the builder empty: `#to_a`.
    def freeze -> Array[T] = to_a
    # The contents as an immutable array, without copying; the builder is
    # left empty and can be filled again. Use `#snapshot` to keep its
    # contents.
    #
    # ```
    # b = Array::Builder[Int].new.push(1, 2)
    # b.to_a   # => [1, 2]
    # b.size   # => 0
    # ```
    native def to_a -> Array[T]
    # A copy of the contents as an immutable array; the builder keeps them.
    #
    # ```
    # b = Array::Builder[Int].new.push(1, 2)
    # b.snapshot   # => [1, 2]
    # b.size       # => 2
    # ```
    native def snapshot -> Array[T]
    # The elements' `inspect` in brackets, as `Array#to_s`.
    native def to_s -> String
    # The elements' `inspect` in brackets, as `Array#inspect`.
    native def inspect -> String
  end
end

# Arrays of comparable elements compare element by element (as tuples
# do, whose elements may differ in type; the checker handles those).
extension Array[T: Comparable[T]]
  include Comparable[Array[T]]
  # Compares element by element: the first pair that differs decides, and
  # when one array is a prefix of the other, the shorter is smaller.
  #
  # ```
  # [1, 2] <=> [1, 3]   # => -1
  # [1, 2] <=> [1]      # => 1
  # [1, 2] < [1, 3]     # => true
  # ```
  native def <=>(other: Array[T]) -> Int
end

# An immutable map from keys to values, kept in insertion order.
#
# Iteration, `#keys`, `#values`, `#to_a` and `#inspect` follow the order in
# which the keys were first added. The updating methods (`#put`, `#delete`,
# `#merge` ...) return a new hash and leave the receiver as it was;
# `Hash::Builder` is the mutable one. A literal is `{a: 1}` with `Symbol`
# keys and `{"a" => 1}` with others. As an `Enumerable`, the elements are
# `[key, value]` tuples, which a block with two parameters takes apart.
#
# A missing key: `#[]` raises `KeyError`, `#[]?` returns `nil` and
# `#fetch` takes a default or a block. There is no default value
# (`Hash.new(0)`) and no `default_proc`.
#
# ```
# h = {b: 1, a: 2}
# h.put(:c, 3)             # => {b: 1, a: 2, c: 3}
# h                        # => {b: 1, a: 2}
# h[:c]?                   # => nil
# h[:c]                    # raises KeyError
# h.fetch(:c, 0)           # => 0
# h.map { |k, v| v }       # => [1, 2]
# ```
class Hash[K, out V]
  include Shareable
  include Enumerable[[K, V]]

  # An empty hash, as `Hash[String, Int].new`.
  native def self.new -> Hash[K, V]
  # Calls the block with a new `Hash::Builder` and returns what it holds
  # afterwards.
  #
  # ```
  # Hash[String, Int].build { |b| %w[x yy].each { |s| b[s] = s.size } }
  # # => {"x" => 1, "yy" => 2}
  # ```
  native def self.build(&: (Hash::Builder[K, V]) -> Nil) -> Hash[K, V]

  # Calls the block with each `[key, value]` pair, in insertion order; a
  # block with two parameters takes the pair apart.
  native def each(&: ([K, V]) -> Nil) -> Nil
  # Calls the block with each key and its value, in insertion order.
  native def each_pair(&: (K, V) -> Nil) -> Nil
  # Calls the block with each key, in insertion order.
  native def each_key(&: (K) -> Nil) -> Nil
  # Calls the block with each value, in the insertion order of the keys.
  native def each_value(&: (V) -> Nil) -> Nil
  # The value for `key`.
  #
  # Raises `KeyError` when there is none: `#[]?` returns `nil` and `#fetch`
  # takes a default instead.
  native def [](key: K) -> V
  # The value for `key`, or `nil` when there is none. A `nil` value looks
  # the same: `#key?` tells them apart.
  native def []?(key: K) -> V?
  # The value for `key`, or `default` when there is none.
  #
  # ```
  # {a: 1}.fetch(:a, 0)      # => 1
  # {a: 1}.fetch(:b, 0)      # => 0
  # {a: 1}.fetch(:b, "none") # => "none"
  # ```
  native def fetch[W >: V](key: K, default: W) -> W
  # The value for `key`, or the block's result, called with `key`, when
  # there is none.
  native def fetch[W >: V](key: K, &: (K) -> W) -> W
  # The value for `key`, or `nil` when there is none, as `#[]?`. It takes
  # one key only.
  native def dig(key: K) -> V?
  # Whether `key` is a key.
  native def key?(key: K) -> Bool
  # Whether `key` is a key: the same as `#key?`.
  native def has_key?(key: K) -> Bool
  # Whether `key` is a key (unlike `Enumerable#include?`, which would compare
  # pairs). A value of another type than the keys' is none.
  native def include?(key: Object) -> Bool
  # Whether `key` is a key: the same as `#include?`.
  native def member?(key: Object) -> Bool
  # Whether some key has `value`, compared with `==`.
  native def value?(value: Object) -> Bool
  # Whether some key has `value`: the same as `#value?`.
  native def has_value?(value: Object) -> Bool
  # The first key, in insertion order, whose value is `value`, or `nil`.
  native def key(value: Object) -> K?
  # The values for `keys`, in their order, with `nil` for a missing key.
  native def values_at(*keys: K) -> Array[V?]
  # The values for `keys`, in their order. Raises `KeyError` for a missing
  # key.
  native def fetch_values(*keys: K) -> Array[V]
  # The hash without the pairs whose value is `nil`.
  native def compact -> Hash[K, V]
  # The hash without `keys`; a key it does not have is ignored.
  native def except(*keys: K) -> Hash[K, V]
  # The pairs for those of `keys` that are present, in the order of `keys`.
  #
  # ```
  # {a: 1, b: 2, c: 3}.slice(:c, :a, :z)   # => {c: 3, a: 1}
  # ```
  native def slice(*keys: K) -> Hash[K, V]
  # The pairs the block is truthy for: the same as `#select`.
  def filter(&: (K, V) -> Object) -> Hash[K, V] = select { |k, v| yield(k, v) }
  # The hash without the pairs the block is truthy for: the same as
  # `#reject`. The receiver is not changed, unlike Ruby's.
  def delete_if(&: (K, V) -> Object) -> Hash[K, V] = reject { |k, v| yield(k, v) }
  # The pairs the block is truthy for: the same as `#select`. The receiver
  # is not changed, unlike Ruby's.
  def keep_if(&: (K, V) -> Object) -> Hash[K, V] = select { |k, v| yield(k, v) }
  # The keys, in insertion order.
  native def keys -> Array[K]
  # The values, in the insertion order of their keys.
  native def values -> Array[V]
  # The number of pairs.
  native def size -> Int
  # The number of pairs: the same as `#size`.
  native def length -> Int
  # Whether there is no pair.
  native def empty? -> Bool
  # The hash with `key` mapped to `value`.
  #
  # A new key comes last; a key already there keeps its place and takes the
  # new value.
  #
  # ```
  # h = {a: 1, b: 2}
  # h.put(:a, 9)             # => {a: 9, b: 2}
  # h.put(:c, 3)             # => {a: 1, b: 2, c: 3}
  # h.delete(:a).put(:a, 1)  # => {b: 2, a: 1}
  # ```
  native def put[W >: V](key: K, value: W) -> Hash[K, W]
  # The hash without `key`, or the same pairs when it has no such key.
  # Unlike Ruby's, it returns the hash, not the value.
  native def delete(key: K) -> Hash[K, V]
  # The hash with the pairs of `other` added: for a key in both, the value
  # of `other`, at the place the key had; the new keys follow, in the order
  # of `other`.
  #
  # ```
  # {a: 1, b: 2}.merge({c: 3, a: 0})   # => {a: 0, b: 2, c: 3}
  # ```
  native def merge[W >: V](other: Hash[K, W]) -> Hash[K, W]
  # The hash with the pairs of `other` added, as `#merge` without a block,
  # but for a key in both, the block's result, called with the key, the old
  # value and the value of `other`.
  #
  # ```
  # {a: 1, b: 2}.merge({a: 10}) { |k, old, new| old + new }
  # # => {a: 11, b: 2}
  # ```
  native def merge[W >: V](other: Hash[K, W], &: (K, W, W) -> W) -> Hash[K, W]
  # The hash with `key` mapped to the block's result, called with the value
  # for `key`, or `nil` when there is none. A new key comes last.
  #
  # ```
  # counts = {"a" => 1}
  # counts.update("a") { |n| (n || 0) + 1 }   # => {"a" => 2}
  # counts.update("b") { |n| (n || 0) + 1 }   # => {"a" => 1, "b" => 1}
  # ```
  native def update[W >: V](key: K, &: (V?) -> W) -> Hash[K, W]
  # The pairs the block, called with each key and value, is truthy for, in
  # order.
  native def select(&: (K, V) -> Object) -> Hash[K, V]
  # The hash without the pairs the block, called with each key and value, is
  # truthy for.
  native def reject(&: (K, V) -> Object) -> Hash[K, V]
  # The hash with each value replaced by the block's result for it.
  native def transform_values[U](&: (V) -> U) -> Hash[K, U]
  # The hash with each key replaced by the block's result for it.
  #
  # When two keys become one, the later pair's value is kept, at the earlier
  # one's place.
  #
  # ```
  # {a: 1, b: 2}.transform_keys { |k| k.to_s }   # => {"a" => 1, "b" => 2}
  # {a: 1, b: 2}.transform_keys { |k| 0 }        # => {0 => 2}
  # ```
  native def transform_keys[U](&: (K) -> U) -> Hash[U, V]
  # The hash with keys and values swapped. When several keys have the same
  # value, the last of them is kept.
  native def invert[W >: V] -> Hash[W, K]
  # The `[key, value]` pairs, in insertion order.
  native def to_a -> Array[[K, V]]
  # The hash itself. With a block, `to_h` is `Enumerable#to_h`.
  native def to_h -> Hash[K, V]
  # The literal form, as `#inspect`.
  native def to_s -> String
  # The literal form, in insertion order: `{a: 1}` for `Symbol` keys,
  # `{"a" => 1}` for others, and `{}` when empty.
  native def inspect -> String
  # Whether `other` is a hash with the same keys mapped to equal values,
  # whatever their order.
  #
  # ```
  # {a: 1, b: 2} == {b: 2, a: 1}             # => true
  # {a: 1, b: 2}.to_a == {b: 2, a: 1}.to_a   # => false
  # ```
  native def ==(other: Object) -> Bool
  # A hash code consistent with `#==`, so the same whatever the order of the
  # keys.
  native def hash -> Int

  # A mutable hash, for building a `Hash` in place.
  #
  # It keeps insertion order as `Hash` does: a new key comes last, a key
  # already there keeps its place, and a key deleted and stored again comes
  # last. It is not `Shareable`. `#to_h` (and `#freeze`) hands the pairs
  # over as a `Hash` without copying and leaves the builder empty, as
  # `Array::Builder#to_a` does; `#snapshot` copies. A missing key is as in
  # `Hash`: `#[]` raises `KeyError`, `#[]?` returns `nil`, `#fetch` takes a
  # default.
  #
  # ```
  # counts = Hash::Builder[String, Int].new
  # %w[b a b].each { |w| counts.update(w) { |n| (n || 0) + 1 } }
  # counts["b"]              # => 2
  # counts.to_h              # => {"b" => 2, "a" => 1}
  # counts.empty?            # => true
  # ```
  class Builder[K, V]
    include Unshareable
    include Enumerable[[K, V]]

    # An empty builder, as `Hash::Builder[String, Int].new`.
    native def self.new -> Hash::Builder[K, V]
    # The value for `key`. Raises `KeyError` when there is none: `#[]?` returns
    # `nil` and `#fetch` takes a default instead.
    native def [](key: K) -> V
    # The value for `key`, or `nil` when there is none.
    native def []?(key: K) -> V?
    # Maps `key` to `value` and returns `value`. A new key comes last; a key
    # already there keeps its place.
    native def []=(key: K, value: V) -> V
    # Maps `key` to `value` and returns `value`: the same as `#[]=`.
    native def store(key: K, value: V) -> V
    # The value for `key`, or `default` when there is none. Nothing is stored.
    native def fetch(key: K, default: V) -> V
    # Removes `key` and returns its value, or `nil` when there was none.
    native def delete(key: K) -> V?
    # Whether `key` is a key.
    native def key?(key: K) -> Bool
    # The keys, in insertion order.
    native def keys -> Array[K]
    # The values, in the insertion order of their keys.
    native def values -> Array[V]
    # The number of pairs.
    native def size -> Int
    # Whether there is no pair.
    native def empty? -> Bool
    # Removes every pair and returns the builder.
    native def clear -> Self
    # Stores the pairs of `other`, in its order, and returns the builder. A
    # key already there keeps its place and takes the value of `other`.
    native def merge!(other: Hash[K, V]) -> Self
    # Stores the pairs of `other`, as `#merge!` without a block, but for a key
    # already there, the block's result, called with the key, the old value
    # and the value of `other`. Returns the builder.
    native def merge!(other: Hash[K, V], &: (K, V, V) -> V) -> Self
    # Maps `key` to the block's result, called with the value for `key` or
    # `nil` when there is none, and returns the builder.
    native def update(key: K, &: (V?) -> V) -> Self
    # Calls the block with each `[key, value]` pair, in insertion order.
    native def each(&: ([K, V]) -> Nil) -> Nil
    # Calls the block with each key and its value, in insertion order.
    native def each_pair(&: (K, V) -> Nil) -> Nil
    # Calls the block with each key, in insertion order.
    native def each_key(&: (K) -> Nil) -> Nil
    # Calls the block with each value, in the insertion order of the keys.
    native def each_value(&: (V) -> Nil) -> Nil
    # The value for `key`, or the block's result, called with `key`, when
    # there is none. Nothing is stored.
    native def fetch(key: K, &: (K) -> V) -> V
    # Whether `key` is a key: the same as `#key?`.
    native def has_key?(key: K) -> Bool
    # Whether `key` is a key. A value of another type than the keys' is none.
    native def include?(key: Object) -> Bool
    # Whether some key has `value`, compared with `==`.
    native def value?(value: V) -> Bool
    # The number of pairs: the same as `#size`.
    native def length -> Int
    # Keeps only the pairs the block is truthy for and returns the builder
    # (even when nothing changed, unlike Ruby's `nil`).
    native def select!(&: (K, V) -> Object) -> Self
    # Removes the pairs the block is truthy for and returns the builder (even
    # when nothing changed, unlike Ruby's `nil`).
    native def reject!(&: (K, V) -> Object) -> Self
    # Removes the pairs the block is truthy for and returns the builder: the
    # same as `#reject!`.
    native def delete_if(&: (K, V) -> Object) -> Self
    # Keeps only the pairs the block is truthy for and returns the builder:
    # the same as `#select!`.
    native def keep_if(&: (K, V) -> Object) -> Self
    # Replaces each value by the block's result for it and returns the
    # builder.
    native def transform_values!(&: (V) -> V) -> Self
    # Removes the pairs whose value is `nil` and returns the builder.
    native def compact! -> Self
    # Replaces the pairs by those of `other` and returns the builder.
    native def replace(other: Hash[K, V]) -> Self
    # The pairs as a `Hash`, leaving the builder empty: the same as `#to_h`.
    def freeze -> Hash[K, V] = to_h
    # The pairs as a `Hash`, handed over without copying: the builder is left
    # empty, and can be filled again.
    native def to_h -> Hash[K, V]
    # A copy of the pairs as a `Hash`; the builder keeps them.
    #
    # ```
    # b = Hash::Builder[Symbol, Int].new
    # b[:a] = 1
    # b.snapshot               # => {a: 1}
    # b.size                   # => 1
    # ```
    native def snapshot -> Hash[K, V]
    # The literal form of the pairs, as `Hash#inspect`.
    native def to_s -> String
    # The literal form of the pairs, as `Hash#inspect`.
    native def inspect -> String
  end
end

# An immutable set: each value at most once, compared with `==` and
# `hash`.
#
# A set keeps insertion order, as Ruby's does: iteration, `#to_a` and
# `#inspect` list the members in the order they were first added. The
# updating methods (`#add`, `#delete`, `#|` ...) return a new set and leave
# the receiver as it was; `Set::Builder` is the mutable one. Equality does
# not depend on the order.
#
# ```
# s = Set[3, 1, 3, 2]
# s                        # => Set[3, 1, 2]
# s.add(4)                 # => Set[3, 1, 2, 4]
# s.include?(4)            # => false
# s | Set[5, 1]            # => Set[3, 1, 2, 5]
# s == Set[1, 2, 3]        # => true
# ```
class Set[out T]
  include Shareable
  include Enumerable[T]

  # An empty set, as `Set[Int].new`.
  native def self.new -> Set[T]
  # A set of `items`, in the order first given, without duplicates.
  native def self.[](*items: T) -> Set[T]
  # Calls the block with a new `Set::Builder` and returns what it holds
  # afterwards.
  native def self.build(&: (Set::Builder[T]) -> Nil) -> Set[T]

  # Calls the block with each member, in insertion order.
  native def each(&: (T) -> Nil) -> Nil
  # The set with `value` added: last when it is new, the same members when
  # it is already one.
  native def add[U >: T](value: U) -> Set[U]
  # The set without `value`, or the same members when it is none.
  native def delete(value: Object) -> Set[T]
  # Whether `value` is a member. A value of another type than the members'
  # is none.
  native def include?(value: Object) -> Bool
  # The number of members.
  native def size -> Int
  # The number of members: the same as `#size`.
  native def length -> Int
  # Whether there is no member.
  native def empty? -> Bool
  # The union: the members of `self`, then those of `other` that are new, in
  # their order.
  native def |[U >: T](other: Set[U]) -> Set[U]
  # The intersection: the members of `self` that are in `other`, in the order
  # of `self`.
  #
  # ```
  # Set[3, 1, 2] & Set[2, 3, 9]      # => Set[3, 2]
  # ```
  native def &(other: Set[Object]) -> Set[T]
  # The difference: the members of `self` that are not in `other`.
  native def -(other: Set[Object]) -> Set[T]
  # The members in exactly one of the two sets: those of `self` first, then
  # those of `other`.
  #
  # ```
  # Set[1, 2, 3] ^ Set[3, 4]         # => Set[1, 2, 4]
  # ```
  native def ^[U >: T](other: Set[U]) -> Set[U]
  # Whether every member is in `other`. A set is a subset of itself.
  native def subset?(other: Set[Object]) -> Bool
  # Whether every member of `other` is in `self`. A set is a superset of
  # itself.
  native def superset?(other: Set[Object]) -> Bool
  # Whether every member is in `other`, which has more.
  native def proper_subset?(other: Set[Object]) -> Bool
  # Whether every member of `other` is in `self`, which has more.
  native def proper_superset?(other: Set[Object]) -> Bool
  # Whether the two sets have no member in common.
  native def disjoint?(other: Set[Object]) -> Bool
  # Whether the two sets have a member in common.
  native def intersect?(other: Set[Object]) -> Bool
  # The set with the elements of `items` added, in their order. Unlike
  # Ruby's, it returns a new set.
  native def merge[U >: T](items: Array[U]) -> Set[U]
  # The set with the value added, or `nil` when it was already a member.
  native def add?[U >: T](value: U) -> Set[U]?
  # The members the block is truthy for, in order.
  native def select(&: (T) -> Object) -> Set[T]
  # The set without the members the block is truthy for.
  native def reject(&: (T) -> Object) -> Set[T]
  # The members, in insertion order.
  native def to_a -> Array[T]
  # The literal form, as `#inspect`.
  native def to_s -> String
  # The literal form, in insertion order, as `Set[1, 2]`.
  native def inspect -> String
  # Whether `other` is a set with the same members, whatever their order.
  native def ==(other: Object) -> Bool
  # A hash code consistent with `#==`, so the same whatever the order of the
  # members.
  native def hash -> Int
  # A set of the elements of `items`, in the order first given, without
  # duplicates.
  #
  # ```
  # Set.new([2, 1, 2])       # => Set[2, 1]
  # ```
  def self.new(items: Array[T]) -> Set[T] = Set[T].new.merge(items)
  # The union: the same as `#|`.
  def +[U >: T](other: Set[U]) -> Set[U] = self | other
  # The union: the same as `#|`.
  def union[U >: T](other: Set[U]) -> Set[U] = self | other
  # The intersection: the same as `#&`.
  def intersection(other: Set[Object]) -> Set[T] = self & other
  # The difference: the same as `#-`.
  def difference(other: Set[Object]) -> Set[T] = self - other
  # Whether every member is in `other`: the same as `#subset?`.
  def <=(other: Set[Object]) -> Bool = subset?(other)
  # Whether every member of `other` is in `self`: the same as `#superset?`.
  def >=(other: Set[Object]) -> Bool = superset?(other)
  # Whether `self` is a proper subset of `other`: the same as
  # `#proper_subset?`.
  def <(other: Set[Object]) -> Bool = proper_subset?(other)
  # Whether `self` is a proper superset of `other`: the same as
  # `#proper_superset?`.
  def >(other: Set[Object]) -> Bool = proper_superset?(other)
  # Whether `value` is a member: the same as `#include?`.
  def member?(value: Object) -> Bool = include?(value)
  # The members the block is truthy for: the same as `#select`.
  def filter(&: (T) -> Object) -> Set[T] = select { |x| yield(x) }
  # The set without the members the block is truthy for: the same as
  # `#reject`. The receiver is not changed, unlike Ruby's.
  def delete_if(&: (T) -> Object) -> Set[T] = reject { |x| yield(x) }
  # The members the block is truthy for: the same as `#select`. The receiver
  # is not changed, unlike Ruby's.
  def keep_if(&: (T) -> Object) -> Set[T] = select { |x| yield(x) }

  # A mutable set, for building a `Set` in place.
  #
  # It keeps insertion order as `Set` does. It is not `Shareable`.
  # `#to_set` (and `#freeze`) hands the members over as a `Set` without
  # copying and leaves the builder empty, as `Array::Builder#to_a` does;
  # `#to_a` copies.
  #
  # ```
  # seen = Set::Builder[String].new
  # seen.add?("a")           # => true
  # seen.add?("a")           # => false
  # seen << "b"
  # seen.to_set              # => Set["a", "b"]
  # seen.empty?              # => true
  # ```
  class Builder[T]
    include Unshareable
    include Enumerable[T]

    # An empty builder, as `Set::Builder[Int].new`.
    native def self.new -> Set::Builder[T]
    # Adds `value` and returns whether it was new. Unlike `Set#add?`, the
    # result is a `Bool`.
    native def add?(value: T) -> Bool
    # Adds the elements of `items`, in their order, and returns the builder.
    native def merge(items: Array[T]) -> Self
    # Adds the members of `other`, in their order, and returns the builder.
    native def merge(other: Set[T]) -> Self
    # Removes the elements of `items` and returns the builder.
    native def subtract(items: Array[T]) -> Self
    # Removes the members of `other` and returns the builder.
    native def subtract(other: Set[T]) -> Self
    # Removes every member and returns the builder.
    native def clear -> Self
    # Replaces the members by those of `other` and returns the builder.
    native def replace(other: Set[T]) -> Self
    # Keeps only the members the block is truthy for and returns the builder
    # (even when nothing changed, unlike Ruby's `nil`).
    native def select!(&: (T) -> Object) -> Self
    # Removes the members the block is truthy for and returns the builder
    # (even when nothing changed, unlike Ruby's `nil`).
    native def reject!(&: (T) -> Object) -> Self
    # Removes the members the block is truthy for and returns the builder: the
    # same as `#reject!`.
    native def delete_if(&: (T) -> Object) -> Self
    # Keeps only the members the block is truthy for and returns the builder:
    # the same as `#select!`.
    native def keep_if(&: (T) -> Object) -> Self
    # The number of members: the same as `#size`.
    native def length -> Int
    # The members as a `Set`, leaving the builder empty: the same as
    # `#to_set`.
    def freeze -> Set[T] = to_set
    # Adds `value`, unless it is a member already, and returns the builder.
    native def <<(value: T) -> Self
    # Adds `value`, unless it is a member already, and returns the builder:
    # the same as `#<<`.
    native def add(value: T) -> Self
    # Removes `value`, if it is a member, and returns the builder.
    native def delete(value: T) -> Self
    # Whether `value` is a member. A value of another type than the members'
    # is none.
    native def include?(value: Object) -> Bool
    # The number of members.
    native def size -> Int
    # Whether there is no member.
    native def empty? -> Bool
    # Calls the block with each member, in insertion order.
    native def each(&: (T) -> Nil) -> Nil
    # The members as a `Set`, handed over without copying: the builder is left
    # empty, and can be filled again.
    native def to_set -> Set[T]
    # A copy of the members as an array, in insertion order; the builder keeps
    # them.
    native def to_a -> Array[T]
    # The literal form of the members, as `Set#inspect`.
    native def to_s -> String
    # The literal form of the members, as `Set#inspect`.
    native def inspect -> String
  end
end

# The values from `begin` to `end`: `1..3` includes 3, `1...3` excludes
# it. Either bound may be left out: `(1..)` is endless and `(..3)`
# beginless; their missing bound is `nil`.
#
# Integer ranges iterate by 1 and `String` ranges by `String#succ`, as
# `String#upto` does; a `Float` range has no elements to iterate over
# (`#each` and `#to_a` raise `TypeError`) but `#include?` works. Only an
# `Int` range has `#size`.
# An endless integer range iterates until the block breaks; `#to_a` on it
# raises `TypeError`. A range is `Enumerable`, so `(1..3).map { }` and
# `(1..).first(n)` work.
#
# A range whose start comes after its end is empty: `3..1`, and a
# `String` range whose start sorts after its end (`"c".."a"`,
# `"b".."aa"`); a `String` range steps as `String#upto` does, so
# `("az".."b").to_a` is `["az"]` and `("9".."10").to_a` is `["9", "10"]`.
#
# ```
# (1..3).to_a          # => [1, 2, 3]
# (1...3).to_a         # => [1, 2]
# ("c".."a").to_a      # => []
# ("c".."a").empty?    # => true
# (1..).first(2)       # => [1, 2]
# (1.0..2.0).include?(1.5)   # => true
# (1..3).sum           # => 6
# ```
class Range[T]
  include Shareable
  include Enumerable[T]

  # Calls the block with each value in order.
  #
  # ## Raises
  #
  # `TypeError` for a beginless range or a range that is neither of `Int`
  # nor of `String` (a `Float` range).
  native def each(&: (T) -> Nil) -> Nil
  # The first bound, or `nil` for a beginless range.
  native def begin -> T?
  # The last bound (included or not), or `nil` for an endless range.
  native def end -> T?
  # The first bound, or `nil` for a beginless range: `#begin`. It is returned
  # even when the range is empty (`(3..1).first` is 3).
  native def first -> T?
  # The last value: `end`, or `end - 1` for an exclusive integer range;
  # `nil` for an endless range. It does not check that the range is empty
  # (`(1...1).last` is 0), and a non-integer exclusive range gives `end`.
  #
  # ```
  # (1..3).last    # => 3
  # (1...3).last   # => 2
  # ```
  native def last -> T?
  # Whether the range leaves out its end (`1...3`).
  native def exclude_end? -> Bool
  # Whether `value` lies between the bounds, by comparison, not by
  # iteration: `(1..3).include?(2.5)` and `("a".."c").include?("bb")` hold
  # (Ruby iterates a `String` range here). A value of another type gives
  # `false`.
  #
  # ```
  # (1...3).include?(3)    # => false
  # (1..).include?(1000)   # => true
  # ```
  native def include?(value: Object) -> Bool
  # Whether `value` lies between the bounds, by comparison: `#include?` for
  # a `value` of the element type.
  native def cover?(value: T) -> Bool
  # Whether the range has no value. False for an endless or beginless
  # range.
  #
  # ## Raises
  #
  # `TypeError` for a `Float` range.
  native def empty? -> Bool
  # Calls the block with every `step`-th value of an integer range, from
  # `begin`.
  #
  # ## Raises
  #
  # `ArgumentError` when `step` is not positive (Ruby counts down with a
  # negative step); `TypeError` when the range is not between two integers
  # (an endless range included).
  #
  # ```
  # (1..10).step(3).to_a   # => [1, 4, 7, 10]
  # (10..1).step(-3).to_a  # raises ArgumentError
  # ```
  native def step(step: Int, &: (T) -> Nil) -> Nil
  # An enumerator of every `step`-th value.
  #
  # The enumerator is made whatever `step` and the range are: a `step`
  # that is not positive or a range that is not between two integers
  # raises, as `step(step) { }` does, only when the enumerator is
  # iterated (`ArgumentError` or `TypeError`).
  #
  # ```
  # e = (1..10).step(0)
  # e.to_a                 # raises ArgumentError
  # ```
  native def step(step: Int) -> Enumerator[T]
  # An enumerator over the values.
  native def each -> Enumerator[T]
  # Calls the block with each value, last first.
  #
  # ## Raises
  #
  # `TypeError` for an endless range, as `#each` does.
  native def reverse_each(&: (T) -> Nil) -> Nil
  # The values as an array.
  #
  # ## Raises
  #
  # `TypeError` for an endless or beginless range or a `Float` range.
  native def to_a -> Array[T]
  # The range with its bounds' `inspect`: `"1..3"`, `"1...3"`. A missing
  # bound shows as `nil` (`"1..nil"`), and a `String` range quotes its bounds
  # (`"\"a\"..\"b\""`), as `#inspect` does: unlike Ruby, `to_s` is `inspect`.
  native def to_s -> String
  # The range as written, as `#to_s`.
  #
  # ```
  # (1...3).inspect   # => "1...3"
  # ```
  native def inspect -> String
  # Whether `other` is a range with `==` bounds that excludes its end just
  # as this one does.
  native def ==(other: Object) -> Bool
  # A hash code: ranges that are `==` have the same one.
  native def hash -> Int
  # The last `n` values (all of them when there are fewer).
  #
  # ## Raises
  #
  # `TypeError` when the range cannot be iterated over, as `#to_a`.
  def last(n: Int) -> Array[T] = to_a.last(n)
end

# `#size` only where the number of values can be computed without
# iterating: a `String` range has none, as Ruby's `size` is `nil` for one
# (use `#count`, which iterates), and a `Float` range has no values.
extension Range[T: Int]
  # The number of values; 0 when the range is empty.
  #
  # ## Raises
  #
  # `TypeError` for an endless or beginless range.
  #
  # ```
  # (1..10).size        # => 10
  # (1...10).size       # => 9
  # (3..1).size         # => 0
  # ```
  native def size -> Int
end

# A block or a lambda as a value, of a type `(A, B) -> R`: called with
# `call`, `()` or `[]`.
class Proc
  include Unshareable
  # The number of parameters: `-n - 1` when there are optional ones or a
  # rest parameter after `n` required ones, as in Ruby. A method reference
  # (`obj.:name`) gives `-1`.
  #
  # ```
  # ->(a: Int, b: Int) { a + b }.arity          # => 2
  # ->(a: Int, b: Int = 2) { a + b }.arity      # => -2
  # ```
  native def arity -> Int
  # Lowering calls it on a block or lambda made as a shareable procedure.
  native def __copy_captures -> Proc
end

# The root of the exception classes. `raise` takes an instance of one
# (`raise ArgumentError, "bad size"` makes it), and `rescue` without a
# class catches `StandardError` and its subclasses only: the direct
# subclasses of `Exception` are for what a program does not usually
# handle (`SystemStackError`, `Task::Cancelled`).
#
# ```
# e = begin
#   raise ArgumentError, "bad size"
# rescue => x
#   x
# end
# e.message   # => "bad size"
# e.inspect   # => "#<ArgumentError: bad size>"
# ```
class Exception
  include Shareable

  # The message given to `new` (or to `raise`), `""` without one.
  @message: String

  attr_reader :message

  # An exception with `message`, not yet raised.
  def initialize(message: String = "")
    @message = message
  end

  # Where the exception was first raised, innermost frame first, as
  # `"file.qz:12:in method"` lines. Empty for one never raised. Raising it
  # again keeps the first backtrace, as in Ruby.
  native def backtrace -> Array[String]
  # The class name and the message, `"ArgumentError: bad size"`, followed
  # by the backtrace, one `"    from file.qz:12:in method"` line per frame:
  # what the runtime prints for an exception nothing rescued.
  native def full_message -> String
  # Whether `other` is this exception: the same object, or a copy of it.
  # Raising an exception that is referred to raises a copy (exceptions are
  # immutable), and `Task.blocking` copies one across threads; a copy is
  # equal to its original, and to its other copies. Two exceptions made
  # apart are not equal, whatever their messages.
  native def ==(other: Object) -> Bool
  # Consistent with `==`: the same for an exception and its copies.
  native def hash -> Int
  # The exception being handled when this one was raised, or `nil`, as
  # Ruby's `$!`: an exception raised while a `rescue` clause runs (there or
  # in what it calls) gets the one the clause is handling, and one raised
  # while an `ensure` clause runs for an exception passing through gets
  # that one. An exception raised again keeps the cause it had. Each task
  # has its own: a `Task.timeout` or `Task.blocking` block, which runs in a
  # task (or thread) of its own, starts with none. One another task raised
  # that `await`, `Task.scope`, `Task.timeout` or `Task.blocking` raises
  # again gets, if it has none, the one handled there (as a Ruby thread's
  # exception raised again by its value).
  #
  # ```
  # e = begin
  #   begin
  #     raise ArgumentError, "inner"
  #   rescue
  #     raise "outer"
  #   end
  # rescue => x
  #   x
  # end
  # e.cause.inspect   # => "#<ArgumentError: inner>"
  # ```
  native def cause -> Exception?
  # The message.
  def to_s -> String = message
  # `#<ArgumentError: bad size>`.
  native def inspect -> String
end

# The exceptions a program is expected to handle: a `rescue` without a
# class rescues these (and their subclasses) only. Define an
# application's errors under it.
class StandardError < Exception
end

# A generic error: what `raise "message"` raises (a `String` given to
# `raise` without a class), and what `Result#unwrap` raises on a `Result::Err`.
#
# ```
# e = begin
#   raise "oops"
# rescue => x
#   x
# end
# e.class   # => RuntimeError
# ```
class RuntimeError < StandardError
end

# An argument with the right type but a wrong value: a malformed text for
# `Integer` or `Float`, `rand(0)`, an exclusive range for
# `Comparable#clamp`, an invalid radix.
#
# ```
# Integer("abc")   # raises ArgumentError
# ```
class ArgumentError < StandardError
end

# A value of the wrong type at run time: a failed cast with `as`
# (`x.as(String)` on an `Int`), or a JSON value of another kind than the
# accessor asked for.
class TypeError < StandardError
end

# An index out of range: `Array#[]` and the indexing methods that do not
# return `nil` (the `?` forms do) raise it.
#
# ```
# v = [1, 2][5]   # raises IndexError
# ```
class IndexError < StandardError
end

# A key that is not there: `Hash#[]` with a missing key, as `fetch` does in
# Ruby (`Hash#[]?` returns `nil` instead).
#
# ```
# v = {a: 1}[:b]   # raises KeyError
# ```
class KeyError < IndexError
end

# A value out of the range an operation accepts: converting NaN or an
# infinity to an `Int` (`Float#to_i`), a `Time` out of range. Its subclass
# `OverflowError` is for `Int` arithmetic.
class RangeError < StandardError
end

# An `Int` operation whose result does not fit in 64 bits. `Integer`
# holds integers of any size.
#
# ```
# 9223372036854775807 + 1   # raises OverflowError
# 2 ** 100                  # raises OverflowError
# ```
class OverflowError < RangeError
end

# An integer division or modulo by zero (`Int#/`, `Int#%`). A `Float`
# division by zero is not an error: it gives an infinity or NaN.
#
# ```
# 1 / 0       # raises ZeroDivisionError
# 1.0 / 0     # => Infinity
# ```
class ZeroDivisionError < StandardError
end

# An attempt to change a frozen value. Declared for compatibility with
# Ruby: built-in values are immutable and have no methods that change
# them, so the runtime does not raise it.
class FrozenError < StandardError
end

# An operation on a stream that cannot do it: writing to a closed stream
# or to one not opened for writing, rewinding a socket.
class IOError < StandardError
end

# Reading past the end of the input: `gets`, `readline` and `IO#readline`
# at the end of the file (`gets?` returns `nil` instead).
class EOFError < IOError
end

# A call to the operating system that failed, with its message: opening a
# file that does not exist, a refused connection.
#
# ```
# File.read("/nonexistent/file")   # raises SystemCallError
# ```
class SystemCallError < StandardError
end

# A `case`/`in` whose patterns all fail to match, without an `else`. The
# compiler warns about such a `case` when it can tell the patterns do not
# cover the type.
class NoMatchingPatternError < StandardError
end

# A method with no implementation: a native method the runtime does not
# provide, or an abstract method reached at run time. Programs raise it
# for what they leave unimplemented.
class NotImplementedError < StandardError
end

# The end of an external iteration: `Enumerator#next` past the last
# element. `loop` rescues it and ends the loop.
#
# ```
# e = [1].each
# e.next   # => 1
# e.next   # raises StopIteration
# ```
class StopIteration < StandardError
end

# Raised by `exit` and `abort` to end the program, as in Ruby. Outside
# `StandardError`, so a plain `rescue` lets it through: the `ensure`
# clauses it leaves run, and one nothing rescues ends the program with
# `#status` (from any task) after the `at_exit` blocks. `rescue SystemExit`
# (or `Exception`) catches it; `exit!` ends the program without it.
#
# ```
# status = begin
#   exit 3
# rescue SystemExit => e
#   e.status
# end
# status   # => 3
# ```
class SystemExit < Exception
  @status: Int

  # A `SystemExit` with `status`, not yet raised.
  def initialize(status: Int = 0, message: String = "exit")
    @status = status
    super(message)
  end

  # The status the program ends with.
  attr_reader :status

  # Whether the status is 0.
  def success? -> Bool = @status == 0
end

# A recursion too deep for the task's stack ("stack level too deep").
# Outside `StandardError`: only `rescue SystemStackError` (or
# `rescue Exception`) catches it.
class SystemStackError < Exception
end

# Declared for compatibility with Ruby. The runtime does not raise it:
# an allocation that fails aborts the process.
class NoMemoryError < Exception
end

# A `Float` that has no integer: NaN or an infinity converted to an `Int`
# (`Float#to_i`, `floor`, `round`, ...), as in Ruby. A `RangeError`.
# `Math` functions return NaN instead.
#
# ```
# Float::NAN.to_i      # raises FloatDomainError
# Float::INFINITY.round   # raises RangeError
# ```
class FloatDomainError < RangeError
end

# Every task is blocked (on a channel, on another task) and none can make
# progress. A fatal error, as Ruby's `fatal` and Go's "all goroutines are
# asleep": the runtime reports it with the blocked tasks and stops the
# program with status 1, without raising it where a `rescue` could catch
# it or an `ensure` run.
class DeadlockError < Exception
end

# The result of an operation that can fail, as a value instead of an
# exception: `Ok` with the value or `Err` with the error. Take it apart
# with `case`/`in`, or chain it with `map` and `and_then` (a `for`
# comprehension desugars to `flat_map`).
#
# ```
# r = Result::Ok[Int, String].new(3)
# r.map { |x| x * 2 }   # => Result::Ok(value: 6)
# e = Result::Err[Int, String].new("bad")
# e.unwrap_or(0)        # => 0
# e.unwrap              # raises RuntimeError
# ```
enum Result[T, E]
  # A success, with its value.
  variant Ok(value: T)
  # A failure, with its error.
  variant Err(error: E)

  # Whether it is an `Ok`.
  def ok? -> Bool
    case self
    in Ok then true
    in Err then false
    end
  end

  # Whether it is an `Err`.
  def err? -> Bool = !ok?

  # The value of an `Ok`.
  #
  # ## Raises
  #
  # `RuntimeError` on an `Err`, with the error in the message.
  def unwrap -> T
    case self
    in Ok(value:) then value
    in Err(error:) then raise RuntimeError, "unwrap called on an Err: #{error}"
    end
  end

  # The value of an `Ok`, or `default` for an `Err`.
  def unwrap_or(default: T) -> T
    case self
    in Ok(value:) then value
    in Err then default
    end
  end

  # An `Ok` with the block's result for the value; an `Err` as it is.
  def map[U](&: (T) -> U) -> Result[U, E]
    case self
    in Ok(value:) then Result::Ok[U, E].new(yield(value))
    in Err(error:) then Result::Err[U, E].new(error)
    end
  end

  # The block's result for the value of an `Ok`, which may itself fail; an
  # `Err` as it is.
  #
  # ```
  # r = Result::Ok[Int, String].new(3)
  # r.and_then { |x| Result::Err[Int, String].new("no #{x}") }
  # # => Result::Err(error: "no 3")
  # ```
  def and_then[U](&: (T) -> Result[U, E]) -> Result[U, E]
    case self
    in Ok(value:) then yield(value)
    in Err(error:) then Result::Err[U, E].new(error)
    end
  end

  # `and_then` under the name `for` comprehensions desugar to.
  def flat_map[U](&: (T) -> Result[U, E]) -> Result[U, E] = and_then { |v| yield(v) }
end

# A lightweight thread, running a block concurrently with the others, and
# the handle to its result `T`.
#
# Tasks switch cooperatively, as in Kotlin: at operations that wait (a
# channel operation that must wait, `Task.sleep`, `#await`, IO) and at
# `Task.yield`; a loop that only computes keeps its worker until it calls
# `Task.yield`. A wait suspends only the calling task;
# the others go on running. Values cross between tasks only when they are
# `Shareable`.
#
# ```
# t = Task.spawn { [1, 2, 3].sum }
# t.await          # => 6
# Task.scope { |s| [s.spawn { 1 }, s.spawn { 2 }].map(&:await) }   # => [1, 2]
# ```
class Task[out T: Shareable]
  include Shareable

  # Starts a task running the block and returns it at once.
  #
  # The block captures by value: every value it captures must be Shareable,
  # and it cannot assign to outer variables. Without a `Task.scope`, the
  # task belongs to the program's root scope and is dropped when the main
  # code finishes; `#await` it, or use `Task.scope`, to wait for it.
  native def self.spawn[R](&: () -> R) -> Task[R]
  # Runs the block with a `Scope`, waits for every task started with
  # `Scope#spawn` to finish, and returns the block's value.
  #
  # When a task of the scope or the block itself raises, the remaining
  # tasks are cancelled and waited for, and the first exception is raised
  # again here (the others are dropped). When the task running the scope
  # is cancelled, the children are cancelled and waited for too.
  #
  # ```
  # Task.scope do |s|
  #   s.spawn { raise ArgumentError, "bad" }
  #   s.spawn { Task.sleep(1.second) }       # cancelled
  #   nil
  # end
  # # raises ArgumentError
  # ```
  native def self.scope[R](&: (Scope) -> R) -> R
  # Suspends the calling task for `duration`; the other tasks run
  # meanwhile.
  #
  # ## Raises
  #
  # `Task::Cancelled` when the task is cancelled while it sleeps.
  native def self.sleep(duration: Duration) -> Nil
  # Suspends the calling task briefly, so that the scheduler can run other
  # runnable tasks, then raises a cancellation (`Task::Cancelled`) or an
  # `exit` from another task that came meanwhile, as a wait does.
  #
  # With one worker thread (`QUARZ_THREADS=1`), the tasks that were
  # runnable run first, each until it finishes, waits or yields, and the
  # caller goes on after them. With several, the others run in parallel
  # and need not have run, nor finished, when the caller goes on: wait for
  # a task (`#await`) or use a `Channel` to know that it did something.
  native def self.yield -> Nil
  # The task running the caller (the main code is a task too).
  native def self.current -> Task[Object]
  # Runs the block in a child task and returns its value, or raises
  # `Task::Timeout` when it has not finished within `duration`.
  #
  # The block is cancelled then, and waited for before the call raises: it
  # is interrupted only at a wait (as by `#cancel`), so a computation that
  # never waits runs to its end first. Cancelling the calling task cancels
  # the block too.
  #
  # ```
  # Task.timeout(1.second) { 42 }                    # => 42
  # Task.timeout(10.ms) { Task.sleep(1.second) }     # raises Task::Timeout
  # ```
  native def self.timeout[R](duration: Duration, &: () -> R) -> R
  # Runs the block on a helper thread and returns its value (or raises its
  # exception); only the calling task waits.
  #
  # For long computations and blocking foreign calls: the standard library's
  # IO already suspends only the task.
  #
  # The block is copied to the helper thread, so it may capture only
  # immutable values (numbers, strings, collections, `data` values) and
  # return only those; what it prints is written out when it finishes.
  # Cancelling the waiting task raises in it, but the block runs to its
  # end. Tasks the block spawned and left running are cancelled when it
  # returns, and waited for (their `ensure` clauses run), as a scope's.
  #
  # ## Raises
  #
  # `ArgumentError` when the block captures or returns a value that cannot
  # be copied: a `Channel`, an `Atom`, a `Task`, a mutable object.
  native def self.blocking[R](&: () -> R) -> R
  # Raises `Task::Cancelled` when the calling task has been cancelled
  # (outside `.uncancellable`); otherwise does nothing.
  #
  # It does not let other tasks run: a loop that only computes calls
  # `.yield` instead, which checks too, or a task of its own worker could
  # not run to cancel it.
  native def self.check_cancel -> Nil
  # Runs the block out of reach of the calling task's cancellation: its
  # waits do not raise `Task::Cancelled`, as in Trio's shielded cancel
  # scope and Kotlin's NonCancellable context. For cleanup that must wait
  # (an `ensure` that tells a peer goodbye): a cancelled task raises
  # `Task::Cancelled` at every wait, and would be interrupted again. Once
  # the block ends, the cancellation applies again. Give the wait its own
  # limit (`Task.timeout`), or a stuck peer holds the task forever. An
  # `exit` from another task still reaches it (`Kernel#exit`).
  #
  # ```
  # started = Channel[Nil].new(capacity: 1)
  # cleaned = Channel[Bool].new(capacity: 1)
  # t = Task.spawn do
  #   begin
  #     started.send(nil)
  #     Task.sleep(1.second)
  #   ensure
  #     Task.uncancellable do
  #       Task.sleep(1.ms)               # waits, though cancelled
  #       cleaned.send(true)
  #     end
  #   end
  # end
  # started.receive
  # t.cancel
  # r = begin
  #   t.await
  #   :finished
  # rescue Task::Cancelled
  #   :cancelled
  # end
  # r                # => :cancelled
  # cleaned.receive  # => true
  # ```
  native def self.uncancellable[R](&: () -> R) -> R
  # :nodoc:
  # Runs the block, then cancels the tasks it left (those spawned while it
  # ran, and theirs) and waits for them, as a scope's, for `limit` and a
  # grace (`nil`: as long as they take): the block's value and how many
  # still ran then. `quarz test` runs each test in one.
  native def self.__contain[R](limit: Duration?, &: () -> R) -> [R, Int]
  # :nodoc:
  # `Task.spawn` outside any `Task.__contain` block: a service the library
  # starts once for the program.
  native def self.__spawn_service[R](&: () -> R) -> Task[R]

  # Waits for the task to finish and returns its value (at once when it has
  # finished); only the calling task waits.
  #
  # Awaiting again returns the same value.
  #
  # ## Raises
  #
  # The exception the task ended with, `Task::Cancelled` when it was
  # cancelled.
  native def await -> T
  # Asks the task to stop: it raises `Task::Cancelled` at its next wait (IO,
  # `Task.sleep`, `#await`), channel `send`, `receive` or `select` (even
  # one that need not wait), `Task.yield` or `Task.check_cancel`,
  # so its `ensure` clauses run. The task stays cancelled: every wait after
  # raises it again (a task that rescues it cannot go on waiting), but
  # inside `Task.uncancellable`.
  #
  # A task cancelled before it starts does not run its block. Does nothing
  # when the task has finished; cancelling twice is cancelling once.
  native def cancel -> Nil
  # Whether the task has finished, by returning, raising or being
  # cancelled.
  native def done? -> Bool
  # Whether the task has been cancelled (`#cancel`, or by its scope or
  # `Task.timeout`): it stays so.
  native def cancelled? -> Bool

  # Raised in a cancelled task (`Task#cancel`, `Scope#cancel`, a failing
  # `Task.scope`). A direct subclass of `Exception`: `rescue => e` does not
  # catch it, and `ensure` runs as usual.
  class Cancelled < Exception
  end

  # Raised by `Task.timeout` when the block has not finished in time.
  class Timeout < StandardError
  end
end

# The scope a `Task.scope` block is given: the tasks started with `#spawn`
# are waited for when the block ends.
class Scope
  include Shareable

  # Starts a task in the scope running the block, as `Task.spawn` does, and
  # returns it.
  #
  # `Task.scope` waits for it before it returns.
  native def spawn[T](&: () -> T) -> Task[T]
  # Cancels the scope's tasks (`Task#cancel`); `Task.scope` then waits for
  # them and returns the block's value normally.
  native def cancel -> Nil
end

# A typed queue between tasks: all communication and synchronization
# between tasks goes through channels.
#
# A channel of capacity 0 (the default) is a rendezvous: `#send` waits for
# a receiver and `#receive` for a sender. A larger capacity buffers that
# many values. Waiting suspends only the calling task. After `#close`, a
# send raises `Channel::Closed` and the buffered values can still be
# received. Updates made before a `#send` are visible after the matching
# `#receive`.
#
# When every task waits and none can go on, the runtime stops the program
# with `DeadlockError`.
#
# ```
# ch = Channel[Int].new(capacity: 2)
# Task.spawn { [1, 2, 3].each { |n| ch.send(n) }; ch.close }
# ch.to_a          # => [1, 2, 3]
# ch.receive?      # => nil
# ch.receive       # raises Channel::Closed
# ```
class Channel[T: Shareable]
  include Shareable
  include Enumerable[T]

  # A new open channel buffering up to `capacity` values (0, the default,
  # buffers none; a negative capacity is taken as 0).
  native def self.new(capacity: Int = 0) -> Channel[T]
  # Performs exactly one of the operations the block registers on the
  # `Selector` (`Selector#receive`, `Selector#send`, `Selector#after`,
  # `Selector#default`), the first that can go on, and then runs that
  # operation's block.
  #
  # When several are ready, the first registered wins. Without
  # `Selector#default`, it waits until one is ready, suspending only the
  # calling task.
  #
  # ## Raises
  #
  # `Channel::Closed` when a registered channel is closed (and, for a
  # receive, empty), even with a `Selector#default`; `ArgumentError` when
  # the block registers nothing.
  #
  # ```
  # jobs = Channel[Int].new(capacity: 1)
  # jobs.send(7)
  # got = 0
  # Channel.select do |s|
  #   s.receive(jobs) { |n| got = n }
  #   s.default { got = -1 }
  # end
  # got              # => 7
  # ```
  native def self.select(&: (Selector) -> Nil) -> Nil
  # `.select` in a loop, until a handler (or the block) calls
  # `Selector#stop`. When it polls (`Selector#default` taken) it lets other
  # tasks run after each select, as `Task.yield` does, so that it does not
  # keep its senders from running; when its cases are ready every time,
  # every 64 selects.
  #
  # `break` in a handler leaves only that handler.
  #
  # ```
  # nums = Channel[Int].new(capacity: 3)
  # [1, 2, 3].each { |n| nums.send(n) }
  # sum = 0
  # Channel.select_loop do |s|
  #   s.receive(nums) { |n| sum += n }
  #   s.default { s.stop }
  # end
  # sum              # => 6
  # ```
  native def self.select_loop(&: (Selector) -> Nil) -> Nil

  # Sends `value`, waiting while the buffer is full (on a capacity-0
  # channel, until a receiver takes it).
  #
  # ## Raises
  #
  # `Channel::Closed` when the channel is closed, or is closed while the
  # task waits.
  native def send(value: T) -> Nil
  # The next value, waiting while the channel is empty. The values
  # buffered before `#close` are still received.
  #
  # ## Raises
  #
  # `Channel::Closed` when the channel is closed and empty.
  native def receive -> T
  # The next value, waiting while the channel is empty; nil when it is
  # closed and empty.
  native def receive? -> T?
  # Sends `value` if that needs no wait (there is room in the buffer, or a
  # receiver waits): whether it was sent.
  #
  # ## Raises
  #
  # `Channel::Closed` when the channel is closed.
  native def try_send(value: T) -> Bool
  # The next value if one is ready without waiting, otherwise nil (also
  # when the channel is closed and empty).
  native def try_receive -> T?
  # Closes the channel: later sends raise `Channel::Closed`, and so do the
  # waiting ones; the receivers get the buffered values and then
  # `Channel::Closed` (or nil from `#receive?`).
  #
  # Closing again does nothing.
  native def close -> Nil
  # Whether `#close` has been called.
  native def closed? -> Bool
  # Whether no value is buffered.
  native def empty? -> Bool
  # The number of values buffered now.
  native def size -> Int
  # Receives values and yields each until the channel is closed and
  # empty, waiting in between.
  native def each(&: (T) -> Nil) -> Nil

  # Raised by sending on a closed channel and by `Channel#receive` on one
  # that is closed and empty.
  class Closed < StandardError
  end
end

# What a `Channel.select` or `Channel.select_loop` block registers its
# operations on. Each method only registers an operation and its block;
# the chosen operation's block runs after the `Channel.select` block
# returns.
class Selector
  include Unshareable

  # These keep their blocks, run after the `Channel.select` block returns.

  # Receive from `channel`: the block gets the value, if this case is the
  # one chosen.
  native def receive[T](channel: Channel[T], &blk: (T) -> Nil) -> Nil
  # Send `value` on `channel`: the block runs once it is sent, if this case
  # is the one chosen.
  native def send[T](channel: Channel[T], value: T, &blk: () -> Nil) -> Nil
  # A timeout: the block runs if no other case is ready within `duration`
  # (with several, the shortest wins).
  native def after(duration: Duration, &blk: () -> Nil) -> Nil
  # The case chosen when no other is ready at once: it makes the select
  # not wait.
  native def default(&blk: () -> Nil) -> Nil
  # Ends a `Channel.select_loop` after this round.
  #
  # Called in the `Channel.select` block itself, before any operation is
  # chosen, it ends the select without performing one.
  native def stop -> Nil
end

# A shared cell holding an immutable value, which any task can read and
# replace atomically. The replacement for shared mutable state: an update
# computes a new value from the old one and swaps it in.
#
# ```
# hits = Atom.new(0)
# Task.scope { |s| 3.times { s.spawn { hits.update { |n| n + 1 } } } }
# hits.value       # => 3
# ```
class Atom[T: Shareable]
  include Shareable

  # A new atom holding `value`.
  native def self.new(value: T) -> Atom[T]
  # The value held now.
  native def value -> T
  # The value held now (as `#value`).
  native def get -> T
  # Replaces the value with `value`.
  native def set(value: T) -> Nil
  # Replaces the value with the block's result for the current value, and
  # returns the new value.
  #
  # When another task changes the value meanwhile, the block runs again with
  # the newer one: keep it free of side effects.
  #
  # ```
  # a = Atom.new({"a" => 1})
  # a.update { |h| h.put("b", 2) }   # => {"a" => 1, "b" => 2}
  # ```
  native def update(&: (T) -> T) -> T
  # Replaces the value with `replacement` if it is `==` to `expected`:
  # whether it did.
  native def compare_and_set(expected: T, replacement: T) -> Bool
end

# A stream: the standard streams and open files. At the end of the
# stream, `gets`, `readline` and `read(length)` raise `EOFError`, `gets?`
# and `read?(length)` return nil, and `read` and `read?` (the rest of the
# stream) return `""`.
#
# Sockets are streams too. An operation that has to wait for the disk, a
# pipe or the network suspends only the calling task. Any task may use a
# handle: one write call goes out whole, one read call takes a whole line
# or chunk, and closing a handle makes the operations waiting on it raise
# `IOError`. Using a closed stream raises `IOError` (`closed stream`), as
# does reading a stream opened only for writing and the reverse.
#
# NOTE: The standard streams (`STDIN`, `STDOUT`, `STDERR`) are blocking
# for now: reading from the terminal stops the scheduler.
#
# ```quarz no_run
# File.open("notes.txt", "w") { |f| f.puts "one", "two" }
# f = File.open("notes.txt")
# f.gets           # => "one\n"
# f.read           # => "two\n"
# f.gets?          # => nil
# f.gets           # raises EOFError
# f.close
# ```
class IO
  include Shareable

  # Writes each argument followed by a newline, unless it already ends in
  # one; an array writes each element so, `nil` and no argument an empty
  # line.
  native def puts(*args: Object) -> Nil
  # Writes each argument's `to_s`, with no separator or newline.
  native def print(*args: Object) -> Nil
  # Writes `format` filled with `args`, as `format` (`Kernel#format`)
  # does.
  native def printf(format: String, *args: Object) -> Nil
  # Writes each argument's `to_s` (or a `Bytes`' bytes) in one write, and
  # returns the number of bytes written. On a file open to read and write
  # (`"r+"`, `"w+"`), a write after a read goes at the read position, and
  # a read after a write starts after what was written.
  native def write(*args: Object) -> Int
  # Writes `value`'s `to_s` and returns the stream, for chaining:
  # `io << "n = " << n << "\n"`.
  native def <<(value: Object) -> Self
  # The next line, with its newline (the last line may have none).
  #
  # ## Raises
  #
  # `EOFError` at the end of the stream.
  native def gets -> String
  # The next line, with its newline, or nil at the end of the stream.
  native def gets? -> String?
  # The next line, as `#gets` (`EOFError` at the end).
  native def readline -> String
  # The remaining lines, each with its newline; empty at the end.
  native def readlines -> Array[String]
  # The rest of the stream; `""` at the end.
  native def read -> String
  # The next `length` bytes (fewer only at the end of the stream) as a
  # string, `""` when `length` is 0.
  #
  # The bytes are cut where `length` falls, not at a character boundary,
  # and a UTF-8 sequence cut at either end is replaced by U+FFFD: on a
  # stream holding `"hé"`, `read(2)` gives `"h\u{FFFD}"` (4 bytes), and
  # the next read starts with the rest of `é`, replaced too. Read text by
  # line or with `#read`, and binary data with `#read_bytes`.
  #
  # ## Raises
  #
  # `EOFError` when the stream is at its end.
  native def read(length: Int) -> String
  # The rest of the stream, as `#read`: `""` at the end, never nil.
  native def read? -> String?
  # Up to `length` bytes, as `#read(length)`, or nil at the end of the
  # stream.
  native def read?(length: Int) -> String?
  # The next character (a UTF-8 sequence), or nil at the end.
  native def getc -> String?
  # What is available now, up to `length` bytes (at least one byte, or
  # EOFError / nil at the end).
  native def readpartial(length: Int) -> String
  # What is available now, up to `length` bytes, waiting only when nothing
  # is; nil at the end of the stream.
  native def readpartial?(length: Int) -> String?
  # Raw bytes, up to `length` (empty at the end). `write` accepts Bytes.
  native def read_bytes(length: Int) -> Bytes
  # Yields each remaining line, with its newline.
  native def each_line(&: (String) -> Nil) -> Nil
  # Shuts down the writing side of a socket: the peer reads the end of the
  # stream, and the socket can still be read.
  #
  # ## Raises
  #
  # `TypeError` on a stream that is not a connected socket.
  native def close_write -> Nil
  # Shuts down the reading side of a socket.
  #
  # ## Raises
  #
  # `TypeError` on a stream that is not a connected socket.
  native def close_read -> Nil
  # Writes out what the stream has buffered.
  native def flush -> Nil
  # Flushes and closes the stream; operations waiting on it raise `IOError`.
  #
  # Closing again does nothing, and so does closing a standard stream.
  native def close -> Nil
  # Whether the stream has been closed.
  native def closed? -> Bool
  # Whether a read would find the end of the stream, waiting for input if
  # none is buffered.
  #
  # True for a stream not opened for reading.
  native def eof? -> Bool
  # Goes back to the start of a file, for reading and writing.
  #
  # ## Raises
  #
  # `IOError` on a socket.
  native def rewind -> Nil
  # Whether the stream is a terminal (only a standard stream can be).
  native def tty? -> Bool
  # The path a file was opened with or a UNIX socket is bound to; nil
  # for the other streams.
  native def path -> String?
  # As `#inspect`: `#<File:notes.txt>`, `#<IO:<STDOUT>>`.
  native def to_s -> String
  # A description of the stream: `#<File:notes.txt>`, `#<IO:<STDOUT>>`.
  native def inspect -> String
end

# Files, by path. Operating-system failures (a missing file, say) raise
# SystemCallError; `File.open` with a block closes the file afterwards.
#
# The operations on paths and whole files run on a helper thread when
# they may wait for the disk: only the calling task waits.
#
# ```
# path = File.join(Dir.tmpdir, "doc_file_#{Process.pid}.txt")
# File.write(path, "one\ntwo\n")             # => 8
# File.readlines(path, chomp: true)          # => ["one", "two"]
# File.open(path, "a") { |f| f.puts "three" }
# File.read(path)                            # => "one\ntwo\nthree\n"
# File.delete(path)                          # => 1
# File.read(path)                            # raises SystemCallError
# ```
class File
  include Unshareable

  # The separator of a path's parts: `"/"`.
  SEPARATOR = "/"

  # Opens the file at `path` and returns the stream.
  #
  # `mode` is `"r"` (read, the default), `"w"` (write, created or
  # truncated), `"a"` (append, created), or one of them with `+` to read and
  # write too (`"r+"`, `"w+"`, `"a+"`); a trailing `b` is accepted and
  # ignored. Reads and writes on such a stream share one position: a
  # write after a read goes where the read stopped, and a read after a
  # write starts after it (`"a+"` writes at the end whatever the
  # position).
  #
  # ## Raises
  #
  # `SystemCallError` when the file cannot be opened, `ArgumentError` for
  # another mode.
  #
  # ```quarz no_run
  # File.write("letters.txt", "abc")
  # File.open("letters.txt", "r+") { |f| f.read(1); f.write("Z") }
  # File.read("letters.txt")   # => "aZc"
  # ```
  native def self.open(path: String, mode: String = "r") -> IO
  # Opens the file as `.open` does, yields the stream, closes it when the
  # block ends (also when it raises) and returns the block's value.
  native def self.open[R](path: String, mode: String = "r", &: (IO) -> R) -> R
  # The whole content of the file at `path`.
  native def self.read(path: String) -> String
  # The whole content of the file at `path`, as bytes.
  native def self.read_bytes(path: String) -> Bytes
  # Replaces the content of the file at `path` (creating it) with
  # `content`, and returns the number of bytes written.
  native def self.write(path: String, content: String) -> Int
  # :ditto:
  native def self.write(path: String, content: Bytes) -> Int
  # Adds `content` at the end of the file at `path` (creating it), and
  # returns the number of bytes written.
  native def self.append(path: String, content: String) -> Int
  # :ditto:
  native def self.append(path: String, content: Bytes) -> Int
  # Whether something exists at `path` (a file, a directory, ...).
  native def self.exist?(path: String) -> Bool
  # Whether `path` is a regular file (following symbolic links).
  native def self.file?(path: String) -> Bool
  # Whether `path` is a directory (following symbolic links).
  native def self.directory?(path: String) -> Bool
  # Whether `path` is itself a symbolic link.
  native def self.symlink?(path: String) -> Bool
  # Whether `path` can be opened for reading.
  native def self.readable?(path: String) -> Bool
  # Whether `path` can be opened for writing (it is not created), or is a
  # directory that is not read-only.
  native def self.writable?(path: String) -> Bool
  # Whether `path` is a regular file with an execute permission bit set
  # (false for a directory).
  native def self.executable?(path: String) -> Bool
  # The size of the file at `path`, in bytes.
  native def self.size(path: String) -> Int
  # When the file at `path` was last modified, in the local time zone.
  native def self.mtime(path: String) -> Time
  # Deletes the files at `paths` and returns how many it deleted.
  #
  # ## Raises
  #
  # `SystemCallError` at the first that cannot be deleted (the ones before
  # it are deleted).
  native def self.delete(*paths: String) -> Int
  # Renames (moves) `from` to `to`, replacing a file at `to`; returns 0.
  native def self.rename(from: String, to: String) -> Int
  # Copies the file `from` to `to`, replacing a file at `to`, and returns
  # the number of bytes copied.
  native def self.copy(from: String, to: String) -> Int
  # The lines of the file at `path`, each with its newline, or without
  # when `chomp` is true.
  native def self.readlines(path: String, chomp: Bool = false) -> Array[String]
  # Yields each line of the file at `path`, with its newline.
  native def self.each_line(path: String, &: (String) -> Nil) -> Nil
  # Yields each line of the file at `path`, as `.each_line`.
  native def self.foreach(path: String, &: (String) -> Nil) -> Nil
  # The last part of `path`, without trailing separators, and without
  # `suffix` when it ends with it (`".*"`: any extension).
  #
  # ```
  # File.basename("/a/b/c.rb")          # => "c.rb"
  # File.basename("/a/b/c.rb", ".rb")   # => "c"
  # File.basename("/a/b/c.rb", ".*")    # => "c"
  # File.basename("/a/b/")              # => "b"
  # ```
  native def self.basename(path: String, suffix: String = "") -> String
  # All of `path` but its last part: `"/a/b"` for `"/a/b/c.rb"`, `"."`
  # for `"c.rb"`, `"/"` for `"/"`.
  native def self.dirname(path: String) -> String
  # The extension of the last part of `path`, with its dot (`".gz"` for
  # `"a.tar.gz"`); `""` when there is none, for a dot file (`".bashrc"`)
  # and for a name ending in a dot.
  native def self.extname(path: String) -> String
  # `.dirname` and `.basename` of `path`: `["/a/b", "c.rb"]`.
  native def self.split(path: String) -> [String, String]
  # The parts joined with one `"/"` between them (the separators already
  # at their ends are not doubled); `""` for no parts.
  #
  # ```
  # File.join("a", "b", "c.rb")   # => "a/b/c.rb"
  # File.join("a/", "/b")         # => "a/b"
  # ```
  native def self.join(*parts: String) -> String
  # The absolute form of `path`, relative to `directory` (the current
  # directory by default), with `.` and `..` resolved and a leading `~`
  # taken as the home directory.
  #
  # Symbolic links are not resolved.
  #
  # ```
  # File.expand_path("../b", "/a/c")     # => "/a/b"
  # File.expand_path("/x/./y/../z")      # => "/x/z"
  # ```
  native def self.expand_path(path: String, directory: String? = nil) -> String
  # The absolute form of `path`, relative to the current directory, with `.`
  # and `..` resolved: `.expand_path` without a directory.
  #
  # Unlike Ruby's, it takes a leading `~` as the home directory too.
  native def self.absolute_path(path: String) -> String
end

# Directories, and the current directory. Operating-system failures raise
# `SystemCallError`. The operations that read or change the file system
# run on a helper thread: only the calling task waits.
#
# ```
# dir = File.join(Dir.tmpdir, "doc_dir_#{Process.pid}")
# Dir.mkdir_p(File.join(dir, "src"))
# File.write(File.join(dir, "src", "main.qz"), "")
# File.write(File.join(dir, "README"), "")
# Dir.children(dir)                 # => ["README", "src"]
# Dir.glob("**/*.qz", dir)          # => ["src/main.qz"]
# Dir.rm_rf(dir)
# Dir.exist?(dir)                   # => false
# ```
module Dir
  # The current directory, as an absolute path.
  native def self.pwd -> String
  # The current directory (as `.pwd`).
  native def self.getwd -> String
  # The home directory, from the HOME environment variable.
  #
  # ## Raises
  #
  # `ArgumentError` when HOME is not set.
  native def self.home -> String
  # The directory for temporary files: the TMPDIR environment variable,
  # or `/tmp`.
  native def self.tmpdir -> String
  # Makes `path` the current directory; returns 0.
  #
  # WARNING: The current directory belongs to the process: changing it
  # changes it for every task.
  native def self.chdir(path: String) -> Int
  # Makes `path` the current directory while the block runs, yielding
  # `path`, then restores the previous one (also when the block raises);
  # returns the block's value. The change is seen by every task meanwhile.
  native def self.chdir[R](path: String, &: (String) -> R) -> R
  # Whether `path` is a directory.
  native def self.exist?(path: String) -> Bool
  # Whether `path` is a directory with no entries; false when it is not a
  # directory or cannot be read.
  native def self.empty?(path: String) -> Bool
  # Creates the directory `path` (its parent must exist); returns 0.
  #
  # ## Raises
  #
  # `SystemCallError` when it exists or cannot be made.
  native def self.mkdir(path: String) -> Int
  # Creates the missing parents too (`mkdir -p`).
  #
  # Returns 0, also when the directory already exists.
  native def self.mkdir_p(path: String) -> Int
  # Removes the empty directory `path`; returns 0.
  #
  # ## Raises
  #
  # `SystemCallError` when it is missing or not empty.
  native def self.rmdir(path: String) -> Int
  # Removes a directory and everything in it (`rm -rf`).
  #
  # Returns 0, also when nothing is at `path`.
  native def self.rm_rf(path: String) -> Int
  # The names in the directory `path`, sorted, with `"."` and `".."`
  # first.
  native def self.entries(path: String) -> Array[String]
  # The names in the directory `path`, sorted, without `"."` and `".."`.
  native def self.children(path: String) -> Array[String]
  # Yields each name `.children` returns.
  native def self.each_child(path: String, &: (String) -> Nil) -> Nil
  # The paths matching `pattern`: `*`, `?`, `[...]`, `**` and `{a,b}`;
  # the results are sorted.
  #
  # With `base`, a relative pattern is matched in that directory and the
  # paths are relative to it; without, in the current directory. `*`
  # matches names starting with a dot too, unlike Ruby's.
  #
  # ## Raises
  #
  # `ArgumentError` for a malformed pattern (`"["`).
  native def self.glob(pattern: String, base: String? = nil) -> Array[String]
  # The paths matching any of `patterns`, sorted, each once.
  native def self.glob(patterns: Array[String], base: String? = nil) -> Array[String]
end

# Signals: `Signal.trap(:TERM) { }` runs the block on a task of its own
# when the signal arrives (the signal handler only notes it).
#
# The signals are `:HUP`, `:INT`, `:QUIT`, `:USR1`, `:USR2`, `:PIPE` and
# `:TERM`, also named as strings, with or without the `"SIG"` prefix.
# SIGPIPE is ignored from the start, so that writing to a closed socket or
# pipe raises `SystemCallError` instead of ending the program.
#
# ```quarz no_run
# stop = Channel[Bool].new(capacity: 1)
# Signal.trap(:TERM) { stop.try_send(true) }
# Signal.trap(:INT) { stop.try_send(true) }
# stop.receive                 # waits; the other tasks go on
# puts "shutting down"
# ```
module Signal
  # The number of the signal `name` (`"TERM"` or `"SIGTERM"`, in capitals),
  # or nil for a signal `trap` does not take.
  native def self.number(name: String) -> Int?
  # The names of the signals `trap` takes, without the `"SIG"` prefix.
  native def self.names -> Array[String]
  # :nodoc:
  # Internal to `trap`: routes the signal to the socket `reader` returns.
  native def self.watch(signo: Int) -> Nil
  # :nodoc:
  # Internal to `trap`: sets the signal's action to ignore or default.
  native def self.action(signo: Int, ignore: Bool) -> Nil
  # :nodoc:
  # Internal to `trap`: the socket the signals arrive on, once (nil after).
  native def self.reader -> IO?

  # The traps by signal number, in the order they were set.
  TRAPS = Atom[Hash[Int, Array[shareable () -> Nil]]].new({})

  # The signals `trap` takes, with their numbers.
  def self.list -> Hash[String, Int]
    out = Hash::Builder[String, Int].new
    names.each { |n| out[n] = number(n) || 0 }
    out.to_h
  end

  # Runs `handler` whenever the signal `name` (`:TERM`, `"SIGTERM"`)
  # arrives.
  #
  # The traps replace the signal's default action: the program no longer
  # ends on a trapped SIGINT or SIGTERM. A new trap is added to the ones
  # set before: each arrival starts a task for each trap of the signal, in
  # no particular order. An exception a handler raises is printed to
  # standard error. The handler captures by value, as a `Task.spawn` block
  # does. Signals that arrive in a burst may run the traps only once.
  #
  # ## Raises
  #
  # `ArgumentError` for a signal not in `.names` (`:KILL`).
  def self.trap(name: Symbol, &handler: shareable () -> Nil) -> Nil = trap(name.to_s, &handler)

  # :ditto:
  def self.trap(name: String, &handler: shareable () -> Nil) -> Nil
    signo = number(name)
    raise ArgumentError, "unsupported signal: #{name}" if signo.nil?
    TRAPS.update { |h| h.put(signo, (h[signo]? || []).push(handler)) }
    watch(signo)
    io = reader
    # Once for the program (`reader` hands its end out once): outside any
    # test's tasks, which `quarz test` cancels.
    Task.__spawn_service { dispatch(io) } if io
    nil
  end

  # `:default` restores the default action, `:ignore` ignores the signal;
  # either drops the traps.
  #
  # ## Raises
  #
  # `ArgumentError` for a signal not in `.names`, for another action, and
  # for `:default` on `:PIPE` (which stays ignored).
  def self.trap(name: Symbol, action: Symbol) -> Nil = trap(name.to_s, action)

  # :ditto:
  def self.trap(name: String, action: Symbol) -> Nil
    signo = number(name)
    raise ArgumentError, "unsupported signal: #{name}" if signo.nil?
    raise ArgumentError, "action must be :default or :ignore" unless action == :default || action == :ignore
    # Writing to a closed socket raises instead (SIGPIPE stays ignored).
    raise ArgumentError, "SIGPIPE cannot be given its default action" if action == :default && name.delete_prefix("SIG") == "PIPE"
    TRAPS.update { |h| h.delete(signo) }
    action(signo, action == :ignore)
  end

  # :nodoc:
  # Internal to `trap`: runs the traps of the signals read from `io`.
  def self.dispatch(io: IO) -> Nil
    loop do
      got = io.read_bytes(16)
      break if got.empty?
      got.each do |signo|
        traps: Array[shareable () -> Nil] = TRAPS.value[signo]? || []
        traps.each do |h|
          Task.spawn do
            begin
              h.call
            rescue => e
              STDERR.puts "Signal.trap: #{e.class.name}: #{e.message}"
            end
          end
        end
      end
    end
  end
end

# The running program and the child processes it runs.
#
# ```
# out = Process.run("echo", "hello")
# out.stdout                         # => "hello\n"
# out.success?                       # => true
# Process.sh("echo oops >&2; exit 3")
# # => Process::Output(status: 3, stdout: "", stderr: "oops\n")
# ```
module Process
  # What a child process produced: `Process.run("ls", "-l")`,
  # `Process.sh("ls | wc -l")`.
  data Output(
    # The exit status: 0 for success, -1 when a signal ended the process.
    status: Int,
    # Everything the process wrote to its standard output.
    stdout: String,
    # Everything the process wrote to its standard error.
    stderr: String
  )
    # Whether the status is 0.
    native def success? -> Bool
  end

  # The program's arguments, without the program's name (as `ARGV`).
  native def self.argv -> Array[String]
  # The environment variables, as they are when it is called (as `ENV`,
  # which is read at start-up).
  native def self.env -> Hash[String, String]
  # The process's id.
  native def self.pid -> Int
  # The standard input (`STDIN`).
  native def self.stdin -> IO
  # The standard output (`STDOUT`).
  native def self.stdout -> IO
  # The standard error (`STDERR`).
  native def self.stderr -> IO
  # The seconds since the program started, from a clock that never goes
  # back (`Time.monotonic` as a `Float`).
  native def self.clock -> Float
  # Runs the program `command[0]` with the arguments that follow, with no
  # shell between, and waits for it to end; only the calling task waits.
  #
  # The child's standard input is empty, and its standard output and error
  # are collected into the result. A failing status is not an error: check
  # `Output#success?`.
  #
  # ## Raises
  #
  # `SystemCallError` when the program cannot be started (not found, not
  # executable); `ArgumentError` when `command` is empty.
  native def self.run(*command: String) -> Process::Output
  # Runs `script` with `sh -c`, as `.run` runs a program.
  native def self.sh(script: String) -> Process::Output
end

# Floating-point functions, as Ruby's `Math`: angles are in radians.
#
# An argument outside a function's domain gives NaN (or an infinity)
# instead of raising a domain error as Ruby does: `Math.sqrt(-1.0)` is NaN,
# `Math.log(0.0)` is `-Float::INFINITY`. An `Int` argument is taken as a
# `Float`.
#
# ```
# Math.sqrt(2.0)               # => 1.4142135623730951
# Math.sin(Math::PI / 2)       # => 1.0
# Math.hypot(3.0, 4.0)         # => 5.0
# Math.sqrt(-1.0).nan?         # => true
# ```
module Math
  # The ratio of a circle's circumference to its diameter.
  PI = 3.141592653589793
  # The base of the natural logarithm.
  E = 2.718281828459045

  # The square root; NaN for a negative `x`.
  native def self.sqrt(x: Float) -> Float
  # The square root, as a `Float` (`Int.sqrt` gives the integer one);
  # NaN for a negative `x`.
  native def self.sqrt(x: Int) -> Float
  # The cube root, negative for a negative `x` (`Math.cbrt(-27.0)` is
  # -3.0).
  native def self.cbrt(x: Float) -> Float
  # The sine of `x` radians.
  native def self.sin(x: Float) -> Float
  # The cosine of `x` radians.
  native def self.cos(x: Float) -> Float
  # The tangent of `x` radians.
  native def self.tan(x: Float) -> Float
  # The arctangent, in radians from -PI/2 to PI/2.
  native def self.atan(x: Float) -> Float
  # The angle from the positive x axis to the point (`x`, `y`), in radians
  # from -PI to PI: unlike `atan(y / x)`, it tells the quadrant.
  #
  # ```
  # Math.atan2(1.0, 1.0)     # => 0.7853981633974483
  # Math.atan2(1.0, -1.0)    # => 2.356194490192345
  # ```
  native def self.atan2(y: Float, x: Float) -> Float
  # E raised to the power `x`.
  native def self.exp(x: Float) -> Float
  # The natural logarithm; `-Float::INFINITY` for 0.0, NaN for a negative
  # `x`.
  native def self.log(x: Float) -> Float
  # The logarithm in `base`, `log(x) / log(base)`.
  #
  # ```
  # Math.log(8.0, 2.0)       # => 3.0
  # Math.log(100.0, 10.0)    # => 2.0
  # ```
  native def self.log(x: Float, base: Float) -> Float
  # The base-2 logarithm.
  native def self.log2(x: Float) -> Float
  # The base-10 logarithm.
  native def self.log10(x: Float) -> Float
  # `x` raised to the power `y`, as `Float#**`: NaN for a negative `x`
  # and a fractional `y`.
  native def self.pow(x: Float, y: Float) -> Float
  # The length of the hypotenuse, `sqrt(x * x + y * y)`, without
  # overflow or underflow in between.
  native def self.hypot(x: Float, y: Float) -> Float
  # The largest `Int` not above `x`, as `Float#floor`: `RangeError` for
  # NaN or an infinity.
  native def self.floor(x: Float) -> Int
  # The smallest `Int` not below `x`, as `Float#ceil`: `RangeError` for
  # NaN or an infinity.
  native def self.ceil(x: Float) -> Int
  # The arcsine, in radians from -PI/2 to PI/2; NaN outside -1.0..1.0.
  native def self.asin(x: Float) -> Float
  # The arccosine, in radians from 0 to PI; NaN outside -1.0..1.0.
  native def self.acos(x: Float) -> Float
  # The hyperbolic sine.
  native def self.sinh(x: Float) -> Float
  # The hyperbolic cosine.
  native def self.cosh(x: Float) -> Float
  # The hyperbolic tangent, from -1.0 to 1.0.
  native def self.tanh(x: Float) -> Float
  # The inverse hyperbolic sine.
  native def self.asinh(x: Float) -> Float
  # The inverse hyperbolic cosine; NaN below 1.0.
  native def self.acosh(x: Float) -> Float
  # The inverse hyperbolic tangent; an infinity at -1.0 and 1.0, NaN
  # beyond them.
  native def self.atanh(x: Float) -> Float
  # `log(1 + x)`, accurate for an `x` near 0, where `1 + x` would lose
  # its digits.
  #
  # ```
  # Math.log1p(1.0e-10)    # => 9.999999999500001e-11
  # ```
  native def self.log1p(x: Float) -> Float
  # `exp(x) - 1`, accurate for an `x` near 0.
  native def self.expm1(x: Float) -> Float
end

# The program's functions (`puts`, `gets`, `rand`, `exit`, ...), included
# in `Object`: private, so they are called without a receiver, as in Ruby.
module Kernel
  # Functions, called without a receiver (as in Ruby).
  private

  # Writes each argument's `to_s` to standard output, followed by a newline
  # unless it ends with one. An array writes its elements, each on its own
  # line (an empty one, an empty line); `nil` and no argument write an empty
  # line.
  native def puts(*args: Object) -> Nil
  # Writes each argument's `to_s` to standard output, with no separator and
  # no newline.
  native def print(*args: Object) -> Nil
  # Writes `value`'s `inspect` and a newline to standard output, and returns
  # `value`, so it can wrap an expression.
  #
  # ```
  # p(1 + 2)   # => 3
  # ```
  native def p[T](value: T) -> T
  # Writes each value's `inspect` on a line of its own; returns `nil`.
  native def p(*values: Object) -> Nil
  # The same as `p` with one value.
  native def pp[T](value: T) -> T
  # Writes the arguments to standard error as `puts` writes them to
  # standard output (flushing standard output first).
  native def warn(*args: Object) -> Nil
  # Runs the block again and again, until a `break` (or a `return` or an
  # exception) leaves it. A `StopIteration` raised in the block ends the
  # loop, so `loop { e.next }` stops at the end of an enumerator. As no
  # loop does, it neither lets other tasks run nor checks for a
  # cancellation by itself: one that only computes calls `Task.yield`.
  #
  # ```
  # n = 0
  # loop do
  #   n += 1
  #   break if n == 3
  # end
  # n   # => 3
  # ```
  native def loop(&: () -> Nil) -> Nil
  # Suspends the current task for `duration` (`Task.sleep`): other tasks
  # run in the meantime.
  native def sleep(duration: Duration) -> Nil
  # Ends the program with `status`, as Ruby's: raises `SystemExit`, so the
  # `ensure` clauses it leaves run, innermost first, then the `at_exit`
  # blocks. A plain `rescue` lets it through; `rescue SystemExit` stops it.
  #
  # In another task, the `SystemExit` ends the task as any exception does:
  # `await`, the task's `Task.scope`, `Task.timeout` and `Task.blocking`
  # raise it again in their caller. It is also raised where it next waits
  # in the main task (once, when it is the one waiting for the task), as
  # Ruby raises a thread's in the main thread: an `exit` in an HTTP handler
  # ends the program. A `Task.timeout` block is its caller's code: while it
  # runs, the exit of a task spawned in it, or one meant for the task
  # waiting in it, is raised in the block instead (so `quarz test` catches
  # one in a test, parallel or not).
  native def exit(status: Int = 0) -> Nothing
  # Ends the program with `status` at once: no `ensure` clause and no
  # `at_exit` block runs. What the task's thread wrote is flushed; as with
  # Ruby's `exit!`, output other threads still hold may be lost.
  native def exit!(status: Int = 1) -> Nothing
  # Writes `message` to standard error and raises `SystemExit` with status
  # 1 and `message`, as `exit` does.
  native def abort(message: String) -> Nothing
  # Runs the block when the program exits.
  native def at_exit(&blk: () -> Nil) -> Nil
  # The next line of standard input, with its newline (the last line may
  # have none).
  #
  # ## Raises
  #
  # `EOFError` at the end of the input. Unlike Ruby, `gets` does not return
  # `nil` there: `gets?` does.
  native def gets -> String
  # The next line of standard input, with its newline, or `nil` at the end
  # of the input.
  native def gets? -> String?
  # The same as `gets`: the next line, raising `EOFError` at the end.
  native def readline -> String
  # The remaining lines of standard input, each with its newline; empty at
  # the end of the input.
  native def readlines -> Array[String]
  # Writes `format(format, *args)` to standard output.
  native def printf(format: String, *args: Object) -> Nil
  # A random `Float` in `0.0...1.0`, from the default generator (seeded by
  # `srand`; `Random` makes generators of their own).
  native def rand -> Float
  # A random `Int` in `0...max`.
  #
  # ## Raises
  #
  # `ArgumentError` when `max` is zero or negative (Ruby's `rand(0)`
  # returns a `Float`).
  native def rand(max: Int) -> Int
  # A random `Float` in `0.0...max`.
  #
  # ## Raises
  #
  # `ArgumentError` when `max` is zero or negative.
  native def rand(max: Float) -> Float
  # A random element of `range`.
  #
  # ## Raises
  #
  # `ArgumentError` for an empty range.
  native def rand(range: Range[Int]) -> Int
  # A random `Float` in `range`, from its start up to, not including, its
  # end (`..` or `...`). A range whose ends are equal, even an empty one
  # (`5.0...5.0`), gives its start.
  #
  # ## Raises
  #
  # `ArgumentError` when the end is below the start.
  native def rand(range: Range[Float]) -> Float
  # Seeds the default generator; returns the previous seed.
  #
  # The same seed gives the same sequence of `rand` results.
  native def srand(seed: Int) -> Int
  # Seeds the default generator with a fresh random seed; returns the
  # previous seed.
  native def srand -> Int
  # The arguments formatted by `format`, a subset of Ruby's `sprintf`:
  # `%d %i %s %f %e %g %x %X %o %b %c %%`, with the flags `-`, `0`, `+`
  # and space, a width and a precision. `%s` takes any value's `to_s`. A
  # conversion without a value formats `nil`. `%e` writes the exponent
  # without a `+` or padding (`1.500000e3`, where Ruby writes
  # `1.500000e+03`).
  #
  # ## Raises
  #
  # `ArgumentError` for a conversion it does not know (`%p`).
  #
  # ```
  # format("%05.1f|%-3d|%x", 3.14159, 7, 255)   # => "003.1|7  |ff"
  # ```
  native def format(format: String, *args: Object) -> String
  # :ditto:
  native def sprintf(format: String, *args: Object) -> String
  # `text` as an `Int`, as Ruby reads it: an optional sign, then the base
  # from a prefix (`0x` hexadecimal, `0b` binary, `0o` octal, `0d`
  # decimal, either case), octal for a bare leading `0` as in a literal
  # (`017` is 15), decimal otherwise. Unlike `String#to_i`, the whole text
  # must be the number: whitespace may surround it, and a single `_` stand
  # between digits. For a zero-padded decimal (`"08"`), pass base 10.
  #
  # ```
  # Integer("0x1f")       # => 31
  # Integer(" 1_000 ")    # => 1000
  # Integer("017")        # => 15
  # Integer("017", 10)    # => 17
  # Integer("08")         # raises ArgumentError
  # Integer("12abc")      # raises ArgumentError
  # ```
  #
  # ## Raises
  #
  # `ArgumentError` for a text that is not an integer, `OverflowError` for
  # one too large for an `Int`.
  native def Integer(text: String) -> Int
  # `text` as an `Int` in `base` (2 to 36, or 0 for the one-argument
  # form's reading), read as that form reads it: the prefix naming `base`
  # is allowed (`Integer("0xff", 16)` is 255), a leading `0` is not octal.
  #
  # ## Raises
  #
  # `ArgumentError` for a text that is not an integer in that base, or a
  # `base` out of range; `OverflowError` for one too large for an `Int`.
  native def Integer(text: String, base: Int) -> Int
  # `text` as a `Float`: a decimal or exponent literal, with surrounding
  # whitespace and `_` between digits allowed.
  #
  # ## Raises
  #
  # `ArgumentError` for a text that is not a number.
  native def Float(text: String) -> Float
  # `value.to_s`.
  native def String(value: Object) -> String
end

# The command-line arguments given to the program, without the program's
# name (`Process.argv`).
ARGV = Process.argv
# The environment variables when the program started, as an immutable
# `Hash` (`Process.env`).
ENV = Process.env
# Standard input (`Process.stdin`).
STDIN = Process.stdin
# Standard output (`Process.stdout`): what `puts` and `print` write to.
STDOUT = Process.stdout
# Standard error (`Process.stderr`): what `warn` writes to.
STDERR = Process.stderr
