data Vec2(x: Float, y: Float) do
  def +(o: Vec2) -> Vec2 = Vec2.new(x + o.x, y + o.y)
  def scale(k: Float) -> Vec2 = Vec2.new(x * k, y * k)
end
class Particle
  var @pos: Vec2
  var @vel: Vec2
  attr_reader :pos
  def initialize(@pos: Vec2, @vel: Vec2); end
  def step(dt: Float) -> Nil
    @pos = @pos + @vel.scale(dt)
  end
end
ps = Array.new(1000) { |i| Particle.new(Vec2.new(i.to_f, 0.0), Vec2.new(1.0, 0.5)) }
300.times { ps.each { |p| p.step(0.01) } }
puts ps[0].pos.x.round(2)
