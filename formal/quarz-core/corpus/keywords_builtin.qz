# Keyword arguments to built-in calls (methods, class methods, Kernel's
# functions, a built-in class's `new`): each typed by the parameter of its
# name, the others by position, the rest with their defaults.
puts Integer(text: "12") + 1
puts Integer(text: "ff", base: 16)
p [3, 1, 2].take(n: 2)
p "abc".include?(other: "b")
puts 5.clamp(min: 1, max: 3)
t = Time.utc(2024, hour: 5)
puts "#{t.year} #{t.hour}"
a = [1, 2]
a = a.push(value: 3)
p a
h = {1 => 2}
h = h.put(key: 3, value: 4)
p h.size
