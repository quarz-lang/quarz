# Signals: `TERM` ends `sleep`, `kill` too; `signal` after the end does
# nothing; `running?` and `status` before and after; `wait` twice gives the
# same status.
c = Process.spawn("sleep", "30")
p c.running?
p c.status
c.signal(:TERM)
s = c.wait
p s
p s.code, s.signal, s.to_i, s.success?
p c.running?
p c.status
p c.wait == s
c.signal("SIGTERM")
c.kill
p c.wait

k = Process.spawn("sleep", "30")
k.kill
p k.wait.signal
p Signal.number("KILL") == Signal.number("SIGKILL")
begin
  Signal.trap(:KILL) { }
rescue ArgumentError => e
  p e.message
end
begin
  k.signal(:NOPE)
rescue ArgumentError => e
  p e.message
end
