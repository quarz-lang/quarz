# A child's standard output and error through pipes, its exit code; its
# standard input through a pipe; and two tasks reading a child's two
# pipes at once, each of which the child fills (1 MB each): both make
# progress, and the child ends.
c = Process.spawn("sh", "-c", "echo out; echo err >&2; exit 3",
                  stdout: :pipe, stderr: :pipe, stdin: :null, chdir: "/tmp")
p c.stdout.read
p c.stderr.read
status = c.wait
p status
p status.code, status.signal, status.success?, status.to_i

cat = Process.spawn("cat", stdin: :pipe, stdout: :pipe)
cat.stdin.puts "hello"
cat.stdin.write("world\n")
cat.stdin.close
p cat.stdout.read
p cat.wait.success?

big = Process.spawn("sh", "-c", "head -c 1048576 /dev/zero; head -c 1048576 /dev/zero >&2",
                    stdout: :pipe, stderr: :pipe)
sizes = Task.scope do |s|
  out = s.spawn { big.stdout.read.size }
  err = s.spawn { big.stderr.read.size }
  [out.await, err.await]
end
p sizes
p big.wait.code
