# Within one extension the last include comes first, as for a class's own
# includes (docs/01 §7, #523), on the instance side too (#536 step 3):
# `N2#m` runs through `M`, `N1` and `N2`, as a direct call where the
# extension is active finds it, and as the class side and a class's own
# two includes do.
module M
  abstract def m -> String
  abstract def self.k -> String
end
module N1
  include M
  def m -> String = "N1"
  def self.k -> String = "N1"
end
module N2
  include M
  def m -> String = "N2"
  def self.k -> String = "N2"
end
class K
  def initialize; end
end
module X
  extension K
    include N1
    include N2
  end
  def self.direct -> String = K.new.m
  def self.as_m -> M = K.new
  def self.as_n1 -> N1 = K.new
  def self.as_n2 -> N2 = K.new
  def self.t_m -> Type[M] = K
  def self.t_n1 -> Type[N1] = K
end
def via(x: M) -> String = x.m
def via1(x: N1) -> String = x.m
def via2(x: N2) -> String = x.m
def cvia(x: Type[M]) -> String = x.k
def cvia1(x: Type[N1]) -> String = x.k
puts X.direct, via(X.as_m), via1(X.as_n1), via2(X.as_n2)
puts cvia(X.t_m), cvia1(X.t_n1)

class Own
  include N1
  include N2
  def initialize; end
end
puts Own.new.m, via(Own.new), via1(Own.new), via2(Own.new)
