# The built-in `Kernel` functions are functions (docs/01 §1, §3): a
# subclass's method of the same name and signature does not take over the
# superclass's call, and `::name` calls the function (the file's top-level
# `def` first, then the built-in) where a method of `self` hides it.
class P
  def hello -> Void = puts("hi from P")
end
class C < P
  def puts(*values: Object) -> Void = print("C#puts\n")
  def own -> Void = puts("not printed")
  def through -> Void = ::puts("through ::puts")
end
C.new.hello
C.new.own
C.new.through

def twice(x: Int) -> Int = x * 2
class D
  def twice(x: Int) -> Int = x * 3
  def both -> Array[Int] = [twice(5), ::twice(5)]
end
p D.new.both
::p ::twice(21)

# `Kernel.name` is always the built-in, also inside a file's own `def`
# of the name, where `name` and `::name` are the file's.
def print(*values: Object) -> Void = Kernel.print("[mine] ", *values)
print "a\n"
::print "b\n"
Kernel.print "c\n"
class W
  def self.run -> Void = Kernel.puts("from a class method")
end
W.run

# `::name` finds the file's `def`s first, then the built-in's other
# overloads; `::Integer(...)` is Kernel's where a method hides it.
class Q
  def Integer(s: String) -> Int = 99
  def go -> Array[Int] = [Integer("3"), ::Integer("3")]
end
p Q.new.go
