# `super` in a block with a receiver is the enclosing method's `super`,
# run on the method's `self`, however the block is lowered (#384): in
# place (a literal block given to `instance_exec`), as a function of its
# own (a block given to a method that `instance_exec`s it), in a lambda
# with a receiver, nested in other blocks, and on a receiver of a class
# that has no such method.

class Q
  def go(n: Int) -> String = "go #{self.class.name} #{n}"
  def zs(n: Int) -> String = "zs #{self.class.name} #{n}"
  def lam(n: Int) -> String = "lam #{self.class.name} #{n}"
  def nest(n: Int) -> String = "nest #{self.class.name} #{n}"
  def un(n: Int) -> String = "un #{self.class.name} #{n}"
  def arg(n: Int) -> String = "arg #{self.class.name} #{n}"
end

class R
end

class Runner
  def with(s: P, &b: P.() -> String) -> String = s.instance_exec(&b)
  def on_r(&b: R.() -> String) -> String = R.new.instance_exec(&b)
end

class P < Q
  def go(n: Int) -> String
    in_place = P3.new.instance_exec { super(n) }
    as_function = Runner.new.with(P3.new) { super(n + 1) }
    "#{in_place} | #{as_function}"
  end

  def zs(n: Int) -> String = Runner.new.with(P3.new) { super }

  def lam(n: Int) -> String
    f: P.() -> String = -> { super(n) }
    P3.new.instance_exec(&f)
  end

  def nest(n: Int) -> String
    [1, 2].map { |i| Runner.new.with(P3.new) { Runner.new.on_r { super(n + i) } } }.join(", ")
  end

  def un(n: Int) -> String = Runner.new.on_r { super(n) }

  def arg(n: Int) -> String = P3.new.instance_exec(n * 2) { |k| super(k) }
end

class P2 < P
end

class P3 < P
end

puts P2.new.go(1)
puts P2.new.zs(7)
puts P2.new.lam(3)
puts P2.new.nest(4)
puts P2.new.un(5)
puts P2.new.arg(6)
