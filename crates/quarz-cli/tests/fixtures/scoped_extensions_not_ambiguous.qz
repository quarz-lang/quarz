# Two active scoped extensions whose includes give a class a method of the
# same name are ambiguous (#577; the ambiguous calls are diagnostics
# tests). Not ambiguous: the class's own method in front; extensions of a
# class and of its superclass (the class's comes first); one extension's
# includes (the last first); an abstract declaration beside a body; a
# conditional extension that does not apply.
# Dropped cells (#517): one module overriding the other (M2 includes M1)
# across two extensions of one class, on both sides and by the forms found
# by name (a method reference, `&:name`, an interpolation, an operator,
# `super`): the second extension would bring M1 to the class again, which
# is refused since #517.
module N1
  def it -> String = "N1"
end
module N2
  def it -> String = "N2"
end
class Own
  def initialize; end
  def it -> String = "own"
end
module SO1
  extension Own
    include N1
  end
end
module SO2
  extension Own
    include N2
  end
end
def own_in_front -> String
  using SO1
  using SO2
  Own.new.it
end

class P
  def initialize; end
end
class D < P
  def initialize; end
end
module SP
  extension P
    include N1
  end
end
module SD
  extension D
    include N2
  end
end
def class_and_superclass -> String
  using SP
  using SD
  D.new.it
end

class E
  def initialize; end
end
module SE
  extension E
    include N1
    include N2
  end
end
def last_include -> String
  using SE
  E.new.it
end

# An abstract declaration gives no method (#522): beside another active
# extension's body, the body, in either `using` order, by every form.
module Named
  abstract def name -> String
  def hello -> String = "hello " + name
end
module Giver
  def name -> String = "giver"
end
class CN
  def initialize; end
end
module SN1
  extension CN
    include Named
  end
end
module SN2
  extension CN
    include Giver
  end
end
def abstract_beside -> String
  using SN1
  using SN2
  c = CN.new
  [c.name, c.:name.call, [c].map(&:name)[0], c.hello].join(",")
end
def abstract_beside_b -> String
  using SN2
  using SN1
  CN.new.name
end

# Two top-level conditional extensions, one applying (its includes, the
# last first) and one not: no rival. (Each brings its own modules: one
# module brought by both would be a second conformance, #517.)
module CA
  def foo -> String = "CA"
end
module CB
  def foo -> String = "CB"
end
module CC
  def foo -> String = "CC"
end
class CBox[T]
  def initialize(v: T); end
end
extension CBox[T <: String]
  include CB
end
extension CBox[T <: Int]
  include CA
  include CC
end
def one_applies -> String = CBox.new(1).foo

puts own_in_front, class_and_superclass, last_include, abstract_beside, abstract_beside_b, one_applies
