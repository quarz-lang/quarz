# Two active scoped extensions whose includes give a class a method of the
# same name are ambiguous (#577; the ambiguous calls are diagnostics
# tests). Not ambiguous: the class's own method in front; extensions of a
# class and of its superclass (the class's comes first); one extension's
# includes (the last first); a conditional extension that does not apply.
# Dropped cells (#517): one module overriding the other (M2 includes M1)
# across two extensions of one class, on both sides and by the forms found
# by name (a method reference, `&:name`, an interpolation, an operator,
# `super`): the second extension would bring M1 to the class again, which
# is refused since #517.
# Dropped cell (R0, #555): an abstract declaration beside another active
# extension's body (#522's witness part): an extension including `Named`
# whose `name` only another extension's module gives is refused, since an
# extension completes the conformance it makes.
module N1
  def it -> String = "N1"
end
module N2
  def it -> String = "N2"
end
class Own
  def initialize; end
  def it -> String = "own"
end
module SO1
  extension Own
    include N1
  end
end
module SO2
  extension Own
    include N2
  end
end
def own_in_front -> String
  using SO1
  using SO2
  Own.new.it
end

class P
  def initialize; end
end
class D < P
  def initialize; end
end
module SP
  extension P
    include N1
  end
end
module SD
  extension D
    include N2
  end
end
def class_and_superclass -> String
  using SP
  using SD
  D.new.it
end

class E
  def initialize; end
end
module SE
  extension E
    include N1
    include N2
  end
end
def last_include -> String
  using SE
  E.new.it
end

# Two top-level conditional extensions, one applying (its includes, the
# last first) and one not: no rival. (Each brings its own modules: one
# module brought by both would be a second conformance, #517.)
module CA
  def foo -> String = "CA"
end
module CB
  def foo -> String = "CB"
end
module CC
  def foo -> String = "CC"
end
class CBox[T]
  def initialize(v: T); end
end
extension CBox[T <: String]
  include CB
end
extension CBox[T <: Int]
  include CA
  include CC
end
def one_applies -> String = CBox.new(1).foo

puts own_in_front, class_and_superclass, last_include, one_applies
