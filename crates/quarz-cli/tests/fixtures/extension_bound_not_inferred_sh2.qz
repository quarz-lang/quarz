# A conditional extension's bound against an argument not inferred yet,
# decided with the subtyping rules (variance, derived Shareable): #518's
# review.
# (`f(Bx.new([]))` and the like, with an argument not inferred yet, is an error since #519's
# decision (i): which overload it takes would turn on a bound not known
# yet. `diagnostics.rs`: `an_overload_on_a_bound_not_known_yet_is_refused`.)
module Summ
  abstract def total -> Int
end
class Bx[T]
  @v: T
  def initialize(@v: T); end
  def v -> T = @v
end
data Pr[A] = (a: A)
extension Bx[T <: Shareable]
  include Summ
  def total -> Int = 7
end
def f(s: Summ) -> String = "summ #{s.total}"
def f(o: Object) -> String = "obj"
p f(Bx.new(Pr.new([1])))
