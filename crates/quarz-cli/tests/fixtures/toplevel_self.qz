# A top-level `def` runs with its file's top-level object as `self`
# (docs/01 §1), wherever it is called from: not the caller's `self`.
def whoami -> String = self.class.name
def show -> String = inspect

class C
  def go -> String = whoami
  def in_block -> String = [1].map { |x| whoami }[0]
  def in_lambda -> String = (-> { whoami }).call
  def shown -> String = show
end

X = whoami

class D
  @who: String = whoami
  def initialize
    # Before `@n` is set: a top-level `def` does not read the object.
    @tag = whoami
    @n = 1
  end
  @tag: String
  @n: Int
  def who -> String = "#{@who} #{@tag} #{@n}"
end

p whoami, C.new.go, C.new.in_block, C.new.in_lambda, X, D.new.who
p show == C.new.shown
p Task.spawn { whoami }.await

# What decides whether a call passes the top-level object: a top-level
# `def` that does not use `self` is called without it, one that calls
# another that does still gets it there, and so does `self` in a lambda,
# a block with a receiver or a parameter's default.
def uses -> String = self.class.name
def via_other -> String = uses
def in_lambda -> String = (-> { self.class.name }).call
def in_exec -> String = 5.instance_exec { self.to_s }
def via_exec -> String = 5.instance_exec { uses }
def in_default(x: String = self.class.name) -> String = x
class E
  def go -> Array[String] = [via_other, in_lambda, in_exec, via_exec, in_default]
  def exec_here -> String = 5.instance_exec { uses }
end
p E.new.go, E.new.exec_here
