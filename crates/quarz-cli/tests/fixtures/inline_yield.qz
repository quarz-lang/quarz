# A method that yields, inlined with its literal block (#1223): each case
# is written twice, its receiver typed `Inl` (whose helpers yield: the
# call is inlined) and `Ref` (the same helpers calling their block: the
# call stays one), and prints the same, interpreted and compiled. (A
# union receiver would be dispatched dynamically, which the inliner
# leaves a call: hence one class per copy.)
class Inl
  def tag -> String = "inl"

  def with(&blk: () -> Int) -> Int
    yield
  end

  def add(x: Int, &blk: (Int) -> Int) -> Int
    x + yield(x)
  end

  def each3(&blk: (Int) -> Int) -> Int
    i = 0
    s = 0
    while i < 3
      s += yield(i)
      i += 1
    end
    s
  end

  def count(n: Int, &blk: (Int) -> Int) -> Int
    i = 0
    last = 0
    while i < n
      last = yield(i)
      i += 1
    end
    last
  end

  def two(&blk: (Int) -> Int) -> Int
    yield(1) + yield(2)
  end

  def three(&blk: (Int) -> Int) -> Int
    yield(1) + yield(2) + yield(3)
  end

  def with_tag(&blk: () -> String) -> String
    tag + ":" + yield
  end

  # `with_tag` on `self`, implicitly: the block's `self` is this object.
  def run_self -> String = with_tag { tag }
end

class Ref
  def tag -> String = "ref"

  def with(&blk: () -> Int) -> Int
    blk.call
  end

  def add(x: Int, &blk: (Int) -> Int) -> Int
    x + blk.call(x)
  end

  def each3(&blk: (Int) -> Int) -> Int
    i = 0
    s = 0
    while i < 3
      s += blk.call(i)
      i += 1
    end
    s
  end

  def count(n: Int, &blk: (Int) -> Int) -> Int
    i = 0
    last = 0
    while i < n
      last = blk.call(i)
      i += 1
    end
    last
  end

  def two(&blk: (Int) -> Int) -> Int
    blk.call(1) + blk.call(2)
  end

  def three(&blk: (Int) -> Int) -> Int
    blk.call(1) + blk.call(2) + blk.call(3)
  end

  def with_tag(&blk: () -> String) -> String
    tag + ":" + blk.call
  end

  # `with_tag` on `self`, implicitly: the block's `self` is this object.
  def run_self -> String = with_tag { tag }
end

LOG = Atom[Array[String]].new([])

class Held
  @name: String

  def initialize(@name: String)
  end

  def deinitialize -> Void
    LOG.update { |a| a + ["drop #{@name}"] }
  end
end

def cases_inl(w: Inl) -> Array[Int | String]
  out: Array[Int | String] = []
  n = 1
  # The arguments are evaluated before the block runs; the block sees
  # what they did to its captures.
  out = out + [w.add(n += 10) { |v| v + n }, n]
  out = out + [w.with { n += 1; n }, n]
  out = out + [w.each3 { |v| next 100 if v == 1; v }]
  out = out + [w.each3 { |v| break -1 if v == 2; v }]
  out = out + [w.with { break 42 }]
  # A yield in the callee's loop: `break` on the third pass, `next`.
  out = out + [w.count(5) { |v| break 99 if v == 2; v }]
  out = out + [w.count(5) { |v| next -v if v == 4; v }]
  # Two and three yields, a branch in the block: each copy its own.
  out = out + [w.two { |v| v.even? ? v * 10 : v + 100 }]
  out = out + [w.three { |v| v.even? ? v * 10 : v + 100 }]
  # A captured local assigned in the block, read after the call; the
  # call's value unused.
  m = 0
  w.with { m += 5; 0 }
  out = out + [m]
  begin
    w.with { raise ArgumentError, "inside" }
  rescue ArgumentError => e
    out = out + [e.message]
  end
  out
end

def returned_inl(w: Inl) -> Int
  w.with { return 7 }
  0
end

def returned_two_down_inl(w: Inl) -> Int
  [1].each { |_| w.with { return 8 } }
  0
end

# `return` out of the block inside the caller's `ensure` and `rescue`.
def ens_return_inl(w: Inl) -> Int
  begin
    w.with { return 1 }
  ensure
    LOG.update { |a| a + ["ensure after return"] }
  end
  0
end

def resc_raise_inl(w: Inl) -> Int
  begin
    w.with { raise ArgumentError, "x" }
  rescue ArgumentError
    2
  end
end

def resc_return_inl(w: Inl) -> Int
  begin
    w.with { return 3 }
  rescue ArgumentError
    4
  end
  5
end

# `break` and `next` out of the block inside `begin`/`ensure`: the
# `ensure` runs after the statement, not at the `break`.
def ens_break_inl(w: Inl) -> Int
  r = 0
  begin
    r = w.with { break 6 }
    LOG.update { |a| a + ["after break #{r}"] }
    r = r + w.with { next 1 }
    LOG.update { |a| a + ["after next #{r}"] }
  ensure
    LOG.update { |a| a + ["ensure #{r}"] }
  end
  r
end

# The call in a loop in a `begin`, `return` on the second pass.
def loop_return_inl(w: Inl) -> Int
  begin
    i = 0
    while i < 5
      w.with { return i * 10 if i == 1; 0 }
      i += 1
    end
    -1
  ensure
    LOG.update { |a| a + ["loop ensure"] }
  end
end

# The call's caller a block, in a method with an `ensure`.
def block_caller_return_inl(w: Inl) -> Int
  begin
    [1, 2].each { |_| w.with { return 9 } }
    0
  ensure
    LOG.update { |a| a + ["outer ensure"] }
  end
end

def drops_inl(w: Inl) -> Int
  w.with do
    h = Held.new("block")
    1
  end
end

# The callee's `self` is its receiver; the block's stays the caller's.
class CallerInl
  def tag -> String = "caller"
  def run(o: Inl) -> String = o.with_tag { tag }
end

def run_inl -> Void
  w = Inl.new
  p cases_inl(w)
  p [returned_inl(w), returned_two_down_inl(w)]
  p [ens_return_inl(w), resc_raise_inl(w), resc_return_inl(w)]
  p [ens_break_inl(w), loop_return_inl(w), block_caller_return_inl(w)]
  p drops_inl(w)
  p [w.run_self, CallerInl.new.run(w)]
  p LOG.value
  LOG.set([])
end

def cases_ref(w: Ref) -> Array[Int | String]
  out: Array[Int | String] = []
  n = 1
  # The arguments are evaluated before the block runs; the block sees
  # what they did to its captures.
  out = out + [w.add(n += 10) { |v| v + n }, n]
  out = out + [w.with { n += 1; n }, n]
  out = out + [w.each3 { |v| next 100 if v == 1; v }]
  out = out + [w.each3 { |v| break -1 if v == 2; v }]
  out = out + [w.with { break 42 }]
  # A yield in the callee's loop: `break` on the third pass, `next`.
  out = out + [w.count(5) { |v| break 99 if v == 2; v }]
  out = out + [w.count(5) { |v| next -v if v == 4; v }]
  # Two and three yields, a branch in the block: each copy its own.
  out = out + [w.two { |v| v.even? ? v * 10 : v + 100 }]
  out = out + [w.three { |v| v.even? ? v * 10 : v + 100 }]
  # A captured local assigned in the block, read after the call; the
  # call's value unused.
  m = 0
  w.with { m += 5; 0 }
  out = out + [m]
  begin
    w.with { raise ArgumentError, "inside" }
  rescue ArgumentError => e
    out = out + [e.message]
  end
  out
end

def returned_ref(w: Ref) -> Int
  w.with { return 7 }
  0
end

def returned_two_down_ref(w: Ref) -> Int
  [1].each { |_| w.with { return 8 } }
  0
end

# `return` out of the block inside the caller's `ensure` and `rescue`.
def ens_return_ref(w: Ref) -> Int
  begin
    w.with { return 1 }
  ensure
    LOG.update { |a| a + ["ensure after return"] }
  end
  0
end

def resc_raise_ref(w: Ref) -> Int
  begin
    w.with { raise ArgumentError, "x" }
  rescue ArgumentError
    2
  end
end

def resc_return_ref(w: Ref) -> Int
  begin
    w.with { return 3 }
  rescue ArgumentError
    4
  end
  5
end

# `break` and `next` out of the block inside `begin`/`ensure`: the
# `ensure` runs after the statement, not at the `break`.
def ens_break_ref(w: Ref) -> Int
  r = 0
  begin
    r = w.with { break 6 }
    LOG.update { |a| a + ["after break #{r}"] }
    r = r + w.with { next 1 }
    LOG.update { |a| a + ["after next #{r}"] }
  ensure
    LOG.update { |a| a + ["ensure #{r}"] }
  end
  r
end

# The call in a loop in a `begin`, `return` on the second pass.
def loop_return_ref(w: Ref) -> Int
  begin
    i = 0
    while i < 5
      w.with { return i * 10 if i == 1; 0 }
      i += 1
    end
    -1
  ensure
    LOG.update { |a| a + ["loop ensure"] }
  end
end

# The call's caller a block, in a method with an `ensure`.
def block_caller_return_ref(w: Ref) -> Int
  begin
    [1, 2].each { |_| w.with { return 9 } }
    0
  ensure
    LOG.update { |a| a + ["outer ensure"] }
  end
end

def drops_ref(w: Ref) -> Int
  w.with do
    h = Held.new("block")
    1
  end
end

# The callee's `self` is its receiver; the block's stays the caller's.
class CallerRef
  def tag -> String = "caller"
  def run(o: Ref) -> String = o.with_tag { tag }
end

def run_ref -> Void
  w = Ref.new
  p cases_ref(w)
  p [returned_ref(w), returned_two_down_ref(w)]
  p [ens_return_ref(w), resc_raise_ref(w), resc_return_ref(w)]
  p [ens_break_ref(w), loop_return_ref(w), block_caller_return_ref(w)]
  p drops_ref(w)
  p [w.run_self, CallerRef.new.run(w)]
  p LOG.value
  LOG.set([])
end

run_inl
run_ref
