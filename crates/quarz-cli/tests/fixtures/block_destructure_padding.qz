# docs/01 §9: a tuple is spread over several block parameters only into
# its arity, a `*rest` taking the elements left; an `Array[T]` element is
# not spread at all (#1072, a compile error; it was padded with `nil`
# here, #531).
ts: Array[[Int, String]] = [[1, "x"], [2, "y"]]
ts.each { |n, s| puts "#{n + 1} #{s.upcase}" }
h = {"k" => 1}
h.each { |k, v| puts "#{k}=#{v + 1}" }
mixed: Array[[Int, Int, String]] = [[1, 2, "x"]]
mixed.each { |a, *rest| puts "#{a + 1} #{rest.inspect}" }
