# `when p` is `p === subject` (docs/01 §11; #1075, #1085), interpreted and
# compiled: a class takes part by defining `===(other: Object) -> Bool`;
# the built-in patterns keep their tests (a class, a range, a regexp, `==`
# for the rest); `Object#===` is `==`, a class's own `==` included; a
# procedure-typed pattern is called, one typed otherwise compared with `==`.
#
# Matrix (where `===` comes from): the class's own; a superclass's; an
# included module's; a generic class's; an abstract class's, through a
# concrete subclass; a subclass overriding its superclass's; a pattern
# typed as the superclass holding the subclass. Each in `when` and as
# `a === b`; a value pattern of `case/in` is a literal or a range (a
# constant there names a class), so no user class reaches one.
# Skipped cells: an extension's `===` (a compile error, the diagnostics
# test), a module as a pattern's static type (a module's instance is a
# class's: the class rows cover it), another cog (`===` is looked up by the
# pattern's class at run time, as `==` is: nothing per cog).
class Even
  def ===(other: Object) -> Bool = other.is_a?(Int) && other % 2 == 0
end
class Big < Even
  def ===(other: Object) -> Bool = other.is_a?(Int) && other > 100
end
module Vowels
  def ===(other: Object) -> Bool = other.is_a?(String) && "aeiou".include?(other)
end
class Letters
  include Vowels
end
class Members[T]
  @items: Array[T]
  def initialize(@items: Array[T]); end
  def ===(other: Object) -> Bool = @items.any? { |x| x == other }
end
abstract class Shape
  abstract def sides -> Int
  def ===(other: Object) -> Bool = other == sides
end
class Square < Shape
  def sides -> Int = 4
end
class Name
  @s: String
  def initialize(@s: String); end
  def ==(other: Object) -> Bool = other.is_a?(String) && other == @s
  def hash -> Int = @s.hash
end
class Plain
end

def kind(x: Object) -> String
  case x
  when Big.new then "big"
  when Square.new then "square sides"
  when Even.new then "even"
  when Letters.new then "vowel"
  when Members.new(["x", "y"]) then "member"
  when Name.new("bob") then "bob"
  when 1..3, /z/ then "small or z"
  when Int then "int"
  else "other"
  end
end
[200, 8, "a", "y", 4, "bob", 3, "zz", 7, "q", 3.5].each { |v| puts "#{v.inspect}: #{kind(v)}" }

# A pattern typed as the superclass, holding the subclass: its `===`.
pat: Even = Big.new
puts(pat === 8)
puts(pat === 300)
# A value pattern of `case/in` (a literal or a range) takes the same test.
v = case 6
    in 1..3 then "small"
    in 6 then "six"
    else "other"
    end
puts v
# `a === b` for each built-in, and `Object#===` (`==`).
p Int === 3, Int === "3", (1..5) === 3, (1..5) === 9, /a/ === "cat", 3 === 3, "a" === "b"
p Plain.new === Plain.new, Name.new("al") === "al"
# A procedure-typed pattern is called; one typed `Object` is compared
# with `==` (identity).
f = ->(n: Int) { n > 1 }
p f === 2, f === 0
case 5
when f then puts "f called"
end
def same(a: Object, b: Object) -> Bool = a === b
p same(f, 5), same(f, f)
