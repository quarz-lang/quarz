# The #536 step-2 resolution-order matrix (generated): what a call
# through the superclass's type runs, and `is_a?` of the module, for
# each way a class gets a module. Expected from docs/01 §6–§7: an own
# include's module comes before the superclass; an extension's module
# replaces the class's or its ancestors' methods only from an
# unconditional top-level extension (a scoped or conditional one's
# never); the class's own method always first; `is_a?` holds for
# every conformance. Skipped: another cog (tests/cogs.rs), the class
# side (step 2b).
class B1
  def initialize; end
  def m -> String = "base"
end
module M1
  def m -> String = "mod"
end
class C1 < B1
  include M1
  def initialize; end
end
def f1(x: B1) -> String = x.m
puts "own include: #{f1(C1.new)} #{C1.new.is_a?(M1)}"
class B2
  def initialize; end
  def m -> String = "base"
end
module M2
  def m -> String = "mod"
end
class P2 < B2
  include M2
  def initialize; end
end
class C2 < P2
  def initialize; end
end
def f2(x: B2) -> String = x.m
puts "superclass's include: #{f2(C2.new)} #{C2.new.is_a?(M2)}"
