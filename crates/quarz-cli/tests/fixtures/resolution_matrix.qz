  def initialize; end
  def m -> String = "base"
end
module M3
  def m -> String = "mod"
end
class C3 < B3
  def initialize; end
end
extension C3
  include M3
end
def f3(x: B3) -> String = x.m
puts "top-level extension of the class: #{f3(C3.new)} #{C3.new.is_a?(M3)}"
