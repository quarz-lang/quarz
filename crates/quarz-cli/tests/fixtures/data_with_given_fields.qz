# `with` copies the fields it is not given and sets the given ones
# without reading the receiver's (#1024): the result is the same, for a
# data type with the generated `initialize` or its own, a field holding
# a data value in place given or not, every field given, a word field
# given beside a counted one, and a type of more than 64 slots given
# fields past the 64th (a counted one, a word, a collection).
data Vec2 = (x: Int, y: Int)

data Body = (name: String, pos: Vec2, tags: Array[String], mass: Float)

data Clamped(lo: Int, hi: Int)
  def initialize(lo: Int, hi: Int)
    @lo = lo
    @hi = hi < lo ? lo : hi
  end
end

b = Body.new(name: "a", pos: Vec2.new(1, 2), tags: ["x"], mass: 1.5)
p b.with(name: "b")
p b.with(pos: Vec2.new(3, 4))
p b.with(tags: b.tags.push("y"), mass: 2.0)
p b.with(name: "c", pos: Vec2.new(5, 6), tags: [], mass: 0.0)
p b

c = Clamped.new(1, 5)
p c.with(hi: 0)
p c.with(lo: 2)
p c.with(lo: 7, hi: 9)
p c

data Rec = (n: Int, label: String)
r = Rec.new(n: 0, label: "r")
p r.with(n: 1)
p r

data Wide = (f0: String, f1: String, f2: String, f3: String, f4: String, f5: String, f6: String, f7: String, f8: String, f9: String, f10: String, f11: String, f12: String, f13: String, f14: String, f15: String, f16: String, f17: String, f18: String, f19: String, f20: String, f21: String, f22: String, f23: String, f24: String, f25: String, f26: String, f27: String, f28: String, f29: String, f30: String, f31: String, f32: String, f33: String, f34: String, f35: String, f36: String, f37: String, f38: String, f39: String, f40: String, f41: String, f42: String, f43: String, f44: String, f45: String, f46: String, f47: String, f48: String, f49: String, f50: String, f51: String, f52: String, f53: String, f54: String, f55: String, f56: String, f57: String, f58: String, f59: String, f60: String, f61: String, f62: String, f63: String, f64: String, f65: String, g: Int, h: Array[Int])
w = Wide.new(f0: "0", f1: "1", f2: "2", f3: "3", f4: "4", f5: "5", f6: "6", f7: "7", f8: "8", f9: "9", f10: "10", f11: "11", f12: "12", f13: "13", f14: "14", f15: "15", f16: "16", f17: "17", f18: "18", f19: "19", f20: "20", f21: "21", f22: "22", f23: "23", f24: "24", f25: "25", f26: "26", f27: "27", f28: "28", f29: "29", f30: "30", f31: "31", f32: "32", f33: "33", f34: "34", f35: "35", f36: "36", f37: "37", f38: "38", f39: "39", f40: "40", f41: "41", f42: "42", f43: "43", f44: "44", f45: "45", f46: "46", f47: "47", f48: "48", f49: "49", f50: "50", f51: "51", f52: "52", f53: "53", f54: "54", f55: "55", f56: "56", f57: "57", f58: "58", f59: "59", f60: "60", f61: "61", f62: "62", f63: "63", f64: "64", f65: "65", g: 7, h: [1])
v = w.with(f65: "z", g: 8, h: w.h.push(2))
puts v.f0, v.f63, v.f64, v.f65, v.g, v.h.inspect
puts w.f65, w.g, w.h.inspect
