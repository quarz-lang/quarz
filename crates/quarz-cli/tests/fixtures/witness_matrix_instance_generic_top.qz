  def m -> String = "ext"
end
def up1(x: C1[Int]) -> M1 = x
def direct1(x: C1[Int]) -> String = x.m
def via1(x: M1) -> String = x.m
puts "generic/ext/ext/default/none/top: #{via1(up1(C1[Int].new))} #{via1(up1(C1[Int].new))} #{direct1(C1[Int].new)}"
