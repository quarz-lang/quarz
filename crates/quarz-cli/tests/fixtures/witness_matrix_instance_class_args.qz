def direct1(x: C1) -> String = x.m(1)
def via1(x: M1[Int]) -> String = x.m(1)
puts "class/own//default/concrete/none: #{via1(up1(C1.new))} #{via1(up1(C1.new))} #{direct1(C1.new)}"
