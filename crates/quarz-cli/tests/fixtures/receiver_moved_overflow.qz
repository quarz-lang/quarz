# #704: a receiver moved into a lean method that recurses until the
# native stack runs out: released exactly once, during the unwinding,
# before the `rescue` around the call runs (as on the interpreter), in
# each of two rounds.

class Deep
  @name: String
  def initialize(@name: String); end
  def deinitialize -> Void
    puts "released #{@name}"
  end
  def dive(n: Int) -> Int = dive(n + 1) + 1
end

# (No handler here: `d`, read for the last time, moves into the call.)
def plunge(s: String) -> Int
  d = Deep.new(s)
  d.dive(0)
end

["a", "b"].each do |s|
  begin
    plunge(s)
  rescue Exception => e
    puts "rescued #{e.message}"
  end
  puts "after #{s}"
end
puts "end"
