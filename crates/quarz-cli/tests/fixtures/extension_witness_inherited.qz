# The witness of a module's abstract method may be a method the class
# inherits, with a scoped extension as with a top-level one (#536 step 3):
# `A#label` for `B < A` conforming to `Named` through an extension that
# defines nothing; a subclass's own method overrides it.
module Named
  abstract def label -> String
end
class A
  def initialize; end
  def label -> String = "A"
end
class B < A
  def initialize; end
end
class C < B
  def initialize; end
  def label -> String = "C"
end
module Sc
  extension B
    include Named
  end
  def self.n(x: B) -> Named = x
end
def via(n: Named) -> String = n.label
puts via(Sc.n(B.new))
puts via(Sc.n(C.new))

class A2
  def initialize; end
  def label -> String = "A2"
end
class B2 < A2
  def initialize; end
end
extension B2
  include Named
end
puts via(B2.new)
