class C34
  def initialize; end
  def m -> String = "own"
end
class S34 < C34
  def initialize; end
end
module X34
  extension C34
    include M34
  end
  extension S34
    include M34
    def m -> String = "subext"
  end
  def self.up(x: C34) -> M34 = x
  def self.via(x: M34) -> String = x.m
  def self.direct(x: C34) -> String = x.m
end
def via34(x: M34) -> String = x.m
puts "class/sub_own_ext/own/abstract/none/scoped: #{via34(X34.up(S34.new))} #{X34.via(X34.up(S34.new))} #{X34.direct(S34.new)}"
