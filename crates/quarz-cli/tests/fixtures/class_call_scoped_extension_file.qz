# class_call_scoped_extension with `using` at file level: `C.tag` runs
# the extension's module's class method (#580); through `Type[C]`, typed
# as the module's where the extension is active, the witness, which is
# the module's own `A.tag` too: the class-side order with the extension
# active reaches it before the inherited `P.tag` (#669's decision (y)).
module A
  def self.tag -> Object = "A"
end
class P
  def self.tag -> String = "P"
end
class C < P
end
module Sa
  extension C
    include A
  end
end
using Sa
def through_type_c(k: Type[C]) -> Object = k.tag
puts C.tag, through_type_c(C)
