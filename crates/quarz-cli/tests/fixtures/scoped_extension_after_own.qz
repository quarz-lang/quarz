# An active scoped extension's module comes after the class's own
# includes and its top-level extensions' modules (docs/01 §7: they override
# any extension's modules), before the superclass: under `using` the
# checker picks B, which runs, on both sides (#570 review). Method-level
# `using`; scoped_extension_after_own_file has it at file level.
# Dropped cell (rule B): a scoped extension of a module the class includes
# (`extension MT; include ST`): an extension of a module cannot include.
module B
  def it -> String = "B"
  def self.tag -> String = "B"
end
module M3
  def it -> Object = 42
  def self.tag -> Object = 42
end
class C
  def initialize; end
  include B
end
class D
  def initialize; end
end
extension D
  include B
end
module Sc
  extension C
    include M3
  end
  extension D
    include M3
  end
end
def inst -> String
  using Sc
  s: String = C.new.it
  t: String = D.new.it
  s + t
end
def cls -> String
  using Sc
  s: String = C.tag
  t: String = D.tag
  s + t
end
puts inst, cls
