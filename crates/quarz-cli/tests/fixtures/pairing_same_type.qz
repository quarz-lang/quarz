# The pairing rule (docs/01 §3) pairs a subclass's method with an
# ancestor's of the same name and parameter types; "the same type" is the
# checker's type equality (#536 step 5), so the same type written another
# way is the same: a union in another order, `T?` and `Nil | T`, an alias.
# Each `B` method replaces `A`'s, so a call through `A` runs `B`'s.
type Num = Int
class A
  def u(x: Int | String) -> String = "A#u"
  def n(x: String?) -> String = "A#n"
  def al(x: Num) -> String = "A#al"
end
class B < A
  def u(x: String | Int) -> String = "B#u"
  def n(x: Nil | String) -> String = "B#n"
  def al(x: Int) -> String = "B#al"
end
a: A = B.new
puts a.u(1), a.n(nil), a.al(2)
