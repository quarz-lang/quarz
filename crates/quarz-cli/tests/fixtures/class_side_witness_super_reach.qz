# What a call of a module's class method runs on a subclass conforming
# through an extension (`World::class_method_target`, #681's (c)): the
# subclass's own class method below the class the witness is recorded for
# takes the witness's place, through `Type[M]` and `T <: M` as directly;
# its `super` is resolved statically to the extension's method
# (`Checker::check_super`, which raises here), never to the module's
# `new`. Cells: the extension top-level (1), scoped (2), and the
# subclass's own `make` without `super` (3), which builds the subclass.
# Expected output derived from these rules.
module M1
  def self.make -> Self = new
end
class F1
  def initialize; end
end
extension F1
  include M1
  def self.make -> Self = raise "ext"
end
class S1 < F1
  @x: Int
  def initialize(@x: Int); end
  def self.make -> Self = super
end
def f1(t: Type[M1]) -> String
  t.make.class.name
rescue
  "raised"
end
def g1[T <: M1](t: Type[T]) -> String
  t.make.class.name
rescue
  "raised"
end
def h1 -> String
  S1.make.class.name
rescue
  "raised"
end
puts "1 " + f1(S1) + " " + g1(S1) + " " + h1

module M2
  def self.make -> Self = new
end
class F2
  def initialize; end
end
module X2
  extension F2
    include M2
    def self.make -> Self = raise "ext"
  end
  class S2 < F2
    @x: Int
    def initialize(@x: Int); end
    def self.make -> Self = super
  end
  def self.f(t: Type[M2]) -> String
    t.make.class.name
  rescue
    "raised"
  end
  def self.h -> String
    S2.make.class.name
  rescue
    "raised"
  end
  def self.run -> Void
    puts "2 " + f(S2) + " " + h
  end
end
X2.run

module M3
  def self.make -> Self = new
end
class F3
  def initialize; end
end
extension F3
  include M3
  def self.make -> Self = raise "ext"
end
class S3 < F3
  @x: Int
  def initialize(@x: Int); end
  def self.make -> Self = new(1)
end
def f3(t: Type[M3]) -> String
  t.make.class.name
rescue
  "raised"
end
puts "3 " + f3(S3) + " " + S3.make.class.name
