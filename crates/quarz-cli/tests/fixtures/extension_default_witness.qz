# A module's default is the witness of a conformance through an
# extension when neither the extension nor the class has one, resolved
# for the receiver (#681): through `Type[M]` a subclass's own class method
# takes its place, as on the instance side (`D`).
module M
  def self.describe -> String = "M"
end
class C
end
extension C
  include M
end
class D < C
  def self.describe -> String = "D"
end
def h(t: Type[M]) -> String = t.describe
puts D.describe, h(D), h(C)

# A module a subclass includes does not take the place of a scoped
# extension's module's default through `Type[M2]`: the class object's
# dispatch order (#681) has no scoped extension's modules, so no include
# pair forms on the class side (on the instance side it does, #778).
module M2
  def self.describe -> String = "M2"
end
module Q2
  def self.describe -> String = "Q2"
end
class C2
end
module X2
  extension C2
    include M2
  end
  def self.h(t: Type[M2]) -> String = t.describe
  def self.run -> Void
    puts h(D2), D2.describe, h(C2)
  end
end
class D2 < C2
  include Q2
end
X2.run

# With the extension at the top level, its module is on the class object's
# dispatch order: the class side's include pairs take the instance side's
# candidate set (#733), so the subclass's own include (`Q3`) takes the
# place of the superclass's extension's module's class method (`M3`) for
# the subclass, as on the instance side.
module M3
  def self.describe -> String = "M3"
end
module Q3
  def self.describe -> String = "Q3"
end
class C3
end
extension C3
  include M3
end
def h3(t: Type[M3]) -> String = t.describe
class D3 < C3
  include Q3
end
puts h3(D3), D3.describe, h3(C3)
