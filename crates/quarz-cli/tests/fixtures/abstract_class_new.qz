# An abstract class's class method may call `new`: it builds the concrete
# subclass it runs on; through a `Type[J]` holding `J` itself it raises (#423).
abstract class J
  abstract def perform -> Void
  def self.run -> Void = new.perform
  def self.make -> Self = new
end
class W < J
  def perform -> Void = puts "w"
end
W.run
p W.make.class
def via(t: Type[J]) -> Void
  t.run
end
via(W)
begin
  via(J)
rescue TypeError => e
  puts "TypeError: #{e.message}"
end

# An abstract class with no subclass at all: the construction still goes
# through the run-time check.
abstract class Lone
  abstract def perform -> Void
  def self.run -> Void = new.perform
end
def via_lone(t: Type[Lone]) -> Void
  t.run
end
begin
  via_lone(Lone)
rescue TypeError => e
  puts "TypeError: #{e.message}"
end
