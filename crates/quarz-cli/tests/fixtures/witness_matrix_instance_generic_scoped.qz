end
class C30[U]
  def initialize; end
end
module X30
  extension C30[U]
    include M30[U]
    def m(x: U) -> String = "ext"
  end
  def self.up(x: C30[Int]) -> M30[Int] = x
  def self.via(x: M30[Int]) -> String = x.m(1)
  def self.direct(x: C30[Int]) -> String = x.m(1)
end
def via30(x: M30[Int]) -> String = x.m(1)
puts "generic/ext/ext/abstract/param/scoped: #{via30(X30.up(C30[Int].new))} #{X30.via(X30.up(C30[Int].new))} #{X30.direct(C30[Int].new)}"
