require "json"
require "time"

doc = JSON.parse('{"name": "quarz", "version": 1, "pi": 3.5, "tags": ["lang", "vm"], "ok": true, "none": null, "nested": {"a": [1, {"b": "é😀"}]}}')
p doc["name"].as_s, doc["version"].as_i, doc["pi"].as_f, doc["tags"][1].as_s
p doc["ok"].as_bool, doc["none"].null?, doc["nested"]["a"][1]["b"].as_s
p doc["missing"]?, doc["tags"].size, doc["tags"].as_a.map(&:as_s)
puts doc.to_json
puts JSON.pretty_generate(doc["nested"])
case doc
in JSON::Value::Object(members:) then puts members.keys.join(",")
else puts "not a map"
end

data Point = (x: Int, y: Int)
puts JSON.generate({ a: 1, "b" => [true, nil, 2.5], c: Point.new(x: 1, y: 2), d: :sym, e: "q\"\n" })
puts JSON.generate([]), JSON.generate({})
puts JSON.pretty_generate({ a: [], b: {}, c: [1, [2]] })

class Temp
  @celsius: Float

  def initialize(celsius: Float)
    @celsius = celsius
  end

  def to_json -> String = JSON.generate({ unit: "C", value: @celsius })
end
puts JSON.generate([Temp.new(21.5)])

enum Color
  variant Red
  variant Green
end
puts JSON.generate(Color::Red)
puts JSON.generate(Time.utc(2026, 1, 2, 3, 4, 5))

begin
  JSON.parse("{bad}")
rescue JSON::ParseError => e
  puts "parse error: #{e.message}"
end
begin
  JSON.parse("[1, 2")
rescue JSON::ParseError => e
  puts "parse error: #{e.message}"
end
begin
  JSON.parse("[" * 101 + "]" * 101)
rescue JSON::ParseError => e
  puts "parse error: #{e.message}"
end
begin
  JSON.generate(Float::NAN)
rescue JSON::GeneratorError => e
  puts "generator error: #{e.message}"
end
begin
  doc["name"].as_i
rescue TypeError => e
  puts "type error: #{e.message}"
end

p JSON.parse("1234567890123456789").as_i, JSON.parse("12345678901234567890").as_integer, JSON.parse("[12345678901234567890]").to_json, JSON.parse("-1.5e3").as_f, JSON.parse('"a\\tb"').as_s
p JSON.parse("[1,2,3]") == JSON.parse(" [1, 2, 3] ")
p JSON.parse("[1, null]")
p JSON::VERSION
