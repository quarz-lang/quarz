# An extension's include of `N`, which brings `M` that the class has by a
# superclass's own include: a top-level unconditional extension's modules
# are on the class side's dispatch, after the class's own includes and
# before its superclass, as on the instance side (#681). So `Type[M]`,
# `T <: M` and `Type[N]` all run `N.d`, over `Base`'s `M.d` and
# `Base2.d`.
module M
  def self.d -> String = "M"
end
module N
  include M
  def self.d -> String = "N"
  def self.only -> String = "N only"
end
class Base
  include M
end
class Base2
  include M
  def self.d -> String = "Base2"
end
class Num < Base
end
class Num2 < Base2
end
extension Num
  include N
end
extension Num2
  include N
end
def m(t: Type[M]) -> String = t.d
def n(t: Type[N]) -> String = "#{t.d} / #{t.only}"
def gm[T <: M](t: Type[T]) -> String = t.d
def gn[T <: N](t: Type[T]) -> String = t.d
puts m(Num), gm(Num), n(Num), gn(Num)
puts m(Num2), gm(Num2), n(Num2), gn(Num2)
