# Keyword-only parameters' names tell overloads apart, and an override
# replaces only the overload of its names.
class C
  def f(*, a: Int) -> String = "C#f(a: #{a})"
  def f(*, b: Int) -> String = "C#f(b: #{b})"
end

class D < C
  def f(*, b: Int) -> String = "D#f(b: #{b})"
end

x: C = D.new
puts x.f(a: 1)
puts x.f(b: 2)
puts D.new.f(a: 3)
puts C.new.f(b: 4)

# A data type's generated methods give way to the body's own.
data P(x: Int, y: Int)
  def to_s -> String = "P<#{x}, #{y}>"
  def with(*, x: Int) -> P = P.new(x, y + 100)
  def to_h -> Hash[Symbol, Object] = {x: x}
end

v = P.new(1, 2)
puts v
puts v.with(x: 5)
p v.to_h
p v.inspect

# A data type with its own `initialize`, held in a field: kept boxed,
# so a read gives the fields it set.
data Q(x: Int, y: Int)
  def initialize(s: Int)
    @x = s
    @y = s * 2
  end
end

class Box
  @q: Q
  def initialize(@q: Q); end
  def q -> Q = @q
end

q = Box.new(Q.new(3)).q
puts q.x + q.y
p q

# `with` builds its value through the body's `initialize` when it takes
# the fields, so what `initialize` checks holds for the copy too.
data Range2(lo: Int, hi: Int)
  def initialize(lo: Int, hi: Int)
    raise ArgumentError.new("lo > hi") if lo > hi
    @lo = lo
    @hi = hi
  end
end

r = Range2.new(1, 5)
p r.with(hi: 9)
begin
  r.with(lo: 7)
rescue ArgumentError => e
  puts "with: #{e.message}"
end

# Among overloads, `with` takes the `initialize` of the fields' types.
data Len(n: Int)
  def initialize(n: String)
    @n = n.size
  end
  def initialize(n: Int)
    @n = n * 10
  end
end
p Len.new(1).with(n: 2)

# An enum's methods replace the generated ones of its variants.
enum Shape
  variant Circle(radius: Float)
  variant Dot
  def to_h -> Hash[Symbol, Object] = {kind: "shape"}
end

s: Shape = Shape::Circle.new(2.0)
p s.to_h
p Shape::Circle.new(1.0).to_h
p Shape::Dot.to_h
