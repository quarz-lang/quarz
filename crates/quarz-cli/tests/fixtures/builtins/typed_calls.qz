# Methods whose parameters and result are declared Int/Float get a typed
# entry: direct calls pass machine values. An overflow in the callee
# raises through the typed frames, as deep recursion and exceptions do.
def mul(n: Int) -> Int = n * 1000000007
def half(x: Float) -> Float = x / 2.0
def mix(a: Int, b: Float, c: Int) -> Float = a.to_f + b + c.to_f
def deep(n: Int) -> Int = n == 0 ? 0 : 1 + deep(n - 1)
def boom(n: Int) -> Int
  raise "boom #{n}" if n > 2
  n
end
def grow(n: Int) -> Int
  x = n
  3.times { x = x * 100000 }
  x
end
class Acc
  var @total: Int
  def initialize; @total = 0; end
  def add(n: Int) -> Int
    @total += n
    @total
  end
  def scaled(k: Float) -> Float = @total.to_f * k
end
p mul(3), mul(10 ** 9), mul(mul(3)), half(5.0), half(1.0e308), mix(1, 2.5, 3)
begin
  p mul(mul(10 ** 9))
rescue OverflowError => e
  p e.class
end
p half(mix(2 ** 40, 0.5, 1))
p deep(1000), deep(5_000)
begin
  p deep(100_000_000)
rescue SystemStackError => e
  p "stack: #{e.class}"
end
begin
  boom(5)
rescue RuntimeError => e
  p e.message
end
p boom(1), grow(1), grow(2 ** 10) * 2
begin
  p grow(2 ** 40)
rescue OverflowError => e
  p e.class
end
a = Acc.new
p a.add(5), a.add(2 ** 61), a.add(2 ** 61), a.scaled(0.5), a.add(1)
begin
  a.add(2 ** 62)
rescue OverflowError
  p a.add(0)
end
def fact(n: Int) -> Int = n <= 1 ? 1 : n * fact(n - 1)
p fact(20)
begin
  p fact(21)
rescue OverflowError => e
  p e.class
end
def fib(n: Int) -> Int = n < 2 ? n : fib(n - 1) + fib(n - 2)
p fib(20), (1..10).to_a.map { |i| fib(i) }
