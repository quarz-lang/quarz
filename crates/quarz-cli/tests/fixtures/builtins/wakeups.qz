# A task waiting on several things is woken by one: what it was listed on
# elsewhere must not wake its next wait, nor keep a wake-up from a task
# waiting behind it. (The sleeps let the other tasks start waiting,
# on whatever worker.)

# A select woken by `a` was listed on `b` too: a send on `b` does not cut
# the task's next sleep short.
a = Channel[Int].new
b = Channel[Int].new(capacity: 1)
t = Task.spawn do
  Channel.select do |s|
    s.receive(a) { |v| p [:a, v] }
    s.receive(b) { |v| p [:b, v] }
  end
  t0 = Time.now
  sleep(150.ms)
  p Time.now - t0 >= 140.ms
end
sleep(20.ms)
a.send 1
sleep(30.ms)
b.send 2
t.await
p b.receive

# A receiver waiting on `d` behind such a select is woken by a send there.
c = Channel[Int].new
d = Channel[Int].new
u = Task.spawn do
  Channel.select do |s|
    s.receive(c) { |v| p [:c, v] }
    s.receive(d) { |v| p [:d, v] }
  end
end
w = Task.spawn { p [:w, d.receive] }
sleep(20.ms)
c.send 1
u.await
sleep(20.ms)
d.send 2
w.await

# A receiver cancelled after a sender chose it passes the value on.
e = Channel[Int].new(capacity: 1)
r1 = Task.spawn { e.receive }
r2 = Task.spawn { p [:r2, e.receive] }
sleep(20.ms)
r1.cancel
e.send 3
r2.await

# A sleep cancelled leaves no timer behind to wake the next one early
# (the next one uncancellable: a cancelled task's waits raise).
x = Task.spawn do
  begin
    sleep(50.ms)
  rescue Task::Cancelled
    t0 = Time.now
    Task.uncancellable { sleep(150.ms) }
    p Time.now - t0 >= 140.ms
  end
end
sleep(20.ms)
x.cancel
x.await

# Nor does an await cancelled: the awaited task finishing later does not
# wake the next wait.
slow = Task.spawn { sleep(50.ms); 1 }
y = Task.spawn do
  begin
    slow.await
  rescue Task::Cancelled
    t0 = Time.now
    Task.uncancellable { sleep(150.ms) }
    p Time.now - t0 >= 140.ms
  end
end
sleep(20.ms)
y.cancel
y.await
p slow.await

# A task cancelled before it starts does not run its block.
z = Task.spawn { puts "z ran"; 0 }
z.cancel
begin
  z.await
rescue Task::Cancelled
  puts "z cancelled before it started"
end

# Cancelling a task waiting in Task.timeout cancels the block.
log = Channel[String].new(capacity: 1)
v = Task.spawn do
  Task.timeout(10.seconds) do
    begin
      sleep(5.seconds)
    ensure
      Task.uncancellable { log.send "block ended" }
    end
  end
end
sleep(20.ms)
v.cancel
begin
  v.await
rescue Task::Cancelled
  puts "v cancelled"
end
t0 = Time.now
p log.receive, Time.now - t0 < 1.seconds
