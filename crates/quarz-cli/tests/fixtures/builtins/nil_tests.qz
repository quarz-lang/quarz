# `x.nil?` is a test of the value (IsNil): no class can define its own
# `nil?`, so the answer is the same whatever the receiver's type.
class Plain
end

def count_nils(xs: Array[Object]) -> Int
  n = 0
  xs.each { |x| n += 1 if x.nil? }
  n
end

def count_missing(xs: Array[Int?]) -> Int
  n = 0
  xs.each { |x| n += 1 if x.nil? }
  n
end

p count_nils([1, nil, Plain.new, "a", nil])
p count_missing([1, nil, 3, nil, nil])
v: Int? = nil
s: String? = "x"
p v.nil?, s.nil?, 3.nil?, Plain.new.nil?
