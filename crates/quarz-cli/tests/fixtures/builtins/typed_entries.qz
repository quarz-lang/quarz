# Typed functions that may return without needing a frame get a
# separate entry; leaving that part (a call, an overflow, a type that
# is not the declared one) runs the full body from the start.
def tak(x: Int, y: Int, z: Int) -> Int
  return z if y >= x
  tak(tak(x - 1, y, z), tak(y - 1, z, x), tak(z - 1, x, y))
end
p tak(18, 12, 6)

# The leaf path may overflow: the body runs it again and raises.
def grow(x: Int, n: Int) -> Int
  return x * 4611686018427387903 if n == 0
  grow(x + 1, n - 1)
end
p grow(1, 0), grow(-2, 1)
begin
  p grow(1, 3)
rescue OverflowError => e
  p e.class
end

# Floats, and a leaf that divides.
def halve(x: Float, n: Int) -> Float
  return x / 2.0 if n <= 0
  halve(x * 3.0, n - 1) + 1.0
end
p halve(1.0, 4)

def safe_div(a: Int, b: Int) -> Int
  return a / b if b != 0
  safe_div(a, b + 1)
end
p safe_div(7, 0), safe_div(-9, 2)
def div_or_recurse(a: Int, b: Int, n: Int) -> Int
  return a / b if n == 0
  div_or_recurse(a, b, n - 1)
end
begin
  p div_or_recurse(5, 0, 2)
rescue ZeroDivisionError => e
  puts "rescued #{e.class}"
end

# Deep recursion still reaches the stack check (in the body).
def depth(n: Int) -> Int
  return 0 if n == 0
  1 + depth(n - 1)
end
p depth(10_000)
def forever(n: Int) -> Int
  return n if n < 0
  forever(n + 1) + 1
end
begin
  forever(0)
rescue SystemStackError
  puts "stack overflow caught"
end
