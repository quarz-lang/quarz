# HTTP::Server over sockets: keep-alive, pipelining, chunked bodies both
# ways, HEAD, HTTP/1.0, errors, limits, 100-continue, timeouts.
require "http"

def raw(port: Int, text: String) -> String
  Socket.tcp("127.0.0.1", port) do |s|
    s.write(text)
    out = String::Builder.new
    loop do
      part = s.readpartial?(4096)
      break if part.nil?
      out << part
    end
    out.to_s.gsub(/Date: [^\r]*\r\n/, "").gsub("\r\n", "|")
  end
end

handler = HTTP.handler do |req|
  case req.path
  when "/echo" then HTTP::Response.text("#{req.method} #{req.body.read}")
  when "/boom" then raise "kaboom"
  when "/teapot" then raise HTTP::Error.new(418, "short and stout")
  when "/stream"
    HTTP::Response.stream do |w|
      3.times { |i| w.write("part#{i};") }
    end
  else HTTP::Response.text("hello #{req.path} #{req.query_params}")
  end
end
errors = Channel[String].new(capacity: 8)
report: shareable (Exception, HTTP::Request?) -> Nil = ->(e: Exception, r: HTTP::Request?) { errors.send("#{e.message} #{r ? r.path : "-"}"); nil }
server = HTTP::Server.new(handler, host: "127.0.0.1", port: 0, on_error: report, idle_timeout: 300.ms,
                          max_body_bytes: 10, max_header_bytes: 200, read_header_timeout: 300.ms)
port = server.local_address.port
Task.scope do |scope|
  scope.spawn { server.serve }
  puts raw(port, "GET /hi?a=1 HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
  # Two requests on one connection, the second pipelined after the first.
  puts raw(port, "POST /echo HTTP/1.1\r\nContent-Length: 3\r\n\r\nabcGET /second HTTP/1.1\r\nConnection: close\r\n\r\n")
  puts raw(port, "GET /boom HTTP/1.1\r\nConnection: close\r\n\r\n")
  p errors.receive
  puts raw(port, "GET /teapot HTTP/1.1\r\nConnection: close\r\n\r\n")
  puts raw(port, "GET /stream HTTP/1.1\r\nConnection: close\r\n\r\n")
  puts raw(port, "HEAD /stream HTTP/1.1\r\nConnection: close\r\n\r\n")
  puts raw(port, "GET /stream HTTP/1.0\r\n\r\n")
  puts raw(port, "GET /x HTTP/1.0\r\nConnection: keep-alive\r\n\r\nGET /y HTTP/1.0\r\n\r\n")
  puts raw(port, "BROKEN\r\n\r\n")
  # Kept alive, then closed after idle_timeout.
  puts raw(port, "GET /k HTTP/1.1\r\n\r\n")
  puts raw(port, "POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n3\r\nabc\r\n0\r\n\r\n")
  puts raw(port, "POST /echo HTTP/1.1\r\nContent-Length: 20\r\n\r\n01234567890123456789")
  puts raw(port, "GET / HTTP/1.1\r\nX: #{"a" * 300}\r\n\r\n")
  # 100 Continue is sent when the handler reads the body.
  puts raw(port, "POST /echo HTTP/1.1\r\nExpect: 100-continue\r\nContent-Length: 3\r\nConnection: close\r\n\r\nabc")
  # Not read: the connection is closed after the response, not drained.
  puts raw(port, "POST / HTTP/1.1\r\nExpect: 100-continue\r\nContent-Length: 3\r\n\r\n")
  # Headers that never end: closed after read_header_timeout.
  p raw(port, "GET / HTTP/1.1\r\nX: 1\r\n")
  server.shutdown
end
