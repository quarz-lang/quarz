# A constant initialized by a literal is the literal at its uses; a chain
# of `+` on strings is built in one buffer like an interpolation.
N = 100
RATE = 2.0
PI = 3.5
NAME = "quarz"
ON = true
TAG = :tag
TWICE = N * 2
GREETING = "hi #{NAME}"
p N + 1, RATE * 2.0, PI, NAME + "!", ON, TAG, TWICE, GREETING
def f(i: Int) -> String
  "f#{i}"
end
# Operands are evaluated left to right.
def tick(s: String) -> String
  puts "tick #{s}"
  s
end
a = "alpha"
b = "beta"
p a + b + "gamma", a + b + "gamma" + "delta" + "epsilon", (a + b) + (b + a), a + (b + "x"), a + b
r = tick("1") + tick("2") + tick("3")
p r
p "pre " + f(1) + " mid " + f(2) + " post", "#{a + b + "c"}!", [a, b].map { |s| s + "-" + s + "-" }.to_a
long = "a very long string that is well past fifteen bytes"
p long + a + long, (long + a + long).size
x = a + b + "" 
p x, x == "alphabeta", x.equal?(x)
