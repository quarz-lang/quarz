# Int, Float, Math, Comparable#clamp and Random: the methods added in the
# second batch. Expected output in numbers.out.
p Int.sqrt(17), Int.sqrt(10**40), 7.fdiv(2), 7.fdiv(2.0), 7.ceildiv(2), -7.ceildiv(2), 2.pow(10), 2.pow(10, 1000)
p 255.digits(16), 0.digits, 1234.floor(-2), 1250.round(-2), -1250.round(-2), 1234.ceil(-2), -1234.ceil(-2), -1234.truncate(-2), 1234.round(2)
p 5[0], 5[1], 5[2], 5[-1], 6.allbits?(6), 6.allbits?(7), 6.anybits?(1), 6.nobits?(1), 5.bit_set?(2), 3.integer?, 3.ord
p 3.upto(5).to_a, 5.downto(3).to_a, 1.step(10, 3).to_a, 1.step(10, 3).map { |x| x * 2 }
p 7.5.divmod(2), -7.5.divmod(2), 7.5.divmod(2.5), 7.5.fdiv(2), 1.0.integer?
p 1.2345.floor(2), 1.2345.ceil(2), -1.2345.truncate(2), 1234.5.floor(-2), 1.0.next_float > 1.0, 1.0.prev_float < 1.0
steps = Array::Builder[Float].new
1.0.step(2.0, 0.5) { |x| steps << x }
p steps.to_a
p Float::EPSILON, Float::MAX, Float::MIN, Float::DIG, Float::INFINITY, -Float::INFINITY
p Math.asin(1.0).round(4), Math.acos(1.0), Math.sinh(0.0), Math.cosh(0.0), Math.tanh(0.0), Math.asinh(0.0), Math.acosh(1.0), Math.atanh(0.0), Math.log1p(0.0), Math.expm1(0.0)
p 15.clamp(1..10), -5.clamp(1..10), 5.clamp(1..10), 5.clamp(1..), 5.clamp(..3), "m".clamp("a".."f")
begin
  5.clamp(1...10)
rescue ArgumentError => e
  puts "error: #{e.message}"
end
r = Random.new(42)
p r.seed, r
a = r.rand(100)
b = r.rand
c = r.rand(1..6)
d = r.rand(2.5)
f = r.rand(1.0..2.0)
r2 = Random.new(42)
p [a, b, c, d, f] == [r2.rand(100), r2.rand, r2.rand(1..6), r2.rand(2.5), r2.rand(1.0..2.0)]
p a >= 0 && a < 100, b >= 0.0 && b < 1.0, c >= 1 && c <= 6, d < 2.5, f >= 1.0 && f <= 2.0
p r.bytes(5).size, Random.bytes(3).size, Random.rand(10) < 10, Random.new_seed != Random.new_seed, Random.new.seed != Random.new.seed
p r == r, r == r2
srand(7)
x = rand(1000)
srand(7)
p x == rand(1000), rand(1..3) <= 3, rand(0.5) < 0.5, rand(1.5..2.0) >= 1.5, srand(1) == 7
rolls = 1000.times.map { r.rand(1..6) }
p rolls.min, rolls.max, rolls.uniq.sort
shuffled = [1, 2, 3, 4, 5].shuffle
p shuffled.sort, [1, 2, 3].sample.nil?
begin
  rand(0)
rescue ArgumentError => e
  puts "error: #{e.message}"
end
begin
  Int.sqrt(-1)
rescue ArgumentError => e
  puts "error: #{e.message}"
end
p NoMemoryError.new("x").is_a?(Exception), FloatDomainError.new("x").is_a?(RangeError)
# bit_length: the bits past the sign (a negative number counts ~n's).
p [0, 255, 256, -1, -256, -257, 9223372036854775807].map(&:bit_length)
p (2 ** 70).bit_length, (2 ** 70 - 1).bit_length, (-(2 ** 70)).bit_length, (-(2 ** 70) - 1).bit_length
