# Fields declared Int, Float or Bool are stored as machine words; what a
# word cannot hold (the smallest Int, nil before the field is assigned)
# is kept aside. Every way of reading and writing a field must see the
# same values. An Integer field holds its value as any other.
require "json"

class Cell
  var @n: Int
  var @x: Float
  var @on: Bool
  var @tag: String
  attr_reader :n, :x, :on
  def initialize(@n: Int, @x: Float, @on: Bool, @tag: String); end
  def set(n: Int, x: Float, on: Bool) -> Nil
    @n = n
    @x = x
    @on = on
    nil
  end
  def grow -> Nil
    @n = @n * 4611686018427387904
    nil
  end
  def least -> Nil
    @n = -9223372036854775807 - 1
    nil
  end
  def to_s -> String = "#{@tag}(#{@n}, #{@x}, #{@on})"
end

c = Cell.new(1, 2.5, true, "c")
puts c
# The smallest Int, kept aside, through compiled and interpreted code;
# an overflow leaves the field as it was.
c.grow
puts c
begin
  c.grow
rescue OverflowError => e
  p e.class
end
puts c
c.least
puts c
c.set(-9223372036854775807 - 1, -0.0, false)
puts c
p c.n, c.n + 1
c.set(7, 0.0 / 0.0, true)
p c.x.nan?, c.on
c.set(9223372036854775807, 1.0e308 * 10.0, false)
puts c

# Structural equality, hashing, `with`, `to_h`, JSON and patterns.
data Point = (i: Int, f: Float, b: Bool)
a = Point.new(-9223372036854775807 - 1, 1.5, true)
b = Point.new(-9223372036854775807 - 1, 1.5, true)
p a == b, a.hash == b.hash, [a, b].uniq.size
p Point.new(1, 0.0, false) == Point.new(1, -0.0, false)
p a.with(i: 3), a.with(f: -2.0).f, a.to_h
p JSON.generate(Point.new(4, 0.5, false).to_h)
case a
in Point(i:, f:, b: true) then p i, f
else p "no"
end
h = { Point.new(1, 1.0, true) => "one" }
p h[Point.new(1, 1.0, true)]

# Held in place in another object.
class Body
  var @at: Point
  var @mass: Float
  def initialize(@at: Point, @mass: Float); end
  def at -> Point = @at
  def move(di: Int) -> Nil
    @at = @at.with(i: @at.i + di)
    @mass = @mass + 0.5
    nil
  end
  def to_s -> String = "#{@at} #{@mass}"
end
body = Body.new(Point.new(-9223372036854775807, 2.0, true), 1.0)
body.move(-1)
puts body
body.move(1)
puts body
p body.at.i

# An Integer field.
data Big = (n: Integer, tag: String)
g = Big.new(2.to_integer ** 100, "g")
p g, g.n + 1, g == Big.new(2.to_integer ** 100, "g"), g.with(n: 5.to_integer).n.class

# Across tasks: copied to the task, and back as its result.
t = Task.spawn { Point.new(-9223372036854775807 - 1, 3.25, false) }
p t.await

# Released with `deinitialize`: the rebuilt object has the same fields.
class Probe
  @n: Int
  @x: Float
  @b: Bool
  def initialize(@n: Int, @x: Float, @b: Bool); end
  def deinitialize
    puts "deinitialize #{@n} #{@x} #{@b}"
  end
end
def probe -> Nil
  q = Probe.new(-9223372036854775807 - 1, 0.125, true)
  r = Probe.new(5, -1.0, false)
  puts "probing"
  nil
end
probe
puts "done"
