# `x = x.push(v)` on a local, a captured variable and a field appends in
# place when the array is unshared; numbers that are equal hash alike.
class Bag
  var @items: Array[Int]
  var @names: Array[String]
  attr_reader :items, :names
  def initialize; @items = []; @names = []; end
  def add(x: Int) -> Nil
    @items = @items.push(x)
    @names = @names.push(x.to_s)
  end
  def add_twice(x: Int) -> Array[Int]
    @items = @items.push(x)
    @items = @items.push(x)
  end
end
b = Bag.new
5.times { |i| b.add(i) }
p b.items, b.names, b.add_twice(9)
# a captured variable (real closure) is a frame slot
acc: Array[Int] = []
f = -> (x: Int) { acc = acc.push(x) }
f.(1); f.(2)
p acc
# a shared array is copied, the alias keeps the old value
xs = [1, 2]
ys = xs
xs = xs.push(3)
p xs, ys
zs: Array[Object] = [1]
zs = zs.push(2.5)
zs = zs.push("s")
p zs
r = xs.push(4)
p r, xs
big = [1]
big = big.push(2 ** 70)
p big
h = { 1 => "a", 2.0 => "b", 3 => "c" }
p h[1.0], h[2], h[3.0], h.size, { 1 => 1 } == { 1.0 => 1 }
hb: Hash[Object, Int] = {}
hb = hb.put(2 ** 70, 1).put(1.5, 2).put(-7, 3).put(1e300, 4)
p hb[2 ** 70], hb[1.5], hb[-7], hb[1e300], hb.size
s = Set.new([1, 1.0, 2])
p s.size
