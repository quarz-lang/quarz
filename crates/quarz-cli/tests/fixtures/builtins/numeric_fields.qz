# Fields declared Int/Float are read unboxed by compiled code; a value
# the field's word cannot hold (the smallest Int, kept aside) sends the
# read to the interpreter.
class Counter
  var @n: Int
  var @f: Float
  attr_reader :n, :f
  def initialize(@n: Int, @f: Float); end
  def bump -> Int
    @n = @n + 1
    @n
  end
  def scaled -> Float
    @f * 2.0 + @n
  end
end
c = Counter.new(2 ** 62, 1.5)
p c.bump, c.bump, c.bump
p c.scaled
d = Counter.new(1, 0.25)
p d.bump, d.scaled
data P(a: Int, b: Float)
  def sum -> Float = a + b
end
p P.new(-9223372036854775807 - 1, 0.5).sum, P.new(3, 0.5).sum
