# Loops and ranges that reach the last or first `Int` stop there.
max = 9223372036854775807
min = -max - 1

(max - 2..max).each { |i| puts(i) }
(max - 1..).each { |i| puts(i) }
p((max - 1..max).to_a)
p((max - 1..max).size)
(max - 1).upto(max) { |i| puts(i) }
(min + 1).downto(min) { |i| puts(i) }
(max - 5).step(max, 3) { |i| puts(i) }
(min + 5).step(min, -3) { |i| puts(i) }
(max - 4..).step(2) { |i| puts(i) }
(max - 1..max).reverse_each { |i| puts(i) }
p((min...min).to_a)
p((min..min + 1).to_a)
p([1, 2, 3][1..max])
p("abc"[1..max])
p(""[0...min])
x = rand(min..max)
p(x.is_a?(Int))
p(rand(max..max))
p(rand(min..min))
begin
  (0...min).last
rescue OverflowError
  puts("OverflowError")
end
e = (max - 1..).each
p([e.next, e.next])
begin
  e.next
rescue StopIteration
  puts("stop")
end
(5..6).each_with_index { |x, j| puts("#{x} #{j}") }
(max - 1..max).each_with_index { |x, j| puts("#{x} #{j}") }
