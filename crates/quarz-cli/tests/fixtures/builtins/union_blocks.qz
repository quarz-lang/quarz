# A block checked once per type of what it is given: an operation whose
# methods differ by type is not compiled as the last check's.
def pk(i: Int) -> Array[Int] | Array[Float] = i > 0 ? [1, 2] : [1.5]
pk(0).each { |x| p(1 + x) }
pk(1).each { |x| p(1 + x) }
pk(0).each { |x| p(2 ** x) }
pk(0).each { |x| p(7 % x) }
pk(0).each { |x| p(1 < x) }
pk(0).each { |x| p(1 == x) }
pk(0).each { |x| p(3.0 + x) }
pk(0).each { |x| p([1, 2].first(x.to_i)) }
p pk(1).map { |x| x + 1 }, pk(0).map { |x| x * 2 }

# Inlined iteration, string `+` chains, in-place `!` and `x = x.f` updates,
# array element reads and loops: none taken for the last check's types.
class Foo
  def times(&blk: (Int) -> Nil) -> Int
    blk.call(42)
    7
  end
  def +(o: String) -> String = "foo:" + o
end
def pt(i: Int) -> Array[Foo] | Array[Int] = i > 0 ? [2] : [Foo.new]
pt(0).each { |x| x.times { |i| p(i) } }
pt(1).each { |x| x.times { |i| p(i) } }
def ps(i: Int) -> Array[Foo] | Array[String] = i > 0 ? ["s"] : [Foo.new]
ps(0).each { |x| p(x + "a" + "b") }
ps(1).each { |x| p(x + "a" + "b") }
def pr(i: Int) -> Array[String] | Array[Array[Int]] = i > 0 ? [[1, 2]] : ["ab"]
pr(0).each { |x| y = x; y.reverse!; p(y) }
pr(1).each { |x| y = x; y.reverse!; p(y) }
def pd(i: Int) -> Array[Set[Int]] | Array[Array[Int]] = i > 0 ? [[1, 2]] : [Set.new([1, 2])]
pd(1).each { |x| y = x; y = y.delete(1); p(y) }
pd(0).each { |x| y = x; y = y.delete(1); p(y) }
def pw(i: Int) -> Array[Array[Float]] | Array[Array[Int]] = i > 0 ? [[1, 2]] : [[1.5]]
pw(1).each { |x| p(x[0] + 1) }
pw(0).each { |x| p(x[0] + 1) }
pw(1).each { |x| x.each { |y| p(y) } }
pw(0).each { |x| p(x.map { |y| y }) }

# A field a generic superclass declares keeps its layout in a subclass
# that gives it a type argument.
class Box[T]
  @v: T
  var @n: Int = 5
  def initialize(@v: T); end
  def v -> T = @v
  def n -> Int = @n
end
class Sub < Box[Int]
  @w: Float = 2.5
  def w -> Float = @w
  def sum -> Int = v + n
end
s = Sub.new(1)
p s.v, s.n, s.w, s.sum

# `!` of a type that has its own and of Bool; `&:name` resolved to
# different methods per member.
class Neg
  def ! -> String = "neg"
end
def pn(i: Int) -> Array[Neg] | Array[Bool] = i > 0 ? [true] : [Neg.new]
pn(1).each { |x| p(!x) }
pn(0).each { |x| p(!x) }
class Ma
  def hi -> String = "ma"
end
class Mb
  def hi -> String = "mb"
end
def pm(i: Int) -> Array[Array[Ma]] | Array[Array[Mb]] = i > 0 ? [[Mb.new]] : [[Ma.new]]
pm(0).each { |x| p x.map(&:hi) }
pm(1).each { |x| p x.map(&:hi) }
def pu(i: Int) -> Array[Ma] | Array[Mb] = i > 0 ? [Mb.new] : [Ma.new]
p pu(0).map(&:hi), pu(1).map(&:hi)

# `!` on a union whose members each have their own; `&&` of two types'
# own methods (called by name); an overload whose check is thrown away
# leaves no `&&` behind.
class NA
  def ! -> String = "a"
  def &&(&blk: () -> Bool) -> String = "NA&&"
end
class NB
  def ! -> String = "b"
  def &&(&blk: () -> Bool) -> String = "NB&&"
end
def nu(i: Int) -> NA | NB = i > 0 ? NB.new : NA.new
[1, 0].each { |i| x = nu(i); p(!x) }
def nl(i: Int) -> Array[NA] | Array[NB] = i > 0 ? [NB.new] : [NA.new]
nl(0).each { |x| p(x && true) }
nl(1).each { |x| p(x && true) }
class K
  def run(&blk: (NA) -> String) -> String = "na #{blk.call(NA.new)}"
  def run(&blk: (Bool) -> Bool) -> String = "bool #{blk.call(true)}"
end
p K.new.run { |x: NA| x && false }
