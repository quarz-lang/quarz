# A shared exception keeps the backtrace of its first raise.
Boom = RuntimeError.new("boom")
def fail_once -> Void
  raise Boom
end
lines = (1..2).map do |_|
  Task.spawn do
    begin
      fail_once
      ""
    rescue => e
      e.backtrace.first
    end
  end
end.map(&:await)
p lines[0] == lines[1], Boom.message
