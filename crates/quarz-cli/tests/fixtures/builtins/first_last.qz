# `first`/`last` as in Ruby: a range's bounds, included or not, and
# ArgumentError for a negative count.
p((1..3).first, (1..3).last)
p((1...3).last, (0...0).last, (3..1).first, (1.0...2.5).last)
p(("a"..."c").last)
begin
  (1..).last
rescue RangeError => e
  puts("RangeError: #{e.message}")
end
begin
  (..3).first
rescue RangeError => e
  puts("RangeError: #{e.message}")
end
p((..3).last, (1..).first)
p((1...3).max, (1...3).last(2))

def neg(name: String, &: () -> Array[Int]) -> Nil
  p(yield)
rescue ArgumentError => e
  puts("#{name}: ArgumentError: #{e.message}")
end
neg("Array#first") { [1, 2].first(-1) }
neg("Array#last") { [1, 2].last(-1) }
neg("Array#take") { [1, 2].take(-1) }
neg("Enumerable#first") { (1..3).first(-1) }
neg("Enumerable#take") { (1..).take(-1) }
neg("Range#last") { (1..3).last(-1) }
neg("Builder#first") { Array.build { |b| b << 1; b.first(-1) } }
neg("Builder#last") { Array.build { |b| b << 1; b.last(-1) } }
neg("zero") { [1, 2].first(0) + [1, 2].last(0) + (1..).first(0) }
neg("min") { [3, 1].min(-1) }
neg("max") { [3, 1].max(-1) }
neg("Enumerable#drop") { (1..3).drop(-1) }
p([3, 1, 2].min(2), [3, 1, 2].max(2), (1..3).drop(1))
begin
  (1..).last(2)
rescue RangeError => e
  puts("RangeError: #{e.message}")
end
