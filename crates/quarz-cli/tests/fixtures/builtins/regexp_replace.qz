# Replacement strings as Ruby reads them, and the MatchData a two-parameter
# block of sub/gsub/scan receives.
p "ab-cd".gsub(/(\w)(\w)/, "\\2\\1"), "ab".gsub(/(a)/, "\\1x")
p "ab".gsub(/(?<x>a)/, "\\k<x>!"), "ab".gsub(/a/, "[\\0]"), "ab".gsub(/a/, "[\\&]")
p "abc".sub(/b/, "<\\`|\\'>"), "a".sub(/a/, "\\\\"), "a".sub(/a/, "\\q"), "ab".sub(/(x)?a/, "[\\1]")
# A String pattern too; an empty one matches between characters.
p "ab".sub("a", "[\\0]"), "abc".gsub("", "-"), "äö".gsub("", "-")
begin
  "x".sub(/(?<x>x)/, "\\k<y>")
rescue => e
  p e.message
end
# Blocks: the match, then its MatchData.
p "ab".gsub(/(a)/) { |m| m.upcase }, "hello".gsub(/l/, &:upcase)
p "k=v, a=b".gsub(/(\w)=(\w)/) { |s, m| "#{m[2]}=#{m[1]}(#{s})" }
p "k=v, a=b".sub(/(?<k>\w)=(?<v>\w)/) { |_, m| "#{m["v"]}<-#{m["k"]} #{m.post_match.inspect}" }
# scan without a block gives the whole matches; with one, also the groups.
p "k=v, a=b".scan(/(\w)=(\w)/)
"k=v, a=b".scan(/(\w)=(\w)/) { |s, m| p [s, m[1], m[2], m.begin(0)] }
"one two".scan(/\w+/) { |w| p w }
# Empty matches, as Ruby finds them: one may follow a match where it ends.
p "abc".gsub(/b*/, "-"), "abc".scan(/b*/), "héllo".gsub(/l*/, "-")
# A MatchData shows as its match, inspected as itself.
"k=v".scan(/(\w)=(\w)/) { |_, m| puts "#{m} #{m.inspect}" }
# A block that does not require two parameters gets the match only.
"ab".scan(/b/) { |*xs| p xs }
"ab".scan(/b/) { |a, *xs| p [a, xs] }
begin
  "a".sub(/(?<n>a)/, "\\k<n")
rescue => e
  p e.message
end
# Every match with its groups.
ms = "k=v, a=b".matches(/(?<k>\w)=(\w)/)
p ms.map { |m| [m.to_s, m["k"], m[2], m.begin(0)] }, "abc".matches(/x/), "abc".matches(/b*/).map(&:to_s)
# begin/end: nil for a group that took no part.
m = "ab".match(/(a)(x)?/)
if m
  p m.begin(1), m.end(1), m.begin(2)
  begin
    m.begin(3)
  rescue => e
    p e.message
  end
end
# ^ and $ match at each line, \A and \z at the text's ends; m lets . match a newline.
p "x\ny".scan(/^./), "x\ny".scan(/.$/), "x\ny".gsub(/^/, "> "), "x\ny".scan(/\A./), "x\ny" =~ /x.y/, "x\ny" =~ /x.y/m
# As in Ruby, ^ does not match after a newline that ends the text.
p "a\nb\n".gsub(/^/, "> "), "a\n\n".scan(/^$/).size, "a\n" =~ /^$/, "a\n".gsub(/$/, "!"), "a\n".gsub(/\z/, "!")
# split as Ruby splits: no empty field before an empty match where a field
# starts, a separator's groups after the field, limits.
p "abc".split(//), "abc".split(/b*/), "a\nb\n".split(/^/), "a-b,c".split(/(-)|(,)/), "a,b,,".split(/,/, -1), "a,b,,".split(/,/, 2), "a\n".split(/^/, -1)
# rindex and rpartition find the last position a match starts at.
p "aaa".rindex(/aa/), "a\nb\n".rindex(/^/), "aaa".rpartition(/aa/), "a\n".rpartition(/^/)
# Groups of an empty match at the end; Ruby's inline m.
p "a\n".matches(/(^)|(\z)/).map(&:captures), "a\nb" =~ /a(?m:.)b/, "a\nb" =~ /a(?-m:.)b/
# rindex/rpartition try each position from the right; past the end, the end.
p ("a" * 1000).rindex(/a+/), "".rindex(/\A/, 1), "abc".rindex(/b/, 10)
# With a named group, plain groups do not capture; POSIX classes are Unicode;
# an extended-mode comment is a comment.
p "ab,b".split(/(?<n>a)(b)?/), "a,".gsub(/(?<n>.)(?<m>,)/, "<\\0|\\1>"), "日本 語x1".scan(/[[:alpha:]]+/), "ab1 x" =~ /b # [ comment
  \h/x
p "<a>b".match(/[(?<]a>(b)/).to_a, "「a」!$+".scan(/[[:punct:]]/), "a b#" =~ /a[ ]b[#]/x, "g1".scan(/\H/)
# Extended mode is scoped as Ruby scopes it; \H in a class; [[:]].
p "a#f" =~ /(?x:a)#\h/, "a#f" =~ /(?x)a(?-x)#\h/, "a#(b)c".match(/(?x:a)#\((b)\)(?<n>c)/).to_a, "g" =~ /[\H]/, "x:]".match(/[[:]]+/).to_s
p "\a\b\e\f\v\x01\x7f"
p :"a\x01b", "\u0085", "aé" =~ Regexp.new("a\\é")
# A `/` in the source is escaped in the literal shown.
p(%r{a/b}, /a\/b\/c/i, %r{a\/b})
p(%r{a/b} == /a\/b/)
puts(%r{a/b}.to_s, "#{%r{a/b}}")
