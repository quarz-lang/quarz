# `x.foo!(args)` is sugar for `x = x.foo(args)` when the receiver's type
# has no `foo!`: the variable or field is rebound to the result; nothing
# else that refers to the old value changes. A real `foo!` (a mutating
# method of a builder) is called as usual.
xs = [3, 1, 2]
ys = xs
xs.push!(4)
xs.sort!
p xs, ys
s = "  hello "
s.strip!.upcase!
p s
h: Hash[String, Int] = {}
"a b a c a".split(" ").each { |w| h.put!(w, (h[w]? || 0) + 1) }
p h
set: Set[Int] = Set.new
set.add!(1).add!(2)
p set.to_a.sort
n = 10
n.succ!
p n
p (xs.reverse!).first, xs
def bump(k: Int) -> Int
  k.succ!
  k * 2
end
p bump(4)

class Bag
  var @items: Array[String] = []
  var @count: Int = 0
  def add(s: String) -> Nil
    @items.push!(s)
    @count.succ!
  end
  def items -> Array[String] = @items
  def count -> Int = @count
end
b = Bag.new
b.add("x")
b.add("y")
p b.items, b.count

# the value of the expression is the new value
total = 0
r = total.succ!
p r, total
# a builder's own `!` method still mutates in place (an alias sees it)
ab = Array::Builder[Int].new
ab << 2 << 1
alias_b = ab
ab.sort!
p alias_b.to_a
# in a loop body lowered in place, and on a captured variable
acc: Array[Int] = []
(1..3).each { |i| acc.push!(i * i) }
p acc
counter = 0
f = -> { counter.succ! }
f.()
f.()
p counter
