# Annotated block parameters; a union goes in parentheses, as `|` closes them.
[1, 2].each { |x: Int| puts x + 1 }
[1, 2].each do |x: Int|
  puts x * 2
end
h = {"a" => 1}
h.each { |k: String, v: Int| puts "#{k}=#{v}" }
[1, 2].map { |x: Int| x.to_s }.each { |s| puts s }
f = ->(x: Int) { x + 1 }
p f.(1)
[1, "a"].each { |v: (Int | String)| p v }
g = [[1, 2]].map { |a: Array[Int | String]| a.size }
p g
[3].each { |x: Int?| p x }
