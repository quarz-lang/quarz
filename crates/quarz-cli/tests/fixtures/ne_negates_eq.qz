# #795: `x != y` on a `String` (and a `Bytes`) is the negation of its
# `==`, rewritten so by the lowering where every receiver runs `Object#!=`
# and that `==`; other receivers keep the call. The expected output
# follows the rule: `!=` is not `==`, by bytes.

def mk(cs: Array[String]) -> String = cs.join

s = mk(Array[String].new)
p s != "", "" != s
s = mk(["x"])
p s != "", "" != s
s = mk(["a"])
p s != "a", "a" != s
s = mk(["b"])
p s != "a", "a" != s
s = mk(["b"])
p s != "a", "a" != s
s = mk(Array[String].new)
p s != "a", "a" != s
s = mk(["a", "x"])
p s != "a", "a" != s
s = mk(["a", "b"])
p s != "ab", "ab" != s
s = mk(["b", "b"])
p s != "ab", "ab" != s
s = mk(["a", "c"])
p s != "ab", "ab" != s
s = mk(["a"])
p s != "ab", "ab" != s
s = mk(["a", "b", "x"])
p s != "ab", "ab" != s
s = mk(["a", "b", "c"])
