w: String | Int = mk(["a"])
p w != "a", w != "b"

class Loose
  @v: Int
  def initialize(@v: Int); end
  def ==(other: Object) -> Bool = other.is_a?(Loose) && other.as(Loose).v % 10 == @v % 10
  def v -> Int = @v
  def hash -> Int = @v % 10
end
a = Loose.new(3)
x: Object = Loose.new(13)
p a != Loose.new(13), a != Loose.new(4), x != a

def mb(s: String) -> Bytes = s.to_bytes
b = mb("abc")
p b != mb("abc"), b != mb("abd"), b != b, b != "abc", b != nil

# An extension's `!=` under `using` binds statically: never rewritten.
module Contrary
  extension String
    def !=(other: String) -> Bool = self == other
  end
end
def contrary(s: String) -> Bool
  using Contrary
  s != "abc"
end
p contrary(mk(["a", "b", "c"])), contrary(mk(["x"]))
