# The witness of a module's abstract method may be the method of another
# module the extension includes after it (#557): `Cmp#<=>` for
# `Comparable#<=>`, a pair of the override table, through a typed call
# and through a native's gated send (`max`), which reads the same row
# (#536 step 3).
module Cmp
  abstract def v -> Int
  def <=>(o: Box) -> Int = o.v - v
end
class Box
  @v: Int
  def initialize(@v: Int)
  end
  def v -> Int = @v
  def to_s -> String = "B#{@v}"
end
module Scope
  extension Box
    include Comparable[Box]
    include Cmp
  end
end
using Scope
# (`Cmp#<=>` reverses the order: the largest is the one with the smallest `v`.)
puts [Box.new(1), Box.new(3)].max.to_s
def typed(a: Comparable[Box], b: Box) -> Int = a <=> b
puts typed(Box.new(1), Box.new(3))
puts Box.new(1) < Box.new(3)
