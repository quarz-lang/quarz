class Base[T]
  @v: T
  def initialize(@v: T); end
  def v -> T = @v
  def m -> T = @v
end
class A < Base[Int]
  def initialize; super(1); end
end
class B < Base[String]
  def initialize; super("s"); end
end
module Sh
  extension A
    include M
  end
  extension B
    include M
  end
  def self.a(x: A) -> M = x
  def self.b(x: B) -> M = x
end
puts "typed/shared/inherited/class: #{show(Sh.a(A.new))} #{show(Sh.b(B.new))}"
module Seq
end
class K1 < Base[Int]
  include Seq
  def initialize; super(1); end
end
class K2 < Base[String]
  include Seq
  def initialize; super("s"); end
end
module Sq
  extension Seq
    include M
  end
  def self.up(x: Seq) -> M = x
end
puts "typed/shared/inherited/module: #{show(Sq.up(K1.new))} #{show(Sq.up(K2.new))}"
module MG[U]
  abstract def g -> U
end
class GB[T]
  @v: T
  def initialize(@v: T); end
  def v -> T = @v
end
class GA < GB[Int]
  def initialize; super(7); end
end
class GS < GB[String]
  def initialize; super("s"); end
end
module Sg
  extension GB[T]
    include MG[T]
    def g -> T = v
  end
  def self.i(x: GB[Int]) -> MG[Int] = x
  def self.s(x: GB[String]) -> MG[String] = x
end
def via_i(x: MG[Int]) -> Int = x.g + 100
def via_s(x: MG[String]) -> String = x.g + "!"
puts "typed/shared/extension: #{via_i(Sg.i(GA.new))} #{via_s(Sg.s(GS.new))}"
class Animal
  def initialize; end
end
class Dog < Animal
  def initialize; end
end
class Sink[in T]
  def initialize; end
  def put(x: T) -> Void
  end
end
extension Sink[T <: Animal]
  include D
end
class CSub < Sink[Object]
  def initialize; end
  def m -> String = "s"
end
def up_sink(s: Sink[Dog]) -> D = s
puts "typed/outside-bound/variance: #{via_d(up_sink(Sink[Dog].new))} #{via_d(up_sink(CSub.new))}"
module Marked
end
class Bx[T]
  def initialize; end
end
extension Bx[T <: Marked]
  include D
end
class BSub < Bx[String]
  def initialize; end
  def m -> String = "s"
end
module Sm
  extension String
    include Marked
  end
  def self.up(b: Bx[String]) -> D = b
end
puts "typed/outside-bound/scoped: #{via_d(Sm.up(BSub.new))}"
module TM[U]
  abstract def tm -> U
end
def via_tm(x: TM[Int]) -> Int = x.tm + 100
module TNGeneric[T]
end
class TCgeneric
  def initialize; end
end
class TGgeneric[V]
  @v: V
  def initialize(@v: V); end
  def v -> V = @v
end
module Stgeneric
  extension TNGeneric[T]
    include TM[T]
  end
  extension TCgeneric
    include TNGeneric[Int]
    def tm -> Int = 8
  end
  extension TGgeneric[V]
    include TNGeneric[V]
    def tm -> V = v
  end
  def self.c(x: TCgeneric) -> TM[Int] = x
  def self.g(x: TGgeneric[Int]) -> TM[Int] = x
end
puts "typed/through-extension/generic: #{via_tm(Stgeneric.c(TCgeneric.new))} #{via_tm(Stgeneric.g(TGgeneric[Int].new(9)))}"
module TNBound[T]
end
class TCbound
  def initialize; end
end
class TGbound[V]
  @v: V
  def initialize(@v: V); end
  def v -> V = @v
end
module Stbound
  extension TNBound[T <: Int]
    include TM[T]
  end
  extension TCbound
    include TNBound[Int]
    def tm -> Int = 8
  end
  extension TGbound[V <: Int]
    include TNBound[V]
    def tm -> V = v
  end
  def self.c(x: TCbound) -> TM[Int] = x
  def self.g(x: TGbound[Int]) -> TM[Int] = x
end
puts "typed/through-extension/bound: #{via_tm(Stbound.c(TCbound.new))} #{via_tm(Stbound.g(TGbound[Int].new(9)))}"
