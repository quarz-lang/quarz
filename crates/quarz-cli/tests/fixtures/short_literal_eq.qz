def word(c: String) -> String
  case c
  when "a" then "A"
  when "" then "empty"
  when "a\0" then "nul"
  else "other"
  end
end
p word(mk(["a"])), word(mk(Array[String].new)), word(mk(["a", "\0"])), word(mk(["b"]))
