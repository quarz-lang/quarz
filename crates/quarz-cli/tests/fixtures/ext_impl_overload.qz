# An extension that makes a class include a module implements its abstract
# method with the overload that takes the method's arguments, not with the
# first method of the name (`Interp::ext_impl`).
module Sized
  abstract def f(x: Int) -> Int
  def g -> Int = f(1) + 1
end

class Box
end

extension Box
  include Sized
  def f(x: String, y: String) -> String = x + y
  def f(x: Int) -> Int = x * 10
end

puts Box.new.g
puts Box.new.f("a", "b")
