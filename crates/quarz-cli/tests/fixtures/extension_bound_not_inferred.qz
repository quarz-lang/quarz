# A conditional extension's bound against an argument not inferred yet
# (#518's review): `Bx[Array[?]]` may still meet `T <: Array[Int]` and
# takes the `Summ` overload; `Bx[Array[Array[?]]]` never can and takes
# `Object`'s.
module Summ
  abstract def total -> Int
end
class Bx[T]
  @v: T
  def initialize(@v: T); end
  def v -> T = @v
end
extension Bx[T <: Array[Int]]
  include Summ
  def total -> Int = v.sum
end
def f(s: Summ) -> String = "summ #{s.total}"
def f(o: Object) -> String = "obj"
p f(Bx.new([1]))
p f(Bx.new(["a"]))
p f(Bx.new([]))
p f(Bx.new([[]]))
