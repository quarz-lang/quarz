p Demo.released(["hi", "a long string, longer than any kept inline in its value"])
p Demo.released_bytes(["ab".to_bytes, "a long string, longer than any kept inline in its value".to_bytes])
p Demo.released_made(40)
p Demo.released_many(80)
# Through a procedure: the general binder, the default filled in.
scale = Demo.:scale
p scale.call(1.5)
m = Demo.int_map(3)
p m, m[1], m == {0 => 0, 1 => 10, 2 => 20}, m.merge({5 => 50})
total = 0
m.each do |k, v|
  total += k + v
end
p total
f = Demo.floats(3)
doubled = f.map { |x| x * 2.0 }
p f, f[2], f == [0.0, 0.5, 1.0], doubled
bl = Demo.byte_list(2)
sizes = bl.map { |b| b.size }
p bl.size, bl[1] == bl[1], sizes
# Blocks called by native code (ABI 1.1).
p Demo.twice(3) { |v| v * 2 }
p Demo.twice(3) { |v| break 42 }
begin
  Demo.twice(3) { |v| raise DemoError.new("from the block") }
rescue DemoError => e
  p e.message
end
def down(n: Int) -> Int = Demo.depth(n) { |k| k > 0 ? down(k - 1) : 0 }
p down(2)
# A block that suspends its task (a channel receive) inside the native.
ch = Channel[Int].new(capacity: 1)
sender = Task.spawn do
  ch.send(5)
  ch.send(5)
  0
end
p Demo.twice(1) { |v| v + ch.receive * 0 + 1 }
# Native classes (ABI 1.1).
c = Counter.open(5)
p c.value, c.bump, c.bump, c.value, c
pool = Pool.open
pool_sizes = Channel[Int].new(capacity: 1)
Task.spawn do
  pool_sizes.send(pool.size)
  0
end
p pool_sizes.receive
begin
  Demo.smuggle
rescue TypeError => e
  p e.message
end
begin
  Demo.peek(pool)
rescue TypeError => e
  p e.message
end
def boom -> Int
  b = Bomb.open
  1
end
p boom, boom
# Native objects as values: in unions, typed Object, in collections, through a module.
class Plain
end

def describe(x: Int | String | Counter | Plain | Nil) -> String
  case x
  in nil then "nil"
  in Int then "int"
  in String then "string"
  in Counter then "counter #{x.value}"
  in Plain then "plain"
  end
end

def look(o: Object) -> Void
  p o.is_a?(Counter), o.is_a?(Plain), o.to_s, o.inspect, o == o, o.hash == o.hash
end

k = Counter.open(40)
xs: Array[Int | String | Counter | Plain | Nil] = [1, "s", k, Plain.new, nil]
xs.each { |x| p describe(x) }
p xs.map { |x| x.is_a?(Counter) }
look(k)
p k == Counter.open(40), k == k
h = {k => 1}
h = h.put(Counter.open(1), 2)
p h[k], h.size
cs = [k, Counter.open(2)]
p cs.include?(k), cs.index(k), cs[1].value, cs.map(&:value)
total = 0
i = 0
while i < cs.size
  total += cs[i].value
  i += 1
end
p total
p "k is #{k}, at #{k.value}"
sz: Sized = Pool.open
p sz.doubled, sz.size
p k.twice_bumped, k.same_as?(k), k.same_as?(Counter.open(0))

# `new` as any class's (docs/15).
p Counter.new(5).value, Counter.new.value, Counter.new(by: 3).value, Counter.new(2, by: 3).value
p Counter.build.value, Pool.new.size, Counter.new(1).class
tw = Counter.new(8)
tw2 = tw.twin
tw2.bump
p tw.value, tw2.value, Counter.lend(30) { |c| c.bump + 1 }

# No copy of a native object: `dup` refuses it, at run time too.
def copy_of(o: Object) -> Object = o.dup
begin
  copy_of(k)
rescue TypeError => e
  p e.message
end

# Drops: at a scope's end, and for a value dropped from a collection
# when the method that dropped it returns (docs/03 §4, as for
# `deinitialize`); a shareable one on whichever worker drops it.
def probe_once -> Int
  pr = Probe.open
  Demo.drops
end

def shrink -> Int
  ps = [Probe.open, Probe.open, Probe.open]
  ps.pop!
  ps.set!(0, Probe.open)
  ps.pop!
  ps.pop!
  ps.size
end

def hand_over -> Int
  probes = Channel[Probe].new(capacity: 1)
  taker = Task.spawn do
    pr = probes.receive
    0
  end
  probes.send(Probe.open)
  taker.await
end

d0 = Demo.drops
p probe_once - d0, Demo.drops - d0
d1 = Demo.drops
p shrink, Demo.drops - d1
d2 = Demo.drops
p hand_over, Demo.drops - d2
p :done
