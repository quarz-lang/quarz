# The methods `native/src/lib.rs` implements (docs/15).
module Demo
  native def self.add(a: Int, b: Int) -> Int
  native def self.describe(x: Object) -> String
  native def self.reverse(s: String) -> String
  native def self.bytes_sum(b: Bytes) -> Int
  native def self.zeros(n: Int) -> Bytes
  native def self.squares(n: Int) -> Array[Int]
  native def self.sum(xs: Array[Int]) -> Int
  native def self.invert(h: Hash[String, Int]) -> Hash[Int, String]
  native def self.sym(s: String) -> Symbol
  native def self.scale(x: Float, *, by: Float = 2.0) -> Float
  native def self.fail(message: String) -> Int
  native def self.fail_with(name: String) -> Int
  native def self.panic -> Int
  native def self.push_lent(xs: Array[Int]) -> Array[Int]
  native def self.wrong -> Int
  native def self.nothing -> Void
  native def self.keep(x: Int) -> Int
  native def self.use_kept -> Int
  # The block, called by native code (ABI 1.1): on `x`, then on its value.
  native def self.twice(x: Int, &blk: (Int) -> Int) -> Int
  # Calls the block on `n`; the depth of such calls under way, kept in a
  # thread-local `RefCell` released around the call, is in the result.
  native def self.depth(n: Int, &blk: (Int) -> Int) -> Int
  # Asks for a Counter's data as another Rust type: a TypeError.
  native def self.counter_as_text(c: Counter) -> Int
  # Makes a Counter its declaration does not return: a TypeError.
  native def self.smuggle -> Int
  # Names a class that is not the cog's: a TypeError.
  native def self.no_such(c: Counter) -> Int
  # Reads a Pool as a Counter: a TypeError.
  native def self.peek(x: Object) -> Int
  # Makes a Counter from another Rust type: a TypeError.
  native def self.wrong_type -> Counter
  # Releases each string or bytes after reading it, then reads it again.
  native def self.released(xs: Array[String]) -> String
  native def self.released_bytes(bs: Array[Bytes]) -> Int
  native def self.released_made(n: Int) -> String
  # Past the values a frame keeps inline: in its chunks.
  native def self.released_many(n: Int) -> String
  # Collections whose representation follows their elements.
  native def self.int_map(n: Int) -> Hash[Int, Int]
  native def self.floats(n: Int) -> Array[Float]
  native def self.byte_list(n: Int) -> Array[Bytes]
end

extension String
  native def shout -> String
end

class DemoError < StandardError
end

class FancyError < StandardError
  def initialize(message: String)
    super("fancy " + message)
  end
end

abstract class AbstractError < StandardError
end

class GenericError[T] < StandardError
end

class Crate
  # Returns a String: refused against its declared `Self`.
  native def self.make -> Self
end

# Native classes (ABI 1.1): objects holding the cog's data.
native class Counter
  native def self.open(start: Int) -> Counter
  native def value -> Int
  native def bump -> Int
end

native class Pool
  include Shareable
  native def self.open -> Pool
  native def size -> Int
end

# Its data's drop panics.
native class Bomb
  native def self.open -> Bomb
end
