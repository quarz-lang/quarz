# Bytes::Secret on several workers (#963): one buffer for every task;
# a wipe on one worker is seen on the others; a read racing a wipe
# sees the whole secret or raises, never a part of it.
require "crypto"

s = Bytes::Secret.of(b"hunter2")
p (1..8).map { |_| Task.spawn { (1..100).all? { |_| s.expose_bytes == b"hunter2" } } }.map(&:await).uniq
Task.spawn { s.wipe }.await
p (1..8).map { |_| Task.spawn { [s.wiped?, s.__cleared?, s.size] } }.map(&:await).uniq

whole = ("hunter2" * 64).to_bytes
t = Bytes::Secret.of(whole)
outcomes = (1..8).map do |k|
  Task.spawn do
    if k == 5
      Task.sleep(1.ms)
      t.wipe
      Array[Symbol].new
    else
      (1..300).map do |_|
        begin
          t.expose_bytes == whole ? :whole : :part
        rescue Bytes::Secret::WipedError
          :raised
        end
      end
    end
  end
end
seen = outcomes.map(&:await).flatten.uniq
p seen.include?(:part), t.wiped?, t.__cleared?

# Made in one task, its last reference dropped in others: released
# whichever worker drops it (the clear on release is pinned by the
# runtime's unit test).
made = (1..8).map { |_| Task.spawn { Crypto.random_secret(16) } }.map(&:await)
p (1..8).map { |k| Task.spawn { made[k - 1].size } }.map(&:await).uniq

# `a == b` on some workers while `b == a` runs on others, and each
# compared with itself: the two locks are taken in one order, the same
# secret's once, so all of them finish.
a = Bytes::Secret.of(b"same")
b = Bytes::Secret.of(b"same")
p (1..8).map { |k|
  Task.spawn do
    (1..2000).all? do |_|
      case k % 4
      when 0 then a == b
      when 1 then b == a
      when 2 then a == a
      else b == b
      end
    end
  end
}.map(&:await).uniq
