# Constants used at once by tasks on different workers: the initializer
# runs once, the others wait for it; one cancelled or failing leaves the
# constant to the next use.
RUNS = Atom.new(0)

def slow -> Int
  RUNS.update { |n| n + 1 }
  Task.sleep(20.ms)
  42
end

def late -> Int = LATE

ts = (0...8).map { |_| Task.spawn { late } }
p ts.map(&:await), RUNS.get
LATE = slow

# The task running an initializer is cancelled while it waits: a task
# waiting for the constant runs it again. The first run waits on a
# channel nothing sends to, so only the cancel ends it, whenever the
# tasks are scheduled.
STARTED = Channel[Int].new(capacity: 1)
NEVER = Channel[Int].new

def stalls -> Int
  first_run = RUNS.get == 0
  RUNS.update { |n| n + 1 }
  if first_run
    STARTED.send(0)
    NEVER.receive
  end
  7
end

def stalled -> Int = STALLED

RUNS.set(0)
first = Task.spawn { stalled }
STARTED.receive
waiters = (0...4).map { |_| Task.spawn { stalled } }
# (Only makes it likely that the waiters wait for the constant already.)
Task.sleep(10.ms)
first.cancel
begin
  first.await
rescue Task::Cancelled
  puts "first cancelled"
end
p waiters.map(&:await), RUNS.get
STALLED = stalls

# A task cancelled while it waits for a constant: the others still get it.
# The initializer goes on only once the quitter's cancel has been seen.
RUNNING = Channel[Int].new(capacity: 1)
RELEASE = Channel[Int].new(capacity: 1)

def slower -> Int
  RUNNING.send(0)
  RELEASE.receive
  9
end

def slowest -> Int = SLOWEST

runner = Task.spawn { slowest }
RUNNING.receive
quitter = Task.spawn { slowest }
others = (0...3).map { |_| Task.spawn { slowest } }
# (Only makes it likely that they wait for the constant already; the
# output is the same if they have not started.)
Task.sleep(10.ms)
quitter.cancel
begin
  quitter.await
rescue Task::Cancelled
  puts "quitter cancelled"
end
RELEASE.send(0)
p runner.await, others.map(&:await)
SLOWEST = slower
