# A task's result is released where the program's last reference to it
# goes, not later on the worker that ran the task (#374): its
# `deinitialize` runs before the next line, every round (counted, so
# that the output stays short; the builtins fixture of the same name
# prints them).
DEINITS = Atom[Int].new(0)

class Res
  include Shareable
  @name: String
  def initialize(@name: String); end
  def deinitialize
    DEINITS.update { |n| n + 1 }
  end
end

def awaited(i: Int) -> Int
  r, n = Task.scope do |scope|
    t = scope.spawn { Res.new("awaited #{i}") }
    [t.await, 1]
  end
  n
end

def spawned(i: Int) -> Int
  t = Task.spawn { Res.new("spawned #{i}") }
  t.await
  1
end

def failed(i: Int) -> Int
  t = Task.spawn { raise ArgumentError.new("failed #{i}") }
  begin
    t.await
  rescue ArgumentError => e
    e.message.size
  end
end

ROUNDS = 1000
late = 0
ROUNDS.times do |i: Int|
  awaited(i)
  late += 1 unless DEINITS.get == 2 * i + 1
  spawned(i)
  late += 1 unless DEINITS.get == 2 * i + 2
  failed(i)
end
p [:rounds, ROUNDS, :late, late, :released, DEINITS.get]
