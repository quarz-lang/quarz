# The top level's `self` is the file's one top-level object, on every
# worker that runs a task it starts (a function has none, docs/01 §2).
def name_of(x: Object) -> String = x.class.name
top = self
ts = (0...32).map { |_| Task.spawn { self.equal?(top) } }
p ts.map(&:await).all?
p Task.scope { |s| (0...8).map { |_| s.spawn { name_of(self) } }.map(&:await) }.uniq
