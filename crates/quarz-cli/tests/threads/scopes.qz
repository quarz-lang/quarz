# A child failing on one worker cancels its siblings on the others, and
# the scope raises the failure in its owner. Channels order it, whatever
# the scheduling: each sibling has started (inside its `begin`, so its
# `ensure` runs when it is cancelled) before the child raises, and waits
# on a channel nothing sends to, which only the cancel ends.
log = Channel[String].new(16)
started = Channel[Int].new(3)
never = Channel[Int].new
begin
  Task.scope do |s|
    3.times do |i|
      s.spawn do
        begin
          started.send(i)
          never.receive
        ensure
          # Uncancellable: a cancelled task's channel operations raise.
          Task.uncancellable { log.send("sibling #{i} ended") }
        end
      end
    end
    s.spawn do
      3.times { started.receive }
      raise ArgumentError, "child failed"
    end
  end
rescue ArgumentError => e
  puts "scope raised: #{e.message}"
end
lines: Array[String] = []
3.times { lines = lines.push(log.receive) }
p lines.sort

# An exception from a task, through await.
t = Task.spawn { raise IOError, "far away" }
begin
  t.await
rescue IOError => e
  puts "awaited: #{e.message}"
end

# Cancelling a task on another worker in a timer wait, once it has
# started (it is sleeping, or about to: the cancel ends the sleep, which
# is far longer than any run).
ready = Channel[Int].new(1)
sleeper = Task.spawn do
  ready.send(0)
  Task.sleep(60.seconds)
  :slept
end
ready.receive
sleeper.cancel
begin
  sleeper.await
rescue Task::Cancelled
  puts "cancelled"
end
