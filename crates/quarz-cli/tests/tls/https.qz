# An HTTPS server (`HTTP::Server`'s `tls:`) for the harness's rustls
# client (tests/tls.rs): each response is the request's scheme; `/quit`
# shuts the server down. ARGV is the certificates' directory.
require "http"

dir = ARGV[0]
config = TLS::ServerConfig.new(certificate: File.read(File.join(dir, "server.pem")),
                               private_key: File.read(File.join(dir, "server.key")),
                               alpn: ["http/1.1"])
stop = Channel[Nil].new(capacity: 1)
handler = HTTP.handler do |req|
  stop.try_send(nil) if req.path == "/quit"
  HTTP::Response.text(req.scheme)
end

begin
  HTTP::Server.new(handler, path: "unused.sock", tls: config)
rescue ArgumentError => e
  puts e.message
end
p HTTP::Request.get("/").scheme

server = HTTP::Server.new(handler, host: "127.0.0.1", port: 0, tls: config,
                          read_header_timeout: 300.ms, trusted_proxies: ["127.0.0.1"],
                          on_error: ->(e: Exception, req: HTTP::Request?) { puts "on_error: #{e.class}" })
puts "port #{server.local_address.port}"
STDOUT.flush
Task.spawn do
  stop.receive
  server.shutdown
end
server.serve
puts "done"
