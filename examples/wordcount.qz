# Read several files concurrently and count their words
# quarz run examples/wordcount.qz *.txt

data WordCount(word: String, count: Int)
  include Comparable[WordCount]
  def <=>(other: WordCount) -> Int
    [other.count, word] <=> [count, other.word]   # by count descending, then word ascending
  end
end

def count_words(text: String) -> Hash[String, Int]
  text.downcase.scan(/[a-z']+/).tally
end

# Process each file in a task of its own, and wait until all are done
counts = Task.scope do |scope|
  ARGV.map { |path| scope.spawn { count_words(File.read(path)) } }
      .map(&:await)
end

total = counts.reduce({}) { |acc, h| acc.merge(h) { |_word, a, b| a + b } }

total.map { |word, count| WordCount.new(word, count) }
     .sort
     .first(10)
     .each { |wc| puts "#{wc.word.ljust(20)} #{wc.count}" }
