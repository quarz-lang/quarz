# When to use immutable collections, and when a Builder

# 1. Immutable style: when the array has a single reference, push updates it
#    in place, so this is fast
def squares(n: Int) -> Array[Int]
  acc: Array[Int] = []
  n.times { |i| acc = acc.push(i * i) }
  acc
end

# 2. Builder: almost the API of Ruby's mutable Array. In the `Array.build { }` form
#    it never leaves its block
def sieve(limit: Int) -> Array[Int]
  flags = Array::Builder[Bool].new(limit + 1, true)
  flags[0] = flags[1] = false
  (2..Math.sqrt(limit).to_i).each do |i|
    next unless flags[i]
    (i * i).step(limit, i) { |j| flags[j] = false }
  end
  Array.build do |primes|
    flags.each_with_index { |f, i| primes << i if f }
  end
end

# 3. Values derived from a large array: each is a new array, and `base` is
#    unchanged (updating an array something else still refers to copies it)
base = squares(100_000)
v1 = base.set(0, -1)
v2 = base.push(1)
puts base[0], v1[0], v2.size         # => 0, -1, 100001

# 4. Building a string
def render(rows: Array[Hash[Symbol, String]]) -> String
  String.build do |out|
    rows.each do |row|
      out << row[:name] << "\t" << row[:email] << "\n"
    end
  end
end

puts sieve(50).inspect
puts render([{ name: "alice", email: "a@example.com" }, { name: "bob", email: "b@example.com" }])

# 5. A Builder cannot be passed to another task
buf = Array::Builder[Int].new
# Task.spawn { buf << 1 }        # compile error: Array::Builder[Int] is not Shareable
frozen = buf.to_a           # O(1): hands the contents over, leaving buf empty
Task.spawn { puts frozen.size }.await
