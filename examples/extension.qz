# extension / using: add methods and module conformance to existing types, in a lexical scope

module Describable
  abstract def describe -> String
end

module Describing
  extension Int
    include Describable
    def describe -> String = "the integer #{self}"
  end

  extension String
    include Describable
    def describe -> String = "the string #{inspect}"
    def shout -> String = upcase + "!"
  end

  extension Array[T <: Describable]
    def describe_all -> String = map(&:describe).join(", ")
  end
end

def show(x: Describable) -> Void
  puts x.describe
end

using Describing

show(42)                 # Int now conforms to Describable
show("quarz")
puts [1, 2, 3].describe_all
puts "hello".shout

# `using` applies to this file only: in a file without `using Describing`,
# "x".shout is a compile error.
