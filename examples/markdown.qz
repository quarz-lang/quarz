# A small Markdown → HTML converter: headings, paragraphs, lists, fenced
# code blocks, rules, and inline code, emphasis and links.
#
#   quarz run examples/markdown.qz README.md > README.html

enum Block
  Heading(level: Int, text: String)
  | Paragraph(text: String)
  | List(items: Array[String], ordered: Bool)
  | Code(lang: String, lines: Array[String])
  | Rule
end

def escape_html(text: String) -> String
  text.gsub("&", "&amp;").gsub("<", "&lt;").gsub(">", "&gt;")
end

# Inline markup, innermost first so that `**` wins over `*`.
def inline(text: String) -> String
  html = escape_html(text)
  html = html.gsub(/`([^`]+)`/, "<code>\\1</code>")
  html = html.gsub(/\*\*([^*]+)\*\*/, "<strong>\\1</strong>")
  html = html.gsub(/\*([^*]+)\*/, "<em>\\1</em>")
  html.gsub(/\[([^\]]+)\]\(([^)]+)\)/, "<a href=\"\\2\">\\1</a>")
end

# Group lines into blocks.
def parse(source: String) -> Array[Block]
  lines = source.lines.map(&:chomp)
  blocks = Array::Builder[Block].new
  paragraph = Array::Builder[String].new
  items = Array::Builder[String].new
  ordered = false
  code: Array::Builder[String]? = nil
  lang = ""

  flush_paragraph = -> {
    blocks << Block::Paragraph.new(paragraph.to_a.join(" ")) unless paragraph.empty?
    paragraph = Array::Builder[String].new
  }
  flush_list = -> {
    blocks << Block::List.new(items.to_a, ordered) unless items.empty?
    items = Array::Builder[String].new
  }

  lines.each do |line|
    current_code = code
    if current_code
      if line.start_with?("```")
        blocks << Block::Code.new(lang, current_code.to_a)
        code = nil
      else
        current_code << line
      end
      next
    end
    if line.start_with?("```")
      flush_paragraph.call
      flush_list.call
      lang = line[3..].strip
      code = Array::Builder[String].new
    elsif (m = line.match(/\A(#+) +(.*)\z/)) && m[1].to_s.size <= 6
      flush_paragraph.call
      flush_list.call
      blocks << Block::Heading.new(m[1].to_s.size, m[2].to_s)
    elsif line.match?(/\A(-{3,}|\*{3,})\z/)
      flush_paragraph.call
      flush_list.call
      blocks << Block::Rule
    elsif (m = line.match(/\A[-*] +(.*)\z/))
      flush_paragraph.call
      flush_list.call if ordered && !items.empty?
      ordered = false
      items << m[1].to_s
    elsif (m = line.match(/\A\d+\. +(.*)\z/))
      flush_paragraph.call
      flush_list.call if !ordered && !items.empty?
      ordered = true
      items << m[1].to_s
    elsif line.strip.empty?
      flush_paragraph.call
      flush_list.call
    else
      flush_list.call
      paragraph << line.strip
    end
  end
  flush_paragraph.call
  flush_list.call
  if (unterminated = code)
    blocks << Block::Code.new(lang, unterminated.to_a)
  end
  blocks.to_a
end

def render(blocks: Array[Block]) -> String
  String.build do |out|
    blocks.each do |block|
      case block
      in Block::Heading(level:, text:)
        out << "<h#{level}>" << inline(text) << "</h#{level}>\n"
      in Block::Paragraph(text:)
        out << "<p>" << inline(text) << "</p>\n"
      in Block::List(items:, ordered:)
        tag = ordered ? "ol" : "ul"
        out << "<#{tag}>\n"
        items.each { |item| out << "  <li>" << inline(item) << "</li>\n" }
        out << "</#{tag}>\n"
      in Block::Code(lang:, lines:)
        attr = lang.empty? ? "" : " class=\"language-#{lang}\""
        out << "<pre><code#{attr}>" << lines.map { |l| escape_html(l) }.join("\n") << "</code></pre>\n"
      in Block::Rule
        out << "<hr>\n"
      end
    end
  end
end

SAMPLE = <<~'MD'
  # Quarz

  A *small* language with **static** classes and `immutable` data.

  ## Features

  - Ruby-like syntax
  - Lightweight tasks (see [the docs](docs/04-concurrency.md))
  - One runtime for `quarz run` and `quarz build`

  1. Parse
  2. Check
  3. Lower & run

  ---

  ```ruby
  def greet(name: String) -> String
    "Hello, <#{name}>!"
  end
  ```
MD

source = case ARGV.first?
         in String => path then File.read(path)
         in nil then SAMPLE
         end
blocks = parse(source)
print render(blocks)
counts = blocks.map { |b| b.class.name.sub("Block::", "") }.tally
warn counts.keys.sort.map { |k| "#{k}: #{counts[k]}" }.join(", ")
