# An Erlang-style actor: its state stays in a task's local variables, and its messages are an enum

enum Msg
  variant Deposit(amount: Int)
  variant Withdraw(amount: Int, reply: Channel[Result[Int, String]])
  variant Balance(reply: Channel[Int])
  variant Stop
end

def account_actor(inbox: Channel[Msg]) -> Void
  balance = 0
  inbox.each do |msg|
    case msg
    in Msg::Deposit(amount:)
      balance += amount
    in Msg::Withdraw(amount:, reply:)
      if amount <= balance
        balance -= amount
        reply.send(Result::Ok.new(balance))
      else
        reply.send(Result::Err.new("insufficient funds: #{balance} < #{amount}"))
      end
    in Msg::Balance(reply:)
      reply.send(balance)
    in Msg::Stop
      break
    end
  end
end

# A thin wrapper for clients
class Account
  include Shareable
  @inbox: Channel[Msg]
  def initialize(@inbox: Channel[Msg]); end

  def deposit(amount: Int) -> Void = @inbox.send(Msg::Deposit.new(amount))

  def withdraw(amount: Int) -> Result[Int, String]
    reply = Channel[Result[Int, String]].new
    @inbox.send(Msg::Withdraw.new(amount, reply))
    reply.receive
  end

  def balance -> Int
    reply = Channel[Int].new
    @inbox.send(Msg::Balance.new(reply))
    reply.receive
  end

  def stop -> Void = @inbox.send(Msg::Stop)
end

Task.scope do |scope|
  inbox = Channel[Msg].new(capacity: 64)
  scope.spawn { account_actor(inbox) }
  account = Account.new(inbox)          # Account is Shareable (it includes Shareable; its fields are immutable)

  # Deposits from several tasks at once: the actor handles them one at a time
  Task.scope do |s|
    10.times { s.spawn { account.deposit(10) } }
  end

  case account.withdraw(30)
  in Result::Ok(value:) then puts "withdrew, balance now #{value}"
  in Result::Err(error:) then warn error
  end

  case account.withdraw(1000)
  in Result::Ok(value:) then puts "withdrew, balance now #{value}"
  in Result::Err(error:) then warn error
  end

  puts "final: #{account.balance}"
  account.stop
end
